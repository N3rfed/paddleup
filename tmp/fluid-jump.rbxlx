      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">MatchRules</string>
          <string name="Source"><![CDATA[-- Court coordinates match the painted lines in World.
local Rules={HALF_WIDTH=20,BASELINE=40,KITCHEN=14,HIT_RANGE=12,PERFECT_RANGE=9,SLAM_RANGE=16,SLAM_HORIZONTAL=8,REAR_REACH=1.5,SLAM_MIN_HEIGHT=0.5,SLAM_EXTRA_HEIGHT=5,BACK_LIMIT=60}

Rules.DIVE_COOLDOWN=1.75
Rules.DIVE_STAMINA_COST=35
Rules.STAMINA_RECOVERY_DELAY=1.0
Rules.STAMINA_REGEN_RATE=22*0.55
Rules.JUMP_HANG_TIME=1
Rules.JUMP_DESCENT_GRAVITY=4
Rules.SLAM_TIMING_WINDOW=0.06

function Rules.canDive(stamina,readyAt,now)
 return now>=readyAt and stamina>=Rules.DIVE_STAMINA_COST
end

function Rules.recoverStamina(stamina,recoveryAt,now,dt)
 local elapsed=math.min(math.max(0,dt),math.max(0,now-recoveryAt))
 return math.min(100,stamina+elapsed*Rules.STAMINA_REGEN_RATE)
end

Rules.LOB_RESTITUTION=0.45
Rules.LOB_GRAVITY_SCALE=1.6
Rules.LOB_HORIZONTAL_RETENTION=0.75

-- Split a frame at the apex so heavier descent gravity never changes ascent.
function Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce)
 if lob and not postBounce and velocity.Y>0 then
  local timeToApex=velocity.Y/gravity
  local ascent=math.min(dt,timeToApex)
  position+=velocity*ascent-Vector3.new(0,0.5*gravity*ascent*ascent,0)
  velocity-=Vector3.new(0,gravity*ascent,0)
  -- Floating-point residue at the apex must not defer the heavier descent.
  if dt>=timeToApex then velocity=Vector3.new(velocity.X,0,velocity.Z) end
  dt-=ascent
 end
 local acceleration=gravity*(lob and (postBounce or velocity.Y<=0) and Rules.LOB_GRAVITY_SCALE or 1)
 position+=velocity*dt-Vector3.new(0,0.5*acceleration*dt*dt,0)
 velocity-=Vector3.new(0,acceleration*dt,0)
 return position,velocity,acceleration
end

-- Offensive topspin switches gravity at the net plane, splitting crossing frames.
function Rules.advanceFlight(position,velocity,gravity,dt,lob,postBounce,offensive,side)
 if not offensive then return Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce) end
 if position.Z*side<=0 then return Rules.advanceBall(position,velocity,gravity*1.8,dt,lob,postBounce) end
 local crossing=velocity.Z~=0 and -position.Z/velocity.Z or math.huge
 if crossing>=0 and crossing<=dt then
  position,velocity=Rules.advanceBall(position,velocity,gravity,crossing,lob,postBounce)
  return Rules.advanceBall(position,velocity,gravity*1.8,dt-crossing,lob,postBounce)
 end
 return Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce)
end

function Rules.ballLandingTime(height,vy,gravity,lob,postBounce)
 height=math.max(0,height)
 if lob and not postBounce and vy>0 then
  local ascent=vy/gravity
  local peak=height+vy*vy/(2*gravity)
  return ascent+math.sqrt(2*peak/(gravity*Rules.LOB_GRAVITY_SCALE))
 end
 local acceleration=gravity*(lob and Rules.LOB_GRAVITY_SCALE or 1)
 return (vy+math.sqrt(vy*vy+2*acceleration*height))/acceleration
end

-- Solve the launch arc with the same piecewise gravity used by simulation.
function Rules.lobLaunchY(height,duration,gravity)
 local descending=(0.5*gravity*Rules.LOB_GRAVITY_SCALE*duration*duration-height)/duration
 if descending<=0 then return descending end
 local low,high=0,gravity*duration
 for _=1,40 do
  local vy=(low+high)/2
  local descent=duration-vy/gravity
  local y=height+vy*vy/(2*gravity)-0.5*gravity*Rules.LOB_GRAVITY_SCALE*descent*descent
  if y>0 then high=vy else low=vy end
 end
 return (low+high)/2
end

function Rules.bounceVelocity(velocity,lob)
 if lob then
  return Vector3.new(velocity.X*Rules.LOB_HORIZONTAL_RETENTION,
   math.max(0,-velocity.Y)*Rules.LOB_RESTITUTION,velocity.Z*Rules.LOB_HORIZONTAL_RETENTION)
 end
 return Vector3.new(velocity.X,math.max(15,-velocity.Y*0.78),velocity.Z)
end

Rules.SERVE_TIMEOUT=15
Rules.BOT_SERVE_DELAY=2
Rules.MAX_SERVE_VELOCITY=90

function Rules.canServe(userId,serverId,ready)
 return ready==true and userId~=nil and userId~=0 and userId==serverId
end

Rules.SERVE_CHARGE_TIME=2
Rules.SERVE_PERFECT_OFFSET=0.06
Rules.SERVE_GOOD_OFFSET=0.4
Rules.SERVE_NET_OFFSET=-0.65

-- Hold to sweep up and down; release is judged at the current position.
function Rules.serveTiming(started,now)
 local phase=math.max(0,now-started)%(Rules.SERVE_CHARGE_TIME*2)/Rules.SERVE_CHARGE_TIME
 local needle=phase<=1 and phase or 2-phase
 local offset=needle*2-1
 local accuracy=1-math.abs(offset)
 local grade=math.abs(offset)<=Rules.SERVE_PERFECT_OFFSET+1e-9 and "PERFECT!"
  or math.abs(offset)<=Rules.SERVE_GOOD_OFFSET+1e-9 and "GOOD"
  or offset<0 and "UNDERCHARGED" or "OVERCHARGED"
 return needle,offset,accuracy,grade
end

function Rules.servePower(charge)
 return 0.3+0.7*math.clamp(charge,0,2)
end

function Rules.timedServeTarget(side,serveX,offset)
 offset=math.clamp(offset,-1,1)
 local depth
 if offset < -Rules.SERVE_GOOD_OFFSET-1e-9 then
  depth=math.max(4,13*(offset+1)/(1-Rules.SERVE_GOOD_OFFSET))
 elseif offset>Rules.SERVE_GOOD_OFFSET+1e-9 then
  depth=42+20*(offset-Rules.SERVE_GOOD_OFFSET)
 else depth=28+offset*22 end
 return Vector3.new(-math.sign(serveX)*10,181.7,-side*depth)
end

-- Ignore invalid remote targets and keep aim inside the diagonal service box.
function Rules.serveTarget(target,side,serveX)
 local fallback=Vector3.new(-serveX,181.7,-side*28)
 if typeof(target)~="Vector3" then return fallback end
 for _,value in ipairs({target.X,target.Y,target.Z}) do
  if value~=value or math.abs(value)==math.huge then return fallback end
 end
 local x=math.clamp(target.X* -math.sign(serveX),1,Rules.HALF_WIDTH-1)
 local depth=math.clamp(-target.Z*side,Rules.KITCHEN+2,Rules.BASELINE-2)
 return Vector3.new(-math.sign(serveX)*x,181.7,-side*depth)
end

function Rules.serveX(side,score)
 return side*(score%2==0 and 10 or -10)
end

function Rules.inKitchen(position,margin)
 margin=margin or 0
 return math.abs(position.X)<=Rules.HALF_WIDTH+margin and math.abs(position.Z)<=Rules.KITCHEN+margin
end

function Rules.servePositionValid(position,side,serveX,grounded)
 return grounded and position.Z*side>Rules.BASELINE+1
  and math.abs(position.X)<Rules.HALF_WIDTH-1 and position.X*math.sign(serveX)>1
end

function Rules.serveLandingValid(position,side,serveX)
 return position.Z*side< -Rules.KITCHEN-0.09 and math.abs(position.Z)<=Rules.BASELINE+0.09
  and math.abs(position.X)<=Rules.HALF_WIDTH+0.09 and position.X*math.sign(serveX)<=0.09
end

function Rules.returnFault(bounces,shots,inKitchen)
 if bounces>0 then return nil end
 if shots<2 then return "Two-bounce rule: let the ball bounce" end
 if inKitchen then return "Kitchen volley fault" end
 return nil
end

function Rules.startPosition(side,servingSide,serveX,primary)
 local serving=side==servingSide
 local x=serving and serveX or -serveX
 if not primary then x=-x end
 local depth=(serving or primary) and 46 or Rules.KITCHEN+4
 return Vector3.new(x,185,side*depth)
end

-- Shared by server validation and the developer hitbox overlay.
function Rules.slamBounds(character,root)
 local head=character:FindFirstChild("Head")
 local headTop=head and head.Position.Y+head.Size.Y*0.5 or root.Position.Y+3
 local armLength=0
 for _,name in ipairs({"RightUpperArm","RightLowerArm","RightHand","Right Arm"}) do
  local part=character:FindFirstChild(name)
  if part then armLength+=part.Size.Y end
 end
 armLength=math.clamp(armLength,2,6)
 return headTop+Rules.SLAM_MIN_HEIGHT,headTop+armLength+Rules.SLAM_EXTRA_HEIGHT
end

-- Generous vertical reach, while preserving the horizontal limit.
function Rules.overheadReach(ballPosition,rootPosition,minY,maxY)
 local offset=ballPosition-rootPosition
 return Vector3.new(offset.X,0,offset.Z).Magnitude<=Rules.SLAM_HORIZONTAL
  and ballPosition.Y>=minY
  and ballPosition.Y<=maxY
end

-- Overhead contact is the timing window for lobs near the kitchen line.
function Rules.kitchenLobWindow(lob,overhead,position,side)
 local depth=position.Z*side
 return lob==true and overhead and side~=0
  and depth>Rules.KITCHEN+1 and depth<=Rules.KITCHEN+Rules.SLAM_HORIZONTAL
  and math.abs(position.X)<=Rules.HALF_WIDTH
end

function Rules.jumpSlam(position,side,grounded,diving)
 local depth=position.Z*side
 return side~=0 and not grounded and not diving and depth>=0
  and depth<=Rules.KITCHEN+Rules.SLAM_HORIZONTAL and math.abs(position.X)<=Rules.HALF_WIDTH
end

function Rules.slamTiming(ballPosition,ballVelocity,contactPosition,perfectVision)
 -- Signed time to the strike plane: approaching is early, passing it is late.
 local speedSquared=ballVelocity:Dot(ballVelocity)
 local timing=speedSquared>1 and -(ballPosition-contactPosition):Dot(ballVelocity)/speedSquared or 0
 local window=Rules.SLAM_TIMING_WINDOW*(perfectVision and 1.2 or 1)
 if timing>window then return "net" end
 if timing< -window then return "out" end
 return "perfect"
end

function Rules.slamTarget(target,side,quality)
 if quality=="out" then return Vector3.new(target.X,target.Y,-side*(Rules.BASELINE+8)) end
 return target
end

-- Deterministic movement influence, shared by the crosshair and server shots.
function Rules.shotAim(rootFrame,velocity,ballPosition)
 local look=rootFrame.LookVector
 local forward=Vector3.new(look.X,0,look.Z).Unit
 local right=Vector3.new(-forward.Z,0,forward.X)
 local movement=Vector3.new(velocity.X,0,velocity.Z)
 local lateral=math.clamp(movement:Dot(right)/18,-1,1)
 local angle=lateral*math.rad(4)
 local direction=forward*math.cos(angle)+right*math.sin(angle)
 local toward=ballPosition and Vector3.new(ballPosition.X-rootFrame.Position.X,0,ballPosition.Z-rootFrame.Position.Z) or forward
 toward=toward.Magnitude>0.1 and toward.Unit or forward
 local momentum=math.clamp(movement:Dot(toward)/18,0,1)
 return direction,momentum,angle
end

function Rules.contactInFront(ballPosition,rootFrame)
 local look=rootFrame.LookVector
 local forward=Vector3.new(look.X,0,look.Z)
 if forward.Magnitude<0.001 then return false end
 return (ballPosition-rootFrame.Position):Dot(forward.Unit)>=-Rules.REAR_REACH
end

function Rules.shotQuality(clean,timeToBounce,timeSinceBounce)
 if clean then return "perfect" end
 if math.min(timeToBounce,timeSinceBounce)>0.65 then return "net" end
 return "lob"
end

function Rules.softShot(position,side)
 -- A drop from behind the kitchen line lands inside the opponent's kitchen.
 return position.Z*side<=Rules.KITCHEN+8 and "dink" or "drop"
end

function Rules.kitchenHitFault(rootPosition,grounded,kitchenTouched)
 -- Airspace is legal when taking off outside; landing is checked separately.
 if grounded then return Rules.inKitchen(rootPosition) end
 return kitchenTouched==true
end

function Rules.updateKitchen(state,position,grounded,velocity,dt)
 local touching=grounded and Rules.inKitchen(position)
 if grounded then state.kitchenTouched=touching end
 local fault=touching and state.volleyPending==true
 if state.volleyPending then
  if grounded and Vector3.new(velocity.X,0,velocity.Z).Magnitude<2 then
   state.volleySettled=(state.volleySettled or 0)+dt
   if state.volleySettled>0.15 then state.volleyPending=false end
  else state.volleySettled=0 end
 end
 return fault
end

function Rules.diveDirection(moveDirection,lookDirection,ballDirection)
 local moving=Vector3.new(moveDirection.X,0,moveDirection.Z)
 if moving.Magnitude>0.15 then return moving.Unit end
 local looking=Vector3.new(lookDirection.X,0,lookDirection.Z)
 if looking.Magnitude>0.1 then return looking.Unit end
 local ball=Vector3.new(ballDirection.X,0,ballDirection.Z)
 return ball.Magnitude>0.1 and ball.Unit or Vector3.new(0,0,-1)
end

function Rules.slamSpeedScale(rallySpeed)
 return rallySpeed*math.clamp(0.9+0.2*math.max(0,rallySpeed-1),0.9,1.3)
end

Rules.CHARGE_TIME=1
Rules.HIT_COOLDOWN=0.28
function Rules.heldBallPosition(character)
 if not character then return nil end
 local hand=character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
 if hand then return hand.CFrame:PointToWorldSpace(Vector3.new(0,-hand.Size.Y*0.5-0.3,-0.2)) end
 local root=character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Body")
 return root and root.CFrame:PointToWorldSpace(Vector3.new(-1.2,0,-1.2)) or nil
end

function Rules.hitReady(now,readyAt,perfect)
 return perfect or now>=readyAt
end

function Rules.chargeAmount(started,now)
 local delay=0.4
 return started and math.clamp((now-started-delay)/(Rules.CHARGE_TIME-delay),0,1) or 0
end

function Rules.chargeTarget(from,target,charge,severity,spread,depthRoll)
 local offset=Vector3.new(target.X-from.X,0,target.Z-from.Z)
 if offset.Magnitude<0.01 then return target end
 local forward=offset.Unit
 local right=Vector3.new(-forward.Z,0,forward.X)
 local risk=charge*charge*math.clamp(severity,0,1)
 return target+forward*((10+18*depthRoll)*risk)+right*(spread*16*risk)
end

function Rules.returnSpeed(speed,clean,slam,charged)
 if not clean then return speed*0.95 end
 if charged and not slam then return math.max(1,speed)*1.07 end
 if speed<1 then return 1 end
 return speed*(slam and 1.10 or 1.05)
end

-- Court coordinates differ only in height; each runtime gets its own wrapper table.
function Rules.withHeight(height)
 local scoped=table.clone(Rules)
 for _,name in ipairs({"serveTarget","timedServeTarget","startPosition"}) do
  scoped[name]=function(...)
   return Rules[name](...)+Vector3.new(0,height,0)
  end
 end
 return scoped
end
return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">MatchSetup</string>
          <string name="Source"><![CDATA[local Setup={}
Setup.ARCADE_FEATURES_ENABLED=false
function Setup.abilities(mode) return mode=="Arcade" and Setup.ARCADE_FEATURES_ENABLED end
Setup.players={Practice=1,["1V1"]=2,["1V2"]=3,["2V2"]=4}
-- Chaos remains the internal ID for the mode presented as Arcade.
Setup.modes={Classic=true,Chaos=true}
function Setup.valid(mode,map,modifier)
 if not Setup.modes[mode] or (map~="Rooftop" and map~="Moon") then return false end
 if mode=="Classic" then return modifier=="None" end
 if mode=="Chaos" then return modifier=="LowGravity" end
 return modifier=="None" or modifier=="LowGravity"
end
return Setup
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="15">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- One public place. Roblox allocates public server instances; this script owns only this instance.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
-- Set before the first yield so duplicate bootstrap scripts cannot connect twice.
if game:GetAttribute("PaddleUpServerInitialized") then return end
game:SetAttribute("PaddleUpServerInitialized",true)
game:GetService("StarterPlayer").EnableMouseLockOption=false
local root=require(script:WaitForChild("World")).build()
local lobbyRoot=require(script:WaitForChild("Lobby")).build()
require(script:WaitForChild("DayNightCycle")).start()
local template=root:Clone(); template.Parent=nil
local folder=ReplicatedStorage:FindFirstChild("PaddleUp") or Instance.new("Folder")
folder.Name="PaddleUp"; folder.Parent=ReplicatedStorage
for _,name in ipairs({"Input","State","Feedback","Session","Queue","IntroReady","Powerup","Practice","Arcade","ArcadeLoadout","Elevator"}) do
 if not folder:FindFirstChild(name) then
  local event=Instance.new("RemoteEvent"); event.Name=name; event.Parent=folder
 end
end
local shared=ReplicatedStorage:FindFirstChild("Shared") or Instance.new("Folder")
shared.Name="Shared"; shared.Parent=ReplicatedStorage
for _,name in ipairs({"MatchRules","MatchSetup","MapCatalog"}) do
 if not shared:FindFirstChild(name) then script:WaitForChild(name):Clone().Parent=shared end
end
-- Directory syncs include these templates even when an existing place lacks new Shared mappings.
-- Publish before requiring ProgressionRules/ShopRules so neither lobby interaction can wait forever.
shared:SetAttribute("CosmeticsVersion",nil)
for _,name in ipairs({"CosmeticCatalog","CosmeticTextures","CosmeticAssets"}) do
 local previous=shared:FindFirstChild(name)
 if previous then previous:Destroy() end
 script:WaitForChild("Cosmetics"):WaitForChild(name):Clone().Parent=shared
end
shared:SetAttribute("CosmeticsVersion",2)
local CourtSession=require(script:WaitForChild("CourtSession"))
local progression=require(script:WaitForChild("ProgressionService")).start(folder,lobbyRoot)
require(script:WaitForChild("CosmeticService")).start(progression)
require(script:WaitForChild("Cosmetics"):WaitForChild("ShopMannequins")).prepare()
require(script:WaitForChild("ShopService")).start(folder,lobbyRoot,progression)
local queueRemote,session=folder.Queue,folder.Session
local elevatorService
local closing=false
local dispatching=false
local owners,runtimes,roots={},{},{}
local reservedSlots={}
local lastSessionRequest={}
-- A slot per allowed visitor supports the worst case: everyone practicing alone.
-- Start with MaxPlayers=8 and measure before raising it (each slot contains scenery).
local capacity=Players.MaxPlayers
local failOverview
local function owner(player) return owners[player] end
local function runtime(id)
 if runtimes[id] then return runtimes[id] end
 local court=root
 if id~=0 then
  court=template:Clone(); court.Name="PaddleUpCourt"..id
  local translation=CFrame.new(0,id*4096,0)
  for _,part in ipairs(court:GetDescendants()) do
   if part:IsA("BasePart") then part.CFrame=translation*part.CFrame end
  end
  court.Parent=workspace
 end
 roots[id]=court
 local cleanup={}
 local ok,result=pcall(CourtSession.new,{id=id,height=id*4096,root=court,network=folder,owner=owner,progression=progression,
  onOverviewFailure=function() if failOverview then failOverview(id) end end,
  track=function(callback) table.insert(cleanup,callback) end})
 if not ok then
  for index=#cleanup,1,-1 do pcall(cleanup[index]) end
  if id~=0 then court:Destroy(); roots[id]=nil end
  error(result)
 end
 runtimes[id]=result
 return runtimes[id]
end
runtime(0)
local queue=require(script:WaitForChild("MatchQueue")).new(function(player,data)
 if not closing and player.Parent==Players then queueRemote:FireClient(player,data) end
end)
local function move(player,id)
 if owners[player]~=nil then runtimes[owners[player]]:remove(player) end
 owners[player]=id
 runtime(id):add(player)
end
local function lobby(player,message)
 if player.Parent~=Players then return end
 move(player,0)
 runtimes[0]:enter(player,"Lobby")
 if message then session:FireClient(player,false,message) end
end
-- Failed map preparation returns the whole party through normal lobby ownership.
failOverview=function(id)
 local match=elevatorService and elevatorService.matches[id]
 if match then elevatorService:cancelTarget(match); elevatorService.matches[id]=nil end
 local roster={}
 for player,courtId in pairs(owners) do if courtId==id then table.insert(roster,player) end end
 if runtimes[id] then runtimes[id]:pauseReplacement(false); runtimes[id]:prepareOverview(nil) end
 for _,player in ipairs(roster) do lobby(player,"The selected map could not finish loading. Please try again.") end
end
local function freeSlot()
 for id=1,capacity do
  if not reservedSlots[id] and (not runtimes[id] or runtimes[id]:empty()) then return id end
 end
end
local function dispatchQueue()
 if closing then return end
 local id=freeSlot()
 local group=queue:update(id~=nil)
 if not group then return end
 reservedSlots[id]=true
 -- Prepare the destination before moving any players. Failure leaves the group in the lobby.
 local ok,err=pcall(runtime,id)
 if not ok then
  reservedSlots[id]=nil
  warn("Court initialization failed: "..tostring(err))
  if roots[id] then roots[id]:Destroy(); roots[id]=nil end
  for _,player in ipairs(group.players) do
   queueRemote:FireClient(player,{stage="Cancelled"})
   lobby(player,"The court could not start. Please queue again.")
  end
  return
 end
 local success,reason=pcall(function()
  for _,player in ipairs(group.players) do
   assert(player.Parent==Players and owners[player]==0,"A queued player left")
  end
  for _,player in ipairs(group.players) do
   queueRemote:FireClient(player,{stage="Cancelled"})
   move(player,id)
   assert(runtimes[id]:enter(player,group.format,group.mode,group.map,group.modifier),"Admission rejected")
  end
 end)
 reservedSlots[id]=nil
 if success and elevatorService and (group.format=="1V1" or group.format=="2V2") then elevatorService:track(id,group) end
 if not success then
  warn("Match admission failed: "..tostring(reason))
  for _,player in ipairs(group.players) do lobby(player,"The group changed. Please queue again.") end
 end
end
local function updateQueue()
 if closing or dispatching then return end
 dispatching=true
 local ok,err=xpcall(dispatchQueue,debug.traceback)
 dispatching=false
 if not ok then warn("Queue dispatch failed: "..tostring(err)) end
end
local function addPlayer(player)
 if closing or owners[player]~=nil or player.Parent~=Players then return end
 move(player,0)
end
local connections={}
local function connect(signal,callback) table.insert(connections,signal:Connect(callback)) end
connect(Players.PlayerAdded,addPlayer)
connect(Players.PlayerRemoving,function(player)
 if elevatorService then elevatorService:departed(player,owners[player]); elevatorService:remove(player) end
 queue:remove(player)
 lastSessionRequest[player]=nil
 local id=owners[player]
 if id~=nil then
  local wasPlaying=player:GetAttribute("CourtSide")~=0
  runtimes[id]:remove(player); owners[player]=nil
  if id~=0 and wasPlaying and (not elevatorService or not elevatorService.matches[id]) then
   local peers={}
   for peer,courtId in pairs(owners) do
    if courtId==id and peer:GetAttribute("CourtSide")~=0 then table.insert(peers,peer) end
   end
   for _,peer in ipairs(peers) do lobby(peer,"A player left the match. Please queue again.") end
  end
 end
end)
connect(session.OnServerEvent,function(player,mode)
 if closing or owners[player]==nil then return end
 if os.clock()-(lastSessionRequest[player] or -math.huge)<0.5 then return end
 lastSessionRequest[player]=os.clock()
 if mode~="Lobby" and mode~="Spectate" then
  session:FireClient(player,false,"Choose a mode and player count to join the queue."); return
 end
 if elevatorService then elevatorService:leave(player,true); elevatorService:departed(player,owners[player]) end
 queue:remove(player)
 local previous=owners[player]
 local peers={}
 if previous~=0 and player:GetAttribute("CourtSide")~=0 and (not elevatorService or not elevatorService.matches[previous]) then
  for peer,courtId in pairs(owners) do
   if peer~=player and courtId==previous and peer:GetAttribute("CourtSide")~=0 then table.insert(peers,peer) end
  end
 end
 for _,peer in ipairs(peers) do lobby(peer,"A player left the match. Please queue again.") end
 local id=0
 if mode=="Spectate" then
  for candidate=1,capacity do
   if runtimes[candidate] and not runtimes[candidate]:empty() then id=candidate; break end
  end
 end
 move(player,id)
 runtimes[id]:enter(player,mode)
end)
connect(queueRemote.OnServerEvent,function(player,action,a,b)
 if closing or owners[player]==nil then return end
 if action=="Cancel" then queue:remove(player)
 elseif action=="Join" then
  if (elevatorService and elevatorService.members[player]) or owners[player]~=0 or player:GetAttribute("SessionMode")~="Lobby" or not queue:join(player,a,b) then
   queueRemote:FireClient(player,{stage="Error",message="Return to the lobby and choose a valid mode and player count."})
  end
 elseif action=="Vote" then
  if not queue:configure(player,a,b) then
   queueRemote:FireClient(player,{stage="Error",message="Voting has closed, or this choice is unavailable."})
  end
 end
 updateQueue()
end)
-- Elevator admission reuses the same runtime, ownership, and CourtSession APIs.
local function startElevatorMatch(group)
 local id=freeSlot()
 if not id or #group.players~=require(script.MatchSetup).players[group.format] then return false end
 reservedSlots[id]=true
 local ok,err=pcall(function()
  runtime(id):prepareOverview(group.overviewSeconds)
  for _,p in ipairs(group.players) do
   assert(p.Parent==Players and owners[p]==0 and p.Character,"Party changed before arrival")
  end
  for _,p in ipairs(group.players) do
   assert(not group.valid or group.valid(),"Party changed while the map was preparing")
   assert(p.Parent==Players and owners[p]==0,"Party member left")
   queue:remove(p); move(p,id)
   assert(runtimes[id]:enter(p,group.format,group.mode,group.map,group.modifier),"Admission rejected")
   assert(not group.valid or group.valid(),"Party changed during admission")
  end
 end)
 reservedSlots[id]=nil
 if not ok then
  warn("Elevator admission failed: "..tostring(err))
  if runtimes[id] then runtimes[id]:prepareOverview(nil) end
  for _,p in ipairs(group.players) do if owners[p]==id then lobby(p,"The transition failed. Please try again.") end end
  return false
 end
 elevatorService:track(id,group)
 return true
end
elevatorService=require(script:WaitForChild("ElevatorService")).new({
 lobby=lobbyRoot,remote=folder.Elevator,queue=queue,owner=owner,
 clock=function() return workspace:GetServerTimeNow() end,
 start=startElevatorMatch,
 pause=function(id,paused) if runtimes[id] then runtimes[id]:pauseReplacement(paused) end end,
 replace=function(player,match,seat)
  local previous=owners[player]
  if previous~=0 and previous~=match.courtId then return false end
  if previous==0 then move(player,match.courtId) end
  local success,admitted=pcall(function()
   return runtimes[match.courtId]:replace(player,match.format,match.mode,match.map,match.modifier,seat)
  end)
  if not success then warn("Replacement admission failed: "..tostring(admitted)) end
  if (not success or not admitted) and previous==0 then lobby(player,"The replacement spot is no longer available.") end
  return success and admitted
 end,
 terminate=function(id)
  local viewers={}
  for p,courtId in pairs(owners) do if courtId==id then table.insert(viewers,p) end end
  for _,p in ipairs(viewers) do lobby(p,"Match terminated: no replacement was available.") end
  if runtimes[id] then runtimes[id]:destroy(); runtimes[id]=nil end
  if roots[id] then roots[id]:Destroy(); roots[id]=nil end
 end,
})
local elevatorElapsed=0
connect(RunService.Heartbeat,function(dt)
 elevatorElapsed+=dt
 if elevatorElapsed>=require(script.ElevatorConfig).PollSeconds then
  elevatorElapsed=0
  local ok,err=xpcall(function() elevatorService:update() end,debug.traceback)
  if not ok then warn("Elevator update failed: "..tostring(err)) end
 end
 updateQueue()
end)
for _,player in ipairs(Players:GetPlayers()) do addPlayer(player) end
game:BindToClose(function()
 if closing then return end
 closing=true
 for _,connection in ipairs(connections) do connection:Disconnect() end
 if elevatorService then elevatorService:destroy() end
 queue:destroy()
 for _,controller in pairs(runtimes) do controller:destroy() end
 table.clear(owners)
 template:Destroy()
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">ArcadePowers</string>
          <string name="Source"><![CDATA[-- Shared eight-power engine: Arcade deck offers and random Chaos stacks.
local Deck=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("ArcadeDeck"))
local Arcade={}
Arcade.__index=Arcade
function Arcade.new(random,height)
 return setmetatable({height=height or 0,random=random or Random.new(),players={},hazards={},zeroUntil=0,glowUntil=0},Arcade)
end
function Arcade:reset()
 for _,hazard in ipairs(self.hazards) do if hazard.part then hazard.part:Destroy() end end
 table.clear(self.players); table.clear(self.hazards); self.zeroUntil=0; self.glowUntil=0
 self.remaining=self.random:NextInteger(2,4)
 self.chaosElapsed=0; self.chaosNext=4; self.chaosEvent=nil
 self.chaosGravity=1
end
function Arcade:data(player)
 if not self.players[player] then self.players[player]={slots={},effects={},pending={},levels={},chaosTimers={}} end
 return self.players[player]
end
function Arcade:empty(player,now)
 local data=self:data(player)
 local slots=data.slots
 for index=1,2 do
  local slot=slots[index]
  if slot and slot.readyAt and now>=slot.readyAt then
   if (slot.charges or 0)>0 then slot.readyAt=nil;slot.activeUntil=nil;slot.duration=nil
   else slots[index]=nil end
  end
  if not slots[index] and #data.pending>0 then
   local id=table.remove(data.pending,1);slots[index]={id=id,charges=1}
   for i=#data.pending,1,-1 do if data.pending[i]==id then slots[index].charges+=1;table.remove(data.pending,i) end end
  end
 end
 for index=1,2 do if not slots[index] then return index end end
end
function Arcade:offer(player,ids,now)
 if not Deck.validate(ids) or not self:empty(player,now) then return nil end
 local cards={}
 for _,id in ipairs(ids) do table.insert(cards,Deck.find(id)) end
 -- Shuffle without changing the selected deck.
 for i=#cards,2,-1 do local j=self.random:NextInteger(1,i); cards[i],cards[j]=cards[j],cards[i] end
 return cards
end
function Arcade:chaosOffer()
 local cards=table.clone(Deck.cards)
 for i=#cards,2,-1 do local j=self.random:NextInteger(1,i); cards[i],cards[j]=cards[j],cards[i] end
 return {cards[1],cards[2],cards[3]}
end
function Arcade:chaosUpgradeOffer(player)
 local levels=self:data(player).levels
 local cards={}
 for _,base in ipairs(Deck.cards) do
  if (levels[base.id] or 0)<Deck.CHAOS_MAX_LEVEL then table.insert(cards,Deck.chaosCard(base.id,levels[base.id])) end
 end
 for i=#cards,2,-1 do local j=self.random:NextInteger(1,i); cards[i],cards[j]=cards[j],cards[i] end
 local offer={}
 for i=1,math.min(3,#cards) do offer[i]=cards[i] end
 return #offer>0 and offer or nil
end
function Arcade:chooseChaos(player,offer,id)
 if type(offer)~="table" or type(id)~="string" then return nil end
 local levels=self:data(player).levels
 for _,candidate in ipairs(offer) do
  if candidate.id==id and candidate.chaosUpgrade and Deck.find(id) then
   local current=levels[id] or 0
   if current>=Deck.CHAOS_MAX_LEVEL or current~=candidate.previousLevel then return nil end
   local card=Deck.chaosCard(id,current)
   levels[id]=card.level
   return card
  end
 end
end
function Arcade:choose(player,offer,id,now,stack)
 local index=self:empty(player,now)
 if (not index and not stack) or type(offer)~="table" then return nil end
 for _,card in ipairs(offer) do
  if card.id==id and Deck.find(id) then
   local data=self:data(player)
   if stack then
    for slot,existing in pairs(data.slots) do
     if existing.id==id then existing.charges=(existing.charges or 0)+1;return card,slot end
    end
   end
   if index then data.slots[index]={id=id,charges=1}
   else table.insert(data.pending,id) end
   return card,index
  end
 end
end
function Arcade:rally()
 self.remaining=(self.remaining or self.random:NextInteger(2,4))-1
 if self.remaining>0 then return false end
 self.remaining=self.random:NextInteger(2,4); return true
end
function Arcade:effect(player,id,now)
 return now<(self:data(player).effects[id] or 0)
end
function Arcade:reach(player,now)
 local data=self:data(player)
 return Deck.chaosValues(data.levels).reach*(data.chaosShrink or 1)
  *(self:effect(player,"bigPaddle",now) and 1.75 or 1)*(self:effect(player,"smallPaddle",now) and 0.5 or 1)
end
function Arcade:speed(player,now)
 return Deck.chaosValues(self:data(player).levels).speed*(self:effect(player,"speedCleats",now) and 1.4 or 1)
end
function Arcade:swingScale(player,now)
 return Deck.chaosValues(self:data(player).levels).swing*(self:effect(player,"speedCleats",now) and Deck.SPEED_SWING_SCALE or 1)
end
function Arcade:gravity(now) return math.min(self.chaosGravity or 1,now<self.zeroUntil and 0.4 or 1) end
function Arcade:arm(player,index,now)
 if type(index)~="number" or index%1~=0 or index<1 or index>2 then return nil end
 self:empty(player,now)
 local slot=self:data(player).slots[index]
 if not slot or slot.readyAt or (slot.charges or 0)<=0 then return nil end
 slot.armed=not slot.armed
 return slot.armed
end
function Arcade:clearArmed(player)
 if player then
  local data=self.players[player]
  if data then for _,slot in pairs(data.slots) do slot.armed=nil end end
 else
  for p in pairs(self.players) do self:clearArmed(p) end
 end
end
function Arcade:activateArmed(player,now,side,opponents,root,world,chaos)
 local activated={}
 local data=self.players[player]
 if not data then return activated end
 for index=1,2 do
  local slot=data.slots[index]
  if slot and slot.armed then
   slot.armed=nil
   local card=self:activate(player,index,now,side,opponents,root,world,chaos)
   if card then table.insert(activated,card) end
  end
 end
 return activated
end
function Arcade:activate(player,index,now,side,opponents,root,world,chaos)
 if type(index)~="number" or index%1~=0 or index<1 or index>2 then return nil end
 self:empty(player,now)
 local data=self:data(player)
 local slot=data.slots[index]
 if not slot or slot.readyAt then return nil end
 slot.armed=nil
 local card=Deck.find(slot.id)
 slot.charges=math.max(0,(slot.charges or 1)-1)
 local duration=card.duration==0 and 15 or card.duration
 slot.cooldownDuration=chaos and Deck.CHAOS_COOLDOWN or Deck.COOLDOWN
 slot.activeUntil=now+duration; slot.readyAt=slot.activeUntil+slot.cooldownDuration; slot.duration=duration
 if card.id~="smallPaddle" then data.effects[card.id]=slot.activeUntil end
 if card.id=="smallPaddle" then
  for _,opponent in ipairs(opponents) do self:data(opponent).effects.smallPaddle=now+Deck.SMALL_PADDLE_SECONDS end
 elseif card.id=="zeroG" then self.zeroUntil=math.max(self.zeroUntil,slot.activeUntil)
 elseif card.id=="glowBall" then self.glowUntil=math.max(self.glowUntil,slot.activeUntil)
 elseif card.id=="dropPickles" or card.id=="slipStream" then
  for i=1,(card.id=="dropPickles" and 3 or 1) do
   local position=Vector3.new(math.clamp(root.Position.X+(i-2)*6,-16,16),181.4+self.height,-side*self.random:NextNumber(12,32))
   local part=Instance.new("Part"); part.Name=card.name; part.Anchored=true; part.CanCollide=false; part.CanTouch=false
   part.Material=Enum.Material.Neon; part.Color=card.id=="dropPickles" and Color3.fromRGB(149,255,63) or Color3.fromRGB(255,221,60)
   part.Size=card.id=="dropPickles" and Vector3.new(1.5,0.5,3) or Vector3.new(10,0.12,12)
   part.Position=position; part.Transparency=card.id=="dropPickles" and 0.1 or 0.45; part.Parent=world
   table.insert(self.hazards,{part=part,position=position,side=-side,expires=slot.activeUntil,kind=card.id,touched={}})
  end
 end
 return card
end
function Arcade:heatTarget(player,now,opponentPositions,side)
 local data=self:data(player)
 local level=data.levels.heatseeker or 0
 if level>0 then
  if now<(data.chaosHeatReadyAt or 0) then return nil end
  data.chaosHeatReadyAt=now+Deck.chaosValues(data.levels).heatInterval
 elseif not self:effect(player,"heatseeker",now) then return nil end
 data.effects.heatseeker=0
 for _,slot in pairs(data.slots) do
  if slot.id=="heatseeker" and slot.activeUntil and slot.activeUntil>now then slot.activeUntil=now; slot.readyAt=now+(slot.cooldownDuration or Deck.COOLDOWN) end
 end
 local best,bestDistance
 for _,x in ipairs({-17,17}) do
  local target=Vector3.new(x,181.7+self.height,-side*35); local nearest=math.huge
  for _,position in ipairs(opponentPositions) do nearest=math.min(nearest,(target-position).Magnitude) end
  if not best or nearest>bestDistance then best=target; bestDistance=nearest end
 end
 return best
end
function Arcade:touch(key,side,position,now)
 local effects=self:data(key).effects
 for _,hazard in ipairs(self.hazards) do
  if now<hazard.expires and hazard.side==side and not hazard.touched[key] then
   local offset=Vector3.new(position.X-hazard.position.X,0,position.Z-hazard.position.Z)
   local inZone=hazard.halfSize and math.abs(offset.X)<=hazard.halfSize and math.abs(offset.Z)<=hazard.halfSize
    or not hazard.halfSize and offset.Magnitude<=Deck.HAZARD_RADIUS
   if inZone then
    hazard.touched[key]=true; effects.slide=now+Deck.PICKLE_RECOVERY
    effects.slideDirection=offset.Magnitude>0.1 and offset.Unit or Vector3.new(1,0,0)
   end
  end
 end
 return now<(effects.slide or 0),effects.slideDirection
end
function Arcade:update(now)
 for i=#self.hazards,1,-1 do
  if now>=self.hazards[i].expires then self.hazards[i].part:Destroy(); table.remove(self.hazards,i) end
 end
end
function Arcade:chaosGift(player,now)
 local offer=self:chaosOffer()
 return self:choose(player,offer,offer[1].id,now,true)
end

-- Permanent levels remain between rallies; automatic hazards advance only in live play.
function Arcade:chaosUpdate(dt,now,participants,world,live)
 self.chaosGravity=1
 for _,entry in ipairs(participants) do
  local data=self:data(entry.player)
  local values=Deck.chaosValues(data.levels)
  self.chaosGravity=math.min(self.chaosGravity,values.gravity)
  data.chaosShrink=1
  for _,enemy in ipairs(participants) do
   if enemy.side~=entry.side then data.chaosShrink=math.min(data.chaosShrink,Deck.chaosValues(self:data(enemy.player).levels).shrink) end
  end
  if not live then continue end
  for _,id in ipairs({"dropPickles","slipStream"}) do
   local level=data.levels[id] or 0
   if level==0 then continue end
   local elapsed=(data.chaosTimers[id] or 0)+math.max(0,dt)
   local interval=id=="dropPickles" and values.pickleInterval or values.slipInterval
   data.chaosTimers[id]=elapsed
   if elapsed<interval then continue end
   data.chaosTimers[id]=0
   local count=id=="dropPickles" and values.pickleCount or 1
   for _=1,count do
    local position=Vector3.new(self.random:NextNumber(-14,14),181.4+self.height,-entry.side*self.random:NextNumber(16,34))
    local part=Instance.new("Part"); part.Name="Chaos "..Deck.find(id).name
    part.Anchored=true; part.CanCollide=false; part.CanTouch=false; part.Material=Enum.Material.Neon
    part.Color=id=="dropPickles" and Color3.fromRGB(149,255,63) or Color3.fromRGB(255,221,60)
    part.Size=id=="dropPickles" and Vector3.new(1.5,0.5,3) or Vector3.new(values.slipSize,0.12,values.slipSize)
    part.Position=position; part.Transparency=id=="dropPickles" and 0.1 or 0.45; part.Parent=world
    table.insert(self.hazards,{part=part,position=position,side=-entry.side,expires=now+6,kind=id,
     halfSize=id=="slipStream" and values.slipSize/2 or nil,touched={}})
   end
  end
 end
end

-- Tick only during live Chaos rallies; one shared event affects both teams.
function Arcade:chaosStep(dt,now,participants,world)
 self.chaosElapsed=(self.chaosElapsed or 0)+math.max(0,dt)
 if self.chaosElapsed<(self.chaosNext or 4) or #participants==0 then return nil end
 local events={
  {id="speedCleats",name="SPEED FRENZY",detail="Everyone moves faster"},
  {id="bigPaddle",name="GIANT PADDLES",detail="Everyone gets extra reach"},
  {id="zeroG",name="GRAVITY SURGE",detail="Extra-low gravity for everyone"},
  {id="glowBall",name="LIGHTS OUT",detail="Follow the glowing ball"},
  {id="pickles",name="PICKLE STORM",detail="Watch your step on both sides"},
 }
 local index=self.random:NextInteger(1,self.chaosEvent and #events-1 or #events)
 if self.chaosEvent and index>=self.chaosEvent.index then index+=1 end
 local event=events[index]
 local endsAt=now+8
 for _,entry in ipairs(participants) do
  local effects=self:data(entry.player).effects
  if event.id=="speedCleats" or event.id=="bigPaddle" then effects[event.id]=math.max(effects[event.id] or 0,endsAt) end
 end
 if event.id=="zeroG" then self.zeroUntil=math.max(self.zeroUntil,endsAt)
 elseif event.id=="glowBall" then self.glowUntil=math.max(self.glowUntil,endsAt)
 elseif event.id=="pickles" then
  for _,side in ipairs({-1,1}) do
   for i=1,3 do
    local position=Vector3.new(self.random:NextNumber(-16,16),181.4+self.height,side*self.random:NextNumber(16,36))
    local part=Instance.new("Part"); part.Name="ChaosPickle"; part.Anchored=true; part.CanCollide=false; part.CanTouch=false
    part.Material=Enum.Material.Neon; part.Color=Color3.fromRGB(149,255,63)
    part.Size=Vector3.new(1.5,0.5,3); part.Position=position; part.Rotation=Vector3.new(0,self.random:NextNumber(-90,90),0); part.Parent=world
    table.insert(self.hazards,{part=part,position=position,side=side,expires=endsAt,kind="dropPickles",touched={}})
   end
  end
 end
 self.chaosEvent={index=index,name=event.name,detail=event.detail,endsAt=endsAt}
 self.chaosElapsed=0; self.chaosNext=self.random:NextInteger(10,14)
 return self.chaosEvent
end
function Arcade:pause(dt)
 self.zeroUntil+=dt; self.glowUntil+=dt
 if self.chaosEvent then self.chaosEvent.endsAt+=dt end
 for _,data in pairs(self.players) do
  if data.chaosHeatReadyAt then data.chaosHeatReadyAt+=dt end
  for id,value in pairs(data.effects) do if type(value)=="number" and value>0 then data.effects[id]+=dt end end
  for _,slot in pairs(data.slots) do if slot.readyAt then slot.readyAt+=dt; slot.activeUntil+=dt end end
 end
 for _,hazard in ipairs(self.hazards) do hazard.expires+=dt end
end
function Arcade:snapshot(player,now)
 self:empty(player,now)
 local slots={}
 for index=1,2 do
  local slot=self:data(player).slots[index]
  slots[index]=slot and {id=slot.id,charges=slot.charges or 0,armed=slot.armed==true,active=math.max(0,(slot.activeUntil or 0)-now),cooldown=math.max(0,(slot.readyAt or 0)-now),cooldownDuration=slot.cooldownDuration or Deck.COOLDOWN,duration=slot.duration or 0} or {id=""}
 end
 local event=self.chaosEvent
 local data=self:data(player)
 local values=Deck.chaosValues(data.levels)
 return {slots=slots,queued=#data.pending,levels=table.clone(data.levels),
  glow=now<self.glowUntil or (data.levels.glowBall or 0)>0,lightRange=values.lightRange,lightBrightness=values.lightBrightness,zeroG=self:gravity(now)<1,
  chaos=event and {name=event.name,detail=event.detail,remaining=math.max(0,event.endsAt-now)} or nil}
end
return Arcade
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">CitySurroundings</string>
          <string name="Source"><![CDATA[-- Static scenery around the lobby: shared construction, no running decor scripts or lights.
local CitySurroundings={}
function CitySurroundings.build(lobby)
 if workspace:FindFirstChild("LobbyCity") then return lobby end
 local floor=lobby.Architecture["Cream marble floor"]
 local base=workspace:WaitForChild("Baseplate")
 local groundY=base.Position.Y+base.Size.Y/2
 local city=workspace:WaitForChild("PaddleUp")
 local concrete=city:FindFirstChild("Balcony slab")
 local tower=city:FindFirstChild("City tower")
 local glass=city:FindFirstChild("Apartment glazing")
 local district=Instance.new("Model")
 district.Name="LobbyCity"; district:SetAttribute("Version",1)
 local center=Vector3.new(floor.Position.X,0,floor.Position.Z)
 local function part(parent,name,size,pos,color,material,collide)
  local p=Instance.new("Part")
  p.Name=name; p.Size=size; p.Position=pos; p.Color=color; p.Material=material
  p.Anchored=true; p.CanCollide=collide~=false; p.CanTouch=false; p.CanQuery=true
  p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
  p.Parent=parent
  return p
 end
 local function localPart(parent,name,size,x,y,z,color,material,collide)
  return part(parent,name,size,center+Vector3.new(x,y,z),color,material,collide)
 end
 local stone=concrete.Color
 local asphalt=Color3.fromRGB(47,52,60)
 local metal=Color3.fromRGB(65,75,84)
 local pavement=Color3.fromRGB(139,144,145)
 -- Tile beyond the original baseplate so the lobby never overlooks its nearby edge.
 local ground=Instance.new("Model"); ground.Name="Ground and streets"; ground.Parent=district
 for x=-1,1 do
  for z=-1,1 do
   if x~=0 or z~=0 then
    part(ground,"City ground extension",Vector3.new(base.Size.X,base.Size.Y,base.Size.Z),
     base.Position+Vector3.new(x*base.Size.X,0,z*base.Size.Z),base.Color,base.Material)
   end
  end
 end
 localPart(ground,"West street",Vector3.new(28,0.2,760),-120,groundY+0.1,10,asphalt,Enum.Material.Asphalt)
 localPart(ground,"Connecting street",Vector3.new(410,0.2,20),-90,groundY+0.1,104,asphalt,Enum.Material.Asphalt)
 localPart(ground,"West sidewalk",Vector3.new(12,0.5,760),-100,groundY+0.25,10,pavement,Enum.Material.Concrete)
 localPart(ground,"Opposite sidewalk",Vector3.new(14,0.5,760),-141,groundY+0.25,10,pavement,Enum.Material.Concrete)
 localPart(ground,"Lobby forecourt",Vector3.new(184,0.5,15),0,groundY+0.25,86.5,pavement,Enum.Material.Concrete)
 localPart(ground,"North curb",Vector3.new(410,0.5,3),-90,groundY+0.25,115.5,pavement,Enum.Material.Concrete)
 localPart(ground,"East sidewalk",Vector3.new(10,0.5,158),99,groundY+0.25,0,pavement,Enum.Material.Concrete)
 -- Sparse road markings stop before the junction.
 for z=-330,330,32 do
  if math.abs(z-104)>22 then
   localPart(ground,"Lane marking",Vector3.new(0.2,0.02,10),-120,groundY+0.21,z,
    Color3.fromRGB(204,201,181),Enum.Material.SmoothPlastic,false)
  end
 end
 -- Concrete additions sit outside the retained windows and join the grounded foundation.
 local details=Instance.new("Model"); details.Name="Concrete tower details"; details.Parent=district
 local ceiling=lobby.Architecture["Ivory ceiling"]
 local podiumTop=ceiling.Position.Y+ceiling.Size.Y/2
 for _,x in ipairs({-91,91}) do
  for _,z in ipairs({-79,79}) do
   localPart(details,"Ground floor concrete pier",Vector3.new(2, podiumTop-groundY,2),
    x,(groundY+podiumTop)/2,z,stone,Enum.Material.Concrete)
  end
  localPart(details,"Concrete base course",Vector3.new(0.6,5,158),
   x+math.sign(x)*0.3,groundY+2.5,0,stone,Enum.Material.Concrete)
 end
 for _,z in ipairs({-79,79}) do
  localPart(details,"Concrete base course",Vector3.new(182,5,0.6),
   0,groundY+2.5,z+math.sign(z)*0.3,stone,Enum.Material.Concrete)
 end
 local foundation=lobby.Architecture["Penthouse foundation"]
 local top=foundation.Position.Y+foundation.Size.Y/2
 for _,x in ipairs({-91,91}) do
  for _,z in ipairs({-79,79}) do
   localPart(details,"Concrete corner fin",Vector3.new(1,top-podiumTop,1),
    x,(top+podiumTop)/2,z,stone,Enum.Material.Concrete)
  end
 end
 local occupied={}
 for _,p in ipairs(city:GetChildren()) do
  if p:IsA("BasePart") and (p.Name=="City tower" or p.Name=="Apartment tower") then
   table.insert(occupied,{x=p.Position.X,z=p.Position.Z,w=p.Size.X,d=p.Size.Z})
  end
 end
 table.insert(occupied,{x=center.X,z=center.Z,w=184,d=172})
 local function building(spec,index)
  local x,z,w,d,h=spec[1],spec[2],spec[3],spec[4],spec[5]
  local worldX,worldZ=center.X+x,center.Z+z
  for _,other in ipairs(occupied) do
   assert(math.abs(worldX-other.x)>(w+other.w)/2+4 or math.abs(worldZ-other.z)>(d+other.d)/2+4,
    "City scenery footprint overlaps an existing building")
  end
  table.insert(occupied,{x=worldX,z=worldZ,w=w,d=d})
  local model=Instance.new("Model"); model.Name=spec[6]; model.Parent=district
  local body=part(model,"Concrete structure",Vector3.new(w,h,d),
   Vector3.new(worldX,groundY+h/2,worldZ),tower.Color:Lerp(stone,(index%4)*0.12),Enum.Material.Concrete)
  local tint=glass.Color:Lerp(Color3.fromRGB(125,143,151),(index%3)*0.14)
  for _,side in ipairs({-1,1}) do
   local pane=part(model,"Glazed facade",Vector3.new(w-2,h-14,0.2),
    body.Position+Vector3.new(0,3,side*(d/2+0.11)),tint,Enum.Material.Glass,false)
   pane.Reflectance=0.15
   pane=part(model,"Glazed facade",Vector3.new(0.2,h-14,d-2),
    body.Position+Vector3.new(side*(w/2+0.11),3,0),tint,Enum.Material.Glass,false)
   pane.Reflectance=0.15
  end
  -- One shared slab per floor, rather than individual window parts.
  local stride=index>11 and 24 or 12
  for y=12,h-2,stride do
   part(model,"Concrete floor band",Vector3.new(w+0.6,0.5,d+0.6),
    Vector3.new(worldX,groundY+y,worldZ),stone,Enum.Material.Concrete,false)
  end
  part(model,"Roof parapet",Vector3.new(w+0.6,1.2,d+0.6),
   Vector3.new(worldX,groundY+h+0.6,worldZ),stone,Enum.Material.Concrete,false)
  part(model,"Rooftop service enclosure",Vector3.new(w*0.35,6,d*0.3),
   Vector3.new(worldX+w*0.1,groundY+h+4.2,worldZ-d*0.1),metal,Enum.Material.Metal,false)
  if index<=7 then
   -- Storefronts on the street-facing side; static glazing and frames only.
   local face=index<=4 and 1 or -1
   if index<=4 then
    local xFace=worldX+w/2+0.15
    part(model,"Storefront glazing",Vector3.new(0.2,9,d-8),
     Vector3.new(xFace,groundY+5.5,worldZ),glass.Color,Enum.Material.Glass,false)
    part(model,"Storefront canopy",Vector3.new(4,0.5,d-4),
     Vector3.new(xFace+1.5,groundY+11,worldZ),metal,Enum.Material.Metal,false)
    part(model,"Storefront entrance",Vector3.new(0.25,8,5),
     Vector3.new(xFace+0.1,groundY+4,worldZ),metal,Enum.Material.Metal,false)
   else
    local zFace=worldZ+face*(d/2+0.15)
    part(model,"Storefront glazing",Vector3.new(w-8,9,0.2),
     Vector3.new(worldX,groundY+5.5,zFace),glass.Color,Enum.Material.Glass,false)
    part(model,"Storefront canopy",Vector3.new(w-4,0.5,4),
     Vector3.new(worldX,groundY+11,zFace-1.5),metal,Enum.Material.Metal,false)
    part(model,"Storefront entrance",Vector3.new(5,8,0.25),
     Vector3.new(worldX,groundY+4,zFace-0.1),metal,Enum.Material.Metal,false)
   end
   part(model,"Concrete pavement",Vector3.new(w+12,0.5,d+12),
    Vector3.new(worldX,groundY+0.25,worldZ),pavement,Enum.Material.Concrete)
  end
 end
 -- Coordinates are relative to the integrated lobby; preserve every existing city tower.
 local blocks={
  {-205,-165,78,82,126,"West apartments"},
  {-205,-25,72,104,174,"West office tower"},
  {-205,135,88,84,94,"West commercial block"},
  {-205,285,68,108,198,"West residential tower"},
  {-75,215,78,74,84,"Front commercial block"},
  {5,224,60,80,132,"Front apartments"},
  {95,325,58,60,158,"City infill tower"},
  {-375,-215,110,100,212,"Outer west tower"},
  {-375,10,96,130,148,"Outer west apartments"},
  {-375,265,118,100,192,"Outer west offices"},
  {-135,495,110,96,156,"North district block"},
  {-615,-380,120,96,208,"Distant southwest tower"},
  {-615,-60,104,112,238,"Distant west tower"},
  {-615,280,126,100,182,"Distant northwest tower"},
  {-515,570,140,100,218,"Distant north offices"},
  {-15,640,160,100,190,"Distant north apartments"},
 }
 for index,spec in ipairs(blocks) do building(spec,index) end
 district.Parent=workspace
 return lobby
end
return CitySurroundings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Comeback</string>
          <string name="Source"><![CDATA[-- One 9–3 comeback activation per match. Side 1 is score[1], side -1 score[2].
local Comeback={MOVE=1.15,HIT=1.15}
function Comeback.new() return {side=0,used=false} end
function Comeback.update(state,score,finished)
 if finished then state.side=0; return end
 if state.side~=0 then
  local own=state.side==1 and 1 or 2
  if score[own]>=score[3-own] then state.side=0 end
 elseif not state.used then
  if score[1]==9 and score[2]==3 then state.side=-1; state.used=true
  elseif score[2]==9 and score[1]==3 then state.side=1; state.used=true end
 end
end
function Comeback.active(state,side) return side~=0 and state.side==side end
return Comeback
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">CosmeticService</string>
          <string name="Source"><![CDATA[-- Server-visible paddle art and wearable geometry; no gameplay state is changed.
local Assets=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("CosmeticAssets"))
local Service={}
function Service.start(progression)
 local Players=game:GetService("Players")
 local records={}
 local function apply(player)
  local record=records[player]; local character=player.Character
  if not record or not character or not record.equipped then return end
  local face=character:FindFirstChild("PaddleFace")
  if face then Assets.paddle(face,record.equipped.Paddles) end
  Assets.wear(character,record.equipped.Wearables)
 end
 local function deferApply(player)
  local record=records[player]; if not record or record.queued then return end
  record.queued=true
  task.defer(function() if records[player]==record then record.queued=false; apply(player) end end)
 end
 local function character(player,c)
  local record=records[player]; if not record then return end
  if record.descendant then record.descendant:Disconnect() end
  record.descendant=c.ChildAdded:Connect(function(part)
   if part.Name=="PaddleFace" or part.Name=="UpperTorso" or part.Name=="Torso" or part.Name=="Head"
    or part.Name=="LeftHand" or part.Name=="RightHand" or part.Name=="Left Arm" or part.Name=="Right Arm" then deferApply(player) end
  end)
  deferApply(player)
 end
 local function add(player)
  if records[player] then return end
  local record={}; records[player]=record
  record.added=player.CharacterAdded:Connect(function(c) character(player,c) end)
  record.appearance=player.CharacterAppearanceLoaded:Connect(function() deferApply(player) end)
  if player.Character then character(player,player.Character) end
 end
 Players.PlayerAdded:Connect(add)
 Players.PlayerRemoving:Connect(function(player)
  local record=records[player]; if not record then return end
  for _,key in ipairs({"added","appearance","descendant"}) do if record[key] then record[key]:Disconnect() end end
  records[player]=nil
 end)
 for _,player in ipairs(Players:GetPlayers()) do add(player) end
 progression:subscribe(function(entry)
  local player=entry.player; local data=entry.data
  if not data or entry.failed or player.Parent~=Players then return end
  add(player); local record=records[player]
  local e=data.equipped
  local signature=(e.Paddles or "").."|"..(e.Wearables or "").."|"..(e.Courts or "")
  if record.signature==signature then return end
  record.signature=signature; record.equipped=table.clone(e)
  player:SetAttribute("EquippedPaddle",e.Paddles or "")
  player:SetAttribute("EquippedWearable",e.Wearables or "")
  player:SetAttribute("EquippedCourt",e.Courts or "")
  deferApply(player)
 end)
 return {apply=apply}
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Cosmetics</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">CosmeticAssets</string>
            <string name="Source"><![CDATA[-- Native Roblox geometry: the identical builders power shop viewports, boutique displays and equipment.
-- All decoration is nonphysical. Existing paddle and character parts are never resized or re-welded.
local Catalog=require(script.Parent:WaitForChild("CosmeticCatalog"))
local Textures=require(script.Parent:WaitForChild("CosmeticTextures"))
local Assets={}
local V=Vector3.new
local function part(parent,name,size,cf,color,material,anchor)
 local p=Instance.new("Part"); p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
 p.Material=material or Enum.Material.SmoothPlastic; p.Anchored=anchor~=false
 p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Massless=true; p.CastShadow=false
 p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=parent
 return p
end
local function model(parent,name) local m=Instance.new("Model"); m.Name=name; m.Parent=parent; return m end
local function attach(parent,target,name,size,offset,color,material)
 local p=part(parent,name,size,target.CFrame*offset,color,material,false)
 local weld=Instance.new("WeldConstraint"); weld.Part0=target; weld.Part1=p; weld.Parent=p
 return p
end
-- Geometry lettering also renders inside ViewportFrames (SurfaceGui text does not).
local function number07(parent,target,offset,width,height,color)
 local segments={a={0,0.42,0.68,0.1},b={0.34,0.21,0.1,0.42},c={0.34,-0.21,0.1,0.42},
  d={0,-0.42,0.68,0.1},e={-0.34,-0.21,0.1,0.42},f={-0.34,0.21,0.1,0.42}}
 for digit,keys in ipairs({{"a","b","c","d","e","f"},{"a","b","c"}}) do
  for _,key in ipairs(keys) do
   local v=segments[key]
   attach(parent,target,"Woven 07",V(width*0.44*v[3],height*v[4],0.014),
    offset*CFrame.new((digit==1 and -0.26 or 0.26)*width+v[1]*width*0.44,v[2]*height,0),color)
  end
 end
end
-- Shared silhouette for equipment, bots and shop previews. Catalog colors and
-- textures supply skins; gameplay continues to use the original face bounds.
Assets.DefaultPaddle={face=Color3.fromRGB(222,224,218),edge=Color3.fromRGB(38,42,46),accent=Color3.fromRGB(116,134,127)}
function Assets.paddle(face,id)
 face:SetAttribute("PaddleSkin",id or "")
 if not face:GetAttribute("PaddleModelBound") then
  face:SetAttribute("PaddleModelBound",true)
  face:GetPropertyChangedSignal("Size"):Connect(function() Assets.paddle(face,face:GetAttribute("PaddleSkin")) end)
 end
 local old=face:FindFirstChild("ShopPaddleArt"); if old then old:Destroy() end
 for _,child in ipairs(face:GetChildren()) do
  if child.Name=="ShopPrintFront" or child.Name=="ShopPrintBack" then child:Destroy() end
 end
 local item=Catalog.ById[id]
 if item and item.category~="Paddles" then item=nil end
 local style=Assets.DefaultPaddle
 local colors=item and item.colors or {style.face,style.edge,style.accent}
 local art=model(face,"ShopPaddleArt")
 face.Transparency=1
 local w,h,d=face.Size.X,face.Size.Y,face.Size.Z
 local function rounded(name,width,height,depth,z,color)
  local radius=width*0.19
  attach(art,face,name,V(width-2*radius,height,depth),CFrame.new(0,0,z),color)
  attach(art,face,name,V(width,height-2*radius,depth),CFrame.new(0,0,z),color)
  for _,x in ipairs({-1,1}) do for _,y in ipairs({-1,1}) do
   local corner=attach(art,face,name,V(depth,2*radius,2*radius),
    CFrame.new(x*(width/2-radius),y*(height/2-radius),z)*CFrame.Angles(0,math.pi/2,0),color)
   corner.Shape=Enum.PartType.Cylinder
  end end
 end
 rounded("Protective edge guard",w,h,d,0,colors[2])
 for _,side in ipairs({-1,1}) do
  rounded("Composite face",w*0.94,h*0.95,0.018,side*(d/2+0.008),colors[1])
  local print=attach(art,face,"Skin print",V(w*0.70,h*0.73,0.012),CFrame.new(0,0,side*(d/2+0.024)),colors[1])
  if item and Textures[item.asset] then
   local decal=Instance.new("Decal"); decal.Name="ShopPrint"
   decal.Face=side<0 and Enum.NormalId.Front or Enum.NormalId.Back
   decal.Texture=Textures[item.asset]; decal.Parent=print
  else
   attach(art,face,"Club stripe",V(w*0.35,h*0.025,0.014),CFrame.new(0,-h*0.24,side*(d/2+0.04)),colors[3])
   attach(art,face,"Club mark",V(w*0.08,h*0.12,0.014),CFrame.new(0,0,side*(d/2+0.04)),colors[2])
  end
 end
 local direction=face:GetAttribute("HandleDirection") or 1
 attach(art,face,"Throat",V(w*0.24,h*0.25,d*0.8),CFrame.new(0,direction*h*0.52,0),colors[2])
 attach(art,face,"Grip core",V(w*0.18,h*0.48,d),CFrame.new(0,direction*h*0.86,0),colors[2],Enum.Material.Fabric)
 for i=0,7 do
  attach(art,face,"Grip wrap",V(w*0.20,h*0.027,d*1.07),CFrame.new(0,direction*(h*0.67+i*h*0.055),0),Color3.fromRGB(62,65,68),Enum.Material.Fabric)
 end
 attach(art,face,"Butt cap",V(w*0.24,h*0.07,d*1.18),CFrame.new(0,direction*h*1.09,0),colors[2])
 art:SetAttribute("PrintDesign",item and item.asset or "default")
 return art
end
local function legacyWear(character,id)
 local old=character:FindFirstChild("ShopWearable"); if old then old:Destroy() end
 local item=Catalog.ById[id]; if not item or item.category~="Wearables" then return end
 local art=model(character,"ShopWearable"); local c=item.colors
 local torso=character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
 local head=character:FindFirstChild("Head")
 local function piece(target,name,size,offset,color)
  return attach(art,target,name,size,offset,color,Enum.Material.Fabric)
 end
 if (item.asset=="jersey" or item.asset=="sunset") and torso then
  local w,h,d=torso.Size.X,torso.Size.Y,torso.Size.Z
  for _,side in ipairs({-1,1}) do
   local panel=piece(torso,"Technical jersey panel",V(w*1.025,h*0.91,0.06),CFrame.new(0,-h*0.035,side*(d/2+0.04)),c[1])
   for i=1,3 do piece(torso,"Woven chest stripe",V(w*0.87,0.07,0.015),CFrame.new(0,h*(0.27-i*0.1),side*(d/2+0.079)),c[2]) end
   if item.asset=="jersey" then
    number07(art,torso,CFrame.new(0,-h*0.23,side*(d/2+0.097)),w*0.38,h*0.28,c[3])
   else
    for i=-2,2 do
     piece(torso,"Stepped sunset",V(w*0.1,h*(0.13-0.025*math.abs(i)),0.018),CFrame.new(i*w*0.11,-h*0.25,side*(d/2+0.1)),c[2])
    end
   end
  end
  for _,x in ipairs({-1,1}) do piece(torso,"Shoulder piping",V(0.07,h*0.85,d+0.08),CFrame.new(x*(w/2+0.025),0,0),c[3]) end
 elseif (item.asset=="headband" or item.asset=="visor") and head then
  local w,h,d=head.Size.X,head.Size.Y,head.Size.Z
  for _,side in ipairs({-1,1}) do
   piece(head,"Woven headband",V(w+0.09,0.22,0.08),CFrame.new(0,h*0.24,side*(d/2+0.045)),c[1])
   piece(head,"Band side",V(0.08,0.22,d+0.16),CFrame.new(side*(w/2+0.045),h*0.24,0),c[1])
  end
  piece(head,"Signature piping",V(w*0.8,0.045,0.02),CFrame.new(0,h*0.24-0.06,-d/2-0.09),c[2])
  piece(head,"Club mark",V(0.15,0.17,0.025),CFrame.new(0,h*0.24,-d/2-0.105),c[3])
  if item.asset=="visor" then piece(head,"Cyan visor brim",V(w*1.05,0.075,d*0.85),CFrame.new(0,h*0.18,-d*0.76),c[2]) end
 elseif item.asset=="wristbands" then
  for index,names in ipairs({{"LeftHand","Left Arm"},{"RightHand","Right Arm"}}) do
   local limb=character:FindFirstChild(names[1]) or character:FindFirstChild(names[2])
   if limb then
    local w,h,d=limb.Size.X,limb.Size.Y,limb.Size.Z
    local y=names[1]==limb.Name and h*0.25 or -h*0.32
    for _,side in ipairs({-1,1}) do
     piece(limb,"Terry cuff",V(w+0.12,0.3,0.08),CFrame.new(0,y,side*(d/2+0.04)),c[index])
     piece(limb,"Cuff edge",V(0.08,0.3,d+0.16),CFrame.new(side*(w/2+0.04),y,0),c[index])
    end
    piece(limb,"Cuff score stripe",V(w*0.75,0.055,0.02),CFrame.new(0,y,-d/2-0.09),c[3])
   end
  end
 elseif item.asset=="towel" and torso then
  local w,h,d=torso.Size.X,torso.Size.Y,torso.Size.Z
  piece(torso,"Shoulder towel",V(w*0.35,0.09,d+0.16),CFrame.new(-w*0.27,h/2+0.04,0),c[1])
  for _,side in ipairs({-1,1}) do
   piece(torso,"Towel fall",V(w*0.35,h*0.9,0.09),CFrame.new(-w*0.27,h*0.06,side*(d/2+0.08)),c[1])
   piece(torso,"Forest hem",V(w*0.35,0.11,0.025),CFrame.new(-w*0.27,-h*0.34,side*(d/2+0.14)),c[2])
   for i=1,3 do piece(torso,"Woven gold stripe",V(w*0.32,0.04,0.02),CFrame.new(-w*0.27,-h*0.19+i*0.07,side*(d/2+0.14)),c[3]) end
  end
 end
 return art
end
local function restoreClothing(character)
 local previous=character:FindFirstChild("ShopWearable")
 if previous then
  local stored=previous:FindFirstChild("OriginalClothing")
  if stored then for _,item in ipairs(stored:GetChildren()) do item.Parent=character end end
 end
 for _,p in ipairs(character:GetDescendants()) do
  if p:IsA("BasePart") and p:GetAttribute("ShopWearOriginalColor") then
   p.Color=p:GetAttribute("ShopWearOriginalColor"); p:SetAttribute("ShopWearOriginalColor",nil)
  end
  if (p:IsA("BasePart") or p:IsA("Decal")) and p:GetAttribute("ShopHiddenTransparency")~=nil then
   p.Transparency=p:GetAttribute("ShopHiddenTransparency"); p:SetAttribute("ShopHiddenTransparency",nil)
  end
 end
 if previous then previous:Destroy() end
end
local function headband(art,head,colors)
 if not head then return end
 local w,h,d=head.Size.X,head.Size.Y,head.Size.Z
 local radiusX,radiusZ=w*0.52+0.035,d*0.52+0.035
 for i=1,40 do
  local a,b=(i-1)*math.pi*2/40,i*math.pi*2/40
  local p1=V(math.cos(a)*radiusX,h*0.25,math.sin(a)*radiusZ)
  local p2=V(math.cos(b)*radiusX,h*0.25,math.sin(b)*radiusZ)
  local middle=(p1+p2)/2
  local offset=CFrame.lookAt(middle,p2)
  attach(art,head,"Fitted woven headband",V(0.045,0.19,(p2-p1).Magnitude+0.003),offset,colors[1],Enum.Material.Fabric)
  attach(art,head,"Headband contrast piping",V(0.056,0.028,(p2-p1).Magnitude+0.003),CFrame.new(0,-0.064,0)*offset,colors[3],Enum.Material.Fabric)
 end
 attach(art,head,"Embroidered club tab",V(w*0.13,0.1,0.018),CFrame.new(0,h*0.25,-radiusZ-0.033),colors[3],Enum.Material.Fabric)
end
function Assets.wear(character,id)
 restoreClothing(character)
 local item=Catalog.ById[id]
 if not item or item.category~="Wearables" then return end
 if item.asset~="outfit" and item.asset~="headband" then return legacyWear(character,id) end
 local art=model(character,"ShopWearable"); local c=item.colors
 local head=character:FindFirstChild("Head")
 if item.asset=="headband" then headband(art,head,c); return art end
 local stored=Instance.new("Folder"); stored.Name="OriginalClothing"; stored.Parent=art
 local bodyNames={UpperTorso=true,LowerTorso=true,Torso=true,LeftUpperArm=true,RightUpperArm=true,
  LeftLowerArm=true,RightLowerArm=true,LeftHand=true,RightHand=true,LeftUpperLeg=true,RightUpperLeg=true,
  LeftLowerLeg=true,RightLowerLeg=true,LeftFoot=true,RightFoot=true,["Left Arm"]=true,["Right Arm"]=true,["Left Leg"]=true,["Right Leg"]=true}
 local clothingTypes={TShirt=true,Shirt=true,Pants=true,Jacket=true,Sweater=true,Shorts=true,DressSkirt=true,LeftShoe=true,RightShoe=true}
 for _,child in ipairs(character:GetChildren()) do
  if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic")
   or (child:IsA("Accessory") and clothingTypes[child.AccessoryType.Name]) then
   for _,p in ipairs(child:GetDescendants()) do
    if p:IsA("BasePart") or p:IsA("Decal") then p:SetAttribute("ShopHiddenTransparency",p.Transparency); p.Transparency=1 end
   end
   child.Parent=stored
  elseif child:IsA("BasePart") and bodyNames[child.Name] then
   child:SetAttribute("ShopWearOriginalColor",child.Color)
   child.Color=head and head.Color or Color3.fromRGB(214,177,145)
  end
 end
 local function shell(target,name,color,scale,offset)
  if not target then return end
  local saved=target.Archivable; target.Archivable=true; local copy=target:Clone(); target.Archivable=saved
  for _,child in ipairs(copy:GetChildren()) do
   if child:IsA("DataModelMesh") then
    if child:IsA("SpecialMesh") then child.TextureId="" end
   else child:Destroy() end
  end
  if copy:IsA("MeshPart") then copy.TextureID="" end
  copy:SetAttribute("ShopWearOriginalColor",nil)
  copy.Name=name; copy.Size=target.Size*(scale or V(1.025,1.025,1.025))
  copy.CFrame=target.CFrame*(offset or CFrame.identity); copy.Color=color; copy.Material=Enum.Material.Fabric
  copy.Anchored=false; copy.CanCollide=false; copy.CanTouch=false; copy.CanQuery=false; copy.Massless=true; copy.CastShadow=false
  copy.Parent=art
  local weld=Instance.new("WeldConstraint"); weld.Part0=target; weld.Part1=copy; weld.Parent=copy
  return copy
 end
 local torso=character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
 local hips=character:FindFirstChild("LowerTorso")
 shell(torso,"Fitted court top",c[1]); shell(hips,"Tailored waist",c[1])
 local female=item.fit=="Female"
 if not female then
  for _,side in ipairs({"Left","Right"}) do
   local arm=character:FindFirstChild(side.."UpperArm")
   if arm then shell(arm,"Polo short sleeve",c[1])
   else
    arm=character:FindFirstChild(side.." Arm")
    if arm then shell(arm,"Polo short sleeve",c[1],V(1.025,0.45,1.025),CFrame.new(0,arm.Size.Y*0.275,0)) end
   end
  end
 end
 for _,side in ipairs({"Left","Right"}) do
  local leg=character:FindFirstChild(side.."UpperLeg") or character:FindFirstChild(side.." Leg")
  if leg then
   local length=female and 0.52 or 0.72
   shell(leg,"Tailored court shorts",c[2],V(1.025,length,1.025),CFrame.new(0,leg.Size.Y*(1-length)/2,0))
  end
  local shin=character:FindFirstChild(side.."LowerLeg")
  if shin then shell(shin,"White court sock",Color3.fromRGB(244,241,231),V(1.03,0.38,1.03),CFrame.new(0,-shin.Size.Y*0.31,0)) end
  local foot=character:FindFirstChild(side.."Foot")
  if foot then
   shell(foot,"Clean court sneaker",Color3.fromRGB(242,239,229),V(1.06,1.08,1.06))
   attach(art,foot,"Sneaker heel accent",V(foot.Size.X*0.7,0.065,0.025),CFrame.new(0,foot.Size.Y*0.2,foot.Size.Z/2+0.045),c[3])
  end
 end
 if female and (hips or torso) then
  local target=hips or torso; local w,h,d=target.Size.X,target.Size.Y,target.Size.Z
  local y=-h/2-0.24
  for _,side in ipairs({-1,1}) do
   attach(art,target,"Court skort front",V(w*1.13,0.7,0.09),CFrame.new(0,y,side*(d/2+0.075))*CFrame.Angles(math.rad(-side*10),0,0),c[2],Enum.Material.Fabric)
   attach(art,target,"Court skort side",V(0.09,0.7,d*1.15),CFrame.new(side*(w/2+0.045),y,0)*CFrame.Angles(0,0,math.rad(side*10)),c[2],Enum.Material.Fabric)
  end
 end
 if torso then
  local w,h,d=torso.Size.X,torso.Size.Y,torso.Size.Z
  local front=-d/2-0.065
  attach(art,torso,"Embroidered chest mark",V(w*0.17,h*0.06,0.015),CFrame.new(-w*0.24,h*0.22,front),c[3],Enum.Material.Fabric)
  attach(art,torso,"Club accent stitch",V(w*0.035,h*0.13,0.015),CFrame.new(-w*0.15,h*0.15,front),c[3],Enum.Material.Fabric)
  if not female then
   for _,side in ipairs({-1,1}) do
    attach(art,torso,"Polo collar detail",V(w*0.13,h*0.12,0.025),CFrame.new(side*w*0.1,h*0.34,front)*CFrame.Angles(0,0,math.rad(side*20)),c[3],Enum.Material.Fabric)
   end
  end
 end
 headband(art,head,c)
 art:SetAttribute("Fit",item.fit); art:SetAttribute("Theme",item.theme)
 return art
end
-- Never touch lines, net, ball, lights, collision properties or dimensions.
function Assets.court(root,id)
 local old=root:FindFirstChild("ShopCourtArt"); if old then old:Destroy() end
 local surface=root:FindFirstChild("Playing surface",true)
 local item=Catalog.ById[id]; if not item or item.category~="Courts" then item=nil end
 for _,p in ipairs(root:GetDescendants()) do
  if p:IsA("BasePart") and (p.Name=="Playing surface" or p.Name=="Kitchen" or p.Name=="Court surround") then
   if p:GetAttribute("ShopCourtColor")==nil then p:SetAttribute("ShopCourtColor",p.Color); p:SetAttribute("ShopCourtMaterial",p.Material.Name) end
   p.Color=item and item.colors[p.Name=="Playing surface" and 1 or p.Name=="Kitchen" and 2 or 3] or p:GetAttribute("ShopCourtBaseColor") or p:GetAttribute("ShopCourtColor")
   p.Material=item and Enum.Material.SmoothPlastic or Enum.Material[p:GetAttribute("ShopCourtBaseMaterial") or p:GetAttribute("ShopCourtMaterial")]
  end
 end
 if not item or not surface then return end
 local art=model(root,"ShopCourtArt"); local c=item.colors
 local cf=surface.CFrame*CFrame.new(0,surface.Size.Y/2+0.015,0)
 local function inlay(name,x,z,w,d,color,angle,neon)
  return part(art,name,V(w,0.009,d),cf*CFrame.new(x,0,z)*CFrame.Angles(0,math.rad(angle or 0),0),color,neon and Enum.Material.Neon)
 end
 if item.asset=="multicolor" then
  for _,x in ipairs({-10,10}) do for _,z in ipairs({-27,27}) do
   if x*z>0 then inlay("Lilac service panel",x,z,19.65,25.65,Color3.fromRGB(113,111,151)) end
  end end
 end
 -- Inlays sit beyond both sidelines; no patterns compete with the ball or court markings.
 for _,side in ipairs({-1,1}) do
  if item.asset=="neon" then
   inlay("Circuit perimeter",side*22.5,0,0.15,76,Color3.fromRGB(76,210,221),0,true)
   for z=-30,30,15 do inlay("Circuit node",side*23.4,z,1.5,0.18,Color3.fromRGB(214,111,183),0,true) end
  elseif item.asset=="tropical" then
   for z=-28,28,14 do for i=-2,2 do inlay("Palm frond inlay",side*(23+math.abs(i)*0.15),z+i*0.45,0.13,2.1,c[2],side*(i*19)) end end
  elseif item.asset=="premium" then
   inlay("Brass boundary inlay",side*23,0,0.07,76,Color3.fromRGB(190,159,98))
   for z=-32,32,16 do inlay("Reserve diamond",side*24,z,0.65,0.65,Color3.fromRGB(190,159,98),45) end
  elseif item.asset=="multicolor" then
   for z=-32,32,8 do inlay("Colorblock tile",side*23.4,z,2.6,4,c[(math.floor((z+32)/8)%3)+1]) end
  elseif item.asset=="modern" then
   for z=-32,32,8 do inlay("Studio tick",side*23,z,1.5,0.12,Color3.fromRGB(51,66,76)) end
  else
   inlay("Championship sideline band",side*23,0,0.13,76,Color3.fromRGB(229,225,204))
   for z=-30,30,15 do inlay("Club inset",side*24,z,0.5,1.8,c[1]) end
  end
 end
end
function Assets.preview(id,fit)
 local item=assert(Catalog.ById[id],"Unknown cosmetic")
 local root=model(nil,"Preview_"..id)
 if item.category=="Paddles" then
  local grip=part(root,"PaddleGrip",V(1.2,0.3,0.3),CFrame.new(0,-1.3,0)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(35,39,47))
  grip.Shape=Enum.PartType.Cylinder
  for i=1,7 do
   local ring=part(root,"Grip wrap",V(0.027,0.31,0.31),CFrame.new(0,-1.83+i*0.145,0)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(63,67,73))
   ring.Shape=Enum.PartType.Cylinder
  end
  local face=part(root,"PaddleFace",V(1.65,2,0.3),CFrame.new(0,0.2,0),Color3.fromRGB(31,193,180))
  face:SetAttribute("HandleDirection",-1); Assets.paddle(face,id); grip.Anchored=true
 elseif item.category=="Wearables" then
  local folder=game:GetService("ReplicatedStorage"):FindFirstChild("ShopMannequins")
  if not folder and game:GetService("RunService"):IsServer() then
   folder=require(game:GetService("ServerScriptService"):WaitForChild("Server"):WaitForChild("Cosmetics"):WaitForChild("ShopMannequins")).prepare()
  end
  folder=folder or game:GetService("ReplicatedStorage"):WaitForChild("ShopMannequins",20)
  local template=folder and folder:FindFirstChild(item.fit or fit or "Male")
  assert(template,"Standard shop mannequin unavailable")
  root:Destroy(); root=template:Clone(); root.Name="Preview_"..id
  if item.asset~="outfit" then
   for _,p in ipairs(root:GetChildren()) do
    if p:IsA("BasePart") then
     if p.Name=="UpperTorso" or p.Name=="LowerTorso" then p.Color=Color3.fromRGB(244,241,231)
     elseif p.Name:find("UpperLeg") then p.Color=Color3.fromRGB(42,48,58) end
    end
   end
  end
  Assets.wear(root,id)
  if item.asset=="headband" then
   -- Headband cards are headshots; hide the unused body instead of showing
   -- an untextured torso/neck below the product.
   for _,p in ipairs(root:GetChildren()) do
    if p:IsA("BasePart") and p.Name~="Head" then p.Transparency=1 end
   end
  end
 else
  part(root,"Playing surface",V(40,0.16,80),CFrame.new(),Color3.fromRGB(43,123,134))
  part(root,"Court surround",V(52,0.12,96),CFrame.new(0,-0.1,0),Color3.fromRGB(136,128,163))
  for _,z in ipairs({-7,7}) do part(root,"Kitchen",V(40,0.02,14),CFrame.new(0,0.095,z),Color3.fromRGB(55,143,147)) end
  local white=Color3.fromRGB(246,244,220)
  for _,x in ipairs({-20,20}) do part(root,"Sideline",V(0.18,0.025,80.2),CFrame.new(x,0.13,0),white) end
  for _,z in ipairs({-40,-14,14,40}) do part(root,"Court line",V(40,0.025,0.18),CFrame.new(0,0.13,z),white) end
  for _,z in ipairs({-27,27}) do part(root,"Service center line",V(0.18,0.025,26),CFrame.new(0,0.13,z),white) end
  part(root,"Net",V(42,3.1,0.18),CFrame.new(0,1.7,0),Color3.fromRGB(43,54,61)).Transparency=0.5
  part(root,"Net tape",V(42,0.15,0.22),CFrame.new(0,3.3,0),white)
  Assets.court(root,id)
 end
 for _,p in ipairs(root:GetDescendants()) do if p:IsA("BasePart") then p.Anchored=true end end
 return root
end
return Assets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">CosmeticCatalog</string>
            <string name="Source"><![CDATA[-- Stable item IDs preserve existing ownership; presentation and new fits live here.
local Catalog={Categories={"Paddles","Wearables","Courts"},Labels={Paddles="Paddles",Wearables="Outfits & Headbands",Courts="Court Customization"},Items={},ById={}}
local function item(id,category,name,price,description,design,colors,fit,hidden)
 local entry={id=id,category=category,name=name,price=price,description=description,asset=design,colors=table.clone(colors),fit=fit,hidden=hidden}
 table.insert(Catalog.Items,entry); Catalog.ById[id]=entry
 return entry
end
local function rgb(r,g,b) return Color3.fromRGB(r,g,b) end
item("paddle_porcelain","Paddles","Pickle Club",180,"A clean dill pickle illustration on soft pistachio. A clean double-sided print with a dark protective edge.","pickle",{rgb(231,241,215),rgb(36,65,45),rgb(94,152,91)})
item("paddle_tour","Paddles","Catnap Club",260,"An original green-eyed tabby with soft stripes, little paw prints, and a warm cream finish.","cat",{rgb(245,230,203),rgb(118,80,57),rgb(214,155,101)})
item("paddle_afterglow","Paddles","Flame Court",350,"A bold orange-and-gold flame on matte charcoal. Heat-check energy without distracting effects.","flame",{rgb(32,35,44),rgb(23,26,33),rgb(244,154,61)})
item("paddle_confetti","Paddles","Love Rally",320,"A rosy heart, little matching accents, and a warm ivory-pink ground. Love every rally.","heart",{rgb(247,230,229),rgb(125,45,68),rgb(217,93,122)})
item("paddle_prism","Paddles","Checkerboard",300,"Crisp cream-and-ink checks, a restrained club badge, and a clean tournament edge.","checker",{rgb(244,240,230),rgb(36,39,48),rgb(216,208,189)})
item("paddle_lotus","Paddles","Lotus Lake",360,"A pink lotus floating on a quiet jade lake, surrounded by lily pads and gentle ripples. A calm double-sided court finish.","lotus",{rgb(192,219,211),rgb(51,95,84),rgb(235,185,205)})
item("paddle_noir","Paddles","Noir Reserve",700,"Your retained legacy charcoal-and-brass club finish.","luxury",{rgb(36,44,51),rgb(196,165,107),rgb(116,130,132)},nil,true)
local palettes={
 white={rgb(244,241,231),rgb(45,51,61),rgb(120,150,131)},
 black={rgb(37,41,49),rgb(27,30,37),rgb(225,224,216)},
 pink={rgb(233,157,180),rgb(245,229,231),rgb(126,55,79)},
 pickle={rgb(58,112,76),rgb(213,230,182),rgb(241,231,183)},
 flame={rgb(37,41,49),rgb(29,32,40),rgb(243,151,71)},
}
local function outfit(id,name,price,fit,theme)
 local entry=item(id,"Wearables",name.." / "..fit,price,
  (fit=="Female" and "A fitted tennis top and clean court skort" or "A refined court polo and tailored tennis shorts")..
  " with matching headband, court shoes, and restrained piping. "..(theme=="pickle" and "Pickle Club colors." or theme=="flame" and "Flame Court colors." or "A timeless "..theme.." court palette."),
  "outfit",palettes[theme],fit)
 entry.theme=theme
end
outfit("wear_club","Court White",240,"Male","white")
outfit("wear_white_female","Court White",240,"Female","white")
outfit("wear_black_male","Court Black",240,"Male","black")
outfit("wear_black_female","Court Black",240,"Female","black")
outfit("wear_pink_male","Court Pink",280,"Male","pink")
outfit("wear_sunset","Court Pink",280,"Female","pink")
outfit("wear_pickle_male","Pickle Club",320,"Male","pickle")
outfit("wear_pickle_female","Pickle Club",320,"Female","pickle")
outfit("wear_flame_male","Flame Court",350,"Male","flame")
outfit("wear_flame_female","Flame Court",350,"Female","flame")
for _,spec in ipairs({
 {"wear_headband","White Headband","white",160},{"wear_band_black","Black Headband","black",160},
 {"wear_band_pink","Pink Headband","pink",160},{"wear_band_pickle","Pickle Club Headband","pickle",190},
 {"wear_band_flame","Flame Court Headband","flame",190},
}) do
 local entry=item(spec[1],"Wearables",spec[2],spec[4],"A smooth fitted sports headband with contrasting woven piping. Fits either mannequin and your own avatar.","headband",palettes[spec[3]])
 entry.theme=spec[3]
end
-- Retain legacy purchases without cluttering the new gallery.
item("wear_visor","Wearables","Circuit Visor",280,"Your saved midnight sports visor with a cyan brim.","visor",{rgb(34,39,65),rgb(80,223,234),rgb(237,108,181)},nil,true)
item("wear_wrists","Wearables","Rally Wristbands",140,"Your saved contrasting terry cuffs.","wristbands",{rgb(50,159,151),rgb(235,130,107),rgb(245,238,217)},nil,true)
item("wear_towel","Wearables","Courtside Towel",200,"Your saved cream and forest shoulder towel.","towel",{rgb(240,233,209),rgb(38,99,77),rgb(213,174,94)},nil,true)
item("court_classic","Courts","Championship",400,"Professional blue service boxes, green kitchen and quiet cream perimeter. Personal court finish.","classic",{rgb(44,100,139),rgb(62,126,105),rgb(117,138,131)})
item("court_arcade","Courts","Night Circuit",600,"Indigo surface, teal kitchen and neon perimeter rails outside the lines.","neon",{rgb(51,55,99),rgb(47,110,124),rgb(111,83,134)})
item("court_tropical","Courts","Palm Club",500,"Lagoon blue, sage kitchen and warm sand with palm-frond perimeter inlays.","tropical",{rgb(41,117,136),rgb(83,143,120),rgb(184,167,129)})
item("court_noir","Courts","Midnight Reserve",800,"Slate service boxes and a smoky teal kitchen framed by restrained brass inlays.","premium",{rgb(46,57,72),rgb(58,91,94),rgb(80,77,84)})
item("court_colorblock","Courts","Color Club",500,"Sky and lilac service panels, coral kitchen and playful off-court blocks.","multicolor",{rgb(72,125,157),rgb(156,101,112),rgb(133,118,158)})
item("court_modern","Courts","Studio Court",420,"Muted blue-gray and sage, with clean graphite perimeter ticks. Minimal and readable.","modern",{rgb(91,122,136),rgb(108,143,137),rgb(144,146,151)})
for _,entry in ipairs(Catalog.Items) do table.freeze(entry.colors); table.freeze(entry) end
table.freeze(Catalog.Items); table.freeze(Catalog.ById); table.freeze(Catalog.Categories); table.freeze(Catalog.Labels)
return table.freeze(Catalog)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">CosmeticTextures</string>
