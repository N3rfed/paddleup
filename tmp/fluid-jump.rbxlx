 ["Pacific/Norfolk"]={{1577836800,43200},{1586012400,39600},{1601737200,43200},{1617462000,39600},{1633186800,43200},{1648911600,39600},{1664636400,43200},{1680361200,39600},{1696086000,43200},{1712415600,39600},{1728140400,43200},{1743865200,39600},{1759590000,43200},{1775314800,39600},{1791039600,43200},{1806764400,39600},{1822489200,43200},{1838214000,39600},{1853938800,43200},{1869663600,39600},{1885993200,43200},{1901718000,39600},{1917442800,43200},{1933167600,39600},{1948892400,43200},{1964617200,39600},{1980342000,43200},{1996066800,39600},{2011791600,43200},{2027516400,39600},{2043241200,43200},{2058966000,39600},{2075295600,43200},{2091020400,39600},{2106745200,43200},{2122470000,39600},{2138194800,43200},{2153919600,39600},{2169644400,43200},{2185369200,39600},{2201094000,43200},{2216818800,39600},{2233148400,43200}},
