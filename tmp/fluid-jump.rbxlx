 end)
 blueprint("Refreshments",function()
  part("Serving tray",Vector3.new(3.4,0.15,2.2),Vector3.new(0,0.1,0),P.brass,Enum.Material.Metal)
  for _,x in ipairs({-0.9,0.9}) do
   disc("Smoothie glass",0.75,1.4,Vector3.new(x,0.85,0),x<0 and P.pink or P.orange)
   part("Striped straw",Vector3.new(0.08,1,0.08),Vector3.new(x,1.8,0),P.ivory)
  end
  ball("Fresh orange",Vector3.new(0.8,0.8,0.8),Vector3.new(0,0.6,0.5),P.orange)
 end)
 blueprint("BallSculpture",function()
  disc("Marble sculpture plinth",4,2,Vector3.new(0,1,0),P.ivory,Enum.Material.Marble,true)
  ball("Golden pickleball",Vector3.new(3.5,3.5,3.5),Vector3.new(0,3.8,0),P.brass,Enum.Material.Metal)
  for i=1,8 do
   local a=i*math.pi/4
   ball("Pickleball perforation",Vector3.new(0.45,0.45,0.12),Vector3.new(math.sin(a)*1.1,3.8+math.cos(a)*1.1,1.42),P.ink)
  end
 end)
 local self={}
 function self.place(kind,parent,frame)
  local template=assert(templates[kind],"Unknown furniture: "..kind)
  local model=template:Clone()
  model:PivotTo(frame); model.Parent=parent
  return model
 end
 function self.destroyTemplates()
  for _,template in pairs(templates) do template:Destroy() end
  table.clear(templates)
 end
 return self
end
return Furniture
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">MapCatalog</string>
          <string name="Source"><![CDATA[-- Elevator map presentation and voting choices. Add environment/previews alongside new entries.
local Catalog={}
Catalog.list={
 {id="Rooftop",name="Rooftop",title="SKYLINE CLUB",tagline="City lights. Big rallies.",badge="SKY HIGH",
  accent=Color3.fromRGB(80,232,255),secondary=Color3.fromRGB(255,145,101),
  from=Vector3.new(108,248,124),to=Vector3.new(72,222,91),focus=Vector3.new(0,184,-8)},
 {id="Moon",name="Moon",title="SELENE LUNAR OUTPOST",tagline="Take your rivalry off-world.",badge="OUT OF THIS WORLD",
  accent=Color3.fromRGB(200,156,255),secondary=Color3.fromRGB(255,85,200),
  from=Vector3.new(-130,260,145),to=Vector3.new(-90,230,108),focus=Vector3.new(-5,187,-18)},
}
function Catalog.get(id)
 for _,map in ipairs(Catalog.list) do if map.id==id then return map end end
end
function Catalog.ids()
 local ids={}; for _,map in ipairs(Catalog.list) do table.insert(ids,map.id) end; return ids
end
return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">MapPreviews</string>
          <string name="Source"><![CDATA[-- Publish scenery snapshots so map thumbnails work without uploaded image assets.
local Previews={}
function Previews.publish(court,rooftop,moon)
 local folder=Instance.new("Folder"); folder.Name="MapPreviews"
 local moonColors={
  ["Roof deck"]=Color3.fromRGB(72,82,98),["Court surround"]=Color3.fromRGB(48,59,77),
  ["Playing surface"]=Color3.fromRGB(48,89,107),Kitchen=Color3.fromRGB(57,127,140),
 }
 for _,name in ipairs({"Rooftop","Moon"}) do
  local model=Instance.new("Model"); model.Name=name
  local sources={}
  for _,child in ipairs(court:GetChildren()) do
   if child~=rooftop and child~=moon then table.insert(sources,child) end
  end
  table.insert(sources,name=="Moon" and moon or rooftop)
  local count=0
  for _,source in ipairs(sources) do
   local parts=source:IsA("BasePart") and {source} or source:GetDescendants()
   for _,part in ipairs(parts) do
    if part:IsA("BasePart") and part.Transparency<1 and math.abs(part.Position.X)<330
     and math.abs(part.Position.Z)<330 and part.Position.Y<420 then
     local copy=part:Clone()
     for _,child in ipairs(copy:GetChildren()) do
      if not child:IsA("DataModelMesh") and not child:IsA("Decal") and not child:IsA("SurfaceAppearance") then child:Destroy() end
     end
     copy.Anchored=true; copy.CanCollide=false; copy.CanTouch=false; copy.CanQuery=false
     if name=="Moon" and moonColors[copy.Name] then copy.Color=moonColors[copy.Name] end
     copy.Parent=model; count+=1
     if count%150==0 then task.wait() end
    end
   end
  end
  model.Parent=folder
 end
 folder.Parent=game:GetService("ReplicatedStorage")
end
return Previews
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">MatchQueue</string>
          <string name="Source"><![CDATA[-- Server-owned voting deadlines and lottery; clients only submit their own picks.
local Setup=require(script.Parent:WaitForChild("MatchSetup"))
local Queue={VOTE_SECONDS=15,REVEAL_SECONDS=4}
Queue.__index=Queue
function Queue.new(notify,clock,random)
 return setmetatable({groups={},members={},reservations={},active=nil,notify=notify,
  clock=clock or function() return workspace:GetServerTimeNow() end,random=random or Random.new()},Queue)
end
function Queue:publish(group)
 local roster,counts={}, {Rooftop=0,Moon=0}
 for _,player in ipairs(group.players) do
  local map=group.votes[player]
  if map then counts[map]+=1 end
  table.insert(roster,{player=player,name=player.DisplayName,map=map,modifier=group.modifiers[player]})
 end
 for _,player in ipairs(group.players) do
  self.notify(player,{stage=group==self.active and group.stage or "Queued",mode=group.mode,
   format=group.format,count=#group.players,required=Setup.players[group.format],roster=roster,
   counts=counts,map=group.map,modifier=group.modifier,endsAt=group.endsAt,
   revealAt=group.revealAt,revealEndsAt=group.revealEndsAt,candidates=group.candidates})
 end
end
function Queue:remove(player)
 local group=self.members[player]
 if not group then return end
 self.reservations[player]=nil
 self.members[player]=nil; group.votes[player]=nil; group.modifiers[player]=nil
 table.remove(group.players,table.find(group.players,player))
 if self.active==group then self.active=nil end
 group.stage="Queued"; group.endsAt=nil; group.revealAt=nil; group.revealEndsAt=nil
 group.map=nil; group.candidates=nil
 if #group.players==0 then table.remove(self.groups,table.find(self.groups,group))
 else self:publish(group) end
 self.notify(player,{stage="Cancelled"})
end
function Queue:join(player,mode,format)
 if not Setup.modes[mode] or not Setup.players[format] or self.members[player] then return false end
 local group
 for _,candidate in ipairs(self.groups) do
  if candidate~=self.active and candidate.mode==mode and candidate.format==format
   and #candidate.players<Setup.players[format] then group=candidate; break end
 end
 if not group then
  group={mode=mode,format=format,players={},votes={},modifiers={},modifier=mode=="Chaos" and "LowGravity" or "None"}
  table.insert(self.groups,group)
 end
 table.insert(group.players,player); self.members[player]=group
 group.modifiers[player]=mode=="Chaos" and "LowGravity" or "None"
 self:publish(group)
 return true
end
function Queue:configure(player,map,modifier)
 local group=self.active
 if not group or self.members[player]~=group or group.stage~="Setup" or self.clock()>=group.endsAt then return false end
 modifier=modifier or group.modifiers[player]
 if not Setup.valid(group.mode,map or group.votes[player] or "Rooftop",modifier) then return false end
 if map then group.votes[player]=map end
 group.modifiers[player]=modifier
 self:publish(group)
 return true
end
function Queue:update(available)
 if not available then return end
 local now=self.clock()
 local group=self.active
 if not group then
  for _,candidate in ipairs(self.groups) do
   local reserved=false
   for _,player in ipairs(candidate.players) do if self.reservations[player] then reserved=true; break end end
   if not reserved and #candidate.players==Setup.players[candidate.format] then
    self.active=candidate; candidate.stage="Setup"; candidate.endsAt=now+Queue.VOTE_SECONDS
    self:publish(candidate); return
   end
  end
  return
 end
 local allSelected=true
 for _,player in ipairs(group.players) do
  if not group.votes[player] then allSelected=false; break end
 end
 if group.stage=="Setup" and (allSelected or now>=group.endsAt) then
  local counts={Rooftop=0,Moon=0}
  local lowGravity=0
  for _,player in ipairs(group.players) do
   local map=group.votes[player]; if map then counts[map]+=1 end
   if group.modifiers[player]=="LowGravity" then lowGravity+=1 end
  end
  group.candidates={}
  local highest=math.max(counts.Rooftop,counts.Moon)
  for _,map in ipairs({"Rooftop","Moon"}) do
   if counts[map]==highest then table.insert(group.candidates,map) end
  end
  group.map=group.candidates[self.random:NextInteger(1,#group.candidates)]
  group.modifier=(group.mode=="Chaos" or (group.mode=="Arcade" and lowGravity>#group.players/2)) and "LowGravity" or "None"
  group.stage="Reveal"; group.revealAt=now
  group.revealEndsAt=now+(#group.candidates>1 and Queue.REVEAL_SECONDS or (allSelected and now<group.endsAt and 0 or 2))
  self:publish(group)
 end
 if group.stage=="Reveal" and now>=group.revealEndsAt then
  self.active=nil; table.remove(self.groups,table.find(self.groups,group))
  for _,player in ipairs(group.players) do self.members[player]=nil end
  return group
 end
end
-- Invitations reserve a player while preserving their queue and preference.
function Queue:reserve(player,id)
 local group=self.members[player]
 if not group or group==self.active or self.reservations[player] then return false end
 self.reservations[player]=id; return true
end
function Queue:isReserved(player,id)
 return self.members[player]~=nil and self.reservations[player]==id
end
function Queue:release(player,id)
 if self.reservations[player]==id then self.reservations[player]=nil end
end
function Queue:destroy()
 local players={}; for player in pairs(self.members) do table.insert(players,player) end
 for _,player in ipairs(players) do self:remove(player) end
 table.clear(self.groups); table.clear(self.members); self.active=nil
end
return Queue
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">MatchRewards</string>
          <string name="Source"><![CDATA[-- Only validated completed games award XP. No XP for clicks, joins, idle time, or early exits.
local Config=require(script.Parent:WaitForChild("ProgressionConfig"))
local Rewards={}
Rewards.__index=Rewards
function Rewards.new(progression,clock,id)
 return setmetatable({progression=progression,clock=clock or os.clock,id=id or function()
  return game:GetService("HttpService"):GenerateGUID(false)
 end},Rewards)
end
function Rewards:begin(users,mode)
 self.started=self.clock(); self.mode=mode; self.contested=0; self.finished=false; self.eventId=self.id(); self.players={}
 for player,data in pairs(users) do if data.side~=0 then self.players[player]={side=data.side,returns=0} end end
end
function Rewards:contact(player)
 local entry=self.players and self.players[player]
 if entry and not self.finished then entry.returns+=1 end
end
function Rewards:rally(shots)
 if self.started and not self.finished and shots>=3 then self.contested+=1 end
end
function Rewards:complete(winner)
 if not self.started or self.finished then return end
 self.finished=true
 if self.clock()-self.started<Config.MinimumMatchSeconds or self.contested<Config.MinimumContestedRallies then return end
 local count=0; for _ in pairs(self.players) do count+=1 end
 local required=({Practice=1,["1V1"]=2,["1V2"]=3,["2V2"]=4})[self.mode]
 if count~=required then return end
 for player,entry in pairs(self.players) do
  if entry.returns>=Config.MinimumReturns then
   local reward=self.mode=="Practice" and "PracticeCompleted" or entry.side==winner and "MatchWon" or "MatchCompleted"
   self.progression:award(player,reward,self.eventId..":"..player.UserId)
  end
 end
end
return Rewards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">MatchRules</string>
          <string name="Source"><![CDATA[-- Court coordinates match the painted lines in World.
local Rules={HALF_WIDTH=20,BASELINE=40,KITCHEN=14,HIT_RANGE=12,PERFECT_RANGE=9,SLAM_RANGE=16,SLAM_HORIZONTAL=8,REAR_REACH=1.5,SLAM_MIN_HEIGHT=0.5,SLAM_EXTRA_HEIGHT=5,BACK_LIMIT=60}

Rules.DIVE_COOLDOWN=1.75
Rules.DIVE_STAMINA_COST=35
Rules.STAMINA_RECOVERY_DELAY=1.0
Rules.STAMINA_REGEN_RATE=22*0.55
Rules.JUMP_HANG_TIME=1
Rules.JUMP_DESCENT_GRAVITY=4
Rules.SLAM_TIMING_WINDOW=0.06

function Rules.canDive(stamina,readyAt,now)
 return now>=readyAt and stamina>=Rules.DIVE_STAMINA_COST
end

function Rules.recoverStamina(stamina,recoveryAt,now,dt)
 local elapsed=math.min(math.max(0,dt),math.max(0,now-recoveryAt))
 return math.min(100,stamina+elapsed*Rules.STAMINA_REGEN_RATE)
end

Rules.LOB_RESTITUTION=0.45
Rules.LOB_GRAVITY_SCALE=1.6
Rules.LOB_HORIZONTAL_RETENTION=0.75

-- Split a frame at the apex so heavier descent gravity never changes ascent.
function Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce)
 if lob and not postBounce and velocity.Y>0 then
  local timeToApex=velocity.Y/gravity
  local ascent=math.min(dt,timeToApex)
  position+=velocity*ascent-Vector3.new(0,0.5*gravity*ascent*ascent,0)
  velocity-=Vector3.new(0,gravity*ascent,0)
  -- Floating-point residue at the apex must not defer the heavier descent.
  if dt>=timeToApex then velocity=Vector3.new(velocity.X,0,velocity.Z) end
  dt-=ascent
 end
 local acceleration=gravity*(lob and (postBounce or velocity.Y<=0) and Rules.LOB_GRAVITY_SCALE or 1)
 position+=velocity*dt-Vector3.new(0,0.5*acceleration*dt*dt,0)
 velocity-=Vector3.new(0,acceleration*dt,0)
 return position,velocity,acceleration
end

-- Offensive topspin switches gravity at the net plane, splitting crossing frames.
function Rules.advanceFlight(position,velocity,gravity,dt,lob,postBounce,offensive,side)
 if not offensive then return Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce) end
 if position.Z*side<=0 then return Rules.advanceBall(position,velocity,gravity*1.8,dt,lob,postBounce) end
 local crossing=velocity.Z~=0 and -position.Z/velocity.Z or math.huge
 if crossing>=0 and crossing<=dt then
  position,velocity=Rules.advanceBall(position,velocity,gravity,crossing,lob,postBounce)
  return Rules.advanceBall(position,velocity,gravity*1.8,dt-crossing,lob,postBounce)
 end
 return Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce)
end

function Rules.ballLandingTime(height,vy,gravity,lob,postBounce)
 height=math.max(0,height)
 if lob and not postBounce and vy>0 then
  local ascent=vy/gravity
  local peak=height+vy*vy/(2*gravity)
  return ascent+math.sqrt(2*peak/(gravity*Rules.LOB_GRAVITY_SCALE))
 end
 local acceleration=gravity*(lob and Rules.LOB_GRAVITY_SCALE or 1)
 return (vy+math.sqrt(vy*vy+2*acceleration*height))/acceleration
end

-- Solve the launch arc with the same piecewise gravity used by simulation.
function Rules.lobLaunchY(height,duration,gravity)
 local descending=(0.5*gravity*Rules.LOB_GRAVITY_SCALE*duration*duration-height)/duration
 if descending<=0 then return descending end
 local low,high=0,gravity*duration
 for _=1,40 do
  local vy=(low+high)/2
  local descent=duration-vy/gravity
  local y=height+vy*vy/(2*gravity)-0.5*gravity*Rules.LOB_GRAVITY_SCALE*descent*descent
  if y>0 then high=vy else low=vy end
 end
 return (low+high)/2
end

function Rules.bounceVelocity(velocity,lob)
 if lob then
  return Vector3.new(velocity.X*Rules.LOB_HORIZONTAL_RETENTION,
   math.max(0,-velocity.Y)*Rules.LOB_RESTITUTION,velocity.Z*Rules.LOB_HORIZONTAL_RETENTION)
 end
 return Vector3.new(velocity.X,math.max(15,-velocity.Y*0.78),velocity.Z)
end

Rules.SERVE_TIMEOUT=15
Rules.BOT_SERVE_DELAY=2
Rules.MAX_SERVE_VELOCITY=90

function Rules.canServe(userId,serverId,ready)
 return ready==true and userId~=nil and userId~=0 and userId==serverId
end

Rules.SERVE_CHARGE_TIME=2
Rules.SERVE_PERFECT_OFFSET=0.06
Rules.SERVE_GOOD_OFFSET=0.4
Rules.SERVE_NET_OFFSET=-0.65

-- Hold to sweep up and down; release is judged at the current position.
function Rules.serveTiming(started,now)
 local phase=math.max(0,now-started)%(Rules.SERVE_CHARGE_TIME*2)/Rules.SERVE_CHARGE_TIME
 local needle=phase<=1 and phase or 2-phase
 local offset=needle*2-1
 local accuracy=1-math.abs(offset)
 local grade=math.abs(offset)<=Rules.SERVE_PERFECT_OFFSET+1e-9 and "PERFECT!"
  or math.abs(offset)<=Rules.SERVE_GOOD_OFFSET+1e-9 and "GOOD"
  or offset<0 and "UNDERCHARGED" or "OVERCHARGED"
 return needle,offset,accuracy,grade
end

function Rules.servePower(charge)
 return 0.3+0.7*math.clamp(charge,0,2)
end

function Rules.timedServeTarget(side,serveX,offset)
 offset=math.clamp(offset,-1,1)
 local depth
 if offset < -Rules.SERVE_GOOD_OFFSET-1e-9 then
  depth=math.max(4,13*(offset+1)/(1-Rules.SERVE_GOOD_OFFSET))
 elseif offset>Rules.SERVE_GOOD_OFFSET+1e-9 then
  depth=42+20*(offset-Rules.SERVE_GOOD_OFFSET)
 else depth=28+offset*22 end
 return Vector3.new(-math.sign(serveX)*10,181.7,-side*depth)
end

-- Ignore invalid remote targets and keep aim inside the diagonal service box.
function Rules.serveTarget(target,side,serveX)
 local fallback=Vector3.new(-serveX,181.7,-side*28)
 if typeof(target)~="Vector3" then return fallback end
 for _,value in ipairs({target.X,target.Y,target.Z}) do
  if value~=value or math.abs(value)==math.huge then return fallback end
 end
 local x=math.clamp(target.X* -math.sign(serveX),1,Rules.HALF_WIDTH-1)
 local depth=math.clamp(-target.Z*side,Rules.KITCHEN+2,Rules.BASELINE-2)
 return Vector3.new(-math.sign(serveX)*x,181.7,-side*depth)
end

function Rules.serveX(side,score)
 return side*(score%2==0 and 10 or -10)
end

function Rules.inKitchen(position,margin)
 margin=margin or 0
 return math.abs(position.X)<=Rules.HALF_WIDTH+margin and math.abs(position.Z)<=Rules.KITCHEN+margin
end

function Rules.servePositionValid(position,side,serveX,grounded)
 return grounded and position.Z*side>Rules.BASELINE+1
  and math.abs(position.X)<Rules.HALF_WIDTH-1 and position.X*math.sign(serveX)>1
end

function Rules.serveLandingValid(position,side,serveX)
 return position.Z*side< -Rules.KITCHEN-0.09 and math.abs(position.Z)<=Rules.BASELINE+0.09
  and math.abs(position.X)<=Rules.HALF_WIDTH+0.09 and position.X*math.sign(serveX)<=0.09
end

function Rules.returnFault(bounces,shots,inKitchen)
 if bounces>0 then return nil end
 if shots<2 then return "Two-bounce rule: let the ball bounce" end
 if inKitchen then return "Kitchen volley fault" end
 return nil
end

function Rules.startPosition(side,servingSide,serveX,primary)
 local serving=side==servingSide
 local x=serving and serveX or -serveX
 if not primary then x=-x end
 local depth=(serving or primary) and 46 or Rules.KITCHEN+4
 return Vector3.new(x,185,side*depth)
end

-- Shared by server validation and the developer hitbox overlay.
function Rules.slamBounds(character,root)
 local head=character:FindFirstChild("Head")
 local headTop=head and head.Position.Y+head.Size.Y*0.5 or root.Position.Y+3
 local armLength=0
 for _,name in ipairs({"RightUpperArm","RightLowerArm","RightHand","Right Arm"}) do
  local part=character:FindFirstChild(name)
  if part then armLength+=part.Size.Y end
 end
 armLength=math.clamp(armLength,2,6)
 return headTop+Rules.SLAM_MIN_HEIGHT,headTop+armLength+Rules.SLAM_EXTRA_HEIGHT
end

-- Generous vertical reach, while preserving the horizontal limit.
function Rules.overheadReach(ballPosition,rootPosition,minY,maxY)
 local offset=ballPosition-rootPosition
 return Vector3.new(offset.X,0,offset.Z).Magnitude<=Rules.SLAM_HORIZONTAL
  and ballPosition.Y>=minY
  and ballPosition.Y<=maxY
end

-- Overhead contact is the timing window for lobs near the kitchen line.
function Rules.kitchenLobWindow(lob,overhead,position,side)
 local depth=position.Z*side
 return lob==true and overhead and side~=0
  and depth>Rules.KITCHEN+1 and depth<=Rules.KITCHEN+Rules.SLAM_HORIZONTAL
  and math.abs(position.X)<=Rules.HALF_WIDTH
end

function Rules.jumpSlam(position,side,grounded,diving)
 local depth=position.Z*side
 return side~=0 and not grounded and not diving and depth>=0
  and depth<=Rules.KITCHEN+Rules.SLAM_HORIZONTAL and math.abs(position.X)<=Rules.HALF_WIDTH
end

function Rules.slamTiming(ballPosition,ballVelocity,contactPosition,perfectVision)
 -- Signed time to the strike plane: approaching is early, passing it is late.
 local speedSquared=ballVelocity:Dot(ballVelocity)
 local timing=speedSquared>1 and -(ballPosition-contactPosition):Dot(ballVelocity)/speedSquared or 0
 local window=Rules.SLAM_TIMING_WINDOW*(perfectVision and 1.2 or 1)
 if timing>window then return "net" end
 if timing< -window then return "out" end
 return "perfect"
end

function Rules.slamTarget(target,side,quality)
 if quality=="out" then return Vector3.new(target.X,target.Y,-side*(Rules.BASELINE+8)) end
 return target
end

-- Deterministic movement influence, shared by the crosshair and server shots.
function Rules.shotAim(rootFrame,velocity,ballPosition)
 local look=rootFrame.LookVector
 local forward=Vector3.new(look.X,0,look.Z).Unit
 local right=Vector3.new(-forward.Z,0,forward.X)
 local movement=Vector3.new(velocity.X,0,velocity.Z)
 local lateral=math.clamp(movement:Dot(right)/18,-1,1)
 local angle=lateral*math.rad(4)
 local direction=forward*math.cos(angle)+right*math.sin(angle)
 local toward=ballPosition and Vector3.new(ballPosition.X-rootFrame.Position.X,0,ballPosition.Z-rootFrame.Position.Z) or forward
 toward=toward.Magnitude>0.1 and toward.Unit or forward
 local momentum=math.clamp(movement:Dot(toward)/18,0,1)
 return direction,momentum,angle
end

function Rules.contactInFront(ballPosition,rootFrame)
 local look=rootFrame.LookVector
 local forward=Vector3.new(look.X,0,look.Z)
 if forward.Magnitude<0.001 then return false end
 return (ballPosition-rootFrame.Position):Dot(forward.Unit)>=-Rules.REAR_REACH
end

function Rules.shotQuality(clean,timeToBounce,timeSinceBounce)
 if clean then return "perfect" end
 if math.min(timeToBounce,timeSinceBounce)>0.65 then return "net" end
 return "lob"
end

function Rules.softShot(position,side)
 -- A drop from behind the kitchen line lands inside the opponent's kitchen.
 return position.Z*side<=Rules.KITCHEN+8 and "dink" or "drop"
end

function Rules.kitchenHitFault(rootPosition,grounded,kitchenTouched)
 -- Airspace is legal when taking off outside; landing is checked separately.
 if grounded then return Rules.inKitchen(rootPosition) end
 return kitchenTouched==true
end

function Rules.updateKitchen(state,position,grounded,velocity,dt)
 local touching=grounded and Rules.inKitchen(position)
 if grounded then state.kitchenTouched=touching end
 local fault=touching and state.volleyPending==true
 if state.volleyPending then
  if grounded and Vector3.new(velocity.X,0,velocity.Z).Magnitude<2 then
   state.volleySettled=(state.volleySettled or 0)+dt
   if state.volleySettled>0.15 then state.volleyPending=false end
  else state.volleySettled=0 end
 end
 return fault
end

function Rules.diveDirection(moveDirection,lookDirection,ballDirection)
 local moving=Vector3.new(moveDirection.X,0,moveDirection.Z)
 if moving.Magnitude>0.15 then return moving.Unit end
 local looking=Vector3.new(lookDirection.X,0,lookDirection.Z)
 if looking.Magnitude>0.1 then return looking.Unit end
 local ball=Vector3.new(ballDirection.X,0,ballDirection.Z)
 return ball.Magnitude>0.1 and ball.Unit or Vector3.new(0,0,-1)
end

function Rules.slamSpeedScale(rallySpeed)
 return rallySpeed*math.clamp(0.9+0.2*math.max(0,rallySpeed-1),0.9,1.3)
end

Rules.CHARGE_TIME=1
Rules.HIT_COOLDOWN=0.28
function Rules.heldBallPosition(character)
 if not character then return nil end
 local hand=character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
 if hand then return hand.CFrame:PointToWorldSpace(Vector3.new(0,-hand.Size.Y*0.5-0.3,-0.2)) end
 local root=character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Body")
 return root and root.CFrame:PointToWorldSpace(Vector3.new(-1.2,0,-1.2)) or nil
end

function Rules.hitReady(now,readyAt,perfect)
 return perfect or now>=readyAt
end

function Rules.chargeAmount(started,now)
 local delay=0.4
 return started and math.clamp((now-started-delay)/(Rules.CHARGE_TIME-delay),0,1) or 0
end

function Rules.chargeTarget(from,target,charge,severity,spread,depthRoll)
 local offset=Vector3.new(target.X-from.X,0,target.Z-from.Z)
 if offset.Magnitude<0.01 then return target end
 local forward=offset.Unit
 local right=Vector3.new(-forward.Z,0,forward.X)
 local risk=charge*charge*math.clamp(severity,0,1)
 return target+forward*((10+18*depthRoll)*risk)+right*(spread*16*risk)
end

function Rules.returnSpeed(speed,clean,slam,charged)
 if not clean then return speed*0.95 end
 if charged and not slam then return math.max(1,speed)*1.07 end
 if speed<1 then return 1 end
 return speed*(slam and 1.10 or 1.05)
end

-- Court coordinates differ only in height; each runtime gets its own wrapper table.
function Rules.withHeight(height)
 local scoped=table.clone(Rules)
 for _,name in ipairs({"serveTarget","timedServeTarget","startPosition"}) do
  scoped[name]=function(...)
   return Rules[name](...)+Vector3.new(0,height,0)
  end
 end
 return scoped
end
return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">MatchSetup</string>
          <string name="Source"><![CDATA[local Setup={}
Setup.ARCADE_FEATURES_ENABLED=false
function Setup.abilities(mode) return mode=="Arcade" and Setup.ARCADE_FEATURES_ENABLED end
Setup.players={Practice=1,["1V1"]=2,["1V2"]=3,["2V2"]=4}
-- Chaos remains the internal ID for the mode presented as Arcade.
Setup.modes={Classic=true,Chaos=true}
function Setup.valid(mode,map,modifier)
 if not Setup.modes[mode] or (map~="Rooftop" and map~="Moon") then return false end
 if mode=="Classic" then return modifier=="None" end
 if mode=="Chaos" then return modifier=="LowGravity" end
 return modifier=="None" or modifier=="LowGravity"
end
return Setup
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">MoonEnvironment</string>
          <string name="Source"><![CDATA[-- Visual scenery only. Court geometry and all gameplay physics belong to World/MatchRules.
local Moon={}
local V=Vector3.new
local P={dust=Color3.fromRGB(143,146,156),rim=Color3.fromRGB(164,169,181),shadow=Color3.fromRGB(84,89,105),
 white=Color3.fromRGB(224,231,236),metal=Color3.fromRGB(55,65,81),dark=Color3.fromRGB(23,30,44),
 orange=Color3.fromRGB(245,145,65),cyan=Color3.fromRGB(92,219,237),blue=Color3.fromRGB(35,74,125)}
local function part(parent,name,size,frame,color,material,solid)
 local p=Instance.new("Part")
 p.Name=name; p.Size=size; p.CFrame=typeof(frame)=="CFrame" and frame or CFrame.new(frame)
 p.Anchored=true; p.CanCollide=solid==true; p.CanTouch=false; p.CanQuery=solid==true
 p.Color=color; p.Material=material or Enum.Material.SmoothPlastic
 p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=parent
 return p
end
local function model(parent,name)
 local m=Instance.new("Model"); m.Name=name; m.Parent=parent; return m
end
local function sphere(parent,name,size,frame,color,material)
 local p=part(parent,name,size,frame,color,material)
 -- Sphere meshes preserve elliptical proportions; Ball parts use a round collision shape.
 local mesh=Instance.new("SpecialMesh"); mesh.MeshType=Enum.MeshType.Sphere; mesh.Parent=p
 return p
end
local function cylinder(parent,name,radius,height,frame,color,material)
 local p=part(parent,name,V(height,radius*2,radius*2),frame*CFrame.Angles(0,0,math.pi/2),color,material)
 p.Shape=Enum.PartType.Cylinder; return p
end
local function beam(parent,name,a,b,width,color,material)
 return part(parent,name,V(width,width,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),color,material)
end
local function ring(parent,name,frame,radius,width,height,count,color,material)
 for i=1,count do
  local angle=i*2*math.pi/count
  local at=V(math.cos(angle)*radius,0,math.sin(angle)*radius)
  part(parent,name,V(2*radius*math.sin(math.pi/count)+0.2,height,width),
   frame*CFrame.lookAt(at,Vector3.zero),color,material)
 end
end
local SURFACE=179.5
-- Each crater owns a square cutout in the regolith. No flat slab crosses its bowl.
local CRATERS={
 {-102,4,23,10},{103,66,24,6},{-180,-42,32,16},{-75,153,25,9},
 {142,151,34,19},{-215,139,29,7},{26,-182,32,14},{237,-181,42,23},
 {-278,-235,46,13},{35,258,47,25},{210,-15,23,11},{-30,-300,19,5},
}
local function triangle(parent,a,b,c,color)
 local ab,ac,bc=b-a,c-a,c-b
 if ab:Dot(ab)>ac:Dot(ac) and ab:Dot(ab)>bc:Dot(bc) then c,a=a,c
 elseif ac:Dot(ac)>bc:Dot(bc) then a,b=b,a end
 ab,ac,bc=b-a,c-a,c-b
 local right=ac:Cross(ab).Unit
 local back=bc.Unit
 local up=bc:Cross(right).Unit
 local height=math.abs(ab:Dot(up))
 for _,entry in ipairs({{a,b,right,back,ab},{a,c,-right,-back,ac}}) do
  local wedge=Instance.new("WedgePart")
  wedge.Name="Regolith facet"; wedge.Size=V(0.08,height,math.abs(entry[5]:Dot(back)))
  wedge.CFrame=CFrame.fromMatrix((entry[1]+entry[2])/2,entry[3],up,entry[4])
  wedge.Anchored=true; wedge.CanCollide=true; wedge.CanTouch=false; wedge.CanQuery=true
  wedge.Material=Enum.Material.Slate; wedge.Color=color; wedge.Parent=parent
 end
end
local function craterHeight(entry,x,z)
 local dx,dz=(x-entry[1])/entry[3],(z-entry[2])/entry[3]
 local angle=math.atan2(dz,dx)
 local radius=math.sqrt(dx*dx+dz*dz)/(0.85+0.045*math.sin(angle*5)+0.025*math.cos(angle*3))
 if radius>=1 then return SURFACE end
 -- Broad low basin and steep, broken inner walls, entirely below ground level.
 return SURFACE-entry[4]*(1-radius*radius)^1.35
end
local function crater(parent,entry)
 local x,z,radius,depth=unpack(entry)
 local m=model(parent,"Impact crater")
 m:SetAttribute("Depth",depth); m:SetAttribute("Radius",radius); m:SetAttribute("Center",V(x,SURFACE,z))
 local steps=10
 for i=0,steps-1 do
  for j=0,steps-1 do
   local function vertex(u,v)
    local px,pz=x-radius+2*radius*u/steps,z-radius+2*radius*v/steps
    return V(px,craterHeight(entry,px,pz),pz)
   end
   local a,b,c,d=vertex(i,j),vertex(i+1,j),vertex(i,j+1),vertex(i+1,j+1)
   local shade=math.clamp((SURFACE-(a.Y+b.Y+c.Y+d.Y)/4)/depth,0,1)
   local color=P.dust:Lerp(P.shadow,shade*0.65)
   if shade==0 then
    -- Tiny overlap seals floating-point seams where level tiles meet the bowl.
    part(m,"Level crater shoulder",V(2*radius/steps+0.08,2,2*radius/steps+0.08),(a+d)/2-V(0,1,0),P.dust,Enum.Material.Slate,true)
   else
    triangle(m,a,b,c,color); triangle(m,b,d,c,color)
   end
  end
 end
end
local function ground(parent)
 local m=model(parent,"Excavated lunar surface")
 local rectangles={{-650,-500,650,500}}
 for _,entry in ipairs(CRATERS) do
  local x,z,r=entry[1],entry[2],entry[3]
  assert(math.abs(x)-r>72 or math.abs(z)-r>96,"Crater overlaps court clearance")
  local nextRects={}
  for _,rect in ipairs(rectangles) do
   local left,front,right,back=unpack(rect)
   local a,b,c,d=math.max(left,x-r),math.max(front,z-r),math.min(right,x+r),math.min(back,z+r)
   if a>=c or b>=d then table.insert(nextRects,rect)
   else
    for _,strip in ipairs({{left,front,a,back},{c,front,right,back},{a,front,c,b},{a,d,c,back}}) do
     if strip[3]>strip[1] and strip[4]>strip[2] then table.insert(nextRects,strip) end
    end
   end
  end
  rectangles=nextRects
  crater(m,entry)
 end
 for _,rect in ipairs(rectangles) do
  part(m,"Unbroken regolith",V(rect[3]-rect[1],2,rect[4]-rect[2]),
   V((rect[1]+rect[3])/2,SURFACE-1,(rect[2]+rect[4])/2),P.dust,Enum.Material.Slate,true)
 end
 part(m,"Deep lunar bedrock",V(1300,8,1000),V(0,145,0),P.shadow,Enum.Material.Slate,true)
end
-- Irregular rock geometry from Low Poly Rock Pack by FracturedSkies (2128776869).
-- Mesh bounds normalize each source before varying its proportions and orientation.
local ROCKS={
 {"Flat slab","2128764023",V(178.239075,123.664474,193.074112),V(1.2,0.28,0.85)},
 {"Elongated shard","2128758133",V(217.166626,225.670319,120.977753),V(1.3,0.42,0.48)},
 {"Chipped stone","2128758599",V(156.518799,156.467407,136.799103),V(0.88,0.68,0.75)},
 {"Broad fragment","2128764803",V(170.629242,138.953323,168.476837),V(1.05,0.38,1)},
 {"Jagged fragment","2128766734",V(184.914566,222.987625,158.861313),V(0.58,0.88,0.62)},
 {"Lopsided stone","2128764428",V(179.997101,199.488892,208.224518),V(1.05,0.6,0.8)},
}
local function rock(parent,position,size,random)
 local variant=ROCKS[random:NextInteger(1,#ROCKS)]
 local m=model(parent,"Moon rock"); m:SetAttribute("Shape",variant[1])
 local proportions=variant[4]
 local dimensions=V(proportions.X*random:NextNumber(0.85,1.12),proportions.Y*random:NextNumber(0.8,1.15),proportions.Z*random:NextNumber(0.85,1.15))*size
 local frame=CFrame.new(position+V(0,dimensions.Y*0.42,0))*CFrame.Angles(random:NextNumber(-0.15,0.15),random:NextNumber(0,math.pi*2),random:NextNumber(-0.15,0.15))
 local stone=part(m,variant[1],dimensions,frame,P.shadow:Lerp(P.rim,random:NextNumber(0.1,0.65)),Enum.Material.Slate)
 local mesh=Instance.new("SpecialMesh"); mesh.MeshType=Enum.MeshType.FileMesh
 mesh.MeshId="rbxassetid://"..variant[2]
 mesh.Scale=V(dimensions.X/variant[3].X,dimensions.Y/variant[3].Y,dimensions.Z/variant[3].Z)
 mesh.Parent=stone
end
local function rocket(parent)
 local m=model(parent,"SELENE Rocket and landing pad")
 local origin=V(-112,180,-126)
 cylinder(m,"Landing pad",37,0.7,CFrame.new(origin),P.dark,Enum.Material.Concrete)
 ring(m,"Pad safety markings",CFrame.new(origin+V(0,0.5,0)),32,1.4,0.1,48,P.orange)
 for i=1,12 do
  local angle=i*math.pi/6
  local p=origin+V(math.cos(angle)*36,0.75,math.sin(angle)*36)
  cylinder(m,"Landing beacon",0.75,0.4,CFrame.new(p),P.cyan,Enum.Material.Neon)
 end
 -- A tapered, panel-built hull with a wider propulsion stage and compact capsule.
 local hull=model(m,"Paneled flight vehicle")
 local profile={{15,6.8},{20,8},{29,8},{43,6.8},{51,6.4},{58,4.6},{65,1.8},{67,0.15}}
 local facets=12
 for stage=1,#profile-1 do
  local lower,upper=profile[stage],profile[stage+1]
  for i=0,facets-1 do
   local a,b=i*math.pi*2/facets,(i+1)*math.pi*2/facets
   local function at(y,r,angle) return origin+V(math.cos(angle)*r,y,math.sin(angle)*r) end
   local p,q,r,t=at(lower[1],lower[2],a),at(lower[1],lower[2],b),at(upper[1],upper[2],a),at(upper[1],upper[2],b)
   local color=stage==1 and P.metal or (i%4==0 and P.white:Lerp(P.metal,0.24) or P.white)
   triangle(hull,p,q,r,color); triangle(hull,q,t,r,color)
   if stage>=2 and stage<=5 then
    beam(m,"Longitudinal panel seam",at(lower[1]+0.12,lower[2]+0.06,a),at(upper[1]-0.12,upper[2]+0.06,a),0.07,P.metal,Enum.Material.Metal)
   end
  end
 end
 for _,panel in ipairs(hull:GetChildren()) do
  panel.Name="Tapered hull panel"; panel.Material=Enum.Material.Metal; panel.CanCollide=false; panel.CanQuery=false
 end
 for _,entry in ipairs({{20,8.08},{29,8.08},{43,6.88},{51,6.48}}) do
  cylinder(m,"Stage separation collar",entry[2],0.45,CFrame.new(origin+V(0,entry[1],0)),P.metal,Enum.Material.Metal)
 end
 cylinder(m,"Mission orange belt",8.08,1.1,CFrame.new(origin+V(0,27,0)),P.orange,Enum.Material.Metal)
 for _,x in ipairs({-2.4,2.4}) do
  local frame=CFrame.new(origin+V(x,48,6.15))*CFrame.Angles(math.rad(12),0,0)
  part(m,"Recessed cockpit surround",V(4,3.5,0.5),frame,P.metal,Enum.Material.Metal)
  part(m,"Cockpit glazing",V(3.2,2.6,0.25),frame*CFrame.new(0,0,0.3),P.blue,Enum.Material.Glass)
  part(m,"Window reflection strip",V(0.14,2.3,0.05),frame*CFrame.new(-0.9,0,0.46),P.cyan,Enum.Material.Neon)
 end
 local hatch=CFrame.new(origin+V(0,36,7.65))
 part(m,"Crew hatch frame",V(4.2,7,0.6),hatch,P.metal,Enum.Material.Metal)
 part(m,"Pressure hatch",V(3.5,6.2,0.7),hatch*CFrame.new(0,0,0.15),P.white,Enum.Material.Metal)
 part(m,"Hatch handle",V(1.2,0.15,0.25),hatch*CFrame.new(0,0.5,0.6),P.orange,Enum.Material.Metal)
 for y=23,32,1.3 do
  beam(m,"Access ladder rung",origin+V(-1.7,y,8.2),origin+V(1.7,y,8.2),0.15,P.metal,Enum.Material.Metal)
 end
 for _,x in ipairs({-1.7,1.7}) do beam(m,"Ladder rail",origin+V(x,22,8.2),origin+V(x,33,8.2),0.16,P.metal,Enum.Material.Metal) end
 for i=1,4 do
  local angle=(i-1)*math.pi/2+math.pi/4
  local radial=V(math.cos(angle),0,math.sin(angle))
  local top=origin+radial*6+V(0,20,0)
  local knee=origin+radial*12+V(0,10,0)
  local foot=origin+radial*17+V(0,1.6,0)
  beam(m,"Articulated upper landing leg",top,knee,1.2,P.white,Enum.Material.Metal)
  beam(m,"Hydraulic landing piston",knee,foot,0.7,P.metal,Enum.Material.Metal)
  beam(m,"Landing leg brace",origin+radial*6+V(0,13,0),foot,0.4,P.orange,Enum.Material.Metal)
  sphere(m,"Landing knee joint",V(2,2,2),knee,P.metal,Enum.Material.Metal)
  cylinder(m,"Landing foot",3.4,0.6,CFrame.new(foot),P.metal,Enum.Material.Metal)
  local frame=CFrame.lookAt(origin+radial*8+V(0,21,0),origin+radial*20+V(0,21,0))
  part(m,"Thermal service pod",V(2.5,9,2),frame,P.metal,Enum.Material.Metal)
  for y=18,24,1.2 do part(m,"Service pod radiator fin",V(3,0.2,2.4),frame*CFrame.new(0,y-21,0),P.white,Enum.Material.Metal) end
 end
 for _,x in ipairs({-3,3}) do
  cylinder(m,"Engine turbopump",1.6,3,CFrame.new(origin+V(x,15,0)),P.orange,Enum.Material.Metal)
  for j=0,5 do
   local radius=1.3+j*0.25
   cylinder(m,"Flared nozzle segment",radius,0.85,CFrame.new(origin+V(x,12.8-j*0.8,0)),P.metal,Enum.Material.Metal)
  end
  cylinder(m,"Dark engine exhaust cavity",2.5,0.12,CFrame.new(origin+V(x,8.35,0)),P.dark)
  for _,z in ipairs({-1.6,1.6}) do beam(m,"Engine feed line",origin+V(x,19,z),origin+V(x,13,z),0.22,P.orange,Enum.Material.Metal) end
 end
 beam(m,"Capsule antenna",origin+V(0,64,0),origin+V(0,72,0),0.14,P.metal,Enum.Material.Metal)

end
local function outpost(parent)
 local m=model(parent,"Lunar research outpost")
 -- A pressurized habitat, scientific equipment, and a fixed flag in the vacuum.
 local base=V(106,181,-82)
 cylinder(m,"Habitat pressure vessel",8,24,CFrame.new(base+V(0,8,0))*CFrame.Angles(0,0,math.pi/2),P.white,Enum.Material.Metal)
 -- Break up the plain pressure shell with structural bands, thermal blankets, and service hardware.
 for _,x in ipairs({-10,-5,0,5,10}) do
  cylinder(m,"Pressure hull reinforcing collar",8.25,0.42,CFrame.new(base+V(x,8,0)),P.metal,Enum.Material.Metal)
  cylinder(m,"Collar insulation gasket",8.32,0.12,CFrame.new(base+V(x+0.28,8,0)),P.orange,Enum.Material.Metal)
 end
 -- Long insulated panels follow the habitat's sides and sit just above its curved hull.
 for _,side in ipairs({-1,1}) do
  for _,x in ipairs({-7.5,-2.5,2.5,7.5}) do
   local panelFrame=CFrame.new(base+V(x,8,side*6.65))*CFrame.Angles(side*math.rad(48),0,0)
   part(m,"Segmented thermal blanket",V(4.2,4.4,0.22),panelFrame,P.metal,Enum.Material.DiamondPlate)
   part(m,"Blanket edge latch",V(3.7,0.14,0.28),panelFrame*CFrame.new(0,2.05,0),P.orange,Enum.Material.Metal)
  end
 end
 -- Small observation ports with raised rims and inner glass give the habitat a human scale.
 for _,x in ipairs({-7,0,7}) do
  local portAt=base+V(x,9.5,7.35)
  cylinder(m,"Observation port bezel",1.35,0.28,CFrame.new(portAt)*CFrame.Angles(math.pi/2,0,0),P.metal,Enum.Material.Metal)
  cylinder(m,"Blue observation glass",0.96,0.32,CFrame.new(portAt+V(0,0,0.18))*CFrame.Angles(math.pi/2,0,0),P.cyan,Enum.Material.Glass)
  beam(m,"Port cross brace",portAt+V(-0.86,0,0.38),portAt+V(0.86,0,0.38),0.12,P.white,Enum.Material.Metal)
 end
 for _,x in ipairs({-12,12}) do
  sphere(m,"Habitat end cap",V(4,16,16),base+V(x,8,0),P.white,Enum.Material.Metal)
  part(m,"Habitat support",V(4,4,12),base+V(x,0,0),P.metal,Enum.Material.Metal)
  for _,z in ipairs({-4.5,4.5}) do
   beam(m,"Landing support strut",base+V(x,2,z),base+V(x,6,z*0.8),0.35,P.white,Enum.Material.Metal)
  end
 end
 part(m,"Airlock pressure vestibule",V(6,8,5),base+V(0,4,9),P.white,Enum.Material.Metal)
 part(m,"Airlock armored door",V(4.3,5.8,0.3),base+V(0,3.8,11.65),P.metal,Enum.Material.DiamondPlate)
 part(m,"Airlock window",V(1.7,1.3,0.18),base+V(0,5.3,11.88),P.cyan,Enum.Material.Glass)
 for _,x in ipairs({-1.55,1.55}) do
  cylinder(m,"Hatch locking wheel",0.34,0.16,CFrame.new(base+V(x,3.8,11.92))*CFrame.Angles(math.pi/2,0,0),P.orange,Enum.Material.Metal)
 end
 for _,x in ipairs({-2.8,2.8}) do beam(m,"Airlock frame",base+V(x,0.5,11.65),base+V(x,8,11.65),0.3,P.metal,Enum.Material.Metal) end
 part(m,"Airlock threshold",V(7,0.5,5),base+V(0,0.25,12),P.metal,Enum.Material.DiamondPlate)
 -- A short approach ladder and handrails make the raised hatch feel usable.
 for _,x in ipairs({-2.4,2.4}) do beam(m,"Airlock handrail",base+V(x,1.4,13),base+V(x,4.6,13),0.2,P.orange,Enum.Material.Metal) end
 for y=1.3,4.2,0.75 do beam(m,"Airlock ladder rung",base+V(-2.35,y,13),base+V(2.35,y,13),0.16,P.white,Enum.Material.Metal) end
 -- Equipment boxes, hoses, and a roof mounted instrument mast add visible mission hardware.
 for _,x in ipairs({-7,7}) do
  part(m,"External equipment locker",V(3.5,3.6,3.2),base+V(x,3.1,-5),P.metal,Enum.Material.DiamondPlate)
  part(m,"Locker safety panel",V(2.5,1.4,0.18),base+V(x,3.2,-6.7),P.orange,Enum.Material.Metal)
  for y=2.2,4.2,0.7 do beam(m,"Locker vent",base+V(x-0.9,y,-6.83),base+V(x+0.9,y,-6.83),0.09,P.white,Enum.Material.Metal) end
 end
 for _,x in ipairs({-4,4}) do
  beam(m,"Habitat roof equipment rail",base+V(x,14,-4),base+V(x,14,4),0.2,P.metal,Enum.Material.Metal)
 end
 beam(m,"Habitat weather mast",base+V(0,14,0),base+V(0,22,0),0.22,P.white,Enum.Material.Metal)
 for _,z in ipairs({-1,1}) do sphere(m,"Habitat sensor",V(0.9,0.9,0.9),base+V(0,22,z),P.orange,Enum.Material.Neon) end
 part(m,"Habitat roof antenna",V(0.18,0.15,8),CFrame.new(base+V(0,20,-5))*CFrame.Angles(0,0,math.rad(35)),P.metal,Enum.Material.Metal)
 for _,x in ipairs({85,109,133}) do
  beam(m,"Solar array support",V(x,180,-119),V(x,187,-119),0.6,P.metal,Enum.Material.Metal)
  local frame=CFrame.new(x,188,-119)*CFrame.Angles(math.rad(22),0,0)
  part(m,"Solar panel frame",V(20,0.6,12),frame,P.white,Enum.Material.Metal)
  for i=-2,2 do for j=-1,1 do
   part(m,"Photovoltaic cell",V(3.6,0.12,3.4),frame*CFrame.new(i*3.9,0.36,j*3.8),P.blue,Enum.Material.Glass)
  end end
 end
 local dish=V(137,191,-51)
 beam(m,"Communications mast",V(137,180,-51),dish,0.8,P.metal,Enum.Material.Metal)
 local dishFrame=CFrame.new(dish)*CFrame.Angles(math.rad(28),0,math.rad(12))
 sphere(m,"Satellite dish",V(13,1.5,13),dishFrame,P.white,Enum.Material.Metal)
 ring(m,"Dish lip",dishFrame,6,0.4,0.4,28,P.metal,Enum.Material.Metal)
 beam(m,"Dish receiver",dish,dish+V(0,5,0),0.35,P.metal,Enum.Material.Metal)
 sphere(m,"Receiver tip",V(1,1,1),dish+V(0,5,0),P.orange)
 beam(m,"Flag mast",V(-53,180,-87),V(-53,198,-87),0.3,P.white,Enum.Material.Metal)
 beam(m,"Flag crossbar",V(-53,198,-87),V(-45,198,-87),0.2,P.white,Enum.Material.Metal)
 part(m,"Expedition flag",V(8,5,0.12),V(-49,195.5,-87),P.orange,Enum.Material.Fabric)
 cylinder(m,"Flag moon emblem",1.5,0.15,CFrame.new(-49,195.5,-86.9)*CFrame.Angles(math.pi/2,0,0),P.white)
 for i=1,7 do
  local at=V(75+i*3,180.4,-55+i*2)
  cylinder(m,"Sample canister",0.7,1.6,CFrame.new(at),i%2==0 and P.orange or P.white,Enum.Material.Metal)
 end
end
local function rover(parent)
 local m=model(parent,"Lunar rover")
 local origin=V(-93,181,64)
 part(m,"Rover chassis",V(13,2.4,8),origin+V(0,2,0),P.white,Enum.Material.Metal)
 part(m,"Rover battery pack",V(4,2,7),origin+V(-4,4,0),P.orange,Enum.Material.Metal)
 for _,x in ipairs({-4.5,0,4.5}) do for _,z in ipairs({-5,5}) do
  local frame=CFrame.new(origin+V(x,0.6,z))*CFrame.Angles(math.pi/2,0,0)
  cylinder(m,"Wire mesh rover wheel",2.2,1.4,frame,P.dark,Enum.Material.DiamondPlate)
  cylinder(m,"Wheel hub",0.8,1.6,frame,P.metal,Enum.Material.Metal)
 end end
 for _,z in ipairs({-2,2}) do
  part(m,"Rover seat",V(3,1,2.6),origin+V(1,4,z),P.dark,Enum.Material.SmoothPlastic,true)
  part(m,"Rover seat back",V(0.8,3,2.6),origin+V(-0.5,5,z),P.dark,Enum.Material.SmoothPlastic,true)
 end
 beam(m,"Rover camera mast",origin+V(5,3,0),origin+V(5,11,0),0.3,P.white,Enum.Material.Metal)
 part(m,"Stereo survey camera",V(1.5,1,3),origin+V(5,11,0),P.dark)
 for _,z in ipairs({-1,1}) do sphere(m,"Camera lens",V(0.2,0.6,0.6),origin+V(5.8,11,z),P.cyan,Enum.Material.Neon) end
 for i=1,20 do for _,z in ipairs({-5,5}) do
  part(m,"Rover track",V(0.6,0.025,1.8),V(-105-i*1.8,179.55,64+z),P.shadow,Enum.Material.Slate)
 end end
end
local function sky(parent,random)
 local m=model(parent,"Lunar sky")
 -- Keep the sky visible even when distant geometry would normally stream out.
 m.ModelStreamingMode=Enum.ModelStreamingMode.Persistent
 local center=V(0,180,0)
 for i=1,180 do
  -- Keep the star dome well behind the terrain and away from the horizon line.
  local y=random:NextNumber(0.32,1)
  local angle=random:NextNumber(0,math.pi*2)
  local direction=V(math.sqrt(1-y*y)*math.cos(angle),y,math.sqrt(1-y*y)*math.sin(angle))
  local size=random:NextNumber(0.65,1.3)
  local star=sphere(m,"Distant star",V(size,size,size),center+direction*random:NextNumber(1900,2350),
   i%7==0 and Color3.fromRGB(160,197,255) or Color3.fromRGB(242,239,220),Enum.Material.Neon)
  star.CastShadow=false; star.Transparency=random:NextNumber(0.08,0.35)
  -- A tiny screen-size core keeps stars visible without large skybox star shapes.
  local point=Instance.new("BillboardGui"); point.Name="Starlight"; point.Adornee=star
  point.Size=UDim2.fromOffset(i%5==0 and 3 or 2,i%5==0 and 3 or 2)
  point.LightInfluence=0; point.MaxDistance=4000; point.Parent=star
  local dot=Instance.new("Frame"); dot.Name="Point"; dot.Size=UDim2.fromScale(1,1)
  dot.BackgroundColor3=star.Color; dot.BackgroundTransparency=star.Transparency; dot.BorderSizePixel=0; dot.Parent=point
  if i%5==0 then star:SetAttribute("TwinklePhase",random:NextNumber(0,math.pi*2)) end
 end
 local earth=model(m,"Earth")
 local earthCenter=V(-265,430,-920)
 -- UV-mapped globe and cloud imagery from Creator Store's Realistic Earth (PBR),
 -- asset 11372170772 by 1980svg. Only mesh/texture references are used.
 local globeFrame=CFrame.new(earthCenter)*CFrame.Angles(0,math.rad(-96),math.rad(23.4))
 local function globe(name,diameter,texture,transparency)
  local p=part(earth,name,V(diameter,diameter,diameter),globeFrame,Color3.new(1,1,1))
  local mesh=Instance.new("SpecialMesh")
  mesh.MeshType=Enum.MeshType.FileMesh; mesh.MeshId="rbxassetid://6510695035"
  mesh.TextureId=texture; mesh.Scale=V(1,1,1)*(diameter/6.366715); mesh.Parent=p
  p.Transparency=transparency or 0
  return p
 end
 globe("Textured oceans and continents",134,"rbxassetid://11287088884")
 globe("Fine cloud systems",134.65,"rbxassetid://11286649227",0.18)
 local atmosphere=sphere(earth,"Atmospheric limb",V(138,138,138),globeFrame,P.cyan,Enum.Material.ForceField)
 atmosphere.Transparency=0.82
 local glow=sphere(earth,"Soft blue atmospheric glow",V(142,142,142),globeFrame,Color3.fromRGB(76,160,255),Enum.Material.Neon)
 glow.Transparency=0.965
 local rim=Instance.new("Highlight"); rim.Name="Earth limb glow"; rim.Adornee=earth
 rim.FillColor=Color3.fromRGB(120,177,255); rim.FillTransparency=0.97
 rim.OutlineColor=Color3.fromRGB(118,192,255); rim.OutlineTransparency=0.6
 rim.DepthMode=Enum.HighlightDepthMode.Occluded; rim.Parent=earth
 local saturn=model(m,"Ringed planet")
 local at=V(620,480,700)
 local frame=CFrame.new(at)*CFrame.Angles(math.rad(24),0,math.rad(-18))
 -- Banded globe texture from Saturn [Realistic], asset 15246961312 by jacobthiagobonito.
 local globe=part(saturn,"Saturn cloud bands",V(75,69,75),frame,Color3.new(1,1,1))
 local mesh=Instance.new("SpecialMesh"); mesh.MeshType=Enum.MeshType.FileMesh
 mesh.MeshId="rbxassetid://453515873"; mesh.TextureId="rbxassetid://128239574"
 mesh.Scale=V(75/1.996349,69/1.995128,75/1.997565); mesh.Parent=globe
 local haze=sphere(saturn,"Saturn atmospheric haze",V(75.6,69.6,75.6),frame,Color3.fromRGB(242,213,169),Enum.Material.ForceField)
 haze.Transparency=0.94
 local rings=model(saturn,"Layered ice rings")
 -- Separate C/B/A rings and the narrow outer F ring leave real dark divisions.
 for index,band in ipairs({{44,3,0.38},{48,3,0.25},{53,5,0.12},{58,4,0.16},{65,4,0.2},{70,5,0.3},{75,2,0.4},{83,0.9,0.5}}) do
  local color=Color3.fromRGB(176,158,128):Lerp(Color3.fromRGB(231,218,190),(index%3)/3)
  local bandModel=model(rings,index<=4 and "Inner ice ring band" or "Outer ice ring band")
  ring(bandModel,"Fine ice ring segment",frame,band[1],band[2],0.16,96,color,Enum.Material.SmoothPlastic)
  for _,segment in ipairs(bandModel:GetChildren()) do segment.Transparency=band[3] end
 end
 -- A few tiny companions add scale without crowding the planet silhouette.
 sphere(saturn,"Titan",V(3.4,3.4,3.4),frame*V(101,8,-12),Color3.fromRGB(184,137,80))
 sphere(saturn,"Icy companion",V(1.5,1.5,1.5),frame*V(-92,-7,18),P.white)
 sphere(m,"Distant red planet",V(25,25,25),V(830,350,-690),Color3.fromRGB(166,83,63),Enum.Material.Neon)
 for _,item in ipairs(m:GetDescendants()) do if item:IsA("BasePart") then item.CastShadow=false end end
 -- Keep the complete backdrop inside the draw distance of lower graphics settings.
 m.WorldPivot=CFrame.new(center)
 m:ScaleTo(0.35)
end
function Moon.build()
 local root=Instance.new("Model"); root.Name="MoonEnvironment"; root:SetAttribute("Version",4)
 root.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
 local random=Random.new(709)
 ground(root)
 local function surfaceAt(x,z)
  for _,entry in ipairs(CRATERS) do
   if math.abs(x-entry[1])<entry[3] and math.abs(z-entry[2])<entry[3] then return craterHeight(entry,x,z) end
  end
  return SURFACE
 end
 local function clear(x,z,padding)
  if math.abs(x)<72+padding and math.abs(z)<96+padding then return false end
  -- Leave the landing pad, habitat, solar arrays and rover exposed.
  if (V(x,0,z)-V(-112,0,-126)).Magnitude<40+padding then return false end
  if x>76-padding and x<149+padding and z> -132-padding and z< -40+padding then return false end
  if math.abs(x+93)<15+padding and math.abs(z-64)<12+padding then return false end
  return true
 end
 local debris=model(root,"Basalt boulder fields")
 for i=1,420 do
  local x,z=random:NextNumber(-430,430),random:NextNumber(-360,360)
  local size=random:NextNumber(0.8,7)
  if clear(x,z,size) then
   rock(debris,V(x,surfaceAt(x,z),z),size,random)
  end
 end
 -- Local ejecta clusters break up the rims without constructing raised rings.
 for _,entry in ipairs(CRATERS) do
  for i=1,16 do
   local angle=random:NextNumber(0,math.pi*2)
   local radius=entry[3]*random:NextNumber(0.9,1.4)
   local x,z=entry[1]+math.cos(angle)*radius,entry[2]+math.sin(angle)*radius
   local size=random:NextNumber(0.5,2.4)
   if clear(x,z,size) then rock(debris,V(x,surfaceAt(x,z),z),size,random) end
  end
 end
 local gravel=model(root,"Scattered regolith fragments")
 for i=1,360 do
  local x,z=random:NextNumber(-260,260),random:NextNumber(-240,240)
  if clear(x,z,2) then
   local size=random:NextNumber(0.2,0.8)
   rock(gravel,V(x,surfaceAt(x,z),z),size,random)
  end
 end
 local ranges=model(root,"Fractured lunar highlands")
 -- Continuous eroded slopes replace separate wedge-shaped mountain blocks.
 local sectors,bands=80,6
 local function ridgePoint(i,j)
  local angle=(i%sectors)*math.pi*2/sectors
  local t=j/bands
  local radius=520+t*120
  local envelope=math.sin(math.pi*t)^1.5
  local peaks=42+14*math.sin(angle*7)+9*math.cos(angle*11+1)
  local erosion=math.noise(math.cos(angle)*5,math.sin(angle)*5,t*3)*17
  return V(math.cos(angle)*radius,SURFACE-0.15+envelope*(peaks+erosion),math.sin(angle)*radius*0.75)
 end
 for i=0,sectors-1 do
  local ridge=model(ranges,"Eroded ridge section")
  for j=0,bands-1 do
   local a,b,c,d=ridgePoint(i,j),ridgePoint(i+1,j),ridgePoint(i,j+1),ridgePoint(i+1,j+1)
   local color=P.shadow:Lerp(P.dust,0.45+0.08*math.sin(i*0.7+j))
   triangle(ridge,a,b,c,color); triangle(ridge,b,d,c,color)
  end
  -- Solid below-grade footings seal the underside and stay clear of crater cutouts.
  local angle=(i+0.5)*math.pi*2/sectors
  local radial=V(math.cos(angle),0,math.sin(angle)*0.75)
  local frame=CFrame.lookAt(V(radial.X*570,SURFACE-16,radial.Z*570),V(0,SURFACE-16,0))
  part(ridge,"Buried highland foundation",V(2*640*math.sin(math.pi/sectors)+2,32,150),frame,P.dust,Enum.Material.Slate)
  for _,face in ipairs(ridge:GetChildren()) do
   if face.Name~="Buried highland foundation" then face.Name="Eroded highland face" end
   face.CanCollide=false; face.CanQuery=false
  end
 end
 for _,x in ipairs({-65,65}) do
  part(root,"Outpost platform edge",V(1,1.2,180),V(x,181.4,0),P.metal,Enum.Material.Metal)
  for z=-80,80,20 do part(root,"Platform navigation light",V(0.3,0.15,5),V(x,182.1,z),P.cyan,Enum.Material.Neon) end
 end
 for _,z in ipairs({-89,89}) do part(root,"Platform end edge",V(132,1.2,1),V(0,181.4,z),P.metal,Enum.Material.Metal) end
 for _,z in ipairs({-26,0,26}) do
  local frame=CFrame.new(48,183,z)*CFrame.Angles(0,-math.pi/2,0)
  part(root,"Lounge seat",V(10,1,4),frame,P.white,Enum.Material.Metal,true)
  part(root,"Lunar bench back",V(10,3,0.5),frame*CFrame.new(0,1,-1.8),P.metal,Enum.Material.Metal,true)
  for _,x in ipairs({-4,4}) do part(root,"Bench support",V(0.5,2,3),frame*CFrame.new(x,-1,0),P.metal,Enum.Material.Metal,true) end
 end
 rocket(root); outpost(root); rover(root); sky(root,random)
 root:SetAttribute("ExpectedDescendants",#root:GetDescendants())
 return root
end
return Moon
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Powerups</string>
          <string name="Source"><![CDATA[-- Draft catalog and pure effect rules. Distances use the painted 20 x 44 foot court.
-- The court is 40 x 80 studs; width defines two studs per foot.
local Powerups={DURATION=20}
local archetypes={
 {"Fleet Foot", "speed", 0.08, "Move %d%% faster", "WIND"},
 {"Second Wind", "regen", 0.18, "Recover stamina %d%% faster", "PULSE"},
 {"Long Reach", "reach", 0.06, "Extend contact range by %d%%", "ORBIT"},
 {"Quick Reset", "dive", 0.08, "Reduce dive cooldown by %d%%", "WIND"},
 {"Light Steps", "speed", 0.07, "Move %d%% faster", "ORBIT"},
 {"Deep Breath", "regen", 0.20, "Recover stamina %d%% faster", "PULSE"},
 {"Wide Guard", "reach", 0.07, "Extend contact range by %d%%", "SHIELD"},
 {"Acrobat", "dive", 0.09, "Reduce dive cooldown by %d%%", "ORBIT"},
 {"Court Runner", "speed", 0.09, "Move %d%% faster", "WIND"},
 {"Endless Rhythm", "regen", 0.16, "Recover stamina %d%% faster", "PULSE"},
 {"Sweet Spot", "reach", 0.08, "Extend contact range by %d%%", "SHIELD"},
 {"Fast Reset", "dive", 0.10, "Reduce dive cooldown by %d%%", "WIND"},
}
Powerups.catalog={
 {id="kitchenCamper",tier=1,name="Kitchen Camper",symbol="WIND",description="Move 15% faster within 2 feet of the kitchen line. Retreating to baseline disables it this rally."},
 {id="dinkSpecialist",tier=1,name="Dink Specialist",symbol="PULSE",description="Land 3 consecutive dinks to boost your next baseline drive speed by 20%."},
 {id="carbonFiber",tier=1,name="Carbon Fiber Core",symbol="SHIELD",description="Your paddle sweet spot is 15% wider, reducing off-center mishits."},
 {id="secondServe",tier=1,name="Second Serve",symbol="PULSE",description="Once per match, a serve fault grants a free retry and fully restores stamina."},
 {id="sliceDice",tier=1,name="Slice and Dice",symbol="ORBIT",description="Slice shots bounce 10% lower. Press X to slice."},
 {id="thirdShot",tier=2,name="The Third-Shot Drop",symbol="ORBIT",description="Your third shot is guided to the kitchen with +40% accuracy and heavy topspin."},
 {id="serveVolley",tier=2,name="Serve and Volley",symbol="WIND",description="Gain 75% movement speed for 3 seconds after serving."},
 {id="vampiricReach",tier=2,name="Vampiric Reach",symbol="PULSE",description="Win a point at the net to permanently gain 1% reach, up to 10%."},
 {id="atpAssassin",tier=2,name="ATP (Around the Post) Assassin",symbol="ORBIT",description="Land a shot around a net post to drain 30% of opponents' max stamina."},
 {id="baitSwitch",tier=2,name="Bait and Switch",symbol="WIND",description="Press lob (R) during a smash windup for a perfect drop. Retreating opponents are stunned for 1 second."},
 {id="erne",tier=3,name="Erne Executioner",symbol="PULSE",description="A legal jumping volley outside the sideline has 300% power and wins on paddle contact."},
 {id="phantom",tier=3,name="Phantom Paddle",symbol="SHIELD",description="Gain 8 inches of invisible paddle reach on your backhand side."},
 {id="lava",tier=3,name="Kitchen is Lava",symbol="PULSE",description="Opponents touching their kitchen line suffer double stamina drain for the rest of the rally."},
 {id="overcharge",tier=3,name="Rally Overcharge",symbol="WIND",description="After 15 shots, ignite your paddle, ignore incoming spin, and unleash one unreturnable smash."},
 {id="deflector",tier=3,name="Deflector Shield",symbol="SHIELD",description="Torso drives automatically deflect into the opponent's court at twice their incoming speed."},
 {id="perfectVision",tier=1,name="Perfect Vision",symbol="EYE",description="The green perfect-hit timing window is 20% longer, before and after a bounce."},
 {id="quickRecovery",tier=1,name="Quick Recovery",symbol="RESET",description="Recover from dive movement and animation locks 50% faster."},
 {id="baselineSentinel",tier=1,name="Baseline Sentinel",symbol="COURT",description="Move sideways 15% faster within 2 feet of the baseline."},
 {id="calculatedReturn",tier=1,name="Calculated Return",symbol="TARGET",description="Standard returns of serve send the ball back at 80% of its incoming velocity."},
 {id="momentumShift",tier=2,name="Momentum Shift",symbol="BOLT",description="Three consecutive perfect hits charge your fourth return with +15% rally acceleration."},
 {id="airTime",tier=2,name="Air Time",symbol="APEX",description="Fall slowly for 1 second after your jump's apex, giving you more time to line up a slam. Diving cancels the effect."},
 {id="offensiveDive",tier=2,name="Offensive Dive",symbol="DIVE",description="Dive hits apply maximum topspin, sharply increasing descent after crossing the net."},
 {id="kitchenWarden",tier=2,name="Kitchen Warden",symbol="SHIELD",description="Stand still at the kitchen line to extend your hit sphere forward by 25%."},
 {id="deceptiveDrop",tier=2,name="Deceptive Drop",symbol="MASK",description="Hold dive while swinging to fake a smash and hit a soft drop. Enemy reticles disappear for 0.5s."},
 {id="apexPredator",tier=3,name="Apex Predator",symbol="APEX",description="Hit at the bounce apex to disguise accelerated ball speed until it crosses the net."},
 {id="rhythmMaster",tier=3,name="Rhythm Master",symbol="RHYTHM",description="After 10 rally hits, perfect swings hide your paddle and its angle."},
 {id="afterimage",tier=3,name="Afterimage",symbol="CLONE",description="Dives leave a solid visual clone for 2s. Hit within 1s to show opponents a decoy landing spot."},
 {id="terminalVelocity",tier=3,name="Terminal Velocity",symbol="INFINITY",description="Uncapped +8% perfect-hit acceleration. Win a rally exceeding 1.5x speed for permanent +5% movement."},
}
function Powerups.has(build,id) return build~=nil and build[id]==true end
function Powerups.slowFall(build,side,variant)
 return side~=0 and variant=="Chaos" and Powerups.has(build,"airTime")
end
function Powerups.newRally()
 return {perfectChain=0,diveStarted=-math.huge,tension=0,camperActive=false,camperLost=false,lava=false,burstUntil=0,stunUntil=0,overchargeUsed=false}
end
function Powerups.perfect(build,timeToBounce,sinceBounce)
 local scale=Powerups.has(build,"perfectVision") and 1.2 or 1
 return timeToBounce<=0.23*scale or sinceBounce<=0.28*scale
end
function Powerups.diveDuration(build)
 local scale=Powerups.has(build,"quickRecovery") and 0.5 or 1
 return 0.48*scale,0.66*scale
end
function Powerups.lateralScale(build,depth,x,lateral)
 return Powerups.has(build,"baselineSentinel") and math.abs(depth-40)<=4 and math.abs(x)<=20
  and math.sqrt(1+(1.15^2-1)*math.clamp(lateral*lateral,0,1)) or 1
end
function Powerups.warden(build,depth,x,speed,grounded)
 return Powerups.has(build,"kitchenWarden") and grounded and math.abs(depth-14)<=1 and math.abs(x)<=20 and speed<=1
end
function Powerups.acceleration(build,state,speed,clean,slam,charged,normal)
 local ready=Powerups.has(build,"momentumShift") and state.perfectChain>=3
 state.perfectChain=clean and (ready and 0 or state.perfectChain+1) or 0
 if ready then return math.max(1,speed)*1.15,"MOMENTUM SHIFT! +15%" end
 if clean and Powerups.has(build,"terminalVelocity") then return math.max(1,speed)*1.08,"TERMINAL VELOCITY! +8%" end
 return normal(speed,clean,slam,charged),nil
end
function Powerups.terminalWin(build,state,peak)
 if Powerups.has(build,"terminalVelocity") and peak>1.5 then state.speedWins=(state.speedWins or 0)+1 end
end
function Powerups.apex(build,bounces,vy,gravity)
 return Powerups.has(build,"apexPredator") and bounces>0 and math.abs(vy)<=gravity*0.06
end
function Powerups.tracking(opponent,live,now,hiddenUntil,glitchUntil,heavy,beforeNet)
 return opponent and live and now<(hiddenUntil or 0), opponent and live and now<(glitchUntil or 0),
  opponent and live and heavy==true and beforeNet
end
function Powerups.camp(state,depth,x,kitchen,baseline)
 if state.camperActive and depth>=baseline then state.camperLost=true end
 local near=math.abs(depth-kitchen)<=4 and math.abs(x)<=20
 if near and not state.camperLost then state.camperActive=true end
 return near and not state.camperLost
end
function Powerups.dink(state,landed)
 state.tension=landed and math.min(3,state.tension+1) or 0
 if state.tension==3 then state.driveReady=true end
end
function Powerups.drive(state,baseline)
 if baseline and state.driveReady then state.tension=0; state.driveReady=false; return 1.2 end
 return 1
end
function Powerups.onFire(build,state,shots)
 return Powerups.has(build,"overcharge") and shots>15
end
function Powerups.retryServe(build,state)
 if not Powerups.has(build,"secondServe") or state.secondServeUsed then return false end
 state.secondServeUsed=true
 return true
end
function Powerups.netWin(build,state,atNet)
 if atNet and Powerups.has(build,"vampiricReach") then state.reachStacks=math.min(10,(state.reachStacks or 0)+1) end
end
function Powerups.extraReach(build,state,backhand)
 return (state.reachStacks or 0)*0.01, (Powerups.has(build,"phantom") and backhand) and 4/3 or 0
end
-- Solve flight time for a specified launch speed; low arc first, high arc if needed.
function Powerups.flightTimes(horizontal,height,speed,gravity)
 local a=speed*speed-gravity*height
 local discriminant=a*a-gravity*gravity*(horizontal*horizontal+height*height)
 if discriminant<0 or a<=0 then return nil end
 local root=math.sqrt(discriminant)
 return math.sqrt(2*(a-root)/(gravity*gravity)),math.sqrt(2*(a+root)/(gravity*gravity))
end
function Powerups.bounceScale(spin,sliceBoost)
 -- Scale velocity by sqrt(height ratio), since bounce height is proportional to v^2.
 return spin=="slice" and math.sqrt(sliceBoost and 0.9 or 1) or spin=="topspin" and math.sqrt(0.55) or 1
end
Powerups.caps={speed=0.6,regen=1.5,reach=0.4,dive=0.5}
function Powerups.roll(random)
 local roll=random:NextNumber()
 return roll<0.6 and 1 or roll<0.9 and 2 or 3
end
function Powerups.deal(random,count,builds)
 assert(count>=1 and count<=4,"Draft supports one to four players")
 local tier=Powerups.roll(random)
 local pool={}
 for index,base in ipairs(archetypes) do
  local amount=base[3]*tier
  table.insert(pool,{id=tostring(tier)..":"..index,name=base[1],stat=base[2],amount=amount,
   description=string.format(base[4],math.floor(amount*100+0.5)),symbol=base[5],tier=tier})
 end
 for _,card in ipairs(Powerups.catalog) do
  if card.tier==tier then table.insert(pool,card) end
 end
 for index=#pool,2,-1 do
  local other=random:NextInteger(1,index)
  pool[index],pool[other]=pool[other],pool[index]
 end
 local offers={}
 for player=1,count do
  offers[player]={}
  for slot=1,3 do
   for index,card in ipairs(pool) do
    if card.stat or not Powerups.has(builds and builds[player],card.id) then
     offers[player][slot]=table.remove(pool,index); break
    end
   end
   assert(offers[player][slot],"Insufficient draft cards")
  end
 end
 return tier,offers
end
function Powerups.choose(offer,id,stats)
 if not offer or type(id)~="string" then return nil end
 for _,card in ipairs(offer) do
  if card.id==id then
   if card.stat then
    stats[card.stat]=math.min(Powerups.caps[card.stat],(stats[card.stat] or 0)+card.amount)
   else stats[card.id]=true end
   return card
  end
 end
 return nil
end
return Powerups
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">PracticeSession</string>
          <string name="Source"><![CDATA[-- Practice-only configuration and authoritative countdown state; no asynchronous timers.
local Practice={}
Practice.__index=Practice
Practice.Profiles={
 Easy={reactionMin=0.4,reactionMax=0.65,think=0.25,move=13,errorX=5,errorZ=4,
  miss=0.2,clean=0.3,wide=0.12,width=10,depthMin=20,depthMax=28,speed=0.8},
 Normal={reactionMin=0.22,reactionMax=0.42,think=0.18,move=18,errorX=3,errorZ=2,
  miss=0.1,clean=0.55,wide=0.07,width=15,depthMin=20,depthMax=34,speed=1},
 Hard={reactionMin=0.12,reactionMax=0.22,think=0.1,move=23,errorX=1.5,errorZ=1,
  miss=0.035,clean=0.8,wide=0.025,width=18,depthMin=25,depthMax=37,speed=1.15},
}
function Practice.new()
 return setmetatable({difficulty="Normal",paused=false,revision=0,remaining=nil,key=nil,served=false,flash=0},Practice)
end
function Practice:reset(difficulty)
 self.difficulty=difficulty or "Normal"
 self.paused=false; self.revision+=1
 self.remaining=nil; self.key=nil; self.served=false; self.flash=0
end
function Practice:select(difficulty)
 if not self.Profiles[difficulty] or difficulty==self.difficulty then return false end
 self:reset(difficulty)
 return true
end
function Practice:setPaused(paused)
 if type(paused)~="boolean" or paused==self.paused then return false end
 self.paused=paused; self.revision+=1
 return true
end
function Practice:step(key,dt)
 if self.paused then return false end
 self.flash=math.max(0,self.flash-dt)
 if not key then self.key=nil; self.remaining=nil; self.served=false; return false end
 if key~=self.key then
  self.key=key; self.remaining=3; self.served=false
  return false
 end
 if self.served then return false end
 self.remaining=math.max(0,self.remaining-dt)
 if self.remaining>0 then return false end
 self.served=true; self.remaining=nil; self.flash=0.6
 return true
end
function Practice:snapshot()
 return {difficulty=self.difficulty,paused=self.paused,revision=self.revision,
  countdown=not self.paused and self.remaining and math.ceil(self.remaining) or nil,
  remaining=self.remaining,serve=self.flash>0 and not self.paused}
end
return Practice
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">ProgressionConfig</string>
          <string name="Source"><![CDATA[-- All progression tuning is server-owned and lives here.
return {
 StoreName="PaddleUpProgression_v1", SchemaVersion=3,
 -- One lifetime XP credit earns this many spendable credits; migration uses the same ratio once.
 ShopCurrencyRatio=1,
 DefaultTimeZone="UTC", TimeZoneChangeDays=7,
 BaseXP=100, LinearXP=50, QuadraticXP=10,
 DailyXP=150, DailyMultiplier=1.05, MultiplyDailyReward=false, MultiplyWeeklyReward=false,
 WeeklyFraction=0.20, StreakDays=7, HistoryDays=35,
 Rewards={MatchCompleted=80,MatchWon=120,PracticeCompleted=30},
 GameplayDailyCap=600, MinimumMatchSeconds=90, MinimumContestedRallies=12, MinimumReturns=6,
 PromptDistance=12, InteractionSeconds=120, RemoteCooldown=1, RefreshSeconds=30, ManualRetrySeconds=3,
 RetryAttempts=3, RetryBaseSeconds=0.75, RetryInterval=15, ShutdownSeconds=25,
 ReceiptSeconds=172800, MaximumReceipts=128, MaximumPending=8,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">ProgressionRepository</string>
          <string name="Source"><![CDATA[-- Write-through transactions merge with the latest record on every server. No cached SetAsync saves.
local Config=require(script.Parent:WaitForChild("ProgressionConfig"))
local Rules=require(script.Parent:WaitForChild("ProgressionRules"))
local Repository={}
Repository.__index=Repository
function Repository.new(store,clock,sleep)
 return setmetatable({store=store,clock=clock or function() return DateTime.now().UnixTimestampMillis/1000 end,
  sleep=sleep or task.wait},Repository)
end
function Repository.errorInfo(err)
 local message=tostring(err)
 if message:find("StudioAccessToApisNotAllowed",1,true) or message:find("API access is not enabled",1,true) then
  return {code="StudioAPI",retryable=false,message="Studio API access is disabled. Enable Studio Access to API Services in a published test experience, then Retry."}
 end
 if message:find("Time-zone",1,true) then
  return {code="TimeZoneData",retryable=false,message="Time-zone data needs an update. No progress was changed. Please contact the game team."}
 end
 if message:find("Unsupported progression data",1,true) then
  return {code="UnsupportedVersion",retryable=false,message="This server needs a progression update. Please rejoin an updated server. Your saved progress is safe."}
 end
 if message:find("Invalid ",1,true) then
  return {code="InvalidData",retryable=false,message="Your saved progression could not be validated. No progress was changed. Retry or contact the game team."}
 end
 return {code="Unavailable",retryable=true,message="Couldn't load or save check-in data. Please Retry."}
end
function Repository:commit(userId,operation,deadline)
 local lastError
 for attempt=1,Config.RetryAttempts do
  if deadline and self.clock()>=deadline then break end
  local outcome,transformError
  local ok,result=pcall(function()
   return self.store:UpdateAsync("player_"..userId,function(current)
    -- Engine UpdateAsync can report a transform exception but return nil instead
    -- of throwing to its caller. Capture validation errors before that boundary.
    local valid,updated,receipt=pcall(Rules.apply,current,operation,self.clock())
    if not valid then transformError=updated; return nil end
    transformError=nil; outcome=receipt
    return updated
   end)
  end)
  if transformError then
   lastError=transformError
  elseif ok and result~=nil then
   local valid,err=pcall(Rules.validate,result)
   if valid then return result,result.receipts[operation.id] or outcome end
   lastError=err
  else lastError=result or "Progression storage returned no saved record" end
  if not Repository.errorInfo(lastError).retryable then break end
  if attempt<Config.RetryAttempts then
   local delay=Config.RetryBaseSeconds*2^(attempt-1)+math.random()*0.2
   if deadline and self.clock()+delay>=deadline then break end
   self.sleep(delay)
  end
 end
 return nil,nil,tostring(lastError or "Progression deadline reached")
end
return Repository
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">ProgressionRules</string>
          <string name="Source"><![CDATA[-- Pure server-time calendar, XP, and idempotent transitions; IANA data stays on the server.
local Config=require(script.Parent:WaitForChild("ProgressionConfig"))
local Zones=require(script.Parent:WaitForChild("TimeZones"))
local ShopRules=require(script.Parent:WaitForChild("ShopRules"))
local Rules={}
local function integer(value,minimum,maximum)
 return type(value)=="number" and value==value and value%1==0 and value>=minimum and value<=maximum
end
function Rules.day(timestamp,zone) return Zones.day(timestamp,zone or "UTC") end
function Rules.required(level)
 local n=level-1
 return Config.BaseXP+Config.LinearXP*n+Config.QuadraticXP*n*n
end
function Rules.new()
 return {version=Config.SchemaVersion,level=1,xp=0,totalXP=0,lastDay=-1,streak=0,
  multiplierUntil=0,weeklyAwards=0,lastWeeklyDay=-1,history={},budgets={},receipts={},
  timeZone=Config.DefaultTimeZone,claims={},zoneChangedAt=0,spendableXP=0,inventory={},equipped={}}
end
function Rules.validate(data)
 assert(type(data)=="table" and (data.version==1 or data.version==2 or data.version==3),"Unsupported progression data")
 assert(integer(data.level,1,100000) and integer(data.xp,0,Rules.required(data.level)-1),"Invalid XP or level")
 assert(integer(data.totalXP,data.xp,9007199254740991),"Invalid lifetime XP")
 assert(integer(data.lastDay,-1,1000000) and integer(data.streak,0,1000000),"Invalid check-in data")
 assert(type(data.multiplierUntil)=="number" and data.multiplierUntil>=0 and data.multiplierUntil<1e12,"Invalid multiplier")
 assert(integer(data.weeklyAwards,0,1000000) and integer(data.lastWeeklyDay,-1,1000000),"Invalid weekly data")
 assert(type(data.history)=="table" and type(data.budgets)=="table" and type(data.receipts)=="table","Invalid history")
 for key,entry in pairs(data.history) do
  assert(type(key)=="string" and integer(tonumber(key),0,1000000),"Invalid date")
  assert(type(entry)=="table" and type(entry.at)=="number" and entry.at>=0 and entry.at<1e12
   and Rules.day(entry.at)==tonumber(key)
   and type(entry.multiplier)=="number" and entry.multiplier>=1 and entry.multiplier<=100,"Invalid check-in history")
 end
 for key,value in pairs(data.budgets) do
  assert(type(key)=="string" and integer(tonumber(key),0,1000000) and integer(value,0,1000000000),"Invalid daily budget")
 end
 for key,receipt in pairs(data.receipts) do
  assert(type(key)=="string" and type(receipt)=="table" and type(receipt.at)=="number" and receipt.at>=0 and receipt.at<1e12
   and type(receipt.kind)=="string" and integer(receipt.amount,0,9007199254740991)
   and integer(receipt.weekly,0,9007199254740991),"Invalid receipt")
 end
 if data.version>=2 then
  assert(Zones.valid(data.timeZone) and type(data.claims)=="table","Invalid time-zone data")
  assert(type(data.zoneChangedAt)=="number" and data.zoneChangedAt>=0 and data.zoneChangedAt<1e12,"Invalid zone change date")
  if data.pendingTimeZone then
   assert(Zones.valid(data.pendingTimeZone) and type(data.zoneEffectiveAt)=="number" and data.zoneEffectiveAt>=0 and data.zoneEffectiveAt<1e12,"Invalid pending time zone")
  end
  if data.lastClaimAt then assert(type(data.lastClaimAt)=="number" and data.lastClaimAt>=0 and type(data.lastClaimEnd)=="number" and data.lastClaimEnd>data.lastClaimAt and data.lastClaimEnd<1e12,"Invalid claim window") end
  for id,claim in pairs(data.claims) do
   assert(type(id)=="string" and type(claim)=="table" and type(claim.at)=="number"
    and claim.at>=0 and type(claim.expires)=="number" and claim.expires>claim.at and claim.expires<1e12 and Zones.valid(claim.zone)
    and integer(claim.day,0,1000000),"Invalid local check-in history")
  end
 end
 -- Version 3 is already written by the shop release in the same store.
 -- Validate its owned state without requiring that release's catalog on this branch.
 if data.version==3 then
  assert(integer(data.spendableXP,0,9007199254740991),"Invalid shop balance")
  assert(type(data.inventory)=="table" and type(data.equipped)=="table","Invalid inventory")
  for id,owned in pairs(data.inventory) do
   assert(type(id)=="string" and #id<=80 and owned==true,"Invalid owned cosmetic")
  end
  for category,id in pairs(data.equipped) do
   assert(type(category)=="string" and type(id)=="string" and data.inventory[id]==true,"Invalid equipped cosmetic")
  end
 end
 return data
end
local function copy(data)
 local result=table.clone(Rules.validate(data))
 for _,name in ipairs({"history","budgets","receipts","claims"}) do result[name]=table.clone(data[name] or {}) end
 if data.version==3 then
  result.inventory=table.clone(data.inventory); result.equipped=table.clone(data.equipped)
 end
 if data.version==1 then
  result.timeZone=Config.DefaultTimeZone; result.zoneChangedAt=0
  for day,entry in pairs(data.history) do
   local number=tonumber(day)
   result.claims["legacy:"..day]={at=entry.at,expires=(number+1)*86400,zone="UTC",day=number,
    weekly=data.lastWeeklyDay==number}
   if not result.lastClaimAt or entry.at>result.lastClaimAt then result.lastClaimAt=entry.at end
  end
  if not result.lastClaimAt and data.lastDay>=0 then result.lastClaimAt=data.lastDay*86400 end
  if result.lastClaimAt then result.lastClaimEnd=math.max(data.multiplierUntil,(data.lastDay+1)*86400) end
 end
 if data.version<3 then
  -- The schema bump is the migration marker. Replaying Load cannot mint a second opening balance.
  result.spendableXP=math.floor(data.totalXP*Config.ShopCurrencyRatio)
  result.inventory={}; result.equipped={}
 else
  result.inventory=table.clone(data.inventory); result.equipped=table.clone(data.equipped)
 end
 result.version=Config.SchemaVersion
 return result
end
function Rules.validTimeZone(id) return Zones.valid(id) end
function Rules.timeZoneFromOffset(minutes) return Zones.fromOffsetMinutes(minutes) end
function Rules.zone(data,now)
 if data.pendingTimeZone and now>=data.zoneEffectiveAt then return data.pendingTimeZone end
 return data.timeZone or Config.DefaultTimeZone
end
local function calendar(data,now) return Zones.calendar(now,Rules.zone(data,now)) end
local function nextClaim(data,zone)
 if not data.lastClaimAt then return 0 end
 local nextDay=Zones.day(data.lastClaimAt,zone)+1
 return math.max(data.lastClaimEnd,Zones.dayStart(nextDay,zone))
end
function Rules.canClaim(data,now)
 data=copy(data)
 local zone=Rules.zone(data,now)
 return now>=nextClaim(data,zone)
end
local function grant(data,amount)
 amount=math.max(0,math.floor(amount))
 data.totalXP+=amount; data.xp+=amount
 data.spendableXP+=math.floor(amount*Config.ShopCurrencyRatio)
 while data.xp>=Rules.required(data.level) do
  data.xp-=Rules.required(data.level); data.level+=1
 end
 return amount
end
function Rules.apply(saved,operation,now)
 local data=saved==nil and Rules.new() or copy(saved)
 if data.pendingTimeZone and now>=data.zoneEffectiveAt then
  data.timeZone=data.pendingTimeZone; data.pendingTimeZone=nil; data.zoneEffectiveAt=nil
 end
 local current=calendar(data,now)
 if operation.kind=="Load" then return data,{kind="Load",amount=0} end
 assert(type(operation.id)=="string" and #operation.id<=100,"Invalid operation ID")
 assert(type(operation.at)=="number" and operation.at<=now+5,"Invalid reward time")
 if data.receipts[operation.id] then return data,data.receipts[operation.id] end
 if now-operation.at>Config.ReceiptSeconds then return data,{kind="Expired",amount=0} end
 local today,earnedDay=current.day,Rules.day(operation.at,current.zone)
 local receipt={at=operation.at,kind=operation.kind,amount=0,weekly=0,levelBefore=data.level}
 if ShopRules.isOperation(operation.kind) then
  receipt.kind=ShopRules.apply(data,operation)
 elseif operation.kind=="SetTimeZone" then
  assert(Zones.valid(operation.zone),"Invalid time zone")
  Zones.calendar(now,operation.zone)
  if data.pendingTimeZone==operation.zone or not data.pendingTimeZone and data.timeZone==operation.zone then return data,{kind="ZoneUnchanged",amount=0} end
  if data.zoneChangedAt>0 and now<data.zoneChangedAt+Config.TimeZoneChangeDays*86400 then return data,{kind="ZoneCooldown",amount=0} end
  if data.lastClaimAt then
   data.pendingTimeZone=operation.zone; data.zoneEffectiveAt=current.nextReset
  else
   data.timeZone=operation.zone
  end
  data.zoneChangedAt=now
 elseif operation.kind=="CheckIn" then
  -- The date is derived from the stored zone and server timestamp, never a client date.
  if earnedDay~=today then return data,{kind="Reset",amount=0} end
  if not Rules.canClaim(data,now) then return data,{kind="Already",amount=0} end
  local expected=data.lastClaimAt and Zones.day(nextClaim(data,current.zone),current.zone) or today
  data.streak=data.lastClaimAt and today==expected and data.streak+1 or 1
  data.lastDay=today; data.multiplierUntil=current.nextReset
  data.lastClaimAt=now; data.lastClaimEnd=current.nextReset
  data.claims[operation.id]={at=now,expires=current.nextReset,zone=current.zone,day=today,weekly=false}
  local daily=Config.DailyXP*(Config.MultiplyDailyReward and Config.DailyMultiplier or 1)
  receipt.amount=grant(data,daily)
  if data.streak%Config.StreakDays==0 and data.lastWeeklyDay~=today then
   -- Daily XP is granted first. Use the level at the instant the weekly bonus is granted.
   local bonus=math.floor(Rules.required(data.level)*Config.WeeklyFraction)
   if Config.MultiplyWeeklyReward then bonus*=Config.DailyMultiplier end
   receipt.weekly=grant(data,bonus); receipt.amount+=receipt.weekly
   data.lastWeeklyDay=today; data.weeklyAwards+=1
   data.claims[operation.id].weekly=true
  end
 elseif operation.kind=="Gameplay" then
  local base=assert(Config.Rewards[operation.reward],"Unknown gameplay reward")
  local active=false
  for _,claim in pairs(data.claims) do
   if operation.at>=claim.at and operation.at<claim.expires then active=true; break end
  end
  local multiplier=active and Config.DailyMultiplier or 1
  earnedDay=Rules.day(operation.at,operation.zone or current.zone)
  local key=tostring(earnedDay)
  local available=math.max(0,Config.GameplayDailyCap-(data.budgets[key] or 0))
  if available==0 then return data,{kind="Capped",amount=0} end
  receipt.amount=grant(data,math.min(available,math.floor(base*multiplier)))
  data.budgets[key]=(data.budgets[key] or 0)+receipt.amount
 else error("Unknown progression operation") end
 receipt.levelAfter=data.level
 -- Retain every non-expired receipt. Never evict a live idempotency key to make room.
 local count=0
 for id,item in pairs(data.receipts) do
  if now-item.at>Config.ReceiptSeconds then data.receipts[id]=nil else count+=1 end
 end
 assert(count<Config.MaximumReceipts,"Progression receipt capacity reached")
 data.receipts[operation.id]=receipt
 for id,claim in pairs(data.claims) do if claim.at<now-Config.HistoryDays*86400 then data.claims[id]=nil end end
 for key in pairs(data.budgets) do if tonumber(key)<today-3 then data.budgets[key]=nil end end
 return data,receipt
end
function Rules.snapshot(data,now)
 data=copy(data)
 local current=calendar(data,now)
 local today=current.day
 local eligibleAt=nextClaim(data,current.zone)
 local streak=data.lastClaimAt and today<=Zones.day(eligibleAt,current.zone) and data.streak or 0
 local completed,active,weeklyToday={},false,false
 for _,claim in pairs(data.claims) do
  local day=Zones.day(claim.at,current.zone)
  if claim.at<=now then completed[day]=true end
  if claim.at<=now and now<claim.expires then active=true end
  if claim.weekly and day==today then weeklyToday=true end
 end
 local monday=today-(today+3)%7
 local days={}
 for offset=0,6 do
  local day=monday+offset
  local done=day<=today and completed[day]==true
  table.insert(days,{date=os.date("!%Y-%m-%d",day*86400),label=os.date("!%a",day*86400),
   shortDate=os.date("!%b %d",day*86400),today=day==today,
   status=done and (day==today and "TodayDone" or "Done") or day<today and "Missed" or day==today and "Available" or "Upcoming"})
 end
 return {ready=true,level=data.level,xp=data.xp,required=Rules.required(data.level),totalXP=data.totalXP,
  spendableXP=data.spendableXP,
  inventory=data.inventory and table.clone(data.inventory) or nil,
  equipped=data.equipped and table.clone(data.equipped) or nil,
  streak=streak,cycle=streak>0 and (streak-1)%Config.StreakDays+1 or 0,weeklyAwards=data.weeklyAwards,
  weeklyCompletedToday=weeklyToday,
  weeklyPreview=math.floor(Rules.required(data.level)*Config.WeeklyFraction),weeklyPercent=Config.WeeklyFraction*100,
  dailyXP=Config.DailyXP,configuredMultiplier=Config.DailyMultiplier,
  dailyBonusPercent=math.floor((Config.DailyMultiplier-1)*100+0.5),
  multiplier=active and Config.DailyMultiplier or 1,multiplierUntil=data.multiplierUntil,
  todayDate=current.date,todayLabel=current.label,timeZone=current.zone,timeZones=Zones.options(),
  utcOffsetMinutes=current.offset/60,
  pendingUtcOffsetMinutes=data.pendingTimeZone and now<data.zoneEffectiveAt and Zones.offset(now,data.pendingTimeZone)/60 or nil,
  pendingTimeZone=data.pendingTimeZone and now<data.zoneEffectiveAt and data.pendingTimeZone or nil,
  zoneChangeDays=Config.TimeZoneChangeDays,
  zoneEffectiveAt=data.zoneEffectiveAt,zoneChangeAvailableAt=data.zoneChangedAt>0 and data.zoneChangedAt+Config.TimeZoneChangeDays*86400 or 0,
  eligibleAt=eligibleAt,canCheckIn=now>=eligibleAt,
  checkedIn=completed[today]==true,nextReset=current.nextReset,serverNow=now,days=days,
  resetLabel=os.date("!%b %d, %H:%M",current.nextReset+Zones.offset(current.nextReset,current.zone)).." / "..current.zone}
end
return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">ProgressionService</string>
          <string name="Source"><![CDATA[local Config=require(script.Parent:WaitForChild("ProgressionConfig"))
local Rules=require(script.Parent:WaitForChild("ProgressionRules"))
local Repository=require(script.Parent:WaitForChild("ProgressionRepository"))
local Service={}
function Service.start(network,lobby)
 -- Module-level reuse also protects the prompt and lifecycle connections from duplicate starts.
 if Service.active then return Service.active end
 local Players=game:GetService("Players")
 local HttpService=game:GetService("HttpService")
 local function now() return DateTime.now().UnixTimestampMillis/1000 end
 local remote=network:FindFirstChild("Progression") or Instance.new("RemoteEvent")
 remote.Name="Progression"; remote.Parent=network
 local api={entries={},closing=false,connections={},subscribers={}}
 Service.active=api
 local store=game:GetService("DataStoreService"):GetDataStore(Config.StoreName)
 local repository=Repository.new(store,now)
 local function guid() return HttpService:GenerateGUID(false) end
 local function connect(signal,callback) table.insert(api.connections,signal:Connect(callback)) end
 local desk=lobby:FindFirstChild("Reception stone top",true) or lobby:FindFirstChild("Reception desk",true)
 assert(desk and desk:IsA("BasePart"),"Daily check-in reception table not found")
 local attachment=desk:FindFirstChild("DailyCheckInPoint") or Instance.new("Attachment")
 attachment.Name="DailyCheckInPoint"; attachment.Position=Vector3.new(0,desk.Size.Y/2+0.7,desk.Size.Z/2+1); attachment.Parent=desk
 local prompt=attachment:FindFirstChild("DailyCheckIn") or Instance.new("ProximityPrompt")
 prompt.Name="DailyCheckIn"; prompt.ActionText="Daily Check-In"; prompt.ObjectText="Paddle Up Club"
 prompt.KeyboardKeyCode=Enum.KeyCode.E; prompt.GamepadKeyCode=Enum.KeyCode.ButtonX
 prompt.HoldDuration=0; prompt.MaxActivationDistance=Config.PromptDistance; prompt.RequiresLineOfSight=false; prompt.Parent=attachment
 local function near(player)
  local character=player.Character
  local root=character and character:FindFirstChild("HumanoidRootPart")
  local humanoid=character and character:FindFirstChildOfClass("Humanoid")
  return player.Parent==Players and player:GetAttribute("SessionMode")=="Lobby"
   and root and humanoid and humanoid.Health>0 and (root.Position-attachment.WorldPosition).Magnitude<=Config.PromptDistance
 end
 local function publish(entry,notice,open)
  local player=entry.player
  if player.Parent~=Players then return end
  local publishedAt=now()
  local snapshot={ready=false}
  if entry.data then
   local ok,result=pcall(Rules.snapshot,entry.data,publishedAt)
   if ok then snapshot=result else entry.failed=true; entry.failure=Repository.errorInfo(result) end
  end
  snapshot.ready=entry.data~=nil and not entry.failed
  snapshot.pending=entry.running==true or not entry.failed and #entry.queue>0
  snapshot.pendingSince=entry.workStartedAt
  snapshot.status=entry.running and (entry.data and not entry.failed and "Saving" or "Loading")
   or entry.failed and "Error" or entry.data and "Ready" or "Loading"
  snapshot.error=snapshot.status=="Error" and entry.failure.message or nil
  snapshot.errorCode=entry.failure and entry.failure.code or nil
  snapshot.serverNow=publishedAt
  snapshot.retryAfter=math.max(0,(entry.lastRetry or -math.huge)+Config.ManualRetrySeconds-publishedAt)
  snapshot.canRetry=snapshot.status=="Error" and snapshot.retryAfter==0
  entry.revision+=1
  if snapshot.ready then
   player:SetAttribute("Level",snapshot.level); player:SetAttribute("XP",snapshot.xp)
   player:SetAttribute("XPRequired",snapshot.required)
   player:SetAttribute("TotalEarnedXP",snapshot.totalXP); player:SetAttribute("SpendableXP",snapshot.spendableXP)
  end
  player:SetAttribute("XPDataReady",snapshot.ready)
  remote:FireClient(player,{state=snapshot,notice=notice,open=open==true,
   revision=entry.revision,ackId=entry.ackId,openId=entry.openId})
  for callback in pairs(api.subscribers) do
   local ok,err=pcall(callback,entry)
   if not ok then warn("Profile subscriber failed: "..tostring(err)) end
  end
 end
 local startWorker
 local function enqueue(entry,operation)
  if #entry.queue>=Config.MaximumPending then return false end
  table.insert(entry.queue,operation)
  startWorker(entry)
  return true
 end
 startWorker=function(entry,manual)
  if entry.running or #entry.queue==0 then return end
  if entry.failure and not entry.failure.retryable and not manual then return end
  if entry.nextRetry and now()<entry.nextRetry and not api.closing then return end
  entry.running=true; entry.workStartedAt=now()
  publish(entry)
  task.spawn(function()
   while #entry.queue>0 do
    local operation=entry.queue[1]
    local data,receipt,err=repository:commit(entry.player.UserId,operation,api.deadline)
    if not data then
     entry.failed=true; entry.failure=Repository.errorInfo(err); entry.nextRetry=now()+Config.RetryInterval
     warn("Paddle Up progression transaction failed for "..entry.player.UserId..": "..tostring(err))
     break
    end
    entry.data=data; entry.failed=false; entry.failure=nil; entry.nextRetry=nil; entry.lastVerified=now()
    table.remove(entry.queue,1)
    if operation.kind=="Load" then entry.loading=false end
    local notice
    local shop=operation.kind=="ShopBuy" or operation.kind=="ShopEquip" or operation.kind=="ShopUnequip"
    if shop then entry.shopResult={id=operation.id,kind=receipt and receipt.kind,item=operation.item,category=operation.category} end
    if operation.kind~="Load" and not shop then
     local kind=receipt and receipt.kind
     notice={amount=receipt and receipt.amount or 0,weekly=receipt and receipt.weekly or 0,
      levelUp=receipt and receipt.levelAfter and receipt.levelBefore and receipt.levelAfter>receipt.levelBefore or false,
      level=data.level,
      message=kind=="ZoneCooldown" and "Time-zone changes are limited to once every "..Config.TimeZoneChangeDays.." days."
       or kind=="ZoneUnchanged" and "That time zone is already selected."
       or operation.kind=="SetTimeZone" and (data.pendingTimeZone and "Time-zone change saved for your next daily reset." or "Time zone saved.")
       or kind=="Already" and "Already checked in for this reward day!" or kind=="Reset" and "A new day started in your selected time zone. Please check in again."
       or kind=="Expired" and "This reward request expired." or operation.kind=="CheckIn" and "Checked in! Your daily XP boost is active."
       or receipt and receipt.amount==0 and "Daily gameplay XP limit reached." or nil}
    end
    publish(entry,notice)
   end
   entry.running=false; entry.workStartedAt=nil
   if entry.player.Parent==Players then publish(entry)
   elseif #entry.queue==0 then api.entries[entry.player]=nil end
  end)
 end
 local function load(entry)
  if entry.loading then startWorker(entry); return end
  entry.loading=true
  if not enqueue(entry,{kind="Load",id=guid(),at=now()}) then entry.loading=false end
 end
 local function add(player)
  if api.closing or api.entries[player] then return end
  local entry={player=player,queue={},running=false,failed=false,requests={},lastPrompt=-math.huge,
   lastRetry=-math.huge,revision=0,ackId=0,openId=0}
  api.entries[player]=entry; player:SetAttribute("XPDataReady",false)
  load(entry)
 end
 function api:award(player,reward,eventId)
  if self.closing or not Config.Rewards[reward] then return false end
  local entry=self.entries[player]
  -- No optimistic rewards or replacement defaults when loading/validation fails.
  if not entry or not entry.data or entry.failed or player.Parent~=Players then return false end
  local earnedAt=now()
  local zone=Rules.zone(entry.data,earnedAt)
  local today=Rules.day(earnedAt,zone)
  if (entry.data.budgets[tostring(today)] or 0)>=Config.GameplayDailyCap then
   if entry.capNoticeDay~=today then
    entry.capNoticeDay=today; publish(entry,{message="Daily gameplay XP limit reached. More XP is available after your next daily reset."})
   end
   return false
  end
  return enqueue(entry,{kind="Gameplay",id=eventId,reward=reward,at=earnedAt,zone=zone})
 end
 -- Trusted server entry points. Clients reach these only through ShopService's proximity/session checks.
 function api:subscribe(callback)
  self.subscribers[callback]=true
  for _,entry in pairs(self.entries) do callback(entry) end
  return function() self.subscribers[callback]=nil end
 end
 function api:shop(player,kind,item,category)
  local entry=self.entries[player]
  if self.closing or not entry or not entry.data or entry.failed or player.Parent~=Players then return false end
  if kind~="ShopBuy" and kind~="ShopEquip" and kind~="ShopUnequip" then return false end
  for _,op in ipairs(entry.queue) do
   if op.kind=="ShopBuy" or op.kind=="ShopEquip" or op.kind=="ShopUnequip" then return false end
  end
  return enqueue(entry,{kind=kind,item=item,category=category,id=guid(),at=now()})
 end
 function api:refreshShop(player,retry)
  local entry=self.entries[player]; if not entry or self.closing then return end
  if retry and now()-entry.lastRetry>=Config.ManualRetrySeconds and not entry.running then
   entry.lastRetry=now(); entry.nextRetry=nil
   if #entry.queue>0 then startWorker(entry,true) else load(entry) end
  elseif not entry.lastVerified or now()-entry.lastVerified>=Config.RefreshSeconds then load(entry) end
 end
 connect(Players.PlayerAdded,add)
 connect(Players.PlayerRemoving,function(player)
  local entry=api.entries[player]
  if not entry then return end
  entry.openUntil=nil; entry.departedAt=now(); startWorker(entry)
  if not entry.running and #entry.queue==0 then api.entries[player]=nil end
 end)
 connect(prompt.Triggered,function(player)
  local entry=api.entries[player]
  if api.closing or not entry or not near(player) or now()-entry.lastPrompt<Config.RemoteCooldown then return end
  if entry.openUntil and now()<entry.openUntil then return end
  entry.openId+=1
  entry.lastPrompt=now(); entry.openUntil=now()+Config.InteractionSeconds
  publish(entry,nil,true)
  -- Refresh periodically; repeated prompt interactions cannot consume a write per opening.
  if not entry.lastVerified or now()-entry.lastVerified>=Config.RefreshSeconds then load(entry) end
 end)
 connect(remote.OnServerEvent,function(player,action,requestId,openId,value)
  local entry=api.entries[player]
  if api.closing or not entry or type(action)~="string" then return end
  if requestId~=nil then
   if type(requestId)~="number" or requestId%1~=0 or requestId<=entry.ackId or requestId>1e9 then return end
   entry.ackId=requestId
  end
  if action=="Close" then
   if openId==entry.openId then entry.openUntil=nil end
   return
  end
  if action~="Sync" and action~="Claim" and action~="Retry" and action~="SetTimeZone" and action~="AutoTimeZone" then return end
  if now()-(entry.requests[action] or -math.huge)<Config.RemoteCooldown then publish(entry); return end
  entry.requests[action]=now()
  if action=="Sync" then
   if not entry.data then load(entry) end
   publish(entry)
  elseif action=="Retry" then
   if now()-entry.lastRetry<Config.ManualRetrySeconds or entry.running then publish(entry); return end
   entry.lastRetry=now(); entry.nextRetry=nil
   if #entry.queue>0 then startWorker(entry,true)
   elseif not entry.data or entry.failed then load(entry)
   end
   publish(entry)
  elseif action=="AutoTimeZone" then
   -- Treat device offset as a bounded preference. Dates, cooldowns, claims,
   -- deferred activation, and all reward timestamps remain server-owned.
   if not entry.data or entry.failed or entry.running or #entry.queue>0 then publish(entry); return end
   local zone=Rules.timeZoneFromOffset(value)
   if not zone then publish(entry); return end
   if enqueue(entry,{kind="SetTimeZone",id=guid(),at=now(),zone=zone,automatic=true}) then publish(entry) end
  elseif action=="SetTimeZone" then
   if openId~=entry.openId then publish(entry); return end
   if not entry.data or entry.failed or not entry.openUntil or now()>entry.openUntil or not near(player) then publish(entry); return end
   if not Rules.validTimeZone(value) then publish(entry,{message="Select a supported time zone."}); return end
   for _,operation in ipairs(entry.queue) do if operation.kind=="SetTimeZone" then return end end
   if enqueue(entry,{kind="SetTimeZone",id=guid(),at=now(),zone=value}) then publish(entry) end
  elseif action=="Claim" then
   if openId~=nil and openId~=entry.openId then publish(entry); return end
   if not entry.openUntil or now()>entry.openUntil or not near(player) then
    publish(entry,{message="Return to the check-in desk and press E."}); return
   end
   if not entry.data or entry.failed then publish(entry); return end
   local claimAt=now()
   if not Rules.canClaim(entry.data,claimAt) then
    publish(entry,{message="Already checked in today!"}); return
   end
   -- One queued claim at a time, including failures with an unknown backend outcome.
   for _,operation in ipairs(entry.queue) do if operation.kind=="CheckIn" then return end end
   if enqueue(entry,{kind="CheckIn",id=guid(),at=claimAt}) then publish(entry) end
  end
 end)
 local maintenance=task.spawn(function()
  while not api.closing do
   task.wait(5)
   for player,entry in pairs(api.entries) do
    if entry.departedAt and now()-entry.departedAt>Config.ShutdownSeconds and not entry.running then
     if #entry.queue>0 then warn("Unconfirmed progression operation abandoned after disconnect for "..player.UserId) end
     api.entries[player]=nil
    else
     startWorker(entry)
     -- Recompute midnight expiry even when no gameplay or UI requests occur.
     if entry.data and player.Parent==Players then publish(entry) end
    end
   end
  end
 end)
 game:BindToClose(function()
  if api.closing then return end
  api.closing=true; api.deadline=now()+Config.ShutdownSeconds; prompt.Enabled=false
  for _,connection in ipairs(api.connections) do connection:Disconnect() end
  pcall(task.cancel,maintenance)
  repeat
   local pending=false
   for _,entry in pairs(api.entries) do
    startWorker(entry)
    if entry.running or #entry.queue>0 and (not entry.failure or entry.failure.retryable) then pending=true end
   end
   if not pending then break end
   task.wait(0.25)
  until now()>=api.deadline
  for player,entry in pairs(api.entries) do
   if #entry.queue>0 then warn("Shutdown ended with an unconfirmed progression operation for "..player.UserId) end
  end
 end)
 for _,player in ipairs(Players:GetPlayers()) do add(player) end
 return api
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">ServeRotation</string>
          <string name="Source"><![CDATA[-- Side-out scoring and service positions, independent of characters and physics.
-- Server numbers are turns within a possession, not permanent player numbers.
local Rotation={}
Rotation.__index=Rotation
local function index(side) return side==1 and 1 or 2 end
local function contains(team,id) return id~=nil and table.find(team,id)~=nil end
local function other(team,id) return team[1]==id and team[2] or team[1] end

function Rotation.new()
 return setmetatable({score={0,0},teams={[1]={},[-1]={}},right={},side=1,number=1,opening=true},Rotation)
end

function Rotation:setTeams(home,away)
 for _,side in ipairs({1,-1}) do
  local team=table.clone(side==1 and home or away)
  assert(#team<=2,"A court supports at most two players per team")
  local previous=self.teams[side]
  if #previous==1 and #team==2 and contains(team,previous[1]) then
   self.right[side]=self.score[index(side)]%2==0 and previous[1] or other(team,previous[1])
  elseif not contains(team,self.right[side]) then self.right[side]=team[1] end
  self.teams[side]=team
 end
 if #self.teams[self.side]==0 then self.side=-self.side end
 local team=self.teams[self.side]
 if not contains(team,self.serverId) then self.serverId=self.right[self.side]; self.number=1 end
 if #team<2 then self.number=1
 elseif self.opening then self.number=2 end
end

function Rotation:serveX()
 local team=self.teams[self.side]
 local right=#team<2 and self.score[index(self.side)]%2==0
  or (#team==2 and self.serverId==self.right[self.side])
 return self.side*(right and 10 or -10)
end

function Rotation:receiverId()
 local side=-self.side
 local team=self.teams[side]
 if #team<2 then return team[1] end
 return self:serveX()*self.side>0 and self.right[side] or other(team,self.right[side])
end

function Rotation:award(winner)
 if winner==self.side then
  self.score[index(winner)]+=1
  if #self.teams[winner]==2 then self.right[winner]=other(self.teams[winner],self.right[winner]) end
  return "point"
 end
 local team=self.teams[self.side]
 if #team==2 and self.number==1 then
  self.serverId=other(team,self.serverId); self.number=2
  return "secondServer"
 end
 self.opening=false; self.side=-self.side; self.number=1
 self.serverId=self.right[self.side]
 return "sideOut"
end

function Rotation:reset()
 self.score={0,0}; self.side=1; self.opening=true
 for _,side in ipairs({1,-1}) do self.right[side]=self.teams[side][1] end
 self.serverId=self.right[1]; self.number=#self.teams[1]==2 and 2 or 1
end

return Rotation
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">ShopRules</string>
          <string name="Source"><![CDATA[-- Mutates only a transaction-local copy. Called inside the existing profile UpdateAsync transform.
local Catalog=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("CosmeticCatalog"))
local Rules={}
local MAX=9007199254740991
function Rules.isOperation(kind) return kind=="ShopBuy" or kind=="ShopEquip" or kind=="ShopUnequip" end
function Rules.validate(data)
 assert(type(data.spendableXP)=="number" and data.spendableXP%1==0 and data.spendableXP>=0 and data.spendableXP<=MAX,"Invalid shop balance")
 assert(type(data.inventory)=="table" and type(data.equipped)=="table","Invalid inventory")
 for id,owned in pairs(data.inventory) do assert(type(id)=="string" and #id<=80 and owned==true,"Invalid owned cosmetic") end
 for category,id in pairs(data.equipped) do
  assert(Catalog.Labels[category] and type(id)=="string" and data.inventory[id]==true,"Invalid equipped cosmetic")
  assert(Catalog.ById[id] and Catalog.ById[id].category==category,"Invalid equipment category")
 end
end
function Rules.apply(data,operation)
 if operation.kind=="ShopUnequip" then
  if not Catalog.Labels[operation.category] then return "InvalidItem" end
  data.equipped[operation.category]=nil; return "Unequipped"
 end
 local item=type(operation.item)=="string" and Catalog.ById[operation.item]
 if not item then return "InvalidItem" end
 if operation.kind=="ShopBuy" then
  if data.inventory[item.id] then return "Owned" end
  if data.spendableXP<item.price then return "Insufficient" end
  data.spendableXP-=item.price; data.inventory[item.id]=true
  return "Purchased"
 elseif operation.kind=="ShopEquip" then
  if not data.inventory[item.id] then return "NotOwned" end
  data.equipped[item.category]=item.id; return "Equipped"
 end
 error("Unknown shop operation")
end
return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[local Catalog=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("CosmeticCatalog"))
local Assets=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("CosmeticAssets"))
local Shop={}
function Shop.start(network,lobby,progression)
 local Players=game:GetService("Players")
 local Http=game:GetService("HttpService")
 local remote=Instance.new("RemoteEvent"); remote.Name="Shop"; remote.Parent=network
 local counter=assert(lobby:FindFirstChild("Boutique stone top",true),"Existing boutique counter is missing")
 local point=Instance.new("Attachment"); point.Name="ShopInteraction"; point.Position=Vector3.new(0,1.4,2.8); point.Parent=counter
 local prompt=Instance.new("ProximityPrompt"); prompt.Name="OpenShop"; prompt.ActionText="Browse Goods"; prompt.ObjectText="PaddleUp Goods"
 prompt.KeyboardKeyCode=Enum.KeyCode.E; prompt.GamepadKeyCode=Enum.KeyCode.ButtonX
 prompt.MaxActivationDistance=12; prompt.RequiresLineOfSight=false; prompt.HoldDuration=0; prompt.Parent=point
 -- Real catalog samples on the counter; built with exactly the equipped paddle builder.
 local display=Instance.new("Model"); display.Name="ShopCatalogDisplay"; display.Parent=lobby
 for i,id in ipairs({"paddle_porcelain","paddle_tour","paddle_afterglow","paddle_confetti","paddle_prism","paddle_lotus"}) do
  local sample=Assets.preview(id); sample:ScaleTo(0.46)
  sample:PivotTo(counter.CFrame*CFrame.new((i-3.5)*1.2,1.15,0)*CFrame.Angles(0,math.pi,0)); sample.Parent=display
 end
 local sign=Instance.new("Part"); sign.Name="Goods welcome plaque"; sign.Size=Vector3.new(7.6,0.75,0.05)
 sign.CFrame=counter.CFrame*CFrame.new(0,-0.65,2.24); sign.Anchored=true; sign.CanCollide=false; sign.CanTouch=false; sign.CanQuery=false
 sign.Color=Color3.fromRGB(32,63,55); sign.Parent=display
 local gui=Instance.new("SurfaceGui"); gui.Face=Enum.NormalId.Back; gui.PixelsPerStud=60; gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud; gui.Parent=sign
 local label=Instance.new("TextLabel"); label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1
 label.Text="GOODS / E TO BROWSE"; label.TextColor3=Color3.fromRGB(237,218,168); label.Font=Enum.Font.GothamBold; label.TextScaled=true; label.Parent=gui
 local sessions={}
 local function near(player)
  local c=player.Character; local root=c and c:FindFirstChild("HumanoidRootPart"); local h=c and c:FindFirstChildOfClass("Humanoid")
  return player.Parent==Players and player:GetAttribute("SessionMode")=="Lobby" and root and h and h.Health>0 and (root.Position-point.WorldPosition).Magnitude<=12
 end
 local function send(player,open,message)
  local session=sessions[player]; if not session then return end
  local entry=progression.entries[player]
  local data=entry and entry.data
  session.revision+=1
  remote:FireClient(player,{open=open==true,token=session.token,revision=session.revision,ack=session.ack,
   ready=data~=nil and not entry.failed,pending=entry and (entry.running or #entry.queue>0) or false,
   error=entry and entry.failed and entry.failure and entry.failure.message or nil,
   level=data and data.level,totalXP=data and data.totalXP,xp=data and data.xp,
   required=data and require(script.Parent:WaitForChild("ProgressionRules")).required(data.level),
   balance=data and data.spendableXP,inventory=data and table.clone(data.inventory) or {},
   equipped=data and table.clone(data.equipped) or {},result=entry and entry.shopResult,message=message})
 end
 local function sessionFor(player)
  if not sessions[player] then sessions[player]={revision=0,ack=0,last=-math.huge,lastPrompt=-math.huge} end
  return sessions[player]
 end
 prompt.Triggered:Connect(function(player)
  if progression.closing or not near(player) then return end
  local s=sessionFor(player); local now=os.clock()
  if now-s.lastPrompt<1 then return end
  s.lastPrompt=now; s.token=Http:GenerateGUID(false); s.expires=now+180
  send(player,true); progression:refreshShop(player)
 end)
 remote.OnServerEvent:Connect(function(player,action,requestId,token,value)
  if progression.closing or type(action)~="string" then return end
  local s=sessionFor(player); local now=os.clock()
  if type(requestId)~="number" or requestId%1~=0 or requestId<=s.ack or requestId>1e9 then return end
  if action=="Close" then if token==s.token then s.expires=nil end; return end
  if action~="Sync" and action~="Retry" and action~="Buy" and action~="Equip" and action~="Unequip" then return end
  if now-s.last<0.4 then
   s.ack=requestId
   if not s.lastRateFeedback or now-s.lastRateFeedback>=0.4 then
    s.lastRateFeedback=now; send(player,false,"Please wait a moment before another shop action.")
   end
   return
  end
  s.last=now; s.ack=requestId
  if action=="Sync" then send(player); return end
  if token~=s.token or not s.expires or now>s.expires or not near(player) then
   send(player,false,"Return to PaddleUp Goods and press E to continue."); return
  end
  if action=="Retry" then progression:refreshShop(player,true); send(player); return end
  if type(value)~="string" or #value>80 then send(player,false,"Choose a valid item."); return end
  if action=="Unequip" then
   if not Catalog.Labels[value] then return end
  elseif not Catalog.ById[value] then send(player,false,"That item is unavailable."); return end
  local ok
  if action=="Unequip" then ok=progression:shop(player,"ShopUnequip",nil,value)
  else ok=progression:shop(player,"Shop"..action,value,nil) end
  if not ok then send(player,false,"A save is pending or your profile is unavailable. Wait or Retry.") else send(player) end
 end)
 progression:subscribe(function(entry) if sessions[entry.player] then send(entry.player) end end)
 Players.PlayerRemoving:Connect(function(player) sessions[player]=nil end)
 return {prompt=prompt,point=point,remote=remote,near=near}
end
return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">Spectator</string>
          <string name="Source"><![CDATA[-- Presentation only; admission and match membership remain in the existing Session flow.
local Spectator={}
local active={}
local slots={}
local function snapshot(instance)
 if instance:IsA("BasePart") then
  return {Transparency=instance.Transparency,CanCollide=instance.CanCollide,CanTouch=instance.CanTouch,CanQuery=instance.CanQuery,CastShadow=instance.CastShadow,Anchored=instance.Anchored}
 elseif instance:IsA("Decal") then return {Transparency=instance.Transparency}
 elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam") or instance:IsA("BillboardGui") then return {Enabled=instance.Enabled} end
end
function Spectator.leave(player)
 local state=active[player]; if not state then return end
 active[player]=nil; slots[state.slot]=nil
 state.connection:Disconnect()
 if state.track then state.track:Stop(0) end
 state.clone:Destroy()
 for instance,properties in pairs(state.saved) do
  if instance.Parent then for key,value in pairs(properties) do instance[key]=value end end
 end
 local h=state.character:FindFirstChildOfClass("Humanoid")
 if h then h.DisplayDistanceType=state.display; h.AutoRotate=state.rotate end
end
function Spectator.enter(player,character)
 Spectator.leave(player)
 local slot=1; while slots[slot] do slot+=1 end; slots[slot]=true
 local wasArchivable=character.Archivable; character.Archivable=true
 local clone=character:Clone(); character.Archivable=wasArchivable
 clone.Name=player.DisplayName.." (Spectator)"
 clone:SetAttribute("SpectatorUserId",player.UserId)
 for _,item in ipairs(clone:GetDescendants()) do
  if item:IsA("LuaSourceContainer") or item:IsA("Tool") or item.Name=="PaddleFace" or item.Name=="PaddleGrip" then item:Destroy() end
 end
 local h=clone:FindFirstChildOfClass("Humanoid")
 if h then h.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None; h.AutoRotate=false; h.EvaluateStateMachine=false end
 -- Reuse the court's lounge benches; no seat instances or seat welds are created.
 local id=player:GetAttribute("CourtId") or 0
 local court=workspace:FindFirstChild(id==0 and "PaddleUp" or "PaddleUpCourt"..id)
 local benches={}
 if court then
  for _,item in ipairs(court:GetDescendants()) do
   if item:IsA("BasePart") and item.Name=="Lounge seat" then table.insert(benches,item) end
  end
 end
 table.sort(benches,function(a,b) return a.Position.Z<b.Position.Z end)
 local cr=clone:FindFirstChild("HumanoidRootPart")
 local bench=benches[(slot-1)%math.max(1,#benches)+1]
 local function positionClone()
  if not bench or not cr then return end
  local row=math.floor((slot-1)/#benches)
  -- Three generous positions per ten-stud bench, centered along its long axis.
  local offset=({0,-3,3})[row%3+1]
  local thigh=clone:FindFirstChild("LeftUpperLeg") or clone:FindFirstChild("Left Leg")
  local inset=thigh and thigh.Size.Y*0.65 or 1
  local front=math.max(0,bench.Size.Z/2-inset)
  local center=bench.CFrame:PointToWorldSpace(Vector3.new(offset,bench.Size.Y/2,front))
  local forward=-bench.CFrame.LookVector
  local toward=Vector3.new(forward.X,0,forward.Z).Unit
  local pelvis=clone:FindFirstChild("LowerTorso") or clone:FindFirstChild("Torso")
  local height=pelvis and pelvis.Size.Y/2 or 1
  cr.CFrame=CFrame.lookAt(center+Vector3.yAxis*height,center+Vector3.yAxis*height+toward)
 end
 for _,item in ipairs(clone:GetDescendants()) do
  if item:IsA("BasePart") then
   item.Anchored=item==cr; item.Massless=true
   item.CanCollide=false; item.CanTouch=false; item.CanQuery=false
  elseif item:IsA("Motor6D") then item.Transform=CFrame.identity end
 end
 positionClone()
 clone.Parent=court or workspace
 -- Parenting a Humanoid initializes torso collision flags; clear them afterward.
 for _,item in ipairs(clone:GetDescendants()) do
  if item:IsA("BasePart") then item.CanCollide=false; item.CanTouch=false; item.CanQuery=false end
 end
 local animation=Instance.new("Animation")
 animation.Name="Spectator seated pose"
 -- Prefer the avatar's configured sit clip; Roblox's rig-specific sit is the fallback.
 local animate=character:FindFirstChild("Animate")
 local sit=animate and animate:FindFirstChild("sit")
 local source=sit and sit:FindFirstChildWhichIsA("Animation",true)
 animation.AnimationId=source and source.AnimationId or (h.RigType==Enum.HumanoidRigType.R6 and "rbxassetid://178130996" or "rbxassetid://2506281703")
 animation.Parent=clone
 local animator=h:FindFirstChildOfClass("Animator") or Instance.new("Animator",h)
 for _,track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end
 h.Sit=true
 local track=animator:LoadAnimation(animation)
 track.Priority=Enum.AnimationPriority.Action; track.Looped=true; track:Play(0)
 local realHumanoid=character:FindFirstChildOfClass("Humanoid")
 local state={character=character,clone=clone,track=track,slot=slot,saved={},display=realHumanoid.DisplayDistanceType,rotate=realHumanoid.AutoRotate}
 active[player]=state
 -- Let the Animator resolve the pose before fitting the thighs to the cushion.
 task.spawn(function()
  local deadline=os.clock()+5
  repeat task.wait() until track.Length>0 or not clone.Parent or os.clock()>deadline
  if active[player]~=state or not clone.Parent or not bench then return end
  track.TimePosition=math.min(0.1,track.Length/2); track:AdjustSpeed(0)
  game:GetService("RunService").Heartbeat:Wait()
  game:GetService("RunService").Heartbeat:Wait()
  if active[player]~=state or not clone.Parent then return end
  local lowest=math.huge
  for _,name in ipairs(h.RigType==Enum.HumanoidRigType.R15 and {"LeftUpperLeg","RightUpperLeg"} or {"Left Leg","Right Leg"}) do
   local thigh=clone:FindFirstChild(name)
   if thigh then
    local cf,size=thigh.CFrame,thigh.Size
    local radius=(math.abs(cf.RightVector.Y)*size.X+math.abs(cf.UpVector.Y)*size.Y+math.abs(cf.LookVector.Y)*size.Z)/2
    lowest=math.min(lowest,thigh.Position.Y-radius)
   end
  end
  if lowest<math.huge then
   local top=bench.Position.Y+bench.Size.Y/2
   cr.CFrame+=Vector3.yAxis*(top-lowest+0.03)
  end
 end)
 local function hide(item)
  local properties=snapshot(item); if not properties then return end
  state.saved[item]=properties
  if item:IsA("BasePart") then
   item.Transparency=1; item.CanCollide=false; item.CanTouch=false; item.CanQuery=false; item.CastShadow=false
   if item.Name=="HumanoidRootPart" then item.Anchored=true end
  elseif item:IsA("Decal") then item.Transparency=1 else item.Enabled=false end
 end
 state.connection=character.DescendantAdded:Connect(hide)
 for _,item in ipairs(character:GetDescendants()) do hide(item) end
 realHumanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None; realHumanoid.AutoRotate=false
 character:PivotTo(CFrame.new(0,185,600))
end
return Spectator
]]></string>
