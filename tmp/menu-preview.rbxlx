 place("SideTable",lounges,-22,0,74); place("TableLamp",lounges,-22,2.5,74)
 place("BallSculpture",reception,-24,0,-12)
 place("BallSculpture",reception,24,0,-12)
 for _,x in ipairs({-10,10}) do
  part(reception,"Club paddle pedestal",Vector3.new(3.5,2.5,3.5),Vector3.new(x,1.25,-20),P.ivory,Enum.Material.Marble)
  local paddle=place("DisplayPaddle",reception,x,2.5,-20)
  paddle["Forest paddle face"].Color=x<0 and P.blue or P.pink
 end
 art(shop,-60,11,5.4,7,5,true)
 -- Soft lavender upholstery and pale stone balance the navy club palette.
 local index=0
 for _,model in ipairs(lounges:GetDescendants()) do
  if model:IsA("Model") and model.Name=="Sofa" then
   index+=1
   local color=({P.ivory,P.upholstery,P.linen,P.beige,P.ivory})[(index-1)%5+1]
   for _,piece in ipairs(model:GetChildren()) do
    if piece:IsA("BasePart") and (piece.Name=="Upholstered base" or piece.Name=="Back cushion" or piece.Name=="Soft armrest" or piece.Name=="Sofa cushion") then piece.Color=color end
   end
  end
 end
 furniture.destroyTemplates()
 -- Swap only this generated lobby; saved older geometry is refreshed automatically.
 if old then old:Destroy() end
 root.Parent=workspace
 local spawn=workspace:FindFirstChildWhichIsA("SpawnLocation") or Instance.new("SpawnLocation")
 spawn.Name="SpawnLocation"; spawn.CFrame=Lobby.Spawn-Vector3.new(0,3.5,0)
 spawn.Size=Vector3.new(5,0.3,5); spawn.Transparency=1; spawn.CanCollide=false
 spawn.Neutral=true; spawn.Duration=0; spawn.Parent=workspace
 return configureLoading(require(script.Parent:WaitForChild("CitySurroundings")).build(Lobby.integrateCity(Lobby.encloseBuilding(Lobby.moveToFirstFloor(Lobby.lightInterior(root))))))
end
return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">LobbyFurniture</string>
          <string name="Source"><![CDATA[-- Anchored furniture blueprints. Built once per lobby, then cloned into named zones.
-- No animation loops, scripts, external assets, or gameplay dependencies.
local Furniture={}
Furniture.Palette={
 ivory=Color3.fromRGB(217,216,227), linen=Color3.fromRGB(202,199,216), beige=Color3.fromRGB(188,181,203), upholstery=Color3.fromRGB(166,157,190),
 forest=Color3.fromRGB(39,42,65), teal=Color3.fromRGB(43,123,134),
 walnut=Color3.fromRGB(82,67,83), brass=Color3.fromRGB(181,179,194),
 sage=Color3.fromRGB(130,157,131), ink=Color3.fromRGB(29,31,57),
 warm=Color3.fromRGB(255,246,235), blue=Color3.fromRGB(80,232,255),
 pink=Color3.fromRGB(255,85,200), purple=Color3.fromRGB(166,157,190), orange=Color3.fromRGB(255,145,55), rose=Color3.fromRGB(193,145,170),
}
function Furniture.new()
 local P=Furniture.Palette
 local templates={}
 local current
 local function part(name,size,pos,color,material,collide,class)
  local p=Instance.new(class or "Part")
  p.Name=name; p.Size=size; p.CFrame=CFrame.new(pos)
  p.Anchored=true; p.Color=color; p.Material=material or Enum.Material.SmoothPlastic
  p.CanCollide=collide==true; p.CanTouch=class=="Seat"; p.CanQuery=collide==true
  p.CastShadow=collide==true; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
  p.Parent=current
  return p
 end
 local function ball(name,size,pos,color,material)
  local p=part(name,size,pos,color,material)
  local mesh=Instance.new("SpecialMesh",p); mesh.MeshType=Enum.MeshType.Sphere
  return p
 end
 local function disc(name,diameter,height,pos,color,material,collide)
  local p=part(name,Vector3.new(height,diameter,diameter),pos,color,material,collide)
  p.Shape=Enum.PartType.Cylinder; p.CFrame*=CFrame.Angles(0,0,math.pi/2)
  return p
 end
 local function light(p,range,brightness)
  local l=Instance.new("PointLight",p); l.Color=P.warm
  l.Range=range; l.Brightness=brightness; l.Shadows=false
 end
 local function blueprint(name,build)
  current=Instance.new("Model"); current.Name=name
  build()
  current.WorldPivot=CFrame.identity
  templates[name]=current
 end
 local function legs(width,depth,height)
  for _,x in ipairs({-width/2+0.5,width/2-0.5}) do
   for _,z in ipairs({-depth/2+0.5,depth/2-0.5}) do
    part("Tapered walnut leg",Vector3.new(0.3,height,0.3),Vector3.new(x,height/2,z),P.walnut,Enum.Material.Wood)
   end
  end
 end
 local function seat(name,size,pos,color)
  local p=part(name,size,pos,color,Enum.Material.Fabric,true,"Seat")
  p:SetAttribute("LobbyFurniture",true)
  return p
 end
 blueprint("Sofa",function()
  legs(12,5,0.8)
  part("Upholstered base",Vector3.new(12,1,5),Vector3.new(0,1.1,0),P.forest,Enum.Material.Fabric,true)
  for _,x in ipairs({-3,3}) do
   seat("Sofa cushion",Vector3.new(5.2,0.65,4.2),Vector3.new(x,1.9,-0.2),P.teal)
   part("Back cushion",Vector3.new(5.2,2.8,1),Vector3.new(x,3,1.9),P.forest,Enum.Material.Fabric,true)
  end
  for _,x in ipairs({-5.9,5.9}) do
   part("Soft armrest",Vector3.new(1,2.5,5),Vector3.new(x,2.3,0),P.forest,Enum.Material.Fabric,true)
   local pillow=ball("Linen throw pillow",Vector3.new(2,2,0.9),Vector3.new(x*0.74,3,-0.1),x>0 and P.teal or P.rose,Enum.Material.Fabric)
   pillow.CFrame*=CFrame.Angles(0,0,x>0 and 0.15 or -0.15)
  end
  part("Sage blanket on cushion",Vector3.new(2.2,0.12,3.5),Vector3.new(-2.6,2.3,-0.3),P.sage,Enum.Material.Fabric)
  part("Blanket drape",Vector3.new(2.2,1.4,0.12),Vector3.new(-2.6,1.7,-2.25),P.sage,Enum.Material.Fabric)
 end)
 blueprint("LoungeChair",function()
  legs(4.8,4.8,0.8)
  part("Lounge base",Vector3.new(4.8,1,4.8),Vector3.new(0,1.1,0),P.walnut,Enum.Material.Wood,true)
  seat("Linen seat",Vector3.new(3.7,0.7,4),Vector3.new(0,1.95,-0.1),P.linen)
  local back=part("Linen back",Vector3.new(4,3,0.8),Vector3.new(0,3,1.95),P.linen,Enum.Material.Fabric,true)
  back.CFrame*=CFrame.Angles(math.rad(-8),0,0)
  for _,x in ipairs({-2.1,2.1}) do part("Walnut arm",Vector3.new(0.4,0.5,4.6),Vector3.new(x,2.7,0),P.walnut,Enum.Material.Wood,true) end
  ball("Sage cushion",Vector3.new(1.9,1.7,0.7),Vector3.new(0,2.7,1),P.sage,Enum.Material.Fabric)
 end)
 blueprint("CafeChair",function()
  legs(3.4,3.4,1.8)
  seat("Cafe seat",Vector3.new(3.4,0.5,3.4),Vector3.new(0,2,-0.1),P.linen)
  part("Curved look back",Vector3.new(3.4,2.5,0.6),Vector3.new(0,3.3,1.4),P.linen,Enum.Material.Fabric,true)
 end)
 blueprint("BarStool",function()
  disc("Stool foot",2.5,0.2,Vector3.new(0,0.1,0),P.ink,Enum.Material.Metal,true)
  part("Brass stem",Vector3.new(0.35,3,0.35),Vector3.new(0,1.6,0),P.brass,Enum.Material.Metal)
  disc("Footrest",1.8,0.15,Vector3.new(0,1.3,0),P.brass,Enum.Material.Metal)
  seat("Leather stool",Vector3.new(2.8,0.5,2.7),Vector3.new(0,3.25,0),P.upholstery)
  part("Stool back",Vector3.new(2.8,1.2,0.5),Vector3.new(0,4.1,1.15),P.upholstery,Enum.Material.Fabric,true)
 end)
 blueprint("CoffeeTable",function()
  legs(8,4.5,1.6)
  part("Walnut coffee table",Vector3.new(8,0.4,4.5),Vector3.new(0,1.8,0),P.ivory,Enum.Material.Marble,true)
  part("Brass edge",Vector3.new(8.1,0.1,4.6),Vector3.new(0,1.61,0),P.brass,Enum.Material.Metal)
 end)
 blueprint("SideTable",function()
  disc("Stone side table",3,0.3,Vector3.new(0,2.3,0),P.ivory,Enum.Material.Marble,true)
  part("Side table pedestal",Vector3.new(0.4,2.2,0.4),Vector3.new(0,1.1,0),P.brass,Enum.Material.Metal)
  disc("Side table base",2.2,0.2,Vector3.new(0,0.1,0),P.walnut,Enum.Material.Wood)
 end)
 blueprint("CafeTable",function()
  disc("Round cafe top",6.5,0.35,Vector3.new(0,3.1,0),P.ivory,Enum.Material.Marble,true)
  part("Cafe pedestal",Vector3.new(0.5,2.9,0.5),Vector3.new(0,1.45,0),P.brass,Enum.Material.Metal)
  disc("Cafe table foot",3,0.2,Vector3.new(0,0.1,0),P.ink,Enum.Material.Metal)
 end)
 blueprint("Books",function()
  for i,color in ipairs({P.linen,P.forest,P.sage}) do
   local p=part("Coffee table book",Vector3.new(2.1,0.22,1.6),Vector3.new(0,(i-0.5)*0.22,0),color)
   p.CFrame*=CFrame.Angles(0,math.rad(i*9-18),0)
  end
  part("Magazine pages",Vector3.new(1.5,0.08,1.9),Vector3.new(2,0.05,0),P.ivory)
 end)
 blueprint("Vase",function()
  ball("Ceramic vase",Vector3.new(1.1,1.5,1.1),Vector3.new(0,0.75,0),P.linen)
  disc("Vase neck",0.5,0.6,Vector3.new(0,1.6,0),P.linen)
  for _,x in ipairs({-0.35,0.15,0.4}) do
   part("Dried stem",Vector3.new(0.05,1.8,0.05),Vector3.new(x,2.5,0),P.walnut)
   ball("Sage sprig",Vector3.new(0.6,0.8,0.25),Vector3.new(x,3,0),P.sage)
  end
 end)
 blueprint("Candle",function()
  disc("Candle vessel",0.7,0.7,Vector3.new(0,0.35,0),P.linen)
  part("Warm candle tip",Vector3.new(0.12,0.18,0.12),Vector3.new(0,0.8,0),P.warm,Enum.Material.Neon)
 end)
 blueprint("TeaService",function()
  part("Walnut tray",Vector3.new(3,0.1,2),Vector3.new(0,0.08,0),P.walnut,Enum.Material.Wood)
  for _,x in ipairs({-0.75,0.75}) do
   disc("Saucer",1.1,0.1,Vector3.new(x,0.2,0),P.ivory)
   disc("Cup",0.7,0.7,Vector3.new(x,0.55,0),P.ivory)
   disc("Coffee",0.56,0.03,Vector3.new(x,0.91,0),P.walnut)
   part("Cup handle",Vector3.new(0.25,0.4,0.15),Vector3.new(x+0.42,0.55,0),P.ivory)
  end
 end)
 blueprint("TableLamp",function()
  disc("Lamp foot",1.2,0.15,Vector3.new(0,0.08,0),P.brass,Enum.Material.Metal)
  part("Lamp stem",Vector3.new(0.15,1.4,0.15),Vector3.new(0,0.8,0),P.brass,Enum.Material.Metal)
  disc("Linen shade",2,1.4,Vector3.new(0,2,0),P.linen,Enum.Material.Fabric)
  local bulb=part("Soft lamp glow",Vector3.new(1.5,0.08,1.5),Vector3.new(0,1.31,0),P.warm,Enum.Material.Neon)
  light(bulb,14,0.65)
 end)
 blueprint("FloorLamp",function()
  disc("Floor lamp foot",2.2,0.2,Vector3.new(0,0.1,0),P.ink,Enum.Material.Metal)
  part("Floor lamp stem",Vector3.new(0.17,8,0.17),Vector3.new(0,4.2,0),P.brass,Enum.Material.Metal)
  disc("Fabric floor shade",3.3,2.5,Vector3.new(0,8.5,0),P.linen,Enum.Material.Fabric)
  local bulb=part("Floor lamp glow",Vector3.new(2.6,0.1,2.6),Vector3.new(0,7.24,0),P.warm,Enum.Material.Neon)
  light(bulb,20,0.8)
 end)
 blueprint("Pendant",function()
  part("Pendant cord",Vector3.new(0.07,4,0.07),Vector3.new(0,2,0),P.ink)
  disc("Walnut pendant shade",3.6,1.1,Vector3.new(0,-0.4,0),P.walnut,Enum.Material.Wood)
  disc("Brass pendant rim",3.7,0.15,Vector3.new(0,-0.96,0),P.brass,Enum.Material.Metal)
  local diffuser=disc("Warm pendant diffuser",3.25,0.08,Vector3.new(0,-1.05,0),P.warm,Enum.Material.Neon)
  light(diffuser,23,0.75)
 end)
 blueprint("Sconce",function()
  part("Walnut wall plate",Vector3.new(1.5,4,0.25),Vector3.new(0,0,0),P.walnut,Enum.Material.Wood)
  part("Brass mount",Vector3.new(0.3,2,0.8),Vector3.new(0,0,0.45),P.brass,Enum.Material.Metal)
  local diffuser=part("Opal sconce",Vector3.new(0.8,2.8,0.6),Vector3.new(0,0,0.8),P.warm,Enum.Material.Neon)
  light(diffuser,19,0.6)
 end)
 blueprint("Plant",function()
  disc("Stone planter",4,3,Vector3.new(0,1.5,0),P.linen,Enum.Material.Concrete,true)
  disc("Planter brass foot",3.5,0.2,Vector3.new(0,0.1,0),P.brass,Enum.Material.Metal)
  disc("Planter soil",3.5,0.1,Vector3.new(0,3.05,0),P.walnut)
  part("Plant trunk",Vector3.new(0.35,6,0.35),Vector3.new(0,5.3,0),P.walnut,Enum.Material.Wood)
  for i=1,7 do
   local angle=i*math.pi*2/7
   local leaf=ball("Broad sage leaf",Vector3.new(2.6,0.6,5.8),Vector3.new(math.sin(angle)*1.7,7.8+(i%3)*0.6,math.cos(angle)*1.7),i%2==0 and P.sage or Color3.fromRGB(104,143,122))
   leaf.CFrame*=CFrame.Angles(0,angle,0)*CFrame.Angles(math.rad(-20),0,0)
  end
 end)
 blueprint("Bookshelf",function()
  part("Walnut cabinet back",Vector3.new(10,10,0.5),Vector3.new(0,5,0.8),P.walnut,Enum.Material.Wood,true)
  for _,x in ipairs({-5,5}) do part("Cabinet frame",Vector3.new(0.4,10,2.5),Vector3.new(x,5,0),P.walnut,Enum.Material.Wood,true) end
  for _,y in ipairs({0.4,3.4,6.4,9.8}) do
   part("Display shelf",Vector3.new(10,0.3,2.5),Vector3.new(0,y,0),P.walnut,Enum.Material.Wood,true)
  end
  for row=1,3 do
   for i=1,5 do
    part("Book spine",Vector3.new(0.45,1.6+(i%2)*0.5,1.1),Vector3.new(-4+i*0.65,row*3-1.6,-0.3),({P.ivory,P.sage,P.forest})[(i%3)+1])
   end
   ball("Shelf ceramic",Vector3.new(1.7,1.9,1.3),Vector3.new(2.8,row*3-1.45,-0.1),P.linen)
  end
 end)
 -- Boutique display props are anchored decorations, with no avatar/bot controllers.
 blueprint("DisplayPaddle",function()
  part("Walnut paddle grip",Vector3.new(0.35,1.3,0.35),Vector3.new(0,0.65,0),P.walnut,Enum.Material.Wood)
  ball("Forest paddle face",Vector3.new(2.2,2.7,0.3),Vector3.new(0,2.25,0),P.forest)
  part("Paddle brass stripe",Vector3.new(1.3,0.12,0.06),Vector3.new(0,2.25,0.19),P.brass,Enum.Material.Metal)
 end)
 blueprint("HangingJersey",function()
  part("Display hanger",Vector3.new(2.1,0.1,0.1),Vector3.new(0,0.15,0),P.brass,Enum.Material.Metal)
  part("Hanger hook",Vector3.new(0.1,0.6,0.1),Vector3.new(0,0.45,0),P.brass,Enum.Material.Metal)
  part("Jersey body",Vector3.new(2.5,2.8,0.3),Vector3.new(0,-1.35,0),P.teal,Enum.Material.Fabric)
  for _,x in ipairs({-1.6,1.6}) do
   local sleeve=part("Jersey sleeve",Vector3.new(1,1.35,0.3),Vector3.new(x,-0.6,0),P.teal,Enum.Material.Fabric)
   sleeve.CFrame*=CFrame.Angles(0,0,x>0 and 0.3 or -0.3)
  end
  part("Jersey collar",Vector3.new(0.7,0.2,0.12),Vector3.new(0,-0.03,0.2),P.ivory,Enum.Material.Fabric)
  part("Club crest",Vector3.new(0.35,0.4,0.08),Vector3.new(0.55,-0.7,0.23),P.brass)
 end)
 blueprint("DisplayOutfit",function()
  disc("Mannequin base",3,0.2,Vector3.new(0,0.1,0),P.brass,Enum.Material.Metal)
  for _,x in ipairs({-0.55,0.55}) do
   part("Walnut display shoe",Vector3.new(0.9,0.5,1.35),Vector3.new(x,0.45,-0.2),P.walnut)
   part("Skin display trouser leg",Vector3.new(0.8,2.2,0.8),Vector3.new(x,1.7,0),P.forest,Enum.Material.Fabric)
  end
  part("Skin display jacket",Vector3.new(2.5,2.8,1),Vector3.new(0,4.1,0),P.teal,Enum.Material.Fabric)
  for _,x in ipairs({-1.6,1.6}) do
   local arm=part("Display sleeve",Vector3.new(0.7,2.5,0.8),Vector3.new(x,4.1,0),P.teal,Enum.Material.Fabric)
   arm.CFrame*=CFrame.Angles(0,0,x>0 and 0.12 or -0.12)
   ball("Linen mannequin hand",Vector3.new(0.6,0.6,0.6),Vector3.new(x*1.1,2.7,0),P.linen)
  end
  part("Jacket zip",Vector3.new(0.05,2.3,0.06),Vector3.new(0,4.15,-0.53),P.brass,Enum.Material.Metal)
  part("Mannequin neck",Vector3.new(0.45,0.6,0.45),Vector3.new(0,5.7,0),P.linen)
  ball("Linen mannequin head",Vector3.new(1.3,1.6,1.2),Vector3.new(0,6.6,0),P.linen)
 end)
 blueprint("Trophy",function()
  part("Trophy stone base",Vector3.new(2,0.4,1.6),Vector3.new(0,0.2,0),P.ink,Enum.Material.Marble)
  part("Trophy brass stem",Vector3.new(0.3,1,0.3),Vector3.new(0,0.9,0),P.brass,Enum.Material.Metal)
  ball("Trophy cup",Vector3.new(1.7,1.4,1.7),Vector3.new(0,1.9,0),P.brass,Enum.Material.Metal)
  disc("Trophy rim",1.7,0.12,Vector3.new(0,2.6,0),P.brass,Enum.Material.Metal)
  disc("Cup interior",1.4,0.03,Vector3.new(0,2.67,0),P.walnut)
  for _,x in ipairs({-1.1,1.1}) do
   part("Trophy handle",Vector3.new(0.17,0.8,0.5),Vector3.new(x,2.1,0),P.brass,Enum.Material.Metal)
   for _,y in ipairs({1.7,2.5}) do
    part("Handle return",Vector3.new(0.5,0.13,0.5),Vector3.new(x*0.85,y,0),P.brass,Enum.Material.Metal)
   end
  end
  part("Engraved trophy plate",Vector3.new(1.1,0.18,0.05),Vector3.new(0,0.22,0.83),P.brass,Enum.Material.Metal)
 end)
 blueprint("Refreshments",function()
  part("Serving tray",Vector3.new(3.4,0.15,2.2),Vector3.new(0,0.1,0),P.brass,Enum.Material.Metal)
  for _,x in ipairs({-0.9,0.9}) do
   disc("Smoothie glass",0.75,1.4,Vector3.new(x,0.85,0),x<0 and P.pink or P.orange)
   part("Striped straw",Vector3.new(0.08,1,0.08),Vector3.new(x,1.8,0),P.ivory)
  end
  ball("Fresh orange",Vector3.new(0.8,0.8,0.8),Vector3.new(0,0.6,0.5),P.orange)
 end)
 blueprint("BallSculpture",function()
  disc("Marble sculpture plinth",4,2,Vector3.new(0,1,0),P.ivory,Enum.Material.Marble,true)
  ball("Golden pickleball",Vector3.new(3.5,3.5,3.5),Vector3.new(0,3.8,0),P.brass,Enum.Material.Metal)
  for i=1,8 do
   local a=i*math.pi/4
   ball("Pickleball perforation",Vector3.new(0.45,0.45,0.12),Vector3.new(math.sin(a)*1.1,3.8+math.cos(a)*1.1,1.42),P.ink)
  end
 end)
 local self={}
 function self.place(kind,parent,frame)
  local template=assert(templates[kind],"Unknown furniture: "..kind)
  local model=template:Clone()
  model:PivotTo(frame); model.Parent=parent
  return model
 end
 function self.destroyTemplates()
  for _,template in pairs(templates) do template:Destroy() end
  table.clear(templates)
 end
 return self
end
return Furniture
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">MapPreviews</string>
          <string name="Source"><![CDATA[-- Publish scenery snapshots so map thumbnails work without uploaded image assets.
local Previews={}
function Previews.publish(court,rooftop,moon)
 local folder=Instance.new("Folder"); folder.Name="MapPreviews"
 local moonColors={
  ["Roof deck"]=Color3.fromRGB(72,82,98),["Court surround"]=Color3.fromRGB(48,59,77),
  ["Playing surface"]=Color3.fromRGB(48,89,107),Kitchen=Color3.fromRGB(57,127,140),
 }
 for _,name in ipairs({"Rooftop","Moon"}) do
  local model=Instance.new("Model"); model.Name=name
  local sources={}
  for _,child in ipairs(court:GetChildren()) do
   if child~=rooftop and child~=moon then table.insert(sources,child) end
  end
  table.insert(sources,name=="Moon" and moon or rooftop)
  local count=0
  for _,source in ipairs(sources) do
   local parts=source:IsA("BasePart") and {source} or source:GetDescendants()
   for _,part in ipairs(parts) do
    if part:IsA("BasePart") and part.Transparency<1 and math.abs(part.Position.X)<330
     and math.abs(part.Position.Z)<330 and part.Position.Y<420 then
     local copy=part:Clone()
     for _,child in ipairs(copy:GetChildren()) do
      if not child:IsA("DataModelMesh") and not child:IsA("Decal") and not child:IsA("SurfaceAppearance") then child:Destroy() end
     end
     copy.Anchored=true; copy.CanCollide=false; copy.CanTouch=false; copy.CanQuery=false
     if name=="Moon" and moonColors[copy.Name] then copy.Color=moonColors[copy.Name] end
     copy.Parent=model; count+=1
     if count%150==0 then task.wait() end
    end
   end
  end
  model.Parent=folder
 end
 folder.Parent=game:GetService("ReplicatedStorage")
end
return Previews
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">MatchQueue</string>
          <string name="Source"><![CDATA[-- Server-owned voting deadlines and lottery; clients only submit their own picks.
local Setup=require(script.Parent:WaitForChild("MatchSetup"))
local Queue={VOTE_SECONDS=15,REVEAL_SECONDS=4}
Queue.__index=Queue
function Queue.new(notify,clock,random)
 return setmetatable({groups={},members={},active=nil,notify=notify,
  clock=clock or function() return workspace:GetServerTimeNow() end,random=random or Random.new()},Queue)
end
function Queue:publish(group)
 local roster,counts={}, {Rooftop=0,Moon=0}
 for _,player in ipairs(group.players) do
  local map=group.votes[player]
  if map then counts[map]+=1 end
  table.insert(roster,{player=player,name=player.DisplayName,map=map,modifier=group.modifiers[player]})
 end
 for _,player in ipairs(group.players) do
  self.notify(player,{stage=group==self.active and group.stage or "Queued",mode=group.mode,
   format=group.format,count=#group.players,required=Setup.players[group.format],roster=roster,
   counts=counts,map=group.map,modifier=group.modifier,endsAt=group.endsAt,
   revealAt=group.revealAt,revealEndsAt=group.revealEndsAt,candidates=group.candidates})
 end
end
function Queue:remove(player)
 local group=self.members[player]
 if not group then return end
 self.members[player]=nil; group.votes[player]=nil; group.modifiers[player]=nil
 table.remove(group.players,table.find(group.players,player))
 if self.active==group then self.active=nil end
 group.stage="Queued"; group.endsAt=nil; group.revealAt=nil; group.revealEndsAt=nil
 group.map=nil; group.candidates=nil
 if #group.players==0 then table.remove(self.groups,table.find(self.groups,group))
 else self:publish(group) end
 self.notify(player,{stage="Cancelled"})
end
function Queue:join(player,mode,format)
 if not Setup.modes[mode] or not Setup.players[format] or self.members[player] then return false end
 local group
 for _,candidate in ipairs(self.groups) do
  if candidate~=self.active and candidate.mode==mode and candidate.format==format
   and #candidate.players<Setup.players[format] then group=candidate; break end
 end
 if not group then
  group={mode=mode,format=format,players={},votes={},modifiers={},modifier=mode=="Chaos" and "LowGravity" or "None"}
  table.insert(self.groups,group)
 end
 table.insert(group.players,player); self.members[player]=group
 group.modifiers[player]=mode=="Chaos" and "LowGravity" or "None"
 self:publish(group)
 return true
end
function Queue:configure(player,map,modifier)
 local group=self.active
 if not group or self.members[player]~=group or group.stage~="Setup" or self.clock()>=group.endsAt then return false end
 modifier=modifier or group.modifiers[player]
 if not Setup.valid(group.mode,map or group.votes[player] or "Rooftop",modifier) then return false end
 if map then group.votes[player]=map end
 group.modifiers[player]=modifier
 self:publish(group)
 return true
end
function Queue:update(available)
 if not available then return end
 local now=self.clock()
 local group=self.active
 if not group then
  for _,candidate in ipairs(self.groups) do
   if #candidate.players==Setup.players[candidate.format] then
    self.active=candidate; candidate.stage="Setup"; candidate.endsAt=now+Queue.VOTE_SECONDS
    self:publish(candidate); return
   end
  end
  return
 end
 local allSelected=true
 for _,player in ipairs(group.players) do
  if not group.votes[player] then allSelected=false; break end
 end
 if group.stage=="Setup" and (allSelected or now>=group.endsAt) then
  local counts={Rooftop=0,Moon=0}
  local lowGravity=0
  for _,player in ipairs(group.players) do
   local map=group.votes[player]; if map then counts[map]+=1 end
   if group.modifiers[player]=="LowGravity" then lowGravity+=1 end
  end
  group.candidates={}
  local highest=math.max(counts.Rooftop,counts.Moon)
  for _,map in ipairs({"Rooftop","Moon"}) do
   if counts[map]==highest then table.insert(group.candidates,map) end
  end
  group.map=group.candidates[self.random:NextInteger(1,#group.candidates)]
  group.modifier=(group.mode=="Chaos" or (group.mode=="Arcade" and lowGravity>#group.players/2)) and "LowGravity" or "None"
  group.stage="Reveal"; group.revealAt=now
  group.revealEndsAt=now+(#group.candidates>1 and Queue.REVEAL_SECONDS or (allSelected and now<group.endsAt and 0 or 2))
  self:publish(group)
 end
 if group.stage=="Reveal" and now>=group.revealEndsAt then
  self.active=nil; table.remove(self.groups,table.find(self.groups,group))
  for _,player in ipairs(group.players) do self.members[player]=nil end
  return group
 end
end
return Queue
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">MatchRules</string>
          <string name="Source"><![CDATA[-- Court coordinates match the painted lines in World.
local Rules={HALF_WIDTH=20,BASELINE=40,KITCHEN=14,HIT_RANGE=12,PERFECT_RANGE=9,SLAM_RANGE=16,SLAM_HORIZONTAL=8,REAR_REACH=1.5,SLAM_MIN_HEIGHT=0.5,SLAM_EXTRA_HEIGHT=5,BACK_LIMIT=60}

Rules.DIVE_COOLDOWN=1.75
Rules.DIVE_STAMINA_COST=35
Rules.STAMINA_RECOVERY_DELAY=1.0
Rules.STAMINA_REGEN_RATE=22*0.55
Rules.JUMP_HANG_TIME=1
Rules.JUMP_DESCENT_GRAVITY=4
Rules.SLAM_TIMING_WINDOW=0.06

function Rules.canDive(stamina,readyAt,now)
 return now>=readyAt and stamina>=Rules.DIVE_STAMINA_COST
end

function Rules.recoverStamina(stamina,recoveryAt,now,dt)
 local elapsed=math.min(math.max(0,dt),math.max(0,now-recoveryAt))
 return math.min(100,stamina+elapsed*Rules.STAMINA_REGEN_RATE)
end

Rules.LOB_RESTITUTION=0.45
Rules.LOB_GRAVITY_SCALE=1.6
Rules.LOB_HORIZONTAL_RETENTION=0.75

-- Split a frame at the apex so heavier descent gravity never changes ascent.
function Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce)
 if lob and not postBounce and velocity.Y>0 then
  local timeToApex=velocity.Y/gravity
  local ascent=math.min(dt,timeToApex)
  position+=velocity*ascent-Vector3.new(0,0.5*gravity*ascent*ascent,0)
  velocity-=Vector3.new(0,gravity*ascent,0)
  -- Floating-point residue at the apex must not defer the heavier descent.
  if dt>=timeToApex then velocity=Vector3.new(velocity.X,0,velocity.Z) end
  dt-=ascent
 end
 local acceleration=gravity*(lob and (postBounce or velocity.Y<=0) and Rules.LOB_GRAVITY_SCALE or 1)
 position+=velocity*dt-Vector3.new(0,0.5*acceleration*dt*dt,0)
 velocity-=Vector3.new(0,acceleration*dt,0)
 return position,velocity,acceleration
end

-- Offensive topspin switches gravity at the net plane, splitting crossing frames.
function Rules.advanceFlight(position,velocity,gravity,dt,lob,postBounce,offensive,side)
 if not offensive then return Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce) end
 if position.Z*side<=0 then return Rules.advanceBall(position,velocity,gravity*1.8,dt,lob,postBounce) end
 local crossing=velocity.Z~=0 and -position.Z/velocity.Z or math.huge
 if crossing>=0 and crossing<=dt then
  position,velocity=Rules.advanceBall(position,velocity,gravity,crossing,lob,postBounce)
  return Rules.advanceBall(position,velocity,gravity*1.8,dt-crossing,lob,postBounce)
 end
 return Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce)
end

function Rules.ballLandingTime(height,vy,gravity,lob,postBounce)
 height=math.max(0,height)
 if lob and not postBounce and vy>0 then
  local ascent=vy/gravity
  local peak=height+vy*vy/(2*gravity)
  return ascent+math.sqrt(2*peak/(gravity*Rules.LOB_GRAVITY_SCALE))
 end
 local acceleration=gravity*(lob and Rules.LOB_GRAVITY_SCALE or 1)
 return (vy+math.sqrt(vy*vy+2*acceleration*height))/acceleration
end

-- Solve the launch arc with the same piecewise gravity used by simulation.
function Rules.lobLaunchY(height,duration,gravity)
 local descending=(0.5*gravity*Rules.LOB_GRAVITY_SCALE*duration*duration-height)/duration
 if descending<=0 then return descending end
 local low,high=0,gravity*duration
 for _=1,40 do
  local vy=(low+high)/2
  local descent=duration-vy/gravity
  local y=height+vy*vy/(2*gravity)-0.5*gravity*Rules.LOB_GRAVITY_SCALE*descent*descent
  if y>0 then high=vy else low=vy end
 end
 return (low+high)/2
end

function Rules.bounceVelocity(velocity,lob)
 if lob then
  return Vector3.new(velocity.X*Rules.LOB_HORIZONTAL_RETENTION,
   math.max(0,-velocity.Y)*Rules.LOB_RESTITUTION,velocity.Z*Rules.LOB_HORIZONTAL_RETENTION)
 end
 return Vector3.new(velocity.X,math.max(15,-velocity.Y*0.78),velocity.Z)
end

Rules.SERVE_TIMEOUT=15
Rules.BOT_SERVE_DELAY=2
Rules.MAX_SERVE_VELOCITY=90

function Rules.canServe(userId,serverId,ready)
 return ready==true and userId~=nil and userId~=0 and userId==serverId
end

Rules.SERVE_CHARGE_TIME=2
Rules.SERVE_PERFECT_OFFSET=0.06
Rules.SERVE_GOOD_OFFSET=0.4
Rules.SERVE_NET_OFFSET=-0.65

-- Hold to sweep up and down; release is judged at the current position.
function Rules.serveTiming(started,now)
 local phase=math.max(0,now-started)%(Rules.SERVE_CHARGE_TIME*2)/Rules.SERVE_CHARGE_TIME
 local needle=phase<=1 and phase or 2-phase
 local offset=needle*2-1
 local accuracy=1-math.abs(offset)
 local grade=math.abs(offset)<=Rules.SERVE_PERFECT_OFFSET+1e-9 and "PERFECT!"
  or math.abs(offset)<=Rules.SERVE_GOOD_OFFSET+1e-9 and "GOOD"
  or offset<0 and "UNDERCHARGED" or "OVERCHARGED"
 return needle,offset,accuracy,grade
end

function Rules.servePower(charge)
 return 0.3+0.7*math.clamp(charge,0,2)
end

function Rules.timedServeTarget(side,serveX,offset)
 offset=math.clamp(offset,-1,1)
 local depth
 if offset < -Rules.SERVE_GOOD_OFFSET-1e-9 then
  depth=math.max(4,13*(offset+1)/(1-Rules.SERVE_GOOD_OFFSET))
 elseif offset>Rules.SERVE_GOOD_OFFSET+1e-9 then
  depth=42+20*(offset-Rules.SERVE_GOOD_OFFSET)
 else depth=28+offset*22 end
 return Vector3.new(-math.sign(serveX)*10,181.7,-side*depth)
end

-- Ignore invalid remote targets and keep aim inside the diagonal service box.
function Rules.serveTarget(target,side,serveX)
 local fallback=Vector3.new(-serveX,181.7,-side*28)
 if typeof(target)~="Vector3" then return fallback end
 for _,value in ipairs({target.X,target.Y,target.Z}) do
  if value~=value or math.abs(value)==math.huge then return fallback end
 end
 local x=math.clamp(target.X* -math.sign(serveX),1,Rules.HALF_WIDTH-1)
 local depth=math.clamp(-target.Z*side,Rules.KITCHEN+2,Rules.BASELINE-2)
 return Vector3.new(-math.sign(serveX)*x,181.7,-side*depth)
end

function Rules.serveX(side,score)
 return side*(score%2==0 and 10 or -10)
end

function Rules.inKitchen(position,margin)
 margin=margin or 0
 return math.abs(position.X)<=Rules.HALF_WIDTH+margin and math.abs(position.Z)<=Rules.KITCHEN+margin
end

function Rules.servePositionValid(position,side,serveX,grounded)
 return grounded and position.Z*side>Rules.BASELINE+1
  and math.abs(position.X)<Rules.HALF_WIDTH-1 and position.X*math.sign(serveX)>1
end

function Rules.serveLandingValid(position,side,serveX)
 return position.Z*side< -Rules.KITCHEN-0.09 and math.abs(position.Z)<=Rules.BASELINE+0.09
  and math.abs(position.X)<=Rules.HALF_WIDTH+0.09 and position.X*math.sign(serveX)<=0.09
end

function Rules.returnFault(bounces,shots,inKitchen)
 if bounces>0 then return nil end
 if shots<2 then return "Two-bounce rule: let the ball bounce" end
 if inKitchen then return "Kitchen volley fault" end
 return nil
end

function Rules.startPosition(side,servingSide,serveX,primary)
 local serving=side==servingSide
 local x=serving and serveX or -serveX
 if not primary then x=-x end
 local depth=(serving or primary) and 46 or Rules.KITCHEN+4
 return Vector3.new(x,185,side*depth)
end

-- Shared by server validation and the developer hitbox overlay.
function Rules.slamBounds(character,root)
 local head=character:FindFirstChild("Head")
 local headTop=head and head.Position.Y+head.Size.Y*0.5 or root.Position.Y+3
 local armLength=0
 for _,name in ipairs({"RightUpperArm","RightLowerArm","RightHand","Right Arm"}) do
  local part=character:FindFirstChild(name)
  if part then armLength+=part.Size.Y end
 end
 armLength=math.clamp(armLength,2,6)
 return headTop+Rules.SLAM_MIN_HEIGHT,headTop+armLength+Rules.SLAM_EXTRA_HEIGHT
end

-- Generous vertical reach, while preserving the horizontal limit.
function Rules.overheadReach(ballPosition,rootPosition,minY,maxY)
 local offset=ballPosition-rootPosition
 return Vector3.new(offset.X,0,offset.Z).Magnitude<=Rules.SLAM_HORIZONTAL
  and ballPosition.Y>=minY
  and ballPosition.Y<=maxY
end

-- Overhead contact is the timing window for lobs near the kitchen line.
function Rules.kitchenLobWindow(lob,overhead,position,side)
 local depth=position.Z*side
 return lob==true and overhead and side~=0
  and depth>Rules.KITCHEN+1 and depth<=Rules.KITCHEN+Rules.SLAM_HORIZONTAL
  and math.abs(position.X)<=Rules.HALF_WIDTH
end

function Rules.jumpSlam(position,side,grounded,diving)
 local depth=position.Z*side
 return side~=0 and not grounded and not diving and depth>=0
  and depth<=Rules.BASELINE and math.abs(position.X)<=Rules.HALF_WIDTH
end

-- Airborne spikes use a bounded strike volume above the player's shoulders.
function Rules.spikeReach(ballPosition,rootFrame,maxY)
 local offset=ballPosition-rootFrame.Position
 return Rules.contactInFront(ballPosition,rootFrame)
  and offset.Magnitude<=Rules.SLAM_RANGE
  and Vector3.new(offset.X,0,offset.Z).Magnitude<=Rules.SLAM_HORIZONTAL
  and offset.Y>=1 and ballPosition.Y<=maxY
end

function Rules.slamTiming(ballPosition,ballVelocity,contactPosition,perfectVision)
 -- Signed time to the strike plane: approaching is early, passing it is late.
 local speedSquared=ballVelocity:Dot(ballVelocity)
 local timing=speedSquared>1 and -(ballPosition-contactPosition):Dot(ballVelocity)/speedSquared or 0
 local window=Rules.SLAM_TIMING_WINDOW*(perfectVision and 1.2 or 1)
 if timing>window then return "net" end
 if timing< -window then return "out" end
 return "perfect"
end

function Rules.slamTarget(target,side,quality)
 if quality=="out" then return Vector3.new(target.X,target.Y,-side*(Rules.BASELINE+8)) end
 return target
end

-- Deterministic movement influence, shared by the crosshair and server shots.
function Rules.shotAim(rootFrame,velocity,ballPosition)
 local look=rootFrame.LookVector
 local forward=Vector3.new(look.X,0,look.Z).Unit
 local right=Vector3.new(-forward.Z,0,forward.X)
 local movement=Vector3.new(velocity.X,0,velocity.Z)
 local lateral=math.clamp(movement:Dot(right)/18,-1,1)
 local angle=lateral*math.rad(4)
 local direction=forward*math.cos(angle)+right*math.sin(angle)
 local toward=ballPosition and Vector3.new(ballPosition.X-rootFrame.Position.X,0,ballPosition.Z-rootFrame.Position.Z) or forward
 toward=toward.Magnitude>0.1 and toward.Unit or forward
 local momentum=math.clamp(movement:Dot(toward)/18,0,1)
 return direction,momentum,angle
end

function Rules.contactInFront(ballPosition,rootFrame)
 local look=rootFrame.LookVector
 local forward=Vector3.new(look.X,0,look.Z)
 if forward.Magnitude<0.001 then return false end
 return (ballPosition-rootFrame.Position):Dot(forward.Unit)>=-Rules.REAR_REACH
end

function Rules.shotQuality(clean,timeToBounce,timeSinceBounce)
 if clean then return "perfect" end
 if math.min(timeToBounce,timeSinceBounce)>0.65 then return "net" end
 return "lob"
end

function Rules.softShot(position,side)
 -- A drop from behind the kitchen line lands inside the opponent's kitchen.
 return position.Z*side<=Rules.KITCHEN+8 and "dink" or "drop"
end

function Rules.kitchenHitFault(rootPosition,grounded,kitchenTouched)
 -- Airspace is legal when taking off outside; landing is checked separately.
 if grounded then return Rules.inKitchen(rootPosition) end
 return kitchenTouched==true
end

function Rules.updateKitchen(state,position,grounded,velocity,dt)
 local touching=grounded and Rules.inKitchen(position)
 if grounded then state.kitchenTouched=touching end
 local fault=touching and state.volleyPending==true
 if state.volleyPending then
  if grounded and Vector3.new(velocity.X,0,velocity.Z).Magnitude<2 then
   state.volleySettled=(state.volleySettled or 0)+dt
   if state.volleySettled>0.15 then state.volleyPending=false end
  else state.volleySettled=0 end
 end
 return fault
end

function Rules.diveDirection(moveDirection,lookDirection,ballDirection)
 local moving=Vector3.new(moveDirection.X,0,moveDirection.Z)
 if moving.Magnitude>0.15 then return moving.Unit end
 local looking=Vector3.new(lookDirection.X,0,lookDirection.Z)
 if looking.Magnitude>0.1 then return looking.Unit end
 local ball=Vector3.new(ballDirection.X,0,ballDirection.Z)
 return ball.Magnitude>0.1 and ball.Unit or Vector3.new(0,0,-1)
end

function Rules.slamSpeedScale(rallySpeed)
 return rallySpeed*math.clamp(0.9+0.2*math.max(0,rallySpeed-1),0.9,1.3)
end

Rules.CHARGE_TIME=1
Rules.HIT_COOLDOWN=0.28
function Rules.heldBallPosition(character)
 if not character then return nil end
 local hand=character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
 if hand then return hand.CFrame:PointToWorldSpace(Vector3.new(0,-hand.Size.Y*0.5-0.3,-0.2)) end
 local root=character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Body")
 return root and root.CFrame:PointToWorldSpace(Vector3.new(-1.2,0,-1.2)) or nil
end

function Rules.hitReady(now,readyAt,perfect)
 return perfect or now>=readyAt
end

function Rules.chargeAmount(started,now)
 local delay=0.4
 return started and math.clamp((now-started-delay)/(Rules.CHARGE_TIME-delay),0,1) or 0
end

function Rules.chargeTarget(from,target,charge,severity,spread,depthRoll)
 local offset=Vector3.new(target.X-from.X,0,target.Z-from.Z)
 if offset.Magnitude<0.01 then return target end
 local forward=offset.Unit
 local right=Vector3.new(-forward.Z,0,forward.X)
 local risk=charge*charge*math.clamp(severity,0,1)
 return target+forward*((10+18*depthRoll)*risk)+right*(spread*16*risk)
end

function Rules.returnSpeed(speed,clean,slam,charged)
 if not clean then return speed*0.95 end
 if charged and not slam then return math.max(1,speed)*1.07 end
 if speed<1 then return 1 end
 return speed*(slam and 1.10 or 1.05)
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">MatchSetup</string>
          <string name="Source"><![CDATA[local Setup={}
Setup.ARCADE_FEATURES_ENABLED=false
function Setup.abilities(mode) return mode=="Arcade" and Setup.ARCADE_FEATURES_ENABLED end
Setup.players={Practice=1,["1V1"]=2,["1V2"]=3,["2V2"]=4}
Setup.modes={Classic=true,Arcade=true,Chaos=true}
function Setup.valid(mode,map,modifier)
 if not Setup.modes[mode] or (map~="Rooftop" and map~="Moon") then return false end
 if mode=="Classic" then return modifier=="None" end
 if mode=="Chaos" then return modifier=="LowGravity" end
 return modifier=="None" or modifier=="LowGravity"
end
return Setup
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">MoonEnvironment</string>
          <string name="Source"><![CDATA[-- Visual scenery only. Court geometry and all gameplay physics belong to World/MatchRules.
local Moon={}
local V=Vector3.new
local P={dust=Color3.fromRGB(143,146,156),rim=Color3.fromRGB(164,169,181),shadow=Color3.fromRGB(84,89,105),
 white=Color3.fromRGB(224,231,236),metal=Color3.fromRGB(55,65,81),dark=Color3.fromRGB(23,30,44),
 orange=Color3.fromRGB(245,145,65),cyan=Color3.fromRGB(92,219,237),blue=Color3.fromRGB(35,74,125)}
local function part(parent,name,size,frame,color,material,solid)
 local p=Instance.new("Part")
 p.Name=name; p.Size=size; p.CFrame=typeof(frame)=="CFrame" and frame or CFrame.new(frame)
 p.Anchored=true; p.CanCollide=solid==true; p.CanTouch=false; p.CanQuery=solid==true
 p.Color=color; p.Material=material or Enum.Material.SmoothPlastic
 p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=parent
 return p
end
local function model(parent,name)
 local m=Instance.new("Model"); m.Name=name; m.Parent=parent; return m
end
local function sphere(parent,name,size,frame,color,material)
 local p=part(parent,name,size,frame,color,material)
 -- Sphere meshes preserve elliptical proportions; Ball parts use a round collision shape.
 local mesh=Instance.new("SpecialMesh"); mesh.MeshType=Enum.MeshType.Sphere; mesh.Parent=p
 return p
end
local function cylinder(parent,name,radius,height,frame,color,material)
 local p=part(parent,name,V(height,radius*2,radius*2),frame*CFrame.Angles(0,0,math.pi/2),color,material)
 p.Shape=Enum.PartType.Cylinder; return p
end
local function beam(parent,name,a,b,width,color,material)
 return part(parent,name,V(width,width,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),color,material)
end
local function ring(parent,name,frame,radius,width,height,count,color,material)
 for i=1,count do
  local angle=i*2*math.pi/count
  local at=V(math.cos(angle)*radius,0,math.sin(angle)*radius)
  part(parent,name,V(2*radius*math.sin(math.pi/count)+0.2,height,width),
   frame*CFrame.lookAt(at,Vector3.zero),color,material)
 end
end
local SURFACE=179.5
-- Each crater owns a square cutout in the regolith. No flat slab crosses its bowl.
local CRATERS={
 {-102,4,23,10},{103,66,24,6},{-180,-42,32,16},{-75,153,25,9},
 {142,151,34,19},{-215,139,29,7},{26,-182,32,14},{237,-181,42,23},
 {-278,-235,46,13},{35,258,47,25},{210,-15,23,11},{-30,-300,19,5},
}
local function triangle(parent,a,b,c,color)
 local ab,ac,bc=b-a,c-a,c-b
 if ab:Dot(ab)>ac:Dot(ac) and ab:Dot(ab)>bc:Dot(bc) then c,a=a,c
 elseif ac:Dot(ac)>bc:Dot(bc) then a,b=b,a end
 ab,ac,bc=b-a,c-a,c-b
 local right=ac:Cross(ab).Unit
 local back=bc.Unit
 local up=bc:Cross(right).Unit
 local height=math.abs(ab:Dot(up))
 for _,entry in ipairs({{a,b,right,back,ab},{a,c,-right,-back,ac}}) do
  local wedge=Instance.new("WedgePart")
  wedge.Name="Regolith facet"; wedge.Size=V(0.08,height,math.abs(entry[5]:Dot(back)))
  wedge.CFrame=CFrame.fromMatrix((entry[1]+entry[2])/2,entry[3],up,entry[4])
  wedge.Anchored=true; wedge.CanCollide=true; wedge.CanTouch=false; wedge.CanQuery=true
  wedge.Material=Enum.Material.Slate; wedge.Color=color; wedge.Parent=parent
 end
end
local function craterHeight(entry,x,z)
 local dx,dz=(x-entry[1])/entry[3],(z-entry[2])/entry[3]
 local angle=math.atan2(dz,dx)
 local radius=math.sqrt(dx*dx+dz*dz)/(0.85+0.045*math.sin(angle*5)+0.025*math.cos(angle*3))
 if radius>=1 then return SURFACE end
 -- Broad low basin and steep, broken inner walls, entirely below ground level.
 return SURFACE-entry[4]*(1-radius*radius)^1.35
end
local function crater(parent,entry)
 local x,z,radius,depth=unpack(entry)
 local m=model(parent,"Impact crater")
 m:SetAttribute("Depth",depth); m:SetAttribute("Radius",radius); m:SetAttribute("Center",V(x,SURFACE,z))
 local steps=10
 for i=0,steps-1 do
  for j=0,steps-1 do
   local function vertex(u,v)
    local px,pz=x-radius+2*radius*u/steps,z-radius+2*radius*v/steps
    return V(px,craterHeight(entry,px,pz),pz)
   end
   local a,b,c,d=vertex(i,j),vertex(i+1,j),vertex(i,j+1),vertex(i+1,j+1)
   local shade=math.clamp((SURFACE-(a.Y+b.Y+c.Y+d.Y)/4)/depth,0,1)
   local color=P.dust:Lerp(P.shadow,shade*0.65)
   if shade==0 then
    -- Tiny overlap seals floating-point seams where level tiles meet the bowl.
    part(m,"Level crater shoulder",V(2*radius/steps+0.08,2,2*radius/steps+0.08),(a+d)/2-V(0,1,0),P.dust,Enum.Material.Slate,true)
   else
    triangle(m,a,b,c,color); triangle(m,b,d,c,color)
   end
  end
 end
end
local function ground(parent)
 local m=model(parent,"Excavated lunar surface")
 local rectangles={{-650,-500,650,500}}
 for _,entry in ipairs(CRATERS) do
  local x,z,r=entry[1],entry[2],entry[3]
  assert(math.abs(x)-r>72 or math.abs(z)-r>96,"Crater overlaps court clearance")
  local nextRects={}
  for _,rect in ipairs(rectangles) do
   local left,front,right,back=unpack(rect)
   local a,b,c,d=math.max(left,x-r),math.max(front,z-r),math.min(right,x+r),math.min(back,z+r)
   if a>=c or b>=d then table.insert(nextRects,rect)
   else
    for _,strip in ipairs({{left,front,a,back},{c,front,right,back},{a,front,c,b},{a,d,c,back}}) do
     if strip[3]>strip[1] and strip[4]>strip[2] then table.insert(nextRects,strip) end
    end
   end
  end
  rectangles=nextRects
  crater(m,entry)
 end
 for _,rect in ipairs(rectangles) do
  part(m,"Unbroken regolith",V(rect[3]-rect[1],2,rect[4]-rect[2]),
   V((rect[1]+rect[3])/2,SURFACE-1,(rect[2]+rect[4])/2),P.dust,Enum.Material.Slate,true)
 end
 part(m,"Deep lunar bedrock",V(1300,8,1000),V(0,145,0),P.shadow,Enum.Material.Slate,true)
end
-- Irregular rock geometry from Low Poly Rock Pack by FracturedSkies (2128776869).
-- Mesh bounds normalize each source before varying its proportions and orientation.
local ROCKS={
 {"Flat slab","2128764023",V(178.239075,123.664474,193.074112),V(1.2,0.28,0.85)},
 {"Elongated shard","2128758133",V(217.166626,225.670319,120.977753),V(1.3,0.42,0.48)},
 {"Chipped stone","2128758599",V(156.518799,156.467407,136.799103),V(0.88,0.68,0.75)},
 {"Broad fragment","2128764803",V(170.629242,138.953323,168.476837),V(1.05,0.38,1)},
 {"Jagged fragment","2128766734",V(184.914566,222.987625,158.861313),V(0.58,0.88,0.62)},
 {"Lopsided stone","2128764428",V(179.997101,199.488892,208.224518),V(1.05,0.6,0.8)},
}
local function rock(parent,position,size,random)
 local variant=ROCKS[random:NextInteger(1,#ROCKS)]
 local m=model(parent,"Moon rock"); m:SetAttribute("Shape",variant[1])
 local proportions=variant[4]
 local dimensions=V(proportions.X*random:NextNumber(0.85,1.12),proportions.Y*random:NextNumber(0.8,1.15),proportions.Z*random:NextNumber(0.85,1.15))*size
 local frame=CFrame.new(position+V(0,dimensions.Y*0.42,0))*CFrame.Angles(random:NextNumber(-0.15,0.15),random:NextNumber(0,math.pi*2),random:NextNumber(-0.15,0.15))
 local stone=part(m,variant[1],dimensions,frame,P.shadow:Lerp(P.rim,random:NextNumber(0.1,0.65)),Enum.Material.Slate)
 local mesh=Instance.new("SpecialMesh"); mesh.MeshType=Enum.MeshType.FileMesh
 mesh.MeshId="rbxassetid://"..variant[2]
 mesh.Scale=V(dimensions.X/variant[3].X,dimensions.Y/variant[3].Y,dimensions.Z/variant[3].Z)
 mesh.Parent=stone
end
local function rocket(parent)
 local m=model(parent,"SELENE Rocket and landing pad")
 local origin=V(-112,180,-126)
 cylinder(m,"Landing pad",37,0.7,CFrame.new(origin),P.dark,Enum.Material.Concrete)
 ring(m,"Pad safety markings",CFrame.new(origin+V(0,0.5,0)),32,1.4,0.1,48,P.orange)
 for i=1,12 do
  local angle=i*math.pi/6
  local p=origin+V(math.cos(angle)*36,0.75,math.sin(angle)*36)
  cylinder(m,"Landing beacon",0.75,0.4,CFrame.new(p),P.cyan,Enum.Material.Neon)
 end
 -- A tapered, panel-built hull with a wider propulsion stage and compact capsule.
 local hull=model(m,"Paneled flight vehicle")
 local profile={{15,6.8},{20,8},{29,8},{43,6.8},{51,6.4},{58,4.6},{65,1.8},{67,0.15}}
 local facets=12
 for stage=1,#profile-1 do
  local lower,upper=profile[stage],profile[stage+1]
  for i=0,facets-1 do
   local a,b=i*math.pi*2/facets,(i+1)*math.pi*2/facets
   local function at(y,r,angle) return origin+V(math.cos(angle)*r,y,math.sin(angle)*r) end
   local p,q,r,t=at(lower[1],lower[2],a),at(lower[1],lower[2],b),at(upper[1],upper[2],a),at(upper[1],upper[2],b)
   local color=stage==1 and P.metal or (i%4==0 and P.white:Lerp(P.metal,0.24) or P.white)
   triangle(hull,p,q,r,color); triangle(hull,q,t,r,color)
   if stage>=2 and stage<=5 then
    beam(m,"Longitudinal panel seam",at(lower[1]+0.12,lower[2]+0.06,a),at(upper[1]-0.12,upper[2]+0.06,a),0.07,P.metal,Enum.Material.Metal)
   end
  end
 end
 for _,panel in ipairs(hull:GetChildren()) do
  panel.Name="Tapered hull panel"; panel.Material=Enum.Material.Metal; panel.CanCollide=false; panel.CanQuery=false
 end
 for _,entry in ipairs({{20,8.08},{29,8.08},{43,6.88},{51,6.48}}) do
  cylinder(m,"Stage separation collar",entry[2],0.45,CFrame.new(origin+V(0,entry[1],0)),P.metal,Enum.Material.Metal)
 end
 cylinder(m,"Mission orange belt",8.08,1.1,CFrame.new(origin+V(0,27,0)),P.orange,Enum.Material.Metal)
 for _,x in ipairs({-2.4,2.4}) do
  local frame=CFrame.new(origin+V(x,48,6.15))*CFrame.Angles(math.rad(12),0,0)
  part(m,"Recessed cockpit surround",V(4,3.5,0.5),frame,P.metal,Enum.Material.Metal)
  part(m,"Cockpit glazing",V(3.2,2.6,0.25),frame*CFrame.new(0,0,0.3),P.blue,Enum.Material.Glass)
  part(m,"Window reflection strip",V(0.14,2.3,0.05),frame*CFrame.new(-0.9,0,0.46),P.cyan,Enum.Material.Neon)
 end
 local hatch=CFrame.new(origin+V(0,36,7.65))
 part(m,"Crew hatch frame",V(4.2,7,0.6),hatch,P.metal,Enum.Material.Metal)
 part(m,"Pressure hatch",V(3.5,6.2,0.7),hatch*CFrame.new(0,0,0.15),P.white,Enum.Material.Metal)
 part(m,"Hatch handle",V(1.2,0.15,0.25),hatch*CFrame.new(0,0.5,0.6),P.orange,Enum.Material.Metal)
 for y=23,32,1.3 do
  beam(m,"Access ladder rung",origin+V(-1.7,y,8.2),origin+V(1.7,y,8.2),0.15,P.metal,Enum.Material.Metal)
 end
 for _,x in ipairs({-1.7,1.7}) do beam(m,"Ladder rail",origin+V(x,22,8.2),origin+V(x,33,8.2),0.16,P.metal,Enum.Material.Metal) end
 for i=1,4 do
  local angle=(i-1)*math.pi/2+math.pi/4
  local radial=V(math.cos(angle),0,math.sin(angle))
  local top=origin+radial*6+V(0,20,0)
  local knee=origin+radial*12+V(0,10,0)
  local foot=origin+radial*17+V(0,1.6,0)
  beam(m,"Articulated upper landing leg",top,knee,1.2,P.white,Enum.Material.Metal)
  beam(m,"Hydraulic landing piston",knee,foot,0.7,P.metal,Enum.Material.Metal)
  beam(m,"Landing leg brace",origin+radial*6+V(0,13,0),foot,0.4,P.orange,Enum.Material.Metal)
  sphere(m,"Landing knee joint",V(2,2,2),knee,P.metal,Enum.Material.Metal)
  cylinder(m,"Landing foot",3.4,0.6,CFrame.new(foot),P.metal,Enum.Material.Metal)
  local frame=CFrame.lookAt(origin+radial*8+V(0,21,0),origin+radial*20+V(0,21,0))
  part(m,"Thermal service pod",V(2.5,9,2),frame,P.metal,Enum.Material.Metal)
  for y=18,24,1.2 do part(m,"Service pod radiator fin",V(3,0.2,2.4),frame*CFrame.new(0,y-21,0),P.white,Enum.Material.Metal) end
 end
 for _,x in ipairs({-3,3}) do
  cylinder(m,"Engine turbopump",1.6,3,CFrame.new(origin+V(x,15,0)),P.orange,Enum.Material.Metal)
  for j=0,5 do
   local radius=1.3+j*0.25
   cylinder(m,"Flared nozzle segment",radius,0.85,CFrame.new(origin+V(x,12.8-j*0.8,0)),P.metal,Enum.Material.Metal)
  end
  cylinder(m,"Dark engine exhaust cavity",2.5,0.12,CFrame.new(origin+V(x,8.35,0)),P.dark)
  for _,z in ipairs({-1.6,1.6}) do beam(m,"Engine feed line",origin+V(x,19,z),origin+V(x,13,z),0.22,P.orange,Enum.Material.Metal) end
 end
 beam(m,"Capsule antenna",origin+V(0,64,0),origin+V(0,72,0),0.14,P.metal,Enum.Material.Metal)

end
local function outpost(parent)
 local m=model(parent,"Lunar research outpost")
 -- A pressurized habitat, scientific equipment, and a fixed flag in the vacuum.
 local base=V(106,181,-82)
 cylinder(m,"Habitat pressure vessel",8,24,CFrame.new(base+V(0,8,0))*CFrame.Angles(0,0,math.pi/2),P.white,Enum.Material.Metal)
 -- Break up the plain pressure shell with structural bands, thermal blankets, and service hardware.
 for _,x in ipairs({-10,-5,0,5,10}) do
  cylinder(m,"Pressure hull reinforcing collar",8.25,0.42,CFrame.new(base+V(x,8,0)),P.metal,Enum.Material.Metal)
  cylinder(m,"Collar insulation gasket",8.32,0.12,CFrame.new(base+V(x+0.28,8,0)),P.orange,Enum.Material.Metal)
 end
 -- Long insulated panels follow the habitat's sides and sit just above its curved hull.
 for _,side in ipairs({-1,1}) do
  for _,x in ipairs({-7.5,-2.5,2.5,7.5}) do
   local panelFrame=CFrame.new(base+V(x,8,side*6.65))*CFrame.Angles(side*math.rad(48),0,0)
   part(m,"Segmented thermal blanket",V(4.2,4.4,0.22),panelFrame,P.metal,Enum.Material.DiamondPlate)
   part(m,"Blanket edge latch",V(3.7,0.14,0.28),panelFrame*CFrame.new(0,2.05,0),P.orange,Enum.Material.Metal)
  end
 end
 -- Small observation ports with raised rims and inner glass give the habitat a human scale.
 for _,x in ipairs({-7,0,7}) do
  local portAt=base+V(x,9.5,7.35)
  cylinder(m,"Observation port bezel",1.35,0.28,CFrame.new(portAt)*CFrame.Angles(math.pi/2,0,0),P.metal,Enum.Material.Metal)
  cylinder(m,"Blue observation glass",0.96,0.32,CFrame.new(portAt+V(0,0,0.18))*CFrame.Angles(math.pi/2,0,0),P.cyan,Enum.Material.Glass)
  beam(m,"Port cross brace",portAt+V(-0.86,0,0.38),portAt+V(0.86,0,0.38),0.12,P.white,Enum.Material.Metal)
 end
 for _,x in ipairs({-12,12}) do
  sphere(m,"Habitat end cap",V(4,16,16),base+V(x,8,0),P.white,Enum.Material.Metal)
  part(m,"Habitat support",V(4,4,12),base+V(x,0,0),P.metal,Enum.Material.Metal)
  for _,z in ipairs({-4.5,4.5}) do
   beam(m,"Landing support strut",base+V(x,2,z),base+V(x,6,z*0.8),0.35,P.white,Enum.Material.Metal)
  end
 end
 part(m,"Airlock pressure vestibule",V(6,8,5),base+V(0,4,9),P.white,Enum.Material.Metal)
 part(m,"Airlock armored door",V(4.3,5.8,0.3),base+V(0,3.8,11.65),P.metal,Enum.Material.DiamondPlate)
 part(m,"Airlock window",V(1.7,1.3,0.18),base+V(0,5.3,11.88),P.cyan,Enum.Material.Glass)
 for _,x in ipairs({-1.55,1.55}) do
  cylinder(m,"Hatch locking wheel",0.34,0.16,CFrame.new(base+V(x,3.8,11.92))*CFrame.Angles(math.pi/2,0,0),P.orange,Enum.Material.Metal)
 end
 for _,x in ipairs({-2.8,2.8}) do beam(m,"Airlock frame",base+V(x,0.5,11.65),base+V(x,8,11.65),0.3,P.metal,Enum.Material.Metal) end
 part(m,"Airlock threshold",V(7,0.5,5),base+V(0,0.25,12),P.metal,Enum.Material.DiamondPlate)
 -- A short approach ladder and handrails make the raised hatch feel usable.
 for _,x in ipairs({-2.4,2.4}) do beam(m,"Airlock handrail",base+V(x,1.4,13),base+V(x,4.6,13),0.2,P.orange,Enum.Material.Metal) end
 for y=1.3,4.2,0.75 do beam(m,"Airlock ladder rung",base+V(-2.35,y,13),base+V(2.35,y,13),0.16,P.white,Enum.Material.Metal) end
 -- Equipment boxes, hoses, and a roof mounted instrument mast add visible mission hardware.
 for _,x in ipairs({-7,7}) do
  part(m,"External equipment locker",V(3.5,3.6,3.2),base+V(x,3.1,-5),P.metal,Enum.Material.DiamondPlate)
  part(m,"Locker safety panel",V(2.5,1.4,0.18),base+V(x,3.2,-6.7),P.orange,Enum.Material.Metal)
  for y=2.2,4.2,0.7 do beam(m,"Locker vent",base+V(x-0.9,y,-6.83),base+V(x+0.9,y,-6.83),0.09,P.white,Enum.Material.Metal) end
 end
 for _,x in ipairs({-4,4}) do
  beam(m,"Habitat roof equipment rail",base+V(x,14,-4),base+V(x,14,4),0.2,P.metal,Enum.Material.Metal)
 end
 beam(m,"Habitat weather mast",base+V(0,14,0),base+V(0,22,0),0.22,P.white,Enum.Material.Metal)
 for _,z in ipairs({-1,1}) do sphere(m,"Habitat sensor",V(0.9,0.9,0.9),base+V(0,22,z),P.orange,Enum.Material.Neon) end
 part(m,"Habitat roof antenna",V(0.18,0.15,8),CFrame.new(base+V(0,20,-5))*CFrame.Angles(0,0,math.rad(35)),P.metal,Enum.Material.Metal)
 for _,x in ipairs({85,109,133}) do
  beam(m,"Solar array support",V(x,180,-119),V(x,187,-119),0.6,P.metal,Enum.Material.Metal)
  local frame=CFrame.new(x,188,-119)*CFrame.Angles(math.rad(22),0,0)
  part(m,"Solar panel frame",V(20,0.6,12),frame,P.white,Enum.Material.Metal)
  for i=-2,2 do for j=-1,1 do
   part(m,"Photovoltaic cell",V(3.6,0.12,3.4),frame*CFrame.new(i*3.9,0.36,j*3.8),P.blue,Enum.Material.Glass)
  end end
 end
 local dish=V(137,191,-51)
 beam(m,"Communications mast",V(137,180,-51),dish,0.8,P.metal,Enum.Material.Metal)
 local dishFrame=CFrame.new(dish)*CFrame.Angles(math.rad(28),0,math.rad(12))
 sphere(m,"Satellite dish",V(13,1.5,13),dishFrame,P.white,Enum.Material.Metal)
 ring(m,"Dish lip",dishFrame,6,0.4,0.4,28,P.metal,Enum.Material.Metal)
 beam(m,"Dish receiver",dish,dish+V(0,5,0),0.35,P.metal,Enum.Material.Metal)
 sphere(m,"Receiver tip",V(1,1,1),dish+V(0,5,0),P.orange)
 beam(m,"Flag mast",V(-53,180,-87),V(-53,198,-87),0.3,P.white,Enum.Material.Metal)
 beam(m,"Flag crossbar",V(-53,198,-87),V(-45,198,-87),0.2,P.white,Enum.Material.Metal)
 part(m,"Expedition flag",V(8,5,0.12),V(-49,195.5,-87),P.orange,Enum.Material.Fabric)
 cylinder(m,"Flag moon emblem",1.5,0.15,CFrame.new(-49,195.5,-86.9)*CFrame.Angles(math.pi/2,0,0),P.white)
 for i=1,7 do
  local at=V(75+i*3,180.4,-55+i*2)
  cylinder(m,"Sample canister",0.7,1.6,CFrame.new(at),i%2==0 and P.orange or P.white,Enum.Material.Metal)
 end
end
local function rover(parent)
 local m=model(parent,"Lunar rover")
 local origin=V(-93,181,64)
 part(m,"Rover chassis",V(13,2.4,8),origin+V(0,2,0),P.white,Enum.Material.Metal)
 part(m,"Rover battery pack",V(4,2,7),origin+V(-4,4,0),P.orange,Enum.Material.Metal)
 for _,x in ipairs({-4.5,0,4.5}) do for _,z in ipairs({-5,5}) do
  local frame=CFrame.new(origin+V(x,0.6,z))*CFrame.Angles(math.pi/2,0,0)
  cylinder(m,"Wire mesh rover wheel",2.2,1.4,frame,P.dark,Enum.Material.DiamondPlate)
  cylinder(m,"Wheel hub",0.8,1.6,frame,P.metal,Enum.Material.Metal)
 end end
 for _,z in ipairs({-2,2}) do
  part(m,"Rover seat",V(3,1,2.6),origin+V(1,4,z),P.dark,Enum.Material.SmoothPlastic,true)
  part(m,"Rover seat back",V(0.8,3,2.6),origin+V(-0.5,5,z),P.dark,Enum.Material.SmoothPlastic,true)
 end
 beam(m,"Rover camera mast",origin+V(5,3,0),origin+V(5,11,0),0.3,P.white,Enum.Material.Metal)
 part(m,"Stereo survey camera",V(1.5,1,3),origin+V(5,11,0),P.dark)
 for _,z in ipairs({-1,1}) do sphere(m,"Camera lens",V(0.2,0.6,0.6),origin+V(5.8,11,z),P.cyan,Enum.Material.Neon) end
 for i=1,20 do for _,z in ipairs({-5,5}) do
  part(m,"Rover track",V(0.6,0.025,1.8),V(-105-i*1.8,179.55,64+z),P.shadow,Enum.Material.Slate)
 end end
