local function sky(parent,random)
 local m=model(parent,"Lunar sky")
 -- Keep the sky visible even when distant geometry would normally stream out.
 m.ModelStreamingMode=Enum.ModelStreamingMode.Persistent
 local center=V(0,180,0)
 for i=1,180 do
  -- Keep the star dome well behind the terrain and away from the horizon line.
  local y=random:NextNumber(0.32,1)
  local angle=random:NextNumber(0,math.pi*2)
  local direction=V(math.sqrt(1-y*y)*math.cos(angle),y,math.sqrt(1-y*y)*math.sin(angle))
  local size=random:NextNumber(0.65,1.3)
  local star=sphere(m,"Distant star",V(size,size,size),center+direction*random:NextNumber(1900,2350),
   i%7==0 and Color3.fromRGB(160,197,255) or Color3.fromRGB(242,239,220),Enum.Material.Neon)
  star.CastShadow=false; star.Transparency=random:NextNumber(0.08,0.35)
  -- A tiny screen-size core keeps stars visible without large skybox star shapes.
  local point=Instance.new("BillboardGui"); point.Name="Starlight"; point.Adornee=star
  point.Size=UDim2.fromOffset(i%5==0 and 3 or 2,i%5==0 and 3 or 2)
  point.LightInfluence=0; point.MaxDistance=4000; point.Parent=star
  local dot=Instance.new("Frame"); dot.Name="Point"; dot.Size=UDim2.fromScale(1,1)
  dot.BackgroundColor3=star.Color; dot.BackgroundTransparency=star.Transparency; dot.BorderSizePixel=0; dot.Parent=point
  if i%5==0 then star:SetAttribute("TwinklePhase",random:NextNumber(0,math.pi*2)) end
 end
 local earth=model(m,"Earth")
 local earthCenter=V(-265,430,-920)
 -- UV-mapped globe and cloud imagery from Creator Store's Realistic Earth (PBR),
 -- asset 11372170772 by 1980svg. Only mesh/texture references are used.
 local globeFrame=CFrame.new(earthCenter)*CFrame.Angles(0,math.rad(-96),math.rad(23.4))
 local function globe(name,diameter,texture,transparency)
  local p=part(earth,name,V(diameter,diameter,diameter),globeFrame,Color3.new(1,1,1))
  local mesh=Instance.new("SpecialMesh")
  mesh.MeshType=Enum.MeshType.FileMesh; mesh.MeshId="rbxassetid://6510695035"
  mesh.TextureId=texture; mesh.Scale=V(1,1,1)*(diameter/6.366715); mesh.Parent=p
  p.Transparency=transparency or 0
  return p
 end
 globe("Textured oceans and continents",134,"rbxassetid://11287088884")
 globe("Fine cloud systems",134.65,"rbxassetid://11286649227",0.18)
 local atmosphere=sphere(earth,"Atmospheric limb",V(138,138,138),globeFrame,P.cyan,Enum.Material.ForceField)
 atmosphere.Transparency=0.82
 local glow=sphere(earth,"Soft blue atmospheric glow",V(142,142,142),globeFrame,Color3.fromRGB(76,160,255),Enum.Material.Neon)
 glow.Transparency=0.965
 local rim=Instance.new("Highlight"); rim.Name="Earth limb glow"; rim.Adornee=earth
 rim.FillColor=Color3.fromRGB(120,177,255); rim.FillTransparency=0.97
 rim.OutlineColor=Color3.fromRGB(118,192,255); rim.OutlineTransparency=0.6
 rim.DepthMode=Enum.HighlightDepthMode.Occluded; rim.Parent=earth
 local saturn=model(m,"Ringed planet")
 local at=V(620,480,700)
 local frame=CFrame.new(at)*CFrame.Angles(math.rad(24),0,math.rad(-18))
 -- Banded globe texture from Saturn [Realistic], asset 15246961312 by jacobthiagobonito.
 local globe=part(saturn,"Saturn cloud bands",V(75,69,75),frame,Color3.new(1,1,1))
 local mesh=Instance.new("SpecialMesh"); mesh.MeshType=Enum.MeshType.FileMesh
 mesh.MeshId="rbxassetid://453515873"; mesh.TextureId="rbxassetid://128239574"
 mesh.Scale=V(75/1.996349,69/1.995128,75/1.997565); mesh.Parent=globe
 local haze=sphere(saturn,"Saturn atmospheric haze",V(75.6,69.6,75.6),frame,Color3.fromRGB(242,213,169),Enum.Material.ForceField)
 haze.Transparency=0.94
 local rings=model(saturn,"Layered ice rings")
 -- Separate C/B/A rings and the narrow outer F ring leave real dark divisions.
 for index,band in ipairs({{44,3,0.38},{48,3,0.25},{53,5,0.12},{58,4,0.16},{65,4,0.2},{70,5,0.3},{75,2,0.4},{83,0.9,0.5}}) do
  local color=Color3.fromRGB(176,158,128):Lerp(Color3.fromRGB(231,218,190),(index%3)/3)
  local bandModel=model(rings,index<=4 and "Inner ice ring band" or "Outer ice ring band")
  ring(bandModel,"Fine ice ring segment",frame,band[1],band[2],0.16,96,color,Enum.Material.SmoothPlastic)
  for _,segment in ipairs(bandModel:GetChildren()) do segment.Transparency=band[3] end
 end
 -- A few tiny companions add scale without crowding the planet silhouette.
 sphere(saturn,"Titan",V(3.4,3.4,3.4),frame*V(101,8,-12),Color3.fromRGB(184,137,80))
 sphere(saturn,"Icy companion",V(1.5,1.5,1.5),frame*V(-92,-7,18),P.white)
 sphere(m,"Distant red planet",V(25,25,25),V(830,350,-690),Color3.fromRGB(166,83,63),Enum.Material.Neon)
 for _,item in ipairs(m:GetDescendants()) do if item:IsA("BasePart") then item.CastShadow=false end end
 -- Keep the complete backdrop inside the draw distance of lower graphics settings.
 m.WorldPivot=CFrame.new(center)
 m:ScaleTo(0.35)
end
function Moon.build()
 local root=Instance.new("Model"); root.Name="MoonEnvironment"; root:SetAttribute("Version",4)
 root.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
 local random=Random.new(709)
 ground(root)
 local function surfaceAt(x,z)
  for _,entry in ipairs(CRATERS) do
   if math.abs(x-entry[1])<entry[3] and math.abs(z-entry[2])<entry[3] then return craterHeight(entry,x,z) end
  end
  return SURFACE
 end
 local function clear(x,z,padding)
  if math.abs(x)<72+padding and math.abs(z)<96+padding then return false end
  -- Leave the landing pad, habitat, solar arrays and rover exposed.
  if (V(x,0,z)-V(-112,0,-126)).Magnitude<40+padding then return false end
  if x>76-padding and x<149+padding and z> -132-padding and z< -40+padding then return false end
  if math.abs(x+93)<15+padding and math.abs(z-64)<12+padding then return false end
  return true
 end
 local debris=model(root,"Basalt boulder fields")
 for i=1,420 do
  local x,z=random:NextNumber(-430,430),random:NextNumber(-360,360)
  local size=random:NextNumber(0.8,7)
  if clear(x,z,size) then
   rock(debris,V(x,surfaceAt(x,z),z),size,random)
  end
 end
 -- Local ejecta clusters break up the rims without constructing raised rings.
 for _,entry in ipairs(CRATERS) do
  for i=1,16 do
   local angle=random:NextNumber(0,math.pi*2)
   local radius=entry[3]*random:NextNumber(0.9,1.4)
   local x,z=entry[1]+math.cos(angle)*radius,entry[2]+math.sin(angle)*radius
   local size=random:NextNumber(0.5,2.4)
   if clear(x,z,size) then rock(debris,V(x,surfaceAt(x,z),z),size,random) end
  end
 end
 local gravel=model(root,"Scattered regolith fragments")
 for i=1,360 do
  local x,z=random:NextNumber(-260,260),random:NextNumber(-240,240)
  if clear(x,z,2) then
   local size=random:NextNumber(0.2,0.8)
   rock(gravel,V(x,surfaceAt(x,z),z),size,random)
  end
 end
 local ranges=model(root,"Fractured lunar highlands")
 -- Continuous eroded slopes replace separate wedge-shaped mountain blocks.
 local sectors,bands=80,6
 local function ridgePoint(i,j)
  local angle=(i%sectors)*math.pi*2/sectors
  local t=j/bands
  local radius=520+t*120
  local envelope=math.sin(math.pi*t)^1.5
  local peaks=42+14*math.sin(angle*7)+9*math.cos(angle*11+1)
  local erosion=math.noise(math.cos(angle)*5,math.sin(angle)*5,t*3)*17
  return V(math.cos(angle)*radius,SURFACE-0.15+envelope*(peaks+erosion),math.sin(angle)*radius*0.75)
 end
 for i=0,sectors-1 do
  local ridge=model(ranges,"Eroded ridge section")
  for j=0,bands-1 do
   local a,b,c,d=ridgePoint(i,j),ridgePoint(i+1,j),ridgePoint(i,j+1),ridgePoint(i+1,j+1)
   local color=P.shadow:Lerp(P.dust,0.45+0.08*math.sin(i*0.7+j))
   triangle(ridge,a,b,c,color); triangle(ridge,b,d,c,color)
  end
  -- Solid below-grade footings seal the underside and stay clear of crater cutouts.
  local angle=(i+0.5)*math.pi*2/sectors
  local radial=V(math.cos(angle),0,math.sin(angle)*0.75)
  local frame=CFrame.lookAt(V(radial.X*570,SURFACE-16,radial.Z*570),V(0,SURFACE-16,0))
  part(ridge,"Buried highland foundation",V(2*640*math.sin(math.pi/sectors)+2,32,150),frame,P.dust,Enum.Material.Slate)
  for _,face in ipairs(ridge:GetChildren()) do
   if face.Name~="Buried highland foundation" then face.Name="Eroded highland face" end
   face.CanCollide=false; face.CanQuery=false
  end
 end
 for _,x in ipairs({-65,65}) do
  part(root,"Outpost platform edge",V(1,1.2,180),V(x,181.4,0),P.metal,Enum.Material.Metal)
  for z=-80,80,20 do part(root,"Platform navigation light",V(0.3,0.15,5),V(x,182.1,z),P.cyan,Enum.Material.Neon) end
 end
 for _,z in ipairs({-89,89}) do part(root,"Platform end edge",V(132,1.2,1),V(0,181.4,z),P.metal,Enum.Material.Metal) end
 for _,z in ipairs({-26,0,26}) do
  local frame=CFrame.new(48,183,z)*CFrame.Angles(0,-math.pi/2,0)
  part(root,"Lounge seat",V(10,1,4),frame,P.white,Enum.Material.Metal,true)
  part(root,"Lunar bench back",V(10,3,0.5),frame*CFrame.new(0,1,-1.8),P.metal,Enum.Material.Metal,true)
  for _,x in ipairs({-4,4}) do part(root,"Bench support",V(0.5,2,3),frame*CFrame.new(x,-1,0),P.metal,Enum.Material.Metal,true) end
 end
 rocket(root); outpost(root); rover(root); sky(root,random)
 root:SetAttribute("ExpectedDescendants",#root:GetDescendants())
 return root
end
return Moon
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Powerups</string>
          <string name="Source"><![CDATA[-- Draft catalog and pure effect rules. Distances use the painted 20 x 44 foot court.
-- The court is 40 x 80 studs; width defines two studs per foot.
local Powerups={DURATION=20}
local archetypes={
 {"Fleet Foot", "speed", 0.08, "Move %d%% faster", "WIND"},
 {"Second Wind", "regen", 0.18, "Recover stamina %d%% faster", "PULSE"},
 {"Long Reach", "reach", 0.06, "Extend contact range by %d%%", "ORBIT"},
 {"Quick Reset", "dive", 0.08, "Reduce dive cooldown by %d%%", "WIND"},
 {"Light Steps", "speed", 0.07, "Move %d%% faster", "ORBIT"},
 {"Deep Breath", "regen", 0.20, "Recover stamina %d%% faster", "PULSE"},
 {"Wide Guard", "reach", 0.07, "Extend contact range by %d%%", "SHIELD"},
 {"Acrobat", "dive", 0.09, "Reduce dive cooldown by %d%%", "ORBIT"},
 {"Court Runner", "speed", 0.09, "Move %d%% faster", "WIND"},
 {"Endless Rhythm", "regen", 0.16, "Recover stamina %d%% faster", "PULSE"},
 {"Sweet Spot", "reach", 0.08, "Extend contact range by %d%%", "SHIELD"},
 {"Fast Reset", "dive", 0.10, "Reduce dive cooldown by %d%%", "WIND"},
}
Powerups.catalog={
 {id="kitchenCamper",tier=1,name="Kitchen Camper",symbol="WIND",description="Move 15% faster within 2 feet of the kitchen line. Retreating to baseline disables it this rally."},
 {id="dinkSpecialist",tier=1,name="Dink Specialist",symbol="PULSE",description="Land 3 consecutive dinks to boost your next baseline drive speed by 20%."},
 {id="carbonFiber",tier=1,name="Carbon Fiber Core",symbol="SHIELD",description="Your paddle sweet spot is 15% wider, reducing off-center mishits."},
 {id="secondServe",tier=1,name="Second Serve",symbol="PULSE",description="Once per match, a serve fault grants a free retry and fully restores stamina."},
 {id="sliceDice",tier=1,name="Slice and Dice",symbol="ORBIT",description="Slice shots bounce 10% lower. Press X to slice."},
 {id="thirdShot",tier=2,name="The Third-Shot Drop",symbol="ORBIT",description="Your third shot is guided to the kitchen with +40% accuracy and heavy topspin."},
 {id="serveVolley",tier=2,name="Serve and Volley",symbol="WIND",description="Gain 75% movement speed for 3 seconds after serving."},
 {id="vampiricReach",tier=2,name="Vampiric Reach",symbol="PULSE",description="Win a point at the net to permanently gain 1% reach, up to 10%."},
 {id="atpAssassin",tier=2,name="ATP (Around the Post) Assassin",symbol="ORBIT",description="Land a shot around a net post to drain 30% of opponents' max stamina."},
 {id="baitSwitch",tier=2,name="Bait and Switch",symbol="WIND",description="Press lob (R) during a smash windup for a perfect drop. Retreating opponents are stunned for 1 second."},
 {id="erne",tier=3,name="Erne Executioner",symbol="PULSE",description="A legal jumping volley outside the sideline has 300% power and wins on paddle contact."},
 {id="phantom",tier=3,name="Phantom Paddle",symbol="SHIELD",description="Gain 8 inches of invisible paddle reach on your backhand side."},
 {id="lava",tier=3,name="Kitchen is Lava",symbol="PULSE",description="Opponents touching their kitchen line suffer double stamina drain for the rest of the rally."},
 {id="overcharge",tier=3,name="Rally Overcharge",symbol="WIND",description="After 15 shots, ignite your paddle, ignore incoming spin, and unleash one unreturnable smash."},
 {id="deflector",tier=3,name="Deflector Shield",symbol="SHIELD",description="Torso drives automatically deflect into the opponent's court at twice their incoming speed."},
 {id="perfectVision",tier=1,name="Perfect Vision",symbol="EYE",description="The green perfect-hit timing window is 20% longer, before and after a bounce."},
 {id="quickRecovery",tier=1,name="Quick Recovery",symbol="RESET",description="Recover from dive movement and animation locks 50% faster."},
 {id="baselineSentinel",tier=1,name="Baseline Sentinel",symbol="COURT",description="Move sideways 15% faster within 2 feet of the baseline."},
 {id="calculatedReturn",tier=1,name="Calculated Return",symbol="TARGET",description="Standard returns of serve send the ball back at 80% of its incoming velocity."},
 {id="momentumShift",tier=2,name="Momentum Shift",symbol="BOLT",description="Three consecutive perfect hits charge your fourth return with +15% rally acceleration."},
 {id="airTime",tier=2,name="Air Time",symbol="APEX",description="Fall slowly for 1 second after your jump's apex, giving you more time to line up a slam. Diving cancels the effect."},
 {id="offensiveDive",tier=2,name="Offensive Dive",symbol="DIVE",description="Dive hits apply maximum topspin, sharply increasing descent after crossing the net."},
 {id="kitchenWarden",tier=2,name="Kitchen Warden",symbol="SHIELD",description="Stand still at the kitchen line to extend your hit sphere forward by 25%."},
 {id="deceptiveDrop",tier=2,name="Deceptive Drop",symbol="MASK",description="Hold dive while swinging to fake a smash and hit a soft drop. Enemy reticles disappear for 0.5s."},
 {id="apexPredator",tier=3,name="Apex Predator",symbol="APEX",description="Hit at the bounce apex to disguise accelerated ball speed until it crosses the net."},
 {id="rhythmMaster",tier=3,name="Rhythm Master",symbol="RHYTHM",description="After 10 rally hits, perfect swings hide your paddle and its angle."},
 {id="afterimage",tier=3,name="Afterimage",symbol="CLONE",description="Dives leave a solid visual clone for 2s. Hit within 1s to show opponents a decoy landing spot."},
 {id="terminalVelocity",tier=3,name="Terminal Velocity",symbol="INFINITY",description="Uncapped +8% perfect-hit acceleration. Win a rally exceeding 1.5x speed for permanent +5% movement."},
}
function Powerups.has(build,id) return build~=nil and build[id]==true end
function Powerups.slowFall(build,side,variant)
 return side~=0 and variant=="Chaos" and Powerups.has(build,"airTime")
end
function Powerups.newRally()
 return {perfectChain=0,diveStarted=-math.huge,tension=0,camperActive=false,camperLost=false,lava=false,burstUntil=0,stunUntil=0,overchargeUsed=false}
end
function Powerups.perfect(build,timeToBounce,sinceBounce)
 local scale=Powerups.has(build,"perfectVision") and 1.2 or 1
 return timeToBounce<=0.23*scale or sinceBounce<=0.28*scale
end
function Powerups.diveDuration(build)
 local scale=Powerups.has(build,"quickRecovery") and 0.5 or 1
 return 0.48*scale,0.66*scale
end
function Powerups.lateralScale(build,depth,x,lateral)
 return Powerups.has(build,"baselineSentinel") and math.abs(depth-40)<=4 and math.abs(x)<=20
  and math.sqrt(1+(1.15^2-1)*math.clamp(lateral*lateral,0,1)) or 1
end
function Powerups.warden(build,depth,x,speed,grounded)
 return Powerups.has(build,"kitchenWarden") and grounded and math.abs(depth-14)<=1 and math.abs(x)<=20 and speed<=1
end
function Powerups.acceleration(build,state,speed,clean,slam,charged,normal)
 local ready=Powerups.has(build,"momentumShift") and state.perfectChain>=3
 state.perfectChain=clean and (ready and 0 or state.perfectChain+1) or 0
 if ready then return math.max(1,speed)*1.15,"MOMENTUM SHIFT! +15%" end
 if clean and Powerups.has(build,"terminalVelocity") then return math.max(1,speed)*1.08,"TERMINAL VELOCITY! +8%" end
 return normal(speed,clean,slam,charged),nil
end
function Powerups.terminalWin(build,state,peak)
 if Powerups.has(build,"terminalVelocity") and peak>1.5 then state.speedWins=(state.speedWins or 0)+1 end
end
function Powerups.apex(build,bounces,vy,gravity)
 return Powerups.has(build,"apexPredator") and bounces>0 and math.abs(vy)<=gravity*0.06
end
function Powerups.tracking(opponent,live,now,hiddenUntil,glitchUntil,heavy,beforeNet)
 return opponent and live and now<(hiddenUntil or 0), opponent and live and now<(glitchUntil or 0),
  opponent and live and heavy==true and beforeNet
end
function Powerups.camp(state,depth,x,kitchen,baseline)
 if state.camperActive and depth>=baseline then state.camperLost=true end
 local near=math.abs(depth-kitchen)<=4 and math.abs(x)<=20
 if near and not state.camperLost then state.camperActive=true end
 return near and not state.camperLost
end
function Powerups.dink(state,landed)
 state.tension=landed and math.min(3,state.tension+1) or 0
 if state.tension==3 then state.driveReady=true end
end
function Powerups.drive(state,baseline)
 if baseline and state.driveReady then state.tension=0; state.driveReady=false; return 1.2 end
 return 1
end
function Powerups.onFire(build,state,shots)
 return Powerups.has(build,"overcharge") and shots>15
end
function Powerups.retryServe(build,state)
 if not Powerups.has(build,"secondServe") or state.secondServeUsed then return false end
 state.secondServeUsed=true
 return true
end
function Powerups.netWin(build,state,atNet)
 if atNet and Powerups.has(build,"vampiricReach") then state.reachStacks=math.min(10,(state.reachStacks or 0)+1) end
end
function Powerups.extraReach(build,state,backhand)
 return (state.reachStacks or 0)*0.01, (Powerups.has(build,"phantom") and backhand) and 4/3 or 0
end
-- Solve flight time for a specified launch speed; low arc first, high arc if needed.
function Powerups.flightTimes(horizontal,height,speed,gravity)
 local a=speed*speed-gravity*height
 local discriminant=a*a-gravity*gravity*(horizontal*horizontal+height*height)
 if discriminant<0 or a<=0 then return nil end
 local root=math.sqrt(discriminant)
 return math.sqrt(2*(a-root)/(gravity*gravity)),math.sqrt(2*(a+root)/(gravity*gravity))
end
function Powerups.bounceScale(spin,sliceBoost)
 -- Scale velocity by sqrt(height ratio), since bounce height is proportional to v^2.
 return spin=="slice" and math.sqrt(sliceBoost and 0.9 or 1) or spin=="topspin" and math.sqrt(0.55) or 1
end
Powerups.caps={speed=0.6,regen=1.5,reach=0.4,dive=0.5}
function Powerups.roll(random)
 local roll=random:NextNumber()
 return roll<0.6 and 1 or roll<0.9 and 2 or 3
end
function Powerups.deal(random,count,builds)
 assert(count>=1 and count<=4,"Draft supports one to four players")
 local tier=Powerups.roll(random)
 local pool={}
 for index,base in ipairs(archetypes) do
  local amount=base[3]*tier
  table.insert(pool,{id=tostring(tier)..":"..index,name=base[1],stat=base[2],amount=amount,
   description=string.format(base[4],math.floor(amount*100+0.5)),symbol=base[5],tier=tier})
 end
 for _,card in ipairs(Powerups.catalog) do
  if card.tier==tier then table.insert(pool,card) end
 end
 for index=#pool,2,-1 do
  local other=random:NextInteger(1,index)
  pool[index],pool[other]=pool[other],pool[index]
 end
 local offers={}
 for player=1,count do
  offers[player]={}
  for slot=1,3 do
   for index,card in ipairs(pool) do
    if card.stat or not Powerups.has(builds and builds[player],card.id) then
     offers[player][slot]=table.remove(pool,index); break
    end
   end
   assert(offers[player][slot],"Insufficient draft cards")
  end
 end
 return tier,offers
end
function Powerups.choose(offer,id,stats)
 if not offer or type(id)~="string" then return nil end
 for _,card in ipairs(offer) do
  if card.id==id then
   if card.stat then
    stats[card.stat]=math.min(Powerups.caps[card.stat],(stats[card.stat] or 0)+card.amount)
   else stats[card.id]=true end
   return card
  end
 end
 return nil
end
return Powerups
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">PracticeSession</string>
          <string name="Source"><![CDATA[-- Practice-only configuration and authoritative countdown state; no asynchronous timers.
local Practice={}
Practice.__index=Practice
Practice.Profiles={
 Easy={reactionMin=0.4,reactionMax=0.65,think=0.25,move=13,errorX=5,errorZ=4,
  miss=0.2,clean=0.3,wide=0.12,width=10,depthMin=20,depthMax=28,speed=0.8},
 Normal={reactionMin=0.22,reactionMax=0.42,think=0.18,move=18,errorX=3,errorZ=2,
  miss=0.1,clean=0.55,wide=0.07,width=15,depthMin=20,depthMax=34,speed=1},
 Hard={reactionMin=0.12,reactionMax=0.22,think=0.1,move=23,errorX=1.5,errorZ=1,
  miss=0.035,clean=0.8,wide=0.025,width=18,depthMin=25,depthMax=37,speed=1.15},
}
function Practice.new()
 return setmetatable({difficulty="Normal",paused=false,revision=0,remaining=nil,key=nil,served=false,flash=0},Practice)
end
function Practice:reset(difficulty)
 self.difficulty=difficulty or "Normal"
 self.paused=false; self.revision+=1
 self.remaining=nil; self.key=nil; self.served=false; self.flash=0
end
function Practice:select(difficulty)
 if not self.Profiles[difficulty] or difficulty==self.difficulty then return false end
 self:reset(difficulty)
 return true
end
function Practice:setPaused(paused)
 if type(paused)~="boolean" or paused==self.paused then return false end
 self.paused=paused; self.revision+=1
 return true
end
function Practice:step(key,dt)
 if self.paused then return false end
 self.flash=math.max(0,self.flash-dt)
 if not key then self.key=nil; self.remaining=nil; self.served=false; return false end
 if key~=self.key then
  self.key=key; self.remaining=3; self.served=false
  return false
 end
 if self.served then return false end
 self.remaining=math.max(0,self.remaining-dt)
 if self.remaining>0 then return false end
 self.served=true; self.remaining=nil; self.flash=0.6
 return true
end
function Practice:snapshot()
 return {difficulty=self.difficulty,paused=self.paused,revision=self.revision,
  countdown=not self.paused and self.remaining and math.ceil(self.remaining) or nil,
  remaining=self.remaining,serve=self.flash>0 and not self.paused}
end
return Practice
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">ServeRotation</string>
          <string name="Source"><![CDATA[-- Side-out scoring and service positions, independent of characters and physics.
-- Server numbers are turns within a possession, not permanent player numbers.
local Rotation={}
Rotation.__index=Rotation
local function index(side) return side==1 and 1 or 2 end
local function contains(team,id) return id~=nil and table.find(team,id)~=nil end
local function other(team,id) return team[1]==id and team[2] or team[1] end

function Rotation.new()
 return setmetatable({score={0,0},teams={[1]={},[-1]={}},right={},side=1,number=1,opening=true},Rotation)
end

function Rotation:setTeams(home,away)
 for _,side in ipairs({1,-1}) do
  local team=table.clone(side==1 and home or away)
  assert(#team<=2,"A court supports at most two players per team")
  local previous=self.teams[side]
  if #previous==1 and #team==2 and contains(team,previous[1]) then
   self.right[side]=self.score[index(side)]%2==0 and previous[1] or other(team,previous[1])
  elseif not contains(team,self.right[side]) then self.right[side]=team[1] end
  self.teams[side]=team
 end
 if #self.teams[self.side]==0 then self.side=-self.side end
 local team=self.teams[self.side]
 if not contains(team,self.serverId) then self.serverId=self.right[self.side]; self.number=1 end
 if #team<2 then self.number=1
 elseif self.opening then self.number=2 end
end

function Rotation:serveX()
 local team=self.teams[self.side]
 local right=#team<2 and self.score[index(self.side)]%2==0
  or (#team==2 and self.serverId==self.right[self.side])
 return self.side*(right and 10 or -10)
end

function Rotation:receiverId()
 local side=-self.side
 local team=self.teams[side]
 if #team<2 then return team[1] end
 return self:serveX()*self.side>0 and self.right[side] or other(team,self.right[side])
end

function Rotation:award(winner)
 if winner==self.side then
  self.score[index(winner)]+=1
  if #self.teams[winner]==2 then self.right[winner]=other(self.teams[winner],self.right[winner]) end
  return "point"
 end
 local team=self.teams[self.side]
 if #team==2 and self.number==1 then
  self.serverId=other(team,self.serverId); self.number=2
  return "secondServer"
 end
 self.opening=false; self.side=-self.side; self.number=1
 self.serverId=self.right[self.side]
 return "sideOut"
end

function Rotation:reset()
 self.score={0,0}; self.side=1; self.opening=true
 for _,side in ipairs({1,-1}) do self.right[side]=self.teams[side][1] end
 self.serverId=self.right[1]; self.number=#self.teams[1]==2 and 2 or 1
end

return Rotation
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Spectator</string>
          <string name="Source"><![CDATA[-- Presentation only; admission and match membership remain in the existing Session flow.
local Spectator={}
local active={}
local slots={}
local function snapshot(instance)
 if instance:IsA("BasePart") then
  return {Transparency=instance.Transparency,CanCollide=instance.CanCollide,CanTouch=instance.CanTouch,CanQuery=instance.CanQuery,CastShadow=instance.CastShadow,Anchored=instance.Anchored}
 elseif instance:IsA("Decal") then return {Transparency=instance.Transparency}
 elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam") or instance:IsA("BillboardGui") then return {Enabled=instance.Enabled} end
end
function Spectator.leave(player)
 local state=active[player]; if not state then return end
 active[player]=nil; slots[state.slot]=nil
 state.connection:Disconnect()
 if state.track then state.track:Stop(0) end
 state.clone:Destroy()
 for instance,properties in pairs(state.saved) do
  if instance.Parent then for key,value in pairs(properties) do instance[key]=value end end
 end
 local h=state.character:FindFirstChildOfClass("Humanoid")
 if h then h.DisplayDistanceType=state.display; h.AutoRotate=state.rotate end
end
function Spectator.enter(player,character)
 Spectator.leave(player)
 local slot=1; while slots[slot] do slot+=1 end; slots[slot]=true
 local wasArchivable=character.Archivable; character.Archivable=true
 local clone=character:Clone(); character.Archivable=wasArchivable
 clone.Name=player.DisplayName.." (Spectator)"
 clone:SetAttribute("SpectatorUserId",player.UserId)
 for _,item in ipairs(clone:GetDescendants()) do
  if item:IsA("LuaSourceContainer") or item:IsA("Tool") or item.Name=="PaddleFace" or item.Name=="PaddleGrip" then item:Destroy() end
 end
 local h=clone:FindFirstChildOfClass("Humanoid")
 if h then h.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None; h.AutoRotate=false; h.EvaluateStateMachine=false end
 -- Reuse the court's lounge benches; no seat instances or seat welds are created.
 local court=workspace:FindFirstChild("PaddleUp")
 local benches={}
 if court then
  for _,item in ipairs(court:GetDescendants()) do
   if item:IsA("BasePart") and item.Name=="Lounge seat" then table.insert(benches,item) end
  end
 end
 table.sort(benches,function(a,b) return a.Position.Z<b.Position.Z end)
 local cr=clone:FindFirstChild("HumanoidRootPart")
 local bench=benches[(slot-1)%math.max(1,#benches)+1]
 local function positionClone()
  if not bench or not cr then return end
  local row=math.floor((slot-1)/#benches)
  -- Three generous positions per ten-stud bench, centered along its long axis.
  local offset=({0,-3,3})[row%3+1]
  local thigh=clone:FindFirstChild("LeftUpperLeg") or clone:FindFirstChild("Left Leg")
  local inset=thigh and thigh.Size.Y*0.65 or 1
  local front=math.max(0,bench.Size.Z/2-inset)
  local center=bench.CFrame:PointToWorldSpace(Vector3.new(offset,bench.Size.Y/2,front))
  local forward=-bench.CFrame.LookVector
  local toward=Vector3.new(forward.X,0,forward.Z).Unit
  local pelvis=clone:FindFirstChild("LowerTorso") or clone:FindFirstChild("Torso")
  local height=pelvis and pelvis.Size.Y/2 or 1
  cr.CFrame=CFrame.lookAt(center+Vector3.yAxis*height,center+Vector3.yAxis*height+toward)
 end
 for _,item in ipairs(clone:GetDescendants()) do
  if item:IsA("BasePart") then
   item.Anchored=item==cr; item.Massless=true
   item.CanCollide=false; item.CanTouch=false; item.CanQuery=false
  elseif item:IsA("Motor6D") then item.Transform=CFrame.identity end
 end
 positionClone()
 clone.Parent=court or workspace
 -- Parenting a Humanoid initializes torso collision flags; clear them afterward.
 for _,item in ipairs(clone:GetDescendants()) do
  if item:IsA("BasePart") then item.CanCollide=false; item.CanTouch=false; item.CanQuery=false end
 end
 local animation=Instance.new("Animation")
 animation.Name="Spectator seated pose"
 -- Prefer the avatar's configured sit clip; Roblox's rig-specific sit is the fallback.
 local animate=character:FindFirstChild("Animate")
 local sit=animate and animate:FindFirstChild("sit")
 local source=sit and sit:FindFirstChildWhichIsA("Animation",true)
 animation.AnimationId=source and source.AnimationId or (h.RigType==Enum.HumanoidRigType.R6 and "rbxassetid://178130996" or "rbxassetid://2506281703")
 animation.Parent=clone
 local animator=h:FindFirstChildOfClass("Animator") or Instance.new("Animator",h)
 for _,track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end
 h.Sit=true
 local track=animator:LoadAnimation(animation)
 track.Priority=Enum.AnimationPriority.Action; track.Looped=true; track:Play(0)
 local realHumanoid=character:FindFirstChildOfClass("Humanoid")
 local state={character=character,clone=clone,track=track,slot=slot,saved={},display=realHumanoid.DisplayDistanceType,rotate=realHumanoid.AutoRotate}
 active[player]=state
 -- Let the Animator resolve the pose before fitting the thighs to the cushion.
 task.spawn(function()
  local deadline=os.clock()+5
  repeat task.wait() until track.Length>0 or not clone.Parent or os.clock()>deadline
  if active[player]~=state or not clone.Parent or not bench then return end
  track.TimePosition=math.min(0.1,track.Length/2); track:AdjustSpeed(0)
  game:GetService("RunService").Heartbeat:Wait()
  game:GetService("RunService").Heartbeat:Wait()
  if active[player]~=state or not clone.Parent then return end
  local lowest=math.huge
  for _,name in ipairs(h.RigType==Enum.HumanoidRigType.R15 and {"LeftUpperLeg","RightUpperLeg"} or {"Left Leg","Right Leg"}) do
   local thigh=clone:FindFirstChild(name)
   if thigh then
    local cf,size=thigh.CFrame,thigh.Size
    local radius=(math.abs(cf.RightVector.Y)*size.X+math.abs(cf.UpVector.Y)*size.Y+math.abs(cf.LookVector.Y)*size.Z)/2
    lowest=math.min(lowest,thigh.Position.Y-radius)
   end
  end
  if lowest<math.huge then
   local top=bench.Position.Y+bench.Size.Y/2
   cr.CFrame+=Vector3.yAxis*(top-lowest+0.03)
  end
 end)
 local function hide(item)
  local properties=snapshot(item); if not properties then return end
  state.saved[item]=properties
  if item:IsA("BasePart") then
   item.Transparency=1; item.CanCollide=false; item.CanTouch=false; item.CanQuery=false; item.CastShadow=false
   if item.Name=="HumanoidRootPart" then item.Anchored=true end
  elseif item:IsA("Decal") then item.Transparency=1 else item.Enabled=false end
 end
 state.connection=character.DescendantAdded:Connect(hide)
 for _,item in ipairs(character:GetDescendants()) do hide(item) end
 realHumanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None; realHumanoid.AutoRotate=false
 character:PivotTo(CFrame.new(0,185,600))
end
return Spectator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Rooftop environment, shared by the edit-time builder and game startup.
local World = {}
-- Gameplay physics uses a fixed court origin. Restore saved courts moved in Studio.
function World.alignCourt(root)
 local surface=root:FindFirstChild("Playing surface")
 if not surface or not surface:IsA("BasePart") then return root end
 local target=CFrame.new(0,181.16,0)
 if (surface.Position-target.Position).Magnitude>0.01
  or surface.CFrame.LookVector:Dot(target.LookVector)<0.9999
  or surface.CFrame.UpVector:Dot(target.UpVector)<0.9999 then
  local delta=target*surface.CFrame:Inverse()
  root:PivotTo(delta*root:GetPivot())
 end
 return root
end
-- A versioned rig also installs on saved courts without rebuilding the scenery.
function World.addCourtLights(root)
 local existing=root:FindFirstChild("RallyLights")
 if existing and existing:GetAttribute("Version")==4 then return existing end
 if existing then existing:Destroy() end
 local rig=Instance.new("Model")
 rig.Name="RallyLights"; rig:SetAttribute("Version",4)
 local idle=Color3.fromRGB(92,211,201)
 local function fixture(name,size,position,color,neon)
  local p=Instance.new("Part")
  p.Name=name; p.Size=size; p.Position=position; p.Color=color
  p.Material=neon and Enum.Material.Neon or Enum.Material.Metal
  p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.CastShadow=false
  p.Parent=rig
  return p
 end
 for _,x in ipairs({-30,30}) do
  for _,z in ipairs({-54,0,54}) do
   fixture("Light mast",Vector3.new(0.4,23,0.4),Vector3.new(x,192.5,z),Color3.fromRGB(27,46,52))
   fixture("Light housing",Vector3.new(4,0.4,2),Vector3.new(x,204,z),Color3.fromRGB(27,46,52))
   local lamp=fixture("Court wash",Vector3.new(3.7,0.15,1.7),Vector3.new(x,203.75,z),idle,true)
   local light=Instance.new("SurfaceLight")
   light.Face=Enum.NormalId.Bottom; light.Angle=125; light.Range=48
   -- Permanent neutral court lighting; rally colors are an accent above this baseline.
   light.Enabled=true; light.Brightness=2.2; light.Color=Color3.fromRGB(235,242,255); light.Shadows=false; light.Parent=lamp
  end
 end
 -- Broad neutral fills cover both baselines and the kitchen, even between rallies.
 -- Invisible emitters avoid adding bright ceiling geometry above the open court.
 for _,x in ipairs({-10,10}) do
  for _,z in ipairs({-28,0,28}) do
   local panel=fixture("Court fill panel",Vector3.new(18,0.1,24),Vector3.new(x,198,z),Color3.new(1,1,1))
   panel.Transparency=1
   local light=Instance.new("SurfaceLight")
   light.Name="Permanent court fill"; light.Face=Enum.NormalId.Bottom
   light.Enabled=true; light.Angle=130; light.Range=32; light.Brightness=0.5
   light.Color=Color3.fromRGB(228,244,255); light.Shadows=false; light.Parent=panel
  end
 end
 rig.Parent=root
 return rig
end
-- Update saved/edit-time courts too, without rebuilding their scenery.
function World.updateLayout(root)
 World.alignCourt(root)
 for _,p in ipairs(root:GetChildren()) do
  if p.Name=="Club sign" or p.Name=="Court glass fence" or p.Name=="Court end glass"
   or p.Name=="Fence upright" or p.Name=="Fence top rail" then p:Destroy()
  elseif p:IsA("BasePart") then
   local pos=p.Position
   if p.Name=="Court surround" then
    p.Size=Vector3.new(64,0.12,168)
    p.Color=Color3.fromRGB(136,128,163); p.Material=Enum.Material.SmoothPlastic
   elseif p.Name=="Playing surface" then p.Color=Color3.fromRGB(43,123,134); p.Material=Enum.Material.SmoothPlastic
   elseif p.Name=="Kitchen" then p.Color=Color3.fromRGB(55,143,147); p.Material=Enum.Material.SmoothPlastic
   elseif p.Name=="Roof deck" then p.Size=Vector3.new(132,3,180); p.Color=Color3.fromRGB(217,216,227)
   elseif p.Name=="Lounge back" then p.Color=Color3.fromRGB(193,145,170)
   elseif p.Name=="Pergola slat" then p.Color=Color3.fromRGB(82,67,83)
   elseif p.Name=="City tower" then p.Color=Color3.fromRGB(95,103,127)
   elseif p.Name=="Safety glass" then p.Size=Vector3.new(0.2,4,180)
   elseif p.Name=="Rooftop parapet" then
    p.Color=Color3.fromRGB(217,216,227)
    if p.Size.Z>p.Size.X then p.Size=Vector3.new(1,3,180)
    else p.Position=Vector3.new(pos.X,pos.Y,math.sign(pos.Z)*89) end
   end
  end
 end
 if not root:GetAttribute("CourtFacingBenches") then
  for _,item in ipairs(root:GetChildren()) do
   if item:IsA("BasePart") and (item.Name=="Lounge seat" or item.Name=="Lounge back" or item.Name=="Lounge legs") then
    local z=item.Name=="Lounge back" and item.Position.Z+2 or item.Position.Z
    local pivot=CFrame.new(45,183,z)
    item.CFrame=pivot*CFrame.Angles(0,-math.pi/2,0)*pivot:ToObjectSpace(item.CFrame)
   end
  end
  root:SetAttribute("CourtFacingBenches",true)
 end
 World.addCourtLights(root)
 require(script.Parent:WaitForChild("CourtsideClub")).build(root)
 return root
end
function World.build()
 local existing = workspace:FindFirstChild("PaddleUp")
 if existing then return World.updateLayout(existing) end
 local root = Instance.new("Model")
 root.Name = "PaddleUp"
 root.Parent = workspace
 local function part(name, size, position, color, material, parent)
  local p = Instance.new("Part")
  p.Name, p.Size, p.Position = name, size, position
  p.Anchored = true
  p.Color = color
  p.Material = material or Enum.Material.SmoothPlastic
  p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
  p.Parent = parent or root
  return p
 end
 local cream = Color3.fromRGB(217,216,227)
 local dark = Color3.fromRGB(27,46,52)
 local teal = Color3.fromRGB(43,123,134)
 local coral = Color3.fromRGB(193,145,170)
 local white = Color3.fromRGB(246,244,220)
 local apartment = part("Apartment tower", Vector3.new(126,176,138),Vector3.new(0,90,0),Color3.fromRGB(92,102,110),Enum.Material.Concrete)
 for y=12,168,12 do
  part("Balcony slab",Vector3.new(131,0.8,142),Vector3.new(0,y,0),cream,Enum.Material.Concrete)
  for x=-50,50,20 do
   for _,z in ipairs({-69.1,69.1}) do
    local w=part("Apartment glazing",Vector3.new(13,7,0.2),Vector3.new(x,y+5,z),Color3.fromRGB(75,121,139),Enum.Material.Glass)
    w.Reflectance=0.25
   end
  end
 end
 part("Roof deck",Vector3.new(132,3,144),Vector3.new(0,179.5,0),cream,Enum.Material.Concrete)
 part("Court surround",Vector3.new(52,0.12,96),Vector3.new(0,181.06,0),Color3.fromRGB(136,128,163))
 part("Playing surface",Vector3.new(40,0.16,80),Vector3.new(0,181.16,0),teal,Enum.Material.SmoothPlastic)
 for _,z in ipairs({-7,7}) do
  part("Kitchen",Vector3.new(40,0.02,14),Vector3.new(0,181.255,z),Color3.fromRGB(55,143,147),Enum.Material.SmoothPlastic)
 end
 for _,x in ipairs({-20,20}) do part("Sideline",Vector3.new(0.18,0.025,80.2),Vector3.new(x,181.28,0),white) end
 for _,z in ipairs({-40,-14,14,40}) do part("Court line",Vector3.new(40,0.025,0.18),Vector3.new(0,181.28,z),white) end
 for _,z in ipairs({-27,27}) do part("Service center line",Vector3.new(0.18,0.025,26),Vector3.new(0,181.28,z),white) end
 for _,x in ipairs({-21,21}) do part("Net post",Vector3.new(0.4,4,0.4),Vector3.new(x,183,0),dark,Enum.Material.Metal) end
 local net=part("Net collision",Vector3.new(42,3.1,0.18),Vector3.new(0,182.8,0),dark)
 net.Transparency=0.8
 part("Net white tape",Vector3.new(42,0.15,0.22),Vector3.new(0,184.4,0),white)
 for x=-20,20,1 do part("Net cord",Vector3.new(0.035,3,0.035),Vector3.new(x,182.8,0),dark).CanCollide=false end
 for y=181.5,184.25,0.5 do part("Net cord",Vector3.new(42,0.035,0.035),Vector3.new(0,y,0),dark).CanCollide=false end
 for _,x in ipairs({-65,65}) do
  part("Rooftop parapet",Vector3.new(1,3,144),Vector3.new(x,182.5,0),cream)
  local g=part("Safety glass",Vector3.new(0.2,4,144),Vector3.new(x,186,0),Color3.fromRGB(164,208,207),Enum.Material.Glass)
  g.Transparency=0.55
 end
 for _,z in ipairs({-71,71}) do
  part("Rooftop parapet",Vector3.new(132,3,1),Vector3.new(0,182.5,z),cream)
 end
 part("Pool coping",Vector3.new(25,0.45,49),Vector3.new(-46,181.3,0),white)
 local water=part("Rooftop pool",Vector3.new(22,0.1,46),Vector3.new(-46,181.56,0),Color3.fromRGB(61,173,192),Enum.Material.Glass)
 water.Transparency=0.22
 water.Reflectance=0.25
 for z=-18,18,6 do part("Pool lane tile",Vector3.new(20,0.025,0.09),Vector3.new(-46,181.63,z),Color3.fromRGB(128,217,218)) end
 local function plant(x,z)
  part("Planter",Vector3.new(4,2.5,4),Vector3.new(x,182.25,z),dark,Enum.Material.Concrete)
  part("Tree trunk",Vector3.new(0.7,7,0.7),Vector3.new(x,185,z),Color3.fromRGB(111,83,58),Enum.Material.Wood)
  local crown=part("Topiary",Vector3.new(6,7,6),Vector3.new(x,189,z),Color3.fromRGB(57,108,77),Enum.Material.Grass)
  crown.Shape=Enum.PartType.Ball
 end
 for _,x in ipairs({-57,-33,34,57}) do for _,z in ipairs({-57,57}) do plant(x,z) end end
 for _,z in ipairs({-26,0,26}) do
  part("Lounge seat",Vector3.new(10,1,4),Vector3.new(45,183,z),white,Enum.Material.Fabric)
  part("Lounge back",Vector3.new(10,3,0.8),Vector3.new(45,184,z-2),coral,Enum.Material.Fabric)
  for _,x in ipairs({41,49}) do part("Lounge legs",Vector3.new(0.4,2,3),Vector3.new(x,182,z),dark) end
  part("Side table",Vector3.new(3,2,3),Vector3.new(54,182,z),dark)
 end
 for _,x in ipairs({35,57}) do for _,z in ipairs({-38,38}) do part("Pergola pillar",Vector3.new(0.5,12,0.5),Vector3.new(x,187,z),dark,Enum.Material.Metal) end end
 for z=-39,39,3 do part("Pergola slat",Vector3.new(25,0.35,0.8),Vector3.new(46,193,z),Color3.fromRGB(82,67,83),Enum.Material.Wood) end
 local rng=Random.new(82)
 for i=1,30 do
  local angle=i*math.pi*2/30
  local radius=rng:NextNumber(160,310)
  local x,z=math.cos(angle)*radius,math.sin(angle)*radius
  local height=rng:NextInteger(65,220)
  local width=rng:NextInteger(25,46)
  part("City tower",Vector3.new(width,height,width),Vector3.new(x,height/2-5,z),Color3.fromRGB(rng:NextInteger(66,104),rng:NextInteger(78,113),rng:NextInteger(90,123)),Enum.Material.Concrete)
  for y=12,height-8,14 do
   for _,dx in ipairs({-width/2-0.05,width/2+0.05}) do
    part("City window ribbon",Vector3.new(0.1,3,width-5),Vector3.new(x+dx,y,z),Color3.fromRGB(194,174,131),Enum.Material.Neon)
   end
   for _,dz in ipairs({-width/2-0.05,width/2+0.05}) do
    part("City window ribbon",Vector3.new(width-5,3,0.1),Vector3.new(x,y,z+dz),Color3.fromRGB(144,169,181),Enum.Material.Glass)
   end
  end
 end
 local spawn=workspace:FindFirstChildWhichIsA("SpawnLocation")
 if not spawn then spawn=Instance.new("SpawnLocation"); spawn.Name="SpawnLocation"; spawn.Parent=workspace end
 if spawn then
  spawn.CFrame=CFrame.new(0,181.5,29)
  spawn.Size=Vector3.new(5,0.3,5)
  spawn.Transparency=1
  spawn.CanCollide=false
  spawn.Neutral=true
  spawn.Duration=0
  for _,v in ipairs(spawn:GetChildren()) do if v:IsA("Decal") then v.Transparency=1 end end
 end
 local base=workspace:FindFirstChild("Baseplate")
 if not base then base=part("Baseplate",Vector3.new(1200,2,1200),Vector3.new(0,-6,0),dark); base.Parent=workspace end
 if base then base.Position=Vector3.new(0,-6,0); base.Size=Vector3.new(1200,2,1200); base.Color=Color3.fromRGB(54,67,73) end
 local lighting=game:GetService("Lighting")
 lighting.ClockTime=17.3
 lighting.Brightness=2.5
 lighting.Ambient=Color3.fromRGB(132,145,166)
 lighting.OutdoorAmbient=Color3.fromRGB(153,158,173)
 lighting.GlobalShadows=true
 local atmosphere=lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere",lighting)
 atmosphere.Density=0.26
 atmosphere.Color=Color3.fromRGB(239,210,181)
 atmosphere.Decay=Color3.fromRGB(130,148,174)
 local bloom=lighting:FindFirstChildOfClass("BloomEffect")
 if bloom then bloom.Intensity=0.15; bloom.Size=24; bloom.Threshold=1.5 end
 local dof=lighting:FindFirstChildOfClass("DepthOfFieldEffect")
 if dof then dof.Enabled=false end
 return World.updateLayout(root)
end
return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="31">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="32">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="33">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[local PowerupVisuals=require(script:WaitForChild("PowerupVisuals"))
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local CAS=game:GetService("ContextActionService")
local TweenService=game:GetService("TweenService")
local SoundService=game:GetService("SoundService")
local Debris=game:GetService("Debris")
local player=Players.LocalPlayer
require(script:WaitForChild("EnvironmentLighting")).start(player)
local DiveController=require(script:WaitForChild("DiveController"))
require(script:WaitForChild("JumpController")).start(player)
local HitboxOverlay=require(script:WaitForChild("HitboxOverlay"))
local RallyEffects=require(script:WaitForChild("RallyEffects"))
local BallShadow=require(script:WaitForChild("BallShadow"))
local FloatingText=require(script:WaitForChild("FloatingText"))
local developerMode=false
local lobbyCamera=require(script:WaitForChild("LobbyCamera")).new(player,UIS)
local Rules
local function canServe(data)
 return Rules~=nil and data~=nil and data.canServe==true and Rules.canServe(player.UserId,data.serverId,data.serveReady)
end
local network=ReplicatedStorage:WaitForChild("PaddleUp")
local input,state,feedback=network:WaitForChild("Input"),network:WaitForChild("State"),network:WaitForChild("Feedback")
require(script:WaitForChild("MainMenu")).start(player,network)
require(script:WaitForChild("ArcadeLoadout")).start(player,network)
local MatchSetup=require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MatchSetup"))
require(script:WaitForChild("PowerupDraft")).start(player,network)
require(script:WaitForChild("MatchIntro")).start(player,network)
require(script:WaitForChild("PracticeUI")).start(player,network)
require(script:WaitForChild("HowToPlay")).start(player,network)
require(script:WaitForChild("ArcadeSlots")).start(player,network)
local function playing() return not player:GetAttribute("HowToPlayOpen") and not player:GetAttribute("PracticeMenuOpen") and not player:GetAttribute("PracticePaused") and (player:GetAttribute("CourtSide") or 0)~=0 and not player:GetAttribute("LeaveConfirmationOpen") and not player:GetAttribute("PowerupDraftOpen") and not player:GetAttribute("PowerupDetailsOpen") end
local cream=Color3.fromRGB(247,239,215)
local mint=Color3.fromRGB(92,233,190)
local coral=Color3.fromRGB(249,139,109)
local dark=Color3.fromRGB(19,37,44)
local gui=Instance.new("ScreenGui")
gui.Name="PaddleUpHUD"; gui.ResetOnSpawn=false; gui.IgnoreGuiInset=true; gui.Parent=player:WaitForChild("PlayerGui")
local canvas=Instance.new("Frame",gui)
canvas.Size=UDim2.fromOffset(1280,800); canvas.AnchorPoint=Vector2.new(0.5,0.5); canvas.Position=UDim2.fromScale(0.5,0.5); canvas.BackgroundTransparency=1
local crosshair=Instance.new("Frame",gui)
crosshair.Name="Crosshair"; crosshair.AnchorPoint=Vector2.new(0.5,0.5); crosshair.Position=UDim2.fromScale(0.5,0.5)
crosshair.Size=UDim2.fromOffset(24,24); crosshair.BackgroundTransparency=1; crosshair.Visible=false
for _,shape in ipairs({{0,11,8,2},{16,11,8,2},{11,0,2,8},{11,16,2,8}}) do
 local bar=Instance.new("Frame",crosshair)
