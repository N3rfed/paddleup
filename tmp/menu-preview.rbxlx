      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">MatchRules</string>
          <string name="Source"><![CDATA[-- Court coordinates match the painted lines in World.
local Rules={HALF_WIDTH=20,BASELINE=40,KITCHEN=14,HIT_RANGE=12,PERFECT_RANGE=9,SLAM_RANGE=16,SLAM_HORIZONTAL=8,REAR_REACH=1.5,SLAM_MIN_HEIGHT=0.5,SLAM_EXTRA_HEIGHT=5,BACK_LIMIT=60}

Rules.DIVE_COOLDOWN=1.75
Rules.DIVE_STAMINA_COST=35
Rules.STAMINA_RECOVERY_DELAY=1.0
Rules.STAMINA_REGEN_RATE=22*0.55
Rules.JUMP_HANG_TIME=1
Rules.JUMP_DESCENT_GRAVITY=4
Rules.SLAM_TIMING_WINDOW=0.06

function Rules.canDive(stamina,readyAt,now)
 return now>=readyAt and stamina>=Rules.DIVE_STAMINA_COST
end

function Rules.recoverStamina(stamina,recoveryAt,now,dt)
 local elapsed=math.min(math.max(0,dt),math.max(0,now-recoveryAt))
 return math.min(100,stamina+elapsed*Rules.STAMINA_REGEN_RATE)
end

Rules.LOB_RESTITUTION=0.45
Rules.LOB_GRAVITY_SCALE=1.6
Rules.LOB_HORIZONTAL_RETENTION=0.75

-- Split a frame at the apex so heavier descent gravity never changes ascent.
function Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce)
 if lob and not postBounce and velocity.Y>0 then
  local timeToApex=velocity.Y/gravity
  local ascent=math.min(dt,timeToApex)
  position+=velocity*ascent-Vector3.new(0,0.5*gravity*ascent*ascent,0)
  velocity-=Vector3.new(0,gravity*ascent,0)
  -- Floating-point residue at the apex must not defer the heavier descent.
  if dt>=timeToApex then velocity=Vector3.new(velocity.X,0,velocity.Z) end
  dt-=ascent
 end
 local acceleration=gravity*(lob and (postBounce or velocity.Y<=0) and Rules.LOB_GRAVITY_SCALE or 1)
 position+=velocity*dt-Vector3.new(0,0.5*acceleration*dt*dt,0)
 velocity-=Vector3.new(0,acceleration*dt,0)
 return position,velocity,acceleration
end

-- Offensive topspin switches gravity at the net plane, splitting crossing frames.
function Rules.advanceFlight(position,velocity,gravity,dt,lob,postBounce,offensive,side)
 if not offensive then return Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce) end
 if position.Z*side<=0 then return Rules.advanceBall(position,velocity,gravity*1.8,dt,lob,postBounce) end
 local crossing=velocity.Z~=0 and -position.Z/velocity.Z or math.huge
 if crossing>=0 and crossing<=dt then
  position,velocity=Rules.advanceBall(position,velocity,gravity,crossing,lob,postBounce)
  return Rules.advanceBall(position,velocity,gravity*1.8,dt-crossing,lob,postBounce)
 end
 return Rules.advanceBall(position,velocity,gravity,dt,lob,postBounce)
end

function Rules.ballLandingTime(height,vy,gravity,lob,postBounce)
 height=math.max(0,height)
 if lob and not postBounce and vy>0 then
  local ascent=vy/gravity
  local peak=height+vy*vy/(2*gravity)
  return ascent+math.sqrt(2*peak/(gravity*Rules.LOB_GRAVITY_SCALE))
 end
 local acceleration=gravity*(lob and Rules.LOB_GRAVITY_SCALE or 1)
 return (vy+math.sqrt(vy*vy+2*acceleration*height))/acceleration
end

-- Solve the launch arc with the same piecewise gravity used by simulation.
function Rules.lobLaunchY(height,duration,gravity)
 local descending=(0.5*gravity*Rules.LOB_GRAVITY_SCALE*duration*duration-height)/duration
 if descending<=0 then return descending end
 local low,high=0,gravity*duration
 for _=1,40 do
  local vy=(low+high)/2
  local descent=duration-vy/gravity
  local y=height+vy*vy/(2*gravity)-0.5*gravity*Rules.LOB_GRAVITY_SCALE*descent*descent
  if y>0 then high=vy else low=vy end
 end
 return (low+high)/2
end

function Rules.bounceVelocity(velocity,lob)
 if lob then
  return Vector3.new(velocity.X*Rules.LOB_HORIZONTAL_RETENTION,
   math.max(0,-velocity.Y)*Rules.LOB_RESTITUTION,velocity.Z*Rules.LOB_HORIZONTAL_RETENTION)
 end
 return Vector3.new(velocity.X,math.max(15,-velocity.Y*0.78),velocity.Z)
end

Rules.SERVE_TIMEOUT=15
Rules.BOT_SERVE_DELAY=2
Rules.MAX_SERVE_VELOCITY=90

function Rules.canServe(userId,serverId,ready)
 return ready==true and userId~=nil and userId~=0 and userId==serverId
end

Rules.SERVE_CHARGE_TIME=2
Rules.SERVE_PERFECT_OFFSET=0.06
Rules.SERVE_GOOD_OFFSET=0.4
Rules.SERVE_NET_OFFSET=-0.65

-- Hold to sweep up and down; release is judged at the current position.
function Rules.serveTiming(started,now)
 local phase=math.max(0,now-started)%(Rules.SERVE_CHARGE_TIME*2)/Rules.SERVE_CHARGE_TIME
 local needle=phase<=1 and phase or 2-phase
 local offset=needle*2-1
 local accuracy=1-math.abs(offset)
 local grade=math.abs(offset)<=Rules.SERVE_PERFECT_OFFSET+1e-9 and "PERFECT!"
  or math.abs(offset)<=Rules.SERVE_GOOD_OFFSET+1e-9 and "GOOD"
  or offset<0 and "UNDERCHARGED" or "OVERCHARGED"
 return needle,offset,accuracy,grade
end

function Rules.servePower(charge)
 return 0.3+0.7*math.clamp(charge,0,2)
end

function Rules.timedServeTarget(side,serveX,offset)
 offset=math.clamp(offset,-1,1)
 local depth
 if offset < -Rules.SERVE_GOOD_OFFSET-1e-9 then
  depth=math.max(4,13*(offset+1)/(1-Rules.SERVE_GOOD_OFFSET))
 elseif offset>Rules.SERVE_GOOD_OFFSET+1e-9 then
  depth=42+20*(offset-Rules.SERVE_GOOD_OFFSET)
 else depth=28+offset*22 end
 return Vector3.new(-math.sign(serveX)*10,181.7,-side*depth)
end

-- Ignore invalid remote targets and keep aim inside the diagonal service box.
function Rules.serveTarget(target,side,serveX)
 local fallback=Vector3.new(-serveX,181.7,-side*28)
 if typeof(target)~="Vector3" then return fallback end
 for _,value in ipairs({target.X,target.Y,target.Z}) do
  if value~=value or math.abs(value)==math.huge then return fallback end
 end
 local x=math.clamp(target.X* -math.sign(serveX),1,Rules.HALF_WIDTH-1)
 local depth=math.clamp(-target.Z*side,Rules.KITCHEN+2,Rules.BASELINE-2)
 return Vector3.new(-math.sign(serveX)*x,181.7,-side*depth)
end

function Rules.serveX(side,score)
 return side*(score%2==0 and 10 or -10)
end

function Rules.inKitchen(position,margin)
 margin=margin or 0
 return math.abs(position.X)<=Rules.HALF_WIDTH+margin and math.abs(position.Z)<=Rules.KITCHEN+margin
end

function Rules.servePositionValid(position,side,serveX,grounded)
 return grounded and position.Z*side>Rules.BASELINE+1
  and math.abs(position.X)<Rules.HALF_WIDTH-1 and position.X*math.sign(serveX)>1
end

function Rules.serveLandingValid(position,side,serveX)
 return position.Z*side< -Rules.KITCHEN-0.09 and math.abs(position.Z)<=Rules.BASELINE+0.09
  and math.abs(position.X)<=Rules.HALF_WIDTH+0.09 and position.X*math.sign(serveX)<=0.09
end

function Rules.returnFault(bounces,shots,inKitchen)
 if bounces>0 then return nil end
 if shots<2 then return "Two-bounce rule: let the ball bounce" end
 if inKitchen then return "Kitchen volley fault" end
 return nil
end

function Rules.startPosition(side,servingSide,serveX,primary)
 local serving=side==servingSide
 local x=serving and serveX or -serveX
 if not primary then x=-x end
 local depth=(serving or primary) and 46 or Rules.KITCHEN+4
 return Vector3.new(x,185,side*depth)
end

-- Shared by server validation and the developer hitbox overlay.
function Rules.slamBounds(character,root)
 local head=character:FindFirstChild("Head")
 local headTop=head and head.Position.Y+head.Size.Y*0.5 or root.Position.Y+3
 local armLength=0
 for _,name in ipairs({"RightUpperArm","RightLowerArm","RightHand","Right Arm"}) do
  local part=character:FindFirstChild(name)
  if part then armLength+=part.Size.Y end
 end
 armLength=math.clamp(armLength,2,6)
 return headTop+Rules.SLAM_MIN_HEIGHT,headTop+armLength+Rules.SLAM_EXTRA_HEIGHT
end

-- Generous vertical reach, while preserving the horizontal limit.
function Rules.overheadReach(ballPosition,rootPosition,minY,maxY)
 local offset=ballPosition-rootPosition
 return Vector3.new(offset.X,0,offset.Z).Magnitude<=Rules.SLAM_HORIZONTAL
  and ballPosition.Y>=minY
  and ballPosition.Y<=maxY
end

-- Overhead contact is the timing window for lobs near the kitchen line.
function Rules.kitchenLobWindow(lob,overhead,position,side)
 local depth=position.Z*side
 return lob==true and overhead and side~=0
  and depth>Rules.KITCHEN+1 and depth<=Rules.KITCHEN+Rules.SLAM_HORIZONTAL
  and math.abs(position.X)<=Rules.HALF_WIDTH
end

function Rules.jumpSlam(position,side,grounded,diving)
 local depth=position.Z*side
 return side~=0 and not grounded and not diving and depth>=0
  and depth<=Rules.BASELINE and math.abs(position.X)<=Rules.HALF_WIDTH
end

-- Airborne spikes use a bounded strike volume above the player's shoulders.
function Rules.spikeReach(ballPosition,rootFrame,maxY)
 local offset=ballPosition-rootFrame.Position
 return Rules.contactInFront(ballPosition,rootFrame)
  and offset.Magnitude<=Rules.SLAM_RANGE
  and Vector3.new(offset.X,0,offset.Z).Magnitude<=Rules.SLAM_HORIZONTAL
  and offset.Y>=1 and ballPosition.Y<=maxY
end

function Rules.slamTiming(ballPosition,ballVelocity,contactPosition,perfectVision)
 -- Signed time to the strike plane: approaching is early, passing it is late.
 local speedSquared=ballVelocity:Dot(ballVelocity)
 local timing=speedSquared>1 and -(ballPosition-contactPosition):Dot(ballVelocity)/speedSquared or 0
 local window=Rules.SLAM_TIMING_WINDOW*(perfectVision and 1.2 or 1)
 if timing>window then return "net" end
 if timing< -window then return "out" end
 return "perfect"
end

function Rules.slamTarget(target,side,quality)
 if quality=="out" then return Vector3.new(target.X,target.Y,-side*(Rules.BASELINE+8)) end
 return target
end

-- Deterministic movement influence, shared by the crosshair and server shots.
function Rules.shotAim(rootFrame,velocity,ballPosition)
 local look=rootFrame.LookVector
 local forward=Vector3.new(look.X,0,look.Z).Unit
 local right=Vector3.new(-forward.Z,0,forward.X)
 local movement=Vector3.new(velocity.X,0,velocity.Z)
 local lateral=math.clamp(movement:Dot(right)/18,-1,1)
 local angle=lateral*math.rad(4)
 local direction=forward*math.cos(angle)+right*math.sin(angle)
 local toward=ballPosition and Vector3.new(ballPosition.X-rootFrame.Position.X,0,ballPosition.Z-rootFrame.Position.Z) or forward
 toward=toward.Magnitude>0.1 and toward.Unit or forward
 local momentum=math.clamp(movement:Dot(toward)/18,0,1)
 return direction,momentum,angle
end

function Rules.contactInFront(ballPosition,rootFrame)
 local look=rootFrame.LookVector
 local forward=Vector3.new(look.X,0,look.Z)
 if forward.Magnitude<0.001 then return false end
 return (ballPosition-rootFrame.Position):Dot(forward.Unit)>=-Rules.REAR_REACH
end

function Rules.shotQuality(clean,timeToBounce,timeSinceBounce)
 if clean then return "perfect" end
 if math.min(timeToBounce,timeSinceBounce)>0.65 then return "net" end
 return "lob"
end

function Rules.softShot(position,side)
 -- A drop from behind the kitchen line lands inside the opponent's kitchen.
 return position.Z*side<=Rules.KITCHEN+8 and "dink" or "drop"
end

function Rules.kitchenHitFault(rootPosition,grounded,kitchenTouched)
 -- Airspace is legal when taking off outside; landing is checked separately.
 if grounded then return Rules.inKitchen(rootPosition) end
 return kitchenTouched==true
end

function Rules.updateKitchen(state,position,grounded,velocity,dt)
 local touching=grounded and Rules.inKitchen(position)
 if grounded then state.kitchenTouched=touching end
 local fault=touching and state.volleyPending==true
 if state.volleyPending then
  if grounded and Vector3.new(velocity.X,0,velocity.Z).Magnitude<2 then
   state.volleySettled=(state.volleySettled or 0)+dt
   if state.volleySettled>0.15 then state.volleyPending=false end
  else state.volleySettled=0 end
 end
 return fault
end

function Rules.diveDirection(moveDirection,lookDirection,ballDirection)
 local moving=Vector3.new(moveDirection.X,0,moveDirection.Z)
 if moving.Magnitude>0.15 then return moving.Unit end
 local looking=Vector3.new(lookDirection.X,0,lookDirection.Z)
 if looking.Magnitude>0.1 then return looking.Unit end
 local ball=Vector3.new(ballDirection.X,0,ballDirection.Z)
 return ball.Magnitude>0.1 and ball.Unit or Vector3.new(0,0,-1)
end

function Rules.slamSpeedScale(rallySpeed)
 return rallySpeed*math.clamp(0.9+0.2*math.max(0,rallySpeed-1),0.9,1.3)
end

Rules.CHARGE_TIME=1
Rules.HIT_COOLDOWN=0.28
function Rules.heldBallPosition(character)
 if not character then return nil end
 local hand=character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
 if hand then return hand.CFrame:PointToWorldSpace(Vector3.new(0,-hand.Size.Y*0.5-0.3,-0.2)) end
 local root=character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Body")
 return root and root.CFrame:PointToWorldSpace(Vector3.new(-1.2,0,-1.2)) or nil
end

function Rules.hitReady(now,readyAt,perfect)
 return perfect or now>=readyAt
end

function Rules.chargeAmount(started,now)
 local delay=0.4
 return started and math.clamp((now-started-delay)/(Rules.CHARGE_TIME-delay),0,1) or 0
end

function Rules.chargeTarget(from,target,charge,severity,spread,depthRoll)
 local offset=Vector3.new(target.X-from.X,0,target.Z-from.Z)
 if offset.Magnitude<0.01 then return target end
 local forward=offset.Unit
 local right=Vector3.new(-forward.Z,0,forward.X)
 local risk=charge*charge*math.clamp(severity,0,1)
 return target+forward*((10+18*depthRoll)*risk)+right*(spread*16*risk)
end

function Rules.returnSpeed(speed,clean,slam,charged)
 if not clean then return speed*0.95 end
 if charged and not slam then return math.max(1,speed)*1.07 end
 if speed<1 then return 1 end
 return speed*(slam and 1.10 or 1.05)
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MatchSetup</string>
          <string name="Source"><![CDATA[local Setup={}
Setup.ARCADE_FEATURES_ENABLED=false
function Setup.abilities(mode) return mode=="Arcade" and Setup.ARCADE_FEATURES_ENABLED end
Setup.players={Practice=1,["1V1"]=2,["1V2"]=3,["2V2"]=4}
Setup.modes={Classic=true,Arcade=true,Chaos=true}
function Setup.valid(mode,map,modifier)
 if not Setup.modes[mode] or (map~="Rooftop" and map~="Moon") then return false end
 if mode=="Classic" then return modifier=="None" end
 if mode=="Chaos" then return modifier=="LowGravity" end
 return modifier=="None" or modifier=="LowGravity"
end
return Setup
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="11">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Server-authoritative arcade pickleball.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
game:GetService("StarterPlayer").EnableMouseLockOption=false
local courtRoot=require(script:WaitForChild("World")).build()
local Spectator=require(script:WaitForChild("Spectator"))
local Lobby=require(script:WaitForChild("Lobby"))
-- Lobby construction samples the original city parts before environments regroup them.
Lobby.build()
local CourtEnvironments=require(script:WaitForChild("CourtEnvironments"))
local environments=CourtEnvironments.new(courtRoot)
require(script:WaitForChild("DayNightCycle")).start()
local folder=ReplicatedStorage:FindFirstChild("PaddleUp") or Instance.new("Folder")
folder.Name="PaddleUp"; folder.Parent=ReplicatedStorage
local function remote(name)
 local r=folder:FindFirstChild(name) or Instance.new("RemoteEvent")
 r.Name=name; r.Parent=folder
 return r
end
local input,state,feedback=remote("Input"),remote("State"),remote("Feedback")
local session=remote("Session")
local queueRemote=remote("Queue")
local MatchSetup=require(script:WaitForChild("MatchSetup"))
local courtModifier="None"
local introReadyRemote=remote("IntroReady")
local powerupRemote=remote("Powerup")
local Powerups=require(script:WaitForChild("Powerups"))
local ArcadeDeck=require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ArcadeDeck"))
local arcade=require(script:WaitForChild("ArcadePowers")).new()
arcade:reset()
local arcadeRemote=remote("Arcade")
local loadoutRemote=remote("ArcadeLoadout")
local loadoutPending=false
local loadoutSerial=0
local loadoutDeadline
local courtVariant=nil
local draft=nil
local draftSerial=0
local draftDue=false
local rallies=0
local powerupRandom=Random.new()
local courtMode=nil
local PracticeSession=require(script:WaitForChild("PracticeSession"))
local practice=PracticeSession.new()
local practiceRemote=remote("Practice")
local practiceRoots={}
local practiceServeSerial=0
local function practicePaused()
 return courtMode=="Practice" and practice.paused
end
local function freezePracticePlayer(p)
 local c=p.Character
 local r=c and c:FindFirstChild("HumanoidRootPart")
 local h=c and c:FindFirstChildOfClass("Humanoid")
 if r and h then
  if not practiceRoots[r] then
   practiceRoots[r]={anchored=r.Anchored,humanoid=h,jumpPower=h.JumpPower,jumpHeight=h.JumpHeight}
  end
  r.Anchored=true; r.AssemblyLinearVelocity=Vector3.zero; r.AssemblyAngularVelocity=Vector3.zero
  h.WalkSpeed=0; h.JumpPower=0; h.JumpHeight=0
 end
 p:SetAttribute("PracticePaused",true)
end
local function releasePracticePlayers()
 for r,saved in pairs(practiceRoots) do
  if r.Parent then r.Anchored=saved.anchored; r.AssemblyLinearVelocity=Vector3.zero end
  if saved.humanoid.Parent then
   saved.humanoid.JumpPower=saved.jumpPower; saved.humanoid.JumpHeight=saved.jumpHeight
  end
 end
 table.clear(practiceRoots)
 for _,p in ipairs(Players:GetPlayers()) do p:SetAttribute("PracticePaused",false) end
end
local FLOOR,GRAVITY,BASE_SPEED=181.7,45,56
local WALK_SPEED,SLOWED_SPEED=18,10
local rulesModule=script:WaitForChild("MatchRules")
local Rules=require(rulesModule)
-- Existing Studio sessions may not have picked up the new Rojo shared mapping.
local shared=ReplicatedStorage:FindFirstChild("Shared") or Instance.new("Folder")
shared.Name="Shared"; shared.Parent=ReplicatedStorage
if not shared:FindFirstChild("MatchRules") then rulesModule:Clone().Parent=shared end
if not shared:FindFirstChild("MatchSetup") then script:WaitForChild("MatchSetup"):Clone().Parent=shared end
local users={}
local matchmaking=require(script:WaitForChild("MatchQueue")).new(function(player,data)
 queueRemote:FireClient(player,data)
end)
local function clearEnvironmentGravity(player)
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 if not root then return end
 for _,name in ipairs({"EnvironmentGravity","EnvironmentGravityAttachment"}) do
  local item=root:FindFirstChild(name); if item then item:Destroy() end
 end
end
local function applyEnvironmentGravity(player,root)
 local factor=(courtModifier=="LowGravity" and 0.5 or 1)*arcade:gravity(os.clock())
 if factor==1 or users[player].side==0 then clearEnvironmentGravity(player); return end
 local force=root:FindFirstChild("EnvironmentGravity")
 if not force then
  local attachment=Instance.new("Attachment"); attachment.Name="EnvironmentGravityAttachment"; attachment.Parent=root
  force=Instance.new("VectorForce"); force.Name="EnvironmentGravity"; force.Attachment0=attachment
  force.RelativeTo=Enum.ActuatorRelativeTo.World; force.ApplyAtCenterOfMass=true; force.Parent=root
 end
 force.Force=Vector3.new(0,root.AssemblyMass*workspace.Gravity*(1-factor),0)
end
local rotation=require(script:WaitForChild("ServeRotation")).new()
local score=rotation.score
local Comeback=require(script:WaitForChild("Comeback"))
local comeback=Comeback.new()
local joinSerial=0
local lastHitter={}
local ball={p=Vector3.new(0,187,-28),v=Vector3.zero,g=GRAVITY,live=false,last=-1,bounces=0,perfects=0,speed=1,bounceAt=-100}
local nextServe=0
local matchIntro=nil
local introSerial=0
local introUntil=0
local introReady={}
local introLoadDeadline=0
local serveDeadline
local servingSide,serveReady,serveX=1,false,10
local serverId,receiverId
ball.shots=0
local banner="Welcome!"
local function resetPowerups()
 draft=nil; draftDue=courtVariant=="Chaos"; rallies=0
 loadoutSerial+=1; loadoutDeadline=nil; loadoutPending=false
 arcade:reset()
 for p,d in pairs(users) do
  loadoutRemote:FireClient(p,{kind="close"})
  if courtVariant=="Arcade" and d.side~=0 and not ArcadeDeck.validate(d.arcadeDeck) then loadoutPending=true end
  d.powerups={}; d.powerupNames={}; d.powerupPulses={}; d.powerupActive={}; d.powerupMatch={}; d.powerupRally=Powerups.newRally()
  p:SetAttribute("PowerupDraftOpen",false)
  p:SetAttribute("SlowFallEnabled",false)
  powerupRemote:FireClient(p,{kind="reset"})
 end
end
loadoutRemote.OnServerEvent:Connect(function(p,serial,ids)
 local d=users[p]
 if not loadoutPending or not loadoutDeadline or serial~=loadoutSerial or os.clock()>=loadoutDeadline
  or courtVariant~="Arcade" or not d or d.side==0 or d.arcadeDeck then return end
 local deck=ArcadeDeck.validate(ids)
 if not deck then return end
 d.arcadeDeck=deck
 loadoutRemote:FireClient(p,{kind="chosen"})
end)
local function choosePowerup(p,id)
 if practicePaused() then return end
 local offer=draft and draft.offers[p]
 local d=users[p]
 if not d or d.side==0 then return end
 local card,slot
 if courtVariant=="Chaos" then
  card=arcade:chooseChaos(p,offer,id)
 else
  card,slot=arcade:choose(p,offer,id,os.clock())
 end
 if not card then return end
 draft.offers[p]=nil
 powerupRemote:FireClient(p,{kind="chosen",mode=courtVariant,sharedPowers=courtVariant=="Arcade",name=card.name,card=card,slot=slot,stats=courtVariant=="Chaos" and table.clone(arcade:data(p).levels) or d.powerups})
end
powerupRemote.OnServerEvent:Connect(function(p,serial,id)
 if draft and serial==draft.id then choosePowerup(p,id) end
end)
local function updateDraft(now)
 if loadoutPending then
  if now<introUntil then return end
  if not loadoutDeadline then
   loadoutDeadline=now+45
   for p,d in pairs(users) do
    if d.side~=0 then
     p:SetAttribute("PowerupDraftOpen",true)
     if not d.arcadeDeck then loadoutRemote:FireClient(p,{kind="open",id=loadoutSerial,endsAt=workspace:GetServerTimeNow()+45}) end
    end
   end
  end
  local waiting=false
  for p,d in pairs(users) do
   if d.side~=0 and not d.arcadeDeck then
    if now>=loadoutDeadline then
     local defaults={}
     for index=1,ArcadeDeck.SIZE do defaults[index]=ArcadeDeck.cards[index].id end
     d.arcadeDeck=ArcadeDeck.validate(defaults)
    else waiting=true end
   end
  end
  if waiting then return end
  loadoutPending=false; loadoutDeadline=nil; nextServe=now+1
  for p,d in pairs(users) do
   if d.side~=0 then p:SetAttribute("PowerupDraftOpen",false); loadoutRemote:FireClient(p,{kind="close"}) end
  end
 end
 if draftDue and not draft and not ball.live and now>=introUntil and now>=nextServe then
  if ball.resetScore then rotation:reset(); score=rotation.score; ball.resetScore=false; comeback=Comeback.new() end
  local roster={}
  local home,away=false,false
  for p,d in pairs(users) do
   if d.side~=0 then table.insert(roster,p); if d.side==1 then home=true else away=true end end
  end
  if not home or (not away and courtMode~="Practice") then return end
  table.sort(roster,function(a,b) return a.UserId<b.UserId end)
  local offers,tier={}
  if courtVariant=="Chaos" then
   for index,p in ipairs(roster) do offers[index]=arcade:chaosUpgradeOffer(p) end
  else
   for index,p in ipairs(roster) do offers[index]=arcade:offer(p,users[p].arcadeDeck,now) end
  end
  draftSerial+=1
  draft={id=draftSerial,endsAt=now+Powerups.DURATION,offers={}}
  draftDue=false; serveReady=false; serveDeadline=nil
  for index,p in ipairs(roster) do
   if not offers[index] then continue end
   draft.offers[p]=offers[index]
   users[p].chargeAt=nil; users[p].diveUntil=0
   if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end
   p:SetAttribute("PowerupDraftOpen",true)
   powerupRemote:FireClient(p,{kind="offer",mode=courtVariant,id=draft.id,sharedPowers=courtVariant=="Arcade",tier=tier,cards=offers[index],endsAt=workspace:GetServerTimeNow()+Powerups.DURATION})
  end
 end
 if draft then
  if now>=draft.endsAt then
   for p,offer in pairs(draft.offers) do choosePowerup(p,offer[1].id) end
  end
  if not next(draft.offers) then
   draft=nil; nextServe=now+1
   for p in pairs(users) do
    p:SetAttribute("PowerupDraftOpen",false)
    powerupRemote:FireClient(p,{kind="close"})
   end
  end
 end
end
local botSlowUntil=0
local botStunUntil=0
local botX,botZ=0,-28
local botRandom=Random.new()
local botShotId,botReactAt,botThinkAt,botSwingAt=nil,0,0,0
local botTarget=Vector3.new(0,0,-28)
local botError=Vector3.zero
local botAttempted=false
local botStride,botMoving=0,false
local world=workspace:WaitForChild("PaddleUp")
local powerups=require(script:WaitForChild("CourtPickups")).new(world,function(player,kind)
 player:SetAttribute("LastCollectedPowerup",kind)
 player:SetAttribute("PowerupsCollected",(player:GetAttribute("PowerupsCollected") or 0)+1)
 feedback:FireAllClients({userId=player.UserId,text="POWERUP COLLECTED / TEST",tone="good"},"playerText")
end)
local bot=Instance.new("Model")
bot.Name="Practice Partner"; bot.Parent=world
local function botPart(name,size,color)
 local p=Instance.new("Part")
 p.Name=name; p.Size=size; p.Color=color; p.Anchored=true; p.CanCollide=false; p.Parent=bot
 return p
end
local botBody=botPart("Body",Vector3.new(2.4,2.6,1.4),Color3.fromRGB(240,135,104))
local botHead=botPart("Head",Vector3.new(1.5,1.5,1.5),Color3.fromRGB(233,227,209)); botHead.Shape=Enum.PartType.Ball
local botPaddle=botPart("Paddle",Vector3.new(1.5,2.2,0.3),Color3.fromRGB(35,193,182))
local botLegs={botPart("Left leg",Vector3.new(0.8,2,0.8),Color3.fromRGB(35,55,63)),botPart("Right leg",Vector3.new(0.8,2,0.8),Color3.fromRGB(35,55,63))}
local tag=Instance.new("BillboardGui",botHead); tag.Size=UDim2.fromOffset(180,35); tag.StudsOffset=Vector3.new(0,2,0); tag.AlwaysOnTop=true
local tagText=Instance.new("TextLabel",tag); tagText.Size=UDim2.fromScale(1,1); tagText.BackgroundTransparency=1; tagText.Text="PRACTICE PARTNER"; tagText.TextColor3=Color3.fromRGB(249,235,204); tagText.Font=Enum.Font.GothamBold; tagText.TextSize=12
local function teamPlayers(side)
 local team={}
 for p,d in pairs(users) do if d.side==side then table.insert(team,p) end end
 table.sort(team,function(a,b)
  if users[a].slot==users[b].slot then return users[a].joined<users[b].joined end
  return users[a].slot<users[b].slot
 end)
 return team
end
local function occupant(side)
 local p=teamPlayers(side)[1]
 if p then return p,users[p] end
end
local function availableSlot(side)
 local occupied={}
 for _,d in pairs(users) do if d.side==side then occupied[d.slot]=true end end
 for slot=1,2 do if not occupied[slot] then return slot end end
end
local function teamName(side)
 local names={}
 for _,p in ipairs(teamPlayers(side)) do table.insert(names,p.DisplayName) end
 return #names>0 and table.concat(names," + ") or (side==-1 and "Practice Partner" or "Waiting for players")
end
local function syncServing()
 servingSide=rotation.side; serverId=rotation.serverId; receiverId=rotation:receiverId(); serveX=rotation:serveX()
end
-- Status belongs to each viewer's current court session, never the lobby.
local function advanceMatchSession(p)
 p:SetAttribute("MatchSessionId",(p:GetAttribute("MatchSessionId") or 0)+1)
end
local function matchStatus(message,kind)
 for p,d in pairs(users) do
  if d.side~=0 or d.mode=="Spectate" then
   feedback:FireClient(p,message,kind,p:GetAttribute("MatchSessionId"))
  end
 end
end
local function rosterChanged()
 releasePracticePlayers()
 practice:reset(courtMode=="Practice" and practice.difficulty or "Normal")
 comeback=Comeback.new()
 powerups:reset()
 resetPowerups()
 local home,away={},{}
 for _,p in ipairs(teamPlayers(1)) do table.insert(home,p.UserId) end
 for _,p in ipairs(teamPlayers(-1)) do table.insert(away,p.UserId) end
 if courtMode=="Practice" and #home>0 and #away==0 then away={0} end -- Bot service follows singles rules.
 rotation:setTeams(home,away)
 if #home==0 and #away==0 then rotation:reset(); score=rotation.score end
 syncServing()
 ball.live=false; ball.v=Vector3.zero; ball.speed=1; ball.perfects=0
 ball.outLanding=nil; serveReady=false; serveDeadline=nil; nextServe=os.clock()+1
 introUntil=0; matchIntro=nil; introReady={}; introLoadDeadline=0
 if #home>0 and #away>0 then
  introSerial+=1
  introUntil=os.clock()+3
  nextServe=introUntil
  local function portraits(side)
   local result={}
   for _,player in ipairs(teamPlayers(side)) do
    table.insert(result,{userId=player.UserId,name=player.DisplayName})
   end
   if side==-1 and courtMode=="Practice" and #result==0 then
    table.insert(result,{userId=0,name="Practice Partner",bot=true})
   end
   return result
  end
  matchIntro={id=introSerial,endsAt=workspace:GetServerTimeNow()+3,home=portraits(1),away=portraits(-1),
   variant=courtVariant,environmentTitle=courtRoot:GetAttribute("EnvironmentTitle"),round=1,pointsToWin=11,winBy=2}
  if environments.active=="Moon" then
   matchIntro.loading=true
   introUntil=math.huge; nextServe=introUntil; introLoadDeadline=os.clock()+30
  end
 end
 for p,d in pairs(users) do
  d.diveUntil=0; d.divePoseUntil=0; d.volleyPending=false; d.chargeAt=nil
  if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end
  if introUntil>0 and d.side~=0 and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
   local primary=p.UserId==(d.side==servingSide and serverId or receiverId)
   local position=Rules.startPosition(d.side,servingSide,serveX,primary)
   p.Character:PivotTo(CFrame.lookAt(position,Vector3.new(position.X,185,0)))
   p.Character.HumanoidRootPart.AssemblyLinearVelocity=Vector3.zero
  end
 end
 if introUntil>0 and courtMode=="Practice" then botX=-serveX; botZ=-46 end
 banner="TEAMS UPDATED / PREPARING SERVE"
 matchStatus({title="Teams Updated",fault="Preparing the next serve"},"rallyResult")
end
introReadyRemote.OnServerEvent:Connect(function(player,id)
 if not matchIntro or not matchIntro.loading or matchIntro.id~=id then return end
 if not users[player] or users[player].side==0 then return end
 introReady[player]=true
 for participant,data in pairs(users) do
  if data.side~=0 and not introReady[participant] then return end
 end
 matchIntro.loading=false; matchIntro.endsAt=workspace:GetServerTimeNow()+3
 introUntil=os.clock()+3; nextServe=introUntil; introLoadDeadline=0
end)
local function rootOf(p)
 local c=p.Character
 return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end
local function tell(p,text,kind)
 kind=kind or "info"
 local tone=(kind=="perfect" or kind=="slam" or kind=="power") and "good"
  or (kind=="miss" or kind=="fault" or kind=="slow") and "bad" or "neutral"
 feedback:FireAllClients({userId=p.UserId,text=text,tone=tone},"playerText")
 if kind=="fault" then feedback:FireClient(p,text,kind) end
end
local function activatePowerup(p,id,duration)
 local d=users[p]
 if not d or not Powerups.has(d.powerups,id) then return end
 d.powerupPulses=d.powerupPulses or {}
 local now=os.clock()
 local previous=d.powerupPulses[id] or 0
 d.powerupPulses[id]=now+(duration or 0.85)
 if previous>now then return end
 local tier=1
 for _,card in ipairs(Powerups.catalog) do if card.id==id then tier=card.tier; break end end
 feedback:FireAllClients({userId=p.UserId,id=id,tier=tier},"powerupFX")
end
local function landing()
 if not ball.live then return ball.p,0 end
 local h=math.max(0,ball.p.Y-FLOOR)
 local gravity=ball.flightGravity or GRAVITY
 local t=Rules.ballLandingTime(h,ball.v.Y,gravity,ball.lob,ball.bounces>0)
 if ball.offensive then
  if ball.p.Z*ball.last<=0 then
   t=Rules.ballLandingTime(h,ball.v.Y,gravity*1.8,ball.lob,ball.bounces>0)
  elseif ball.v.Z~=0 then
   local crossing=-ball.p.Z/ball.v.Z
   if crossing>=0 and crossing<t then
    local at,velocity=Rules.advanceBall(ball.p,ball.v,gravity,crossing,ball.lob,ball.bounces>0)
    t=crossing+Rules.ballLandingTime(at.Y-FLOOR,velocity.Y,gravity*1.8,ball.lob,ball.bounces>0)
   end
  end
 end
 return ball.p+Vector3.new(ball.v.X*t+0.5*(ball.curveX or 0)*t*t,-h,ball.v.Z*t),t
end
local function perfect(now,d)
 local _,t=landing()
 return Powerups.perfect(d and d.powerups,t,now-ball.bounceAt)
end
local function lobCrossesSlamZone(from,velocity,gravity,duration)
 -- Classify the whole shot at launch, independent of a receiver's current position.
 -- A blue arc advertises an overhead opportunity, not a guaranteed legal hit.
 for step=0,120 do
  local t=duration*step/120
  local position=Rules.advanceBall(from,velocity,gravity,t,true,false)
  local side=-ball.last
  local root=Vector3.new(math.clamp(position.X,-Rules.HALF_WIDTH,Rules.HALF_WIDTH),184,side*(Rules.KITCHEN+2))
  local headTop,armLength=187,4
  if Rules.overheadReach(position,root,headTop+Rules.SLAM_MIN_HEIGHT,headTop+armLength+Rules.SLAM_EXTRA_HEIGHT)
   and (position-(root+Vector3.new(0,0,-side*2))).Magnitude<=Rules.SLAM_RANGE then return true end
 end
 return false
end
local activateArmedPowers
local function launch(from,target,boost,lob,slam,momentum,soft,mishit,charge,contact)
 local startingRally=not ball.live
 local rallyScale=contact and contact.uncapped and 1 or ball.speed
 local speedScale=(slam and Rules.slamSpeedScale(rallyScale) or rallyScale)*(boost and 1.22 or 1)*(1+0.12*(momentum or 0))
 if not slam and not soft then speedScale*=1+0.22*(charge or 0) end
 -- Speed changes flight time; lobs use heavier gravity after their apex.
 if soft then speedScale*=0.65 end
 local distance=(Vector3.new(target.X,0,target.Z)-Vector3.new(from.X,0,from.Z)).Magnitude
 local gravity=GRAVITY*arcade:gravity(os.clock())
 local duration=slam and math.max(0.12,math.min(distance/(BASE_SPEED*1.8),math.sqrt(2*math.max(0.1,from.Y-FLOOR)/gravity)*0.75)) or math.max(0.7,distance/BASE_SPEED)
 if lob then duration=math.max(duration*1.35,1.5) end
 duration=duration/math.max(0.1,speedScale)
 if contact and contact.minDuration then duration=math.max(duration,contact.minDuration) end
 local vy=(FLOOR-from.Y+0.5*gravity*duration*duration)/duration
 local crossing=(0-from.Z)/(target.Z-from.Z)
 local crossingX=from.X+(target.X-from.X)*crossing
 local aroundPost=crossing>0 and crossing<1 and math.abs(from.X)>21 and math.abs(crossingX)>21
 if not aroundPost and not mishit and crossing>0 and crossing<1 then
  local tc=duration*crossing
  local netY=from.Y+vy*tc-0.5*gravity*tc*tc
  if netY<185.2 then
   duration=math.sqrt(math.max(0.01,2*(185.2-from.Y-(FLOOR-from.Y)*crossing)/(gravity*crossing*(1-crossing))))
   vy=(FLOOR-from.Y+0.5*gravity*duration*duration)/duration
  end
 end
 if lob then
  vy=Rules.lobLaunchY(from.Y-FLOOR,duration,gravity)
  if not mishit and crossing>0 and crossing<1 then
   for _=1,100 do
    local sample=Rules.advanceBall(from,Vector3.new(0,vy,0),gravity,duration*crossing,true,false)
    if sample.Y>=185.2 then break end
    duration*=1.03
    vy=Rules.lobLaunchY(from.Y-FLOOR,duration,gravity)
   end
  end
 end
 if mishit then
  -- Keep horizontal aim, but send the ball below net height without clearance assist.
  if crossing>0 and crossing<1 then
   local tc=duration*crossing
   vy=(183.3-from.Y+0.5*gravity*tc*tc)/tc
  else vy=math.min(vy,-3) end
 end
 -- Preserve the landing target while bounding the complete serve launch velocity.
 if contact and contact.maxVelocity then
  for _=1,100 do
   local velocity=Vector3.new((target.X-from.X)/duration,vy,(target.Z-from.Z)/duration)
   if velocity.Magnitude<=contact.maxVelocity then break end
   duration*=1.01
   vy=(FLOOR-from.Y+0.5*gravity*duration*duration)/duration
  end
 end
 ball.offensive=contact and contact.offensive or false
 if ball.offensive and crossing>0 and crossing<1 then
  vy+=0.4*GRAVITY*(duration-duration*crossing)^2/duration
 end
 ball.heavy=contact and contact.heavy or false
 ball.trackingHiddenUntil=contact and contact.deceptive and os.clock()+0.5 or 0
 ball.trackingGlitchUntil=contact and contact.afterimage and os.clock()+0.65 or 0
 ball.spin=contact and contact.spin or nil
 ball.sliceBoost=contact and contact.sliceBoost or false
 ball.soft=soft; ball.slam=slam==true
 ball.atp=aroundPost and contact and contact.atp or false
 ball.deadly=contact and contact.deadly or false
 ball.hitter=contact and contact.userId or nil
 ball.lob=lob==true
 ball.p=from
 ball.g=ball.lob and vy<=0 and GRAVITY*Rules.LOB_GRAVITY_SCALE or GRAVITY
 ball.v=Vector3.new((target.X-from.X)/duration,vy,(target.Z-from.Z)/duration)
 if contact and contact.reflectedSpeed then
  local height=FLOOR-from.Y
  -- Slow calculated returns still reach the court at the specified speed.
  local reachGravity=contact.reflectedSpeed^2/math.max(0.01,math.sqrt(distance^2+height^2)+height)
  gravity=math.min(gravity,reachGravity*0.95)
  local low,high=Powerups.flightTimes(distance,height,contact.reflectedSpeed,gravity)
  if low and low>0 then
   duration=low
   local y=(FLOOR-from.Y+0.5*gravity*duration*duration)/duration
   local tc=duration*crossing
   if crossing>0 and crossing<1 and from.Y+y*tc-0.5*gravity*tc*tc<185.2 then duration=high end
   ball.v=Vector3.new((target.X-from.X)/duration,(FLOOR-from.Y+0.5*gravity*duration*duration)/duration,(target.Z-from.Z)/duration)
  end
 end
 -- Preserve the solved arc while changing travel speed, including net clearance.
 local shotMultiplier=contact and contact.speedMultiplier or 1
 local multiplier=shotMultiplier*(contact and contact.uncapped and ball.speed or 1)
 ball.v*=multiplier
 ball.flightGravity=gravity*multiplier*multiplier
 ball.g=ball.flightGravity*(ball.lob and ball.v.Y<=0 and Rules.LOB_GRAVITY_SCALE or 1)
 ball.shotMultiplier=shotMultiplier
 ball.peakSpeed=math.max(ball.peakSpeed or 1,ball.speed*shotMultiplier)
 ball.curveX=contact and contact.heatseeker and math.sign(target.X-from.X)*18 or 0
 ball.v-=Vector3.new(0.5*ball.curveX*duration/multiplier,0,0)
 ball.arcadeGravity=arcade:gravity(os.clock())
 ball.launchPosition=from; ball.launchVelocity=ball.v; ball.launchedAt=os.clock()
 ball.shotId=(ball.shotId or 0)+1
 ball.slamLob=ball.lob and lobCrossesSlamZone(from,ball.v,ball.flightGravity,duration/multiplier)
 ball.bounces=0; ball.bounceAt=-100; ball.live=true
 -- All viewers receive the same accepted contact, including practice-partner hits.
 contact=contact or {}
 contact.position=from; contact.direction=ball.v.Unit; contact.speed=ball.speed*shotMultiplier
 contact.slam=slam==true; contact.powered=boost==true; contact.charge=charge or 0; contact.soft=soft
 feedback:FireAllClients(contact,"ballHit")
 if startingRally and activateArmedPowers then activateArmedPowers(os.clock()) end
end
local function point(winner,reason)
 if practicePaused() then return end
 if not ball.live then return end
 arcade:clearArmed()
 -- A return is only missed once the incoming ball double-bounces.
 -- Swing attempts can still be followed by a successful return or dive.
 if reason=="Double bounce" then
  for player,data in pairs(users) do
   if data.side==-winner then tell(player,"Miss!","miss") end
  end
 end
 local server=serverId and Players:GetPlayerByUserId(serverId)
 local serverData=server and users[server]
 if ball.shots==0 and winner==-servingSide and serverData
  and Powerups.retryServe(serverData.powerups,serverData.powerupMatch) then
  activatePowerup(server,"secondServe",1.5)
  serverData.stamina=100
  ball.live=false; ball.v=Vector3.zero; serveReady=false; serveDeadline=nil; nextServe=os.clock()+1
  tell(server,"SECOND SERVE / MULLIGAN + FULL STAMINA","perfect")
  return
 end
 for player,data in pairs(users) do
  if data.side==winner then
   local root=rootOf(player)
   local wins=data.powerupMatch.speedWins or 0
   local reach=data.powerupMatch.reachStacks or 0
   Powerups.terminalWin(data.powerups,data.powerupMatch,ball.peakSpeed or ball.speed)
   Powerups.netWin(data.powerups,data.powerupMatch,root and math.abs(root.Position.X)<=20
    and root.Position.Z*data.side<=Rules.KITCHEN+4)
   if (data.powerupMatch.speedWins or 0)>wins then activatePowerup(player,"terminalVelocity",1.5) end
   if (data.powerupMatch.reachStacks or 0)>reach then activatePowerup(player,"vampiricReach",1.5) end
  end
 end
 ball.live=false; ball.v=Vector3.zero; ball.perfects=0; ball.speed=1
 local index=winner==1 and 1 or 2
 local outcome=rotation:award(winner)
 local scored=outcome=="point"
 local previousComeback=comeback.side
 Comeback.update(comeback,score,false)
 syncServing()
 banner="TEAM "..(servingSide==1 and "1" or "2")..(scored and " POINT / " or outcome=="secondServer" and " SECOND SERVER / " or " SIDE OUT / ")..reason
 serveReady=false; serveDeadline=nil
 for p,d in pairs(users) do d.powerupRally.stunUntil=0; d.powerupRally.burstUntil=0; d.diveUntil=0; d.divePoseUntil=0; d.volleyPending=false; d.serveChargeAt=nil; d.chargeAt=nil; if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end end
 nextServe=os.clock()+2.5
 local scorer=lastHitter[winner] or occupant(winner)
 local scorerName=scorer and scorer.DisplayName or "Practice Partner"
 local faultNames={
  ["Double bounce"]="Double Bounce!",["Net"]="Net Fault!",["Out"]="Out!",
  ["Short return"]="Short Return!",["Kitchen volley fault"]="Foot Fault!",
  ["Two-bounce rule: let the ball bounce"]="Two-Bounce Fault!",
  ["Wrong receiver: the diagonal player must return the serve"]="Wrong Receiver!",
  ["Serve fault: land in the diagonal service court"]="Serve Fault!",
  ["Rally over"]="Rally Over!",
 }
 matchStatus({title=scored and (scorerName.." Scored for Team "..index.."!") or outcome=="secondServer" and "Second Server!" or "Side Out!",fault=faultNames[reason] or (reason.."!")},"rallyResult")
 if scored and score[index]>=11 and math.abs(score[1]-score[2])>=2 then
  banner="TEAM "..index.." WINS!  /  New game in 6 seconds"
  matchStatus(banner,"point")
  nextServe=os.clock()+6
  ball.resetScore=true
  Comeback.update(comeback,score,true)
 end
 if previousComeback~=comeback.side then
  matchStatus(comeback.side~=0 and "COMEBACK! Team "..(comeback.side==1 and "1" or "2").." gains +15% movement, reach and hit speed until tied." or "COMEBACK BOOST ENDED","point")
 end
 if courtVariant=="Chaos" then
  rallies+=1
  if ball.resetScore then resetPowerups()
  elseif rallies%3==0 then draftDue=true end
 elseif courtVariant=="Arcade" then
  if ball.resetScore then resetPowerups() elseif arcade:rally() then draftDue=true end
 end
end
local function paddle(character)
 local hand=character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
 if not hand then return end
 local function attach(name,size,offset,color)
  local p=Instance.new("Part")
  p.Name=name; p.Size=size; p.Color=color; p.Material=Enum.Material.SmoothPlastic
  p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Massless=true
  p.CFrame=hand.CFrame*offset; p.Parent=character
  local weld=Instance.new("WeldConstraint",p); weld.Part0=hand; weld.Part1=p
  return p
 end
 attach("PaddleGrip",Vector3.new(0.3,1.2,0.3),CFrame.new(0,-0.7,0),Color3.fromRGB(35,47,52))
 local face=attach("PaddleFace",Vector3.new(1.65,2,0.3),CFrame.new(0,-2,0),Color3.fromRGB(31,193,180))
 face:SetAttribute("Paddle",true)
end
local function spawnCharacter(p,c)
 local d=users[p]; if not d then return end
 local r=c:WaitForChild("HumanoidRootPart",10)
 local h=c:WaitForChild("Humanoid",10)
 if not r or not h or p.Character~=c then return end
 Spectator.leave(p)
 -- Release lobby furniture before relocating an avatar to the court or spectator deck.
 local seatedAt=h.SeatPart
 h.Sit=false
 if seatedAt then
  local weld=seatedAt:FindFirstChild("SeatWeld")
  if weld and weld:IsA("Weld") and weld.Part1 and weld.Part1:IsDescendantOf(c) then weld:Destroy() end
 end
 h.WalkSpeed=WALK_SPEED; h.UseJumpPower=true; h.JumpPower=38
 local z=d.side==0 and 58 or d.side*28
 c:PivotTo(d.mode=="Lobby" and Lobby.Spawn or CFrame.lookAt(Vector3.new(d.side==0 and 40 or 0,185,z),Vector3.new(0,185,0)))
 if d.side~=0 and os.clock()<introUntil then
  local primary=p.UserId==(d.side==servingSide and serverId or receiverId)
  local position=Rules.startPosition(d.side,servingSide,serveX,primary)
  c:PivotTo(CFrame.lookAt(position,Vector3.new(position.X,185,0)))
 end
 r.AssemblyLinearVelocity=Vector3.zero; r.AssemblyAngularVelocity=Vector3.zero
 for _,name in ipairs({"PaddleFace","PaddleGrip"}) do
  local existing=c:FindFirstChild(name)
  if existing and d.side==0 then existing:Destroy() end
 end
 if d.side~=0 and not c:FindFirstChild("PaddleFace") then paddle(c) end
 d.kitchenTouched=false; d.volleyPending=false; d.diveUntil=0; d.divePoseUntil=0; d.serveChargeAt=nil; d.chargeAt=nil; if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end
 if d.side~=0 and not ball.live then serveReady=false; serveDeadline=nil end
 if d.mode=="Spectate" then Spectator.enter(p,c) end
end
local function addPlayer(p)
 if users[p] then return end
 local side=0
 joinSerial+=1
 users[p]={powerups={},powerupNames={},powerupMatch={},powerupRally=Powerups.newRally(),mode="Lobby",sessionAt=0,side=side,slot=side~=0 and availableSlot(side) or 0,joined=joinSerial,stamina=100,staminaRecoveryAt=0,lastSwing=0,diveAt=0,powerAt=0,slowAt=0,powerUntil=0,slowUntil=0,lastInput=0}
 p:SetAttribute("CourtSide",side)
 p:SetAttribute("SessionMode","Lobby")
 p:SetAttribute("MatchSessionId",0)
 p:SetAttribute("SlowFallEnabled",false)
 if side~=0 then rosterChanged() end
 p.CharacterRemoving:Connect(function() Spectator.leave(p) end)
 p.CharacterAppearanceLoaded:Connect(function(c)
  if users[p] and users[p].mode=="Spectate" and p.Character==c then spawnCharacter(p,c) end
 end)
 p.CharacterAdded:Connect(function(c) spawnCharacter(p,c) end)
 if p.Character then task.spawn(spawnCharacter,p,p.Character) end
end
Players.PlayerAdded:Connect(addPlayer)
for _,p in ipairs(Players:GetPlayers()) do addPlayer(p) end
-- Queued groups use the existing shared court simulation.
local function leaveCourt(p)
 local d=users[p]
 if not d then return end
 local active=d.side~=0
 clearEnvironmentGravity(p)
 p:SetAttribute("EnvironmentModifier",nil)
 advanceMatchSession(p)
 d.side=0; d.slot=0
 d.variant=nil; p:SetAttribute("MatchVariant",nil)
 d.arcadeDeck=nil
 arcade:clearArmed(p)
 p:SetAttribute("PowerupDraftOpen",false)
 loadoutRemote:FireClient(p,{kind="close"})
 p:SetAttribute("SlowFallEnabled",false)
 d.diveUntil=0; d.divePoseUntil=0; d.volleyPending=false; d.serveChargeAt=nil; d.chargeAt=nil; d.chargeCooldownBlocked=nil
 d.powerUntil=0; d.slowUntil=0
 if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end
 p:SetAttribute("CourtSide",0)
 if not active then return end
 if not occupant(1) then
  local remaining,other=occupant(-1)
  if remaining then
   other.slot=availableSlot(1); other.side=1; remaining:SetAttribute("CourtSide",1)
   if remaining.Character then task.spawn(spawnCharacter,remaining,remaining.Character) end
  end
 end
 if not occupant(1) and not occupant(-1) then
  courtMode=nil; courtVariant=nil; courtModifier="None"; GRAVITY=45; courtRoot:SetAttribute("EnvironmentalModifier","None"); rotation:reset(); score=rotation.score; ball.resetScore=false; comeback=Comeback.new()
 end
 rosterChanged()
end
local function connectSession(p,mode,variant,environment,modifier)
 local d=users[p]
 if not d or type(mode)~="string" then return end
 if mode~="Lobby" and mode~="Spectate" and mode~="Practice" and mode~="1V1" and mode~="2V2" and mode~="1V2" then return end
 if mode~="Lobby" and mode~="Spectate" and not MatchSetup.modes[variant] then
  session:FireClient(p,false,"Choose Classic, Arcade, or Chaos first."); return
 end
 environment=environment or (courtMode and environments.active or "Rooftop")
 if mode~="Lobby" and mode~="Spectate" and not CourtEnvironments.valid(environment) then
  session:FireClient(p,false,"Choose Rooftop or Moon first."); return
 end
 if mode~="Lobby" and mode~="Spectate" and not MatchSetup.valid(variant,environment,modifier) then
  session:FireClient(p,false,"Invalid map or environmental modifier."); return
 end
 local now=os.clock()
 if now-d.sessionAt<0.5 then session:FireClient(p,false,"Please wait a moment before switching."); return end
 d.sessionAt=now
 if mode==d.mode and (d.side==0 or (variant==d.variant and environment==environments.active and modifier==courtModifier)) then session:FireClient(p,true,"Already connected."); return end
 if mode=="Lobby" or mode=="Spectate" then
  leaveCourt(p); d.mode=mode
 else
  -- Validate before leaving, so a rejected choice never disrupts a live match.
  if courtMode and (courtMode~=mode or courtVariant~=variant or environments.active~=environment or courtModifier~=modifier) then
   session:FireClient(p,false,"Court is in "..environments.active.." / "..courtMode.." / "..courtVariant..". Join those settings, spectate, or wait for it to empty.")
   return
  end
  local homeLimit=mode=="2V2" and 2 or 1
  local awayLimit=(mode=="2V2" or mode=="1V2") and 2 or 1
  local home,away=#teamPlayers(1),#teamPlayers(-1)
  if (mode=="Practice" and home+away>0) or (home>=homeLimit and away>=awayLimit) then
   session:FireClient(p,false,"Court is full. Choose Spectate to watch.")
   return
  end
  advanceMatchSession(p)
  if mode=="Practice" then practice:reset() end
  local environmentChanged=environments.active~=environment
  environments:set(environment)
  if environmentChanged then
   for spectator,data in pairs(users) do
    if data.mode=="Spectate" and spectator.Character then Spectator.enter(spectator,spectator.Character) end
   end
  end
  courtMode=mode
  courtModifier=modifier; GRAVITY=modifier=="LowGravity" and 22.5 or 45
  courtRoot:SetAttribute("EnvironmentalModifier",modifier)
  p:SetAttribute("EnvironmentModifier",modifier)
  courtVariant=variant; d.variant=variant; p:SetAttribute("MatchVariant",variant)
  d.side=(home<homeLimit and (home<=away or away>=awayLimit)) and 1 or -1
  d.slot=availableSlot(d.side); d.mode=mode
  p:SetAttribute("CourtSide",d.side)
  d.stamina=100; d.powerUntil=0; d.slowUntil=0
  rosterChanged()
 end
 p:SetAttribute("SessionMode",d.mode)
 if p.Character then task.spawn(spawnCharacter,p,p.Character) end
 session:FireClient(p,true,"Connected.")
end
session.OnServerEvent:Connect(function(p,mode)
 if mode~="Lobby" and mode~="Spectate" then
  session:FireClient(p,false,"Choose a mode and player count to join the queue."); return
 end
 matchmaking:remove(p)
 connectSession(p,mode)
end)
local function updateQueue()
 local group=matchmaking:update(courtMode==nil)
 if not group then return end
 for _,member in ipairs(group.players) do
  queueRemote:FireClient(member,{stage="Cancelled"})
  users[member].sessionAt=-math.huge
  connectSession(member,group.format,group.mode,group.map,group.modifier)
 end
end
queueRemote.OnServerEvent:Connect(function(p,action,a,b,c)
 local d=users[p]
 if not d then return end
 if action=="Cancel" then
  matchmaking:remove(p)
 elseif action=="Join" then
  if d.mode~="Lobby" or not matchmaking:join(p,a,b) then
   queueRemote:FireClient(p,{stage="Error",message="Return to the lobby and choose a valid mode and player count."})
  else d.arcadeDeck=nil end
 elseif action=="Vote" then
  if not matchmaking:configure(p,a,b) then
   queueRemote:FireClient(p,{stage="Error",message="Voting has closed, or this choice is unavailable."})
  end
 end
 updateQueue()
end)
Players.PlayerRemoving:Connect(function(p)
 matchmaking:remove(p)
 Spectator.leave(p)
 leaveCourt(p)
 users[p]=nil
end)
local function prepareServe()
 if loadoutPending then return end
 if ball.resetScore then rotation:reset(); score=rotation.score; ball.resetScore=false; comeback=Comeback.new() end
 syncServing()
 if not occupant(1) or (courtMode~="Practice" and not occupant(-1)) then return end
 table.clear(lastHitter)
 botStunUntil=0
 for _,d in pairs(users) do d.powerupRally=Powerups.newRally(); d.diveHeld=false end
 for p,d in pairs(users) do
  local r,h=rootOf(p)
  if d.side~=0 and r and h and h.Health>0 then
   local primary=p.UserId==(d.side==servingSide and serverId or receiverId)
   local position=Rules.startPosition(d.side,servingSide,serveX,primary)
   p.Character:PivotTo(CFrame.lookAt(position,Vector3.new(position.X,185,0)))
   r.AssemblyLinearVelocity=Vector3.zero
   d.diveUntil=0; d.divePoseUntil=0; d.volleyPending=false; d.kitchenTouched=false; d.serveChargeAt=nil; d.chargeAt=nil; if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end
  end
 end
 if servingSide==-1 and not occupant(-1) then botX=serveX; botZ=-46
 else botX=-serveX; botZ=-46 end
 botShotId=nil; botAttempted=false; botSwingAt=0
 botTarget=Vector3.new(botX,0,botZ)
 ball.outLanding=nil; ball.peakSpeed=1
 ball.p=Vector3.new(serveX,184,servingSide*46)
 ball.v=Vector3.zero; ball.speed=1; ball.perfects=0; ball.shots=0
 ball.bounces=0; ball.bounceAt=-100; ball.last=servingSide
 serveReady=true
 practiceServeSerial+=1
 serveDeadline=workspace:GetServerTimeNow()+Rules.SERVE_TIMEOUT
 if courtMode=="Practice" and servingSide==-1 and serverId==0 then serveDeadline=nil end
 banner="TEAM "..(servingSide==1 and "1" or "2").." / SERVER "..rotation.number.." TO SERVE"
end
local function facingTarget(from,r,side,depth)
 local direction,momentum=Rules.shotAim(r.CFrame,r.AssemblyLinearVelocity,from)
 depth+=momentum*4
 -- Facing plus a bounded movement offset; out shots remain possible.
 local distance=math.abs(-side*depth-from.Z)/math.max(0.25,math.abs(direction.Z))
 return from+direction*math.clamp(distance,12,110),momentum
end
local function serve(p,d,r,h)
 if not serveReady or practicePaused() or (courtMode=="Practice" and servingSide==-1 and serverId==0) then return end
 if os.clock()<d.lastSwing then return end
 if not serveDeadline or workspace:GetServerTimeNow()>=serveDeadline then return end
 if not d.serveChargeAt then return end
 local _,offset,accuracy,grade=Rules.serveTiming(d.serveChargeAt,workspace:GetServerTimeNow())
 if not Rules.canServe(p.UserId,serverId,serveReady) then
  tell(p,"WAIT FOR THE DESIGNATED SERVER","info"); return
 end
 if not Rules.servePositionValid(r.Position,d.side,serveX,h.FloorMaterial~=Enum.Material.Air) then
  tell(p,"Foot Fault! Serve from behind the baseline on the marked side.","fault"); return
 end
 local from=Rules.heldBallPosition(p.Character) or Vector3.new(r.Position.X,184,r.Position.Z)
 lastHitter[servingSide]=p
 if Powerups.has(d.powerups,"serveVolley") then d.powerupRally.burstUntil=os.clock()+3; activatePowerup(p,"serveVolley",3) end
 d.serveChargeAt=nil; d.chargeAt=nil; if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end
 serveReady=false; serveDeadline=nil; ball.last=servingSide; ball.shots=0
 local target=Rules.timedServeTarget(servingSide,serveX,offset)
 ball.speed=Rules.servePower(offset+1)
 d.lastSwing=os.clock()+Rules.HIT_COOLDOWN
 p.Character:SetAttribute("HitReadyAt",workspace:GetServerTimeNow()+Rules.HIT_COOLDOWN)
 launch(from,Vector3.new(target.X,FLOOR,target.Z),false,false,false,0,nil,offset<Rules.SERVE_NET_OFFSET,0,{userId=p.UserId,maxVelocity=offset>=Rules.SERVE_NET_OFFSET and Rules.MAX_SERVE_VELOCITY or nil})
 feedback:FireClient(p,{grade=grade,offset=offset,accuracy=accuracy},"serveTiming")
 feedback:FireAllClients({userId=p.UserId,backhand=false,contact=from,direction=ball.v.Unit,charge=accuracy},"swing")
 banner="SERVE  /  LET IT BOUNCE"
end
-- No delayed tasks: one countdown is advanced by the authoritative heartbeat.
local function autoBotServe()
 local config=PracticeSession.Profiles[practice.difficulty]
 serveReady=false; serveDeadline=nil; ball.last=servingSide; ball.shots=0
 ball.speed=Rules.servePower(1)
 local from=Rules.heldBallPosition(bot) or Vector3.new(serveX,184,servingSide*46)
 launch(from,Rules.serveTarget(nil,servingSide,serveX),false,false,false,0,nil,false,0,
  {maxVelocity=Rules.MAX_SERVE_VELOCITY,speedMultiplier=math.min(1,config.speed)})
 banner="BOT SERVE / LET IT BOUNCE"
end
practiceRemote.OnServerEvent:Connect(function(p,action,value,revision)
 local d=users[p]
 if courtMode~="Practice" or not d or d.mode~="Practice" or d.side~=1 or occupant(1)~=p then return end
 if revision~=practice.revision then return end
 if action=="Difficulty" then
  local wasPaused=practice.paused
  if type(value)~="string" or not practice:select(value) then return end
  releasePracticePlayers()
  rotation:reset(); score=rotation.score; ball.resetScore=false
  rosterChanged()
  introUntil=0; matchIntro=nil; nextServe=os.clock()
  botSlowUntil=0; botStunUntil=0; botReactAt=0; botThinkAt=0
  d.stamina=100; d.powerAt=0; d.slowAt=0; d.powerUntil=0; d.slowUntil=0
  d.lastSwing=0; d.diveAt=0; d.chargeShotAt=0
  if p.Character then p.Character:SetAttribute("HitReadyAt",0) end
  prepareServe()
  if draftDue then serveReady=false; serveDeadline=nil end
  banner="PRACTICE / "..string.upper(practice.difficulty)
  if wasPaused then practice:setPaused(true); freezePracticePlayer(p) end
 elseif action=="Paused" and practice:setPaused(value) then
  if practice.paused then
   for player,data in pairs(users) do
    if data.mode=="Practice" then
     data.serveChargeAt=nil; data.chargeAt=nil; data.diveUntil=0; data.divePoseUntil=0; data.diveHeld=false
     if player.Character then player.Character:SetAttribute("ShotChargeAt",nil) end
     freezePracticePlayer(player)
    end
   end
  else
   releasePracticePlayers()
   if ball.live then
    -- Restart the interrupted rally safely, retaining score, server and difficulty.
    ball.live=false; ball.v=Vector3.zero; serveReady=false; serveDeadline=nil
    practice:step(nil,0); practice.flash=0
    prepareServe()
   end
  end
 end
end)
-- Keep all practice deadlines at their remaining duration while paused.
local function suspendPracticeTimers(dt)
 arcade:pause(dt)
 nextServe+=dt
 if introUntil>0 then introUntil+=dt end
 if matchIntro then matchIntro.endsAt+=dt end
 if draft then draft.endsAt+=dt end
 if serveDeadline then serveDeadline+=dt end
 for _,key in ipairs({"bounceAt","launchedAt","trackingHiddenUntil","trackingGlitchUntil"}) do
  if ball[key] then ball[key]+=dt end
 end
 botSlowUntil+=dt; botStunUntil+=dt; botReactAt+=dt; botThinkAt+=dt; botSwingAt+=dt
 for _,d in pairs(users) do
  if d.mode=="Practice" then
   for _,key in ipairs({"lastSwing","diveAt","powerAt","slowAt","powerUntil","slowUntil","staminaRecoveryAt","chargeShotAt"}) do
    if d[key] then d[key]+=dt end
   end
   for _,key in ipairs({"diveStarted","burstUntil","stunUntil"}) do
    if d.powerupRally[key] then d.powerupRally[key]+=dt end
   end
   for key,value in pairs(d.powerupPulses or {}) do d.powerupPulses[key]=value+dt end
  end
 end
 for _,slot in pairs(powerups.slots) do
  slot.nextSpawn+=dt
  if slot.pickup then slot.pickup.born+=dt end
 end
 for _,burst in ipairs(powerups.bursts) do burst.at+=dt; burst.pickup.born+=dt end
end
local function overheadStatus(p,r)
  local face=p.Character:FindFirstChild("PaddleFace")
  local center=face and face.Position or r.Position
  local distance=(ball.p-center).Magnitude
  local minY,maxY=Rules.slamBounds(p.Character,r)
  local overhead=Rules.contactInFront(ball.p,r.CFrame) and distance<=Rules.SLAM_RANGE and Rules.overheadReach(ball.p,r.Position,minY,maxY)
 return distance,overhead
end
local function slamQuality(p,d,r,now,overhead)
 local grounded=p.Character.Humanoid.FloorMaterial~=Enum.Material.Air
 local diving=now<(d.divePoseUntil or d.diveUntil or 0)
 local jumping=Rules.jumpSlam(r.Position,d.side,grounded,diving)
 local minY,maxY=Rules.slamBounds(p.Character,r)
 if jumping and Rules.spikeReach(ball.p,r.CFrame,maxY) then return "perfect" end
 if not overhead then return nil end
 local contact=r.Position+r.CFrame.LookVector*5
 contact=Vector3.new(contact.X,minY+1,contact.Z)
 return Rules.slamTiming(ball.p,ball.v,contact,Powerups.has(d.powerups,"perfectVision"))
end
local function slamReady(p,d,now)
 local r,h=rootOf(p)
 if not r or not h or h.Health<=0 or d.side==0 then return false end
 if not ball.live or ball.last==d.side or ball.p.Z*d.side< -1 then return false end
 if ball.shots==0 and receiverId and p.UserId~=receiverId then return false end
 if Rules.returnFault(ball.bounces,ball.shots,Rules.kitchenHitFault(r.Position,h.FloorMaterial~=Enum.Material.Air,d.kitchenTouched)) then return false end
 local _,overhead=overheadStatus(p,r)
 return slamQuality(p,d,r,now,overhead)=="perfect"
end
local function tryReturn(p,d,r,now,automatic,softRequested,charge,shotKind)
  if arcade:effect(p,"slide",now) then return false end
  charge=charge or 0
  local distance,overhead=overheadStatus(p,r)
  local backhand=r.CFrame:PointToObjectSpace(ball.p).X<0
  local bonus,extension=Powerups.extraReach(d.powerups,d.powerupMatch,backhand)
  local reach=(1+((d.powerups and d.powerups.reach) or 0)+bonus)*(Comeback.active(comeback,d.side) and Comeback.HIT or 1)*arcade:reach(p,now)
  local fire=Powerups.onFire(d.powerups,d.powerupRally,ball.shots+1)
  local guided=Powerups.has(d.powerups,"thirdShot") and ball.shots==1 and d.side==servingSide
  local feint=shotKind=="Lob" and d.chargeAt~=nil and overhead and Powerups.has(d.powerups,"baitSwitch")
  local shield=shotKind=="Deflect"
  local incomingSpeed=ball.v.Magnitude
  local diving=now<(d.divePoseUntil or d.diveUntil or 0)
  local deceptive=not shield and d.diveHeld and Powerups.has(d.powerups,"deceptiveDrop")
  local offensive=not shield and diving and Powerups.has(d.powerups,"offensiveDive")
  local heavy=Powerups.apex(d.powerups,ball.bounces,ball.v.Y,ball.g or GRAVITY)
  local grounded=p.Character.Humanoid.FloorMaterial~=Enum.Material.Air
  if Powerups.warden(d.powerups,r.Position.Z*d.side,r.Position.X,Vector3.new(r.AssemblyLinearVelocity.X,0,r.AssemblyLinearVelocity.Z).Magnitude,grounded) then
   local face=p.Character:FindFirstChild("PaddleFace")
   local center=(face and face.Position or r.Position)+r.CFrame.LookVector*Rules.HIT_RANGE*reach*0.25
   -- Union with the normal sphere: only the forward intercept volume is added.
   distance=math.min(distance,(ball.p-center).Magnitude)
  end
  local slamTiming=not softRequested and shotKind~="Lob" and shotKind~="Slice" and not shield
   and not guided and not feint and not deceptive and slamQuality(p,d,r,now,overhead) or nil
  local inReach=Rules.contactInFront(ball.p,r.CFrame) and (distance<=Rules.HIT_RANGE*reach+extension or overhead or slamTiming~=nil)
  local valid=ball.live and ball.last~=d.side and ball.p.Z*d.side>=-1 and inReach
  if automatic and not valid then return false end
  local clean=valid and (distance<=Rules.PERFECT_RANGE*reach*(Powerups.has(d.powerups,"carbonFiber") and 1.15 or 1)+extension or overhead) and perfect(now,d)
  if guided or feint or deceptive or shield then clean=valid end
  if ball.spin and not fire and not guided and not feint and not deceptive and not shield then
   clean=clean and (perfect(now,d) and distance<=Rules.PERFECT_RANGE*reach*(Powerups.has(d.powerups,"carbonFiber") and 1.15 or 1)+extension or overhead)
  end
  if slamTiming then clean=valid and slamTiming=="perfect" end
  if not Rules.hitReady(now,d.lastSwing,clean) then return false end
  local cooldown=Rules.HIT_COOLDOWN*arcade:swingScale(p,now)
  d.lastSwing=clean and now or now+cooldown
  p.Character:SetAttribute("HitReadyAt",workspace:GetServerTimeNow()+(clean and 0 or cooldown))
  if not valid then
   feedback:FireAllClients({userId=p.UserId,backhand=backhand,soft=softRequested and Rules.softShot(r.Position,d.side) or nil},"swing")
   -- An out-of-range swing does not end the return opportunity; report faults only when the rally resolves.
   return
  end
  if ball.shots==0 and receiverId and p.UserId~=receiverId then
   point(-d.side,"Wrong receiver: the diagonal player must return the serve"); return false
  end
  local kitchenFault=Rules.kitchenHitFault(r.Position,grounded,d.kitchenTouched)
  local fault=Rules.returnFault(ball.bounces,ball.shots,kitchenFault)
  if fault then point(-d.side,fault); return false end
  if ball.deadly then point(ball.last,"Unreturnable paddle strike"); return true end
  if ball.bounces==0 and ball.soft=="dink" and ball.hitter then
   local prior=Players:GetPlayerByUserId(ball.hitter)
   if prior and users[prior] then Powerups.dink(users[prior].powerupRally,false) end
  end
  local humanoid=p.Character:FindFirstChildOfClass("Humanoid")
  local erne=Powerups.has(d.powerups,"erne") and ball.bounces==0 and ball.shots>=2
   and math.abs(r.Position.X)>Rules.HALF_WIDTH+1 and math.abs(r.Position.Z)<=Rules.KITCHEN+4
   and humanoid and humanoid.FloorMaterial==Enum.Material.Air and not d.kitchenTouched
  if erne and not slamTiming then clean=true end
  if ball.bounces==0 then d.volleyPending=true; d.volleySettled=0 end
  local _,timeToBounce=landing()
  local quality=Rules.shotQuality(clean,timeToBounce,now-ball.bounceAt)
  local soft=(guided or feint or deceptive) and "drop" or softRequested and clean and Rules.softShot(r.Position,d.side) or nil
  if soft or (shotKind=="Slice" and clean) then quality="perfect" end
  if shotKind=="Lob" and not feint and not guided and not deceptive then quality="lob"; soft=nil end
  local serveReturn=ball.shots==0
  ball.shots+=1
  local slam=slamTiming~=nil
  if slam then quality=slamTiming end
  local restored=clean and ball.speed<1
  if clean then ball.perfects+=1 end
  local charged=charge>0 and not soft and not softRequested and not slam
  if charged then
   d.chargeShotAt=now+1
   p.Character:SetAttribute("ChargedShotReadyAt",workspace:GetServerTimeNow()+1)
  end
  local accelerationMessage
  ball.speed,accelerationMessage=Powerups.acceleration(d.powerups,d.powerupRally,ball.speed,clean,slam,charged,Rules.returnSpeed)
  local calculated=serveReturn and not diving and not soft and shotKind~="Lob" and shotKind~="Slice" and Powerups.has(d.powerups,"calculatedReturn")
  if calculated then ball.speed*=0.8 end
  local target,momentum=facingTarget(ball.p,r,d.side,soft and (soft=="dink" and 7 or 10) or (slam and 35 or 27))
  if charged and not clean then
   local timingError=math.min(timeToBounce,now-ball.bounceAt)
   local severity=math.clamp((timingError-0.23)/0.42,0.25,1)
   target=Rules.chargeTarget(ball.p,target,charge,severity,math.random()*2-1,math.random())
  end
  if guided or feint or deceptive or shield then
   local opponent=occupant(-d.side)
   local opponentRoot=opponent and rootOf(opponent)
   local aimX=opponentRoot and opponentRoot.Position.X or botX
   -- Guidance reduces lateral aim error by 40%; feints and shields use a safe center target.
   local x=guided and aimX+(target.X-aimX)*0.6 or target.X
   target=Vector3.new(math.clamp(x,-17,17),FLOOR,-d.side*(shield and 27 or 7))
  end
  local multiplier=1
  if not soft and not slam and not shield and quality~="lob" and shotKind~="Lob" and shotKind~="Slice" and Powerups.has(d.powerups,"dinkSpecialist") then
   multiplier=Powerups.drive(d.powerupRally,r.Position.Z*d.side>=Rules.BASELINE-4)
  end
  local dinkBoost=multiplier>1
  if Comeback.active(comeback,d.side) then multiplier*=Comeback.HIT end
  if soft~="dink" then Powerups.dink(d.powerupRally,false) end
  local deadly=(erne and clean) or (fire and slam and clean and not d.powerupRally.overchargeUsed)
  if erne then multiplier*=3 end
  if fire and slam and clean then d.powerupRally.overchargeUsed=true end
  if feint then
   for _,opponent in ipairs(teamPlayers(-d.side)) do
    local enemy=users[opponent]; local enemyRoot=rootOf(opponent)
    if enemyRoot and enemyRoot.AssemblyLinearVelocity.Z*enemy.side>1 then enemy.powerupRally.stunUntil=now+1 end
   end
   if courtMode=="Practice" and botTarget.Z<botZ then botStunUntil=now+1 end
   tell(p,"BAIT AND SWITCH!","perfect")
  end
  local rhythm=clean and ball.shots+1>10 and Powerups.has(d.powerups,"rhythmMaster")
  local afterimage=Powerups.has(d.powerups,"afterimage") and now-d.powerupRally.diveStarted<=1
  if offensive then
   for _,opponent in ipairs(teamPlayers(-d.side)) do
    local data=users[opponent]
    if Powerups.onFire(data.powerups,data.powerupRally,ball.shots+1) then offensive=false; break end
   end
   if offensive and not slam then quality="perfect" end
  end
  if slam then target=Rules.slamTarget(target,d.side,quality) end
  local triggered={thirdShot=guided,baitSwitch=feint,deflector=shield,erne=erne and clean,overcharge=fire and slam and clean,
   deceptiveDrop=deceptive,offensiveDive=offensive,apexPredator=heavy,rhythmMaster=rhythm,afterimage=afterimage,
   calculatedReturn=calculated,sliceDice=shotKind=="Slice",dinkSpecialist=dinkBoost,
   perfectVision=clean,carbonFiber=clean,phantom=backhand,
   momentumShift=accelerationMessage=="MOMENTUM SHIFT! +15%",terminalVelocity=accelerationMessage=="TERMINAL VELOCITY! +8%"}
  for id,active in pairs(triggered) do if active then activatePowerup(p,id) end end
  local powered=clean and not soft and now<d.powerUntil
  d.powerUntil=0
  ball.last=d.side; lastHitter[d.side]=p
  local positions={}
  for _,opponent in ipairs(teamPlayers(-d.side)) do local root=rootOf(opponent); if root then table.insert(positions,root.Position) end end
  if courtMode=="Practice" then table.insert(positions,Vector3.new(botX,184,botZ)) end
  local heatTarget=arcade:heatTarget(p,now,positions,d.side)
  if heatTarget then target=heatTarget; quality="perfect"; soft=nil; slam=false end
  launch(ball.p,Vector3.new(target.X,FLOOR,target.Z),powered,quality=="lob",slam,momentum,soft,quality=="net",charged and charge or 0,{userId=p.UserId,clean=clean,heatseeker=heatTarget~=nil,
   reflectedSpeed=shield and incomingSpeed*2 or calculated and incomingSpeed*0.8 or nil,
   offensive=offensive,heavy=heavy,deceptive=deceptive,afterimage=afterimage,
   uncapped=Powerups.has(d.powerups,"terminalVelocity") and not shield and not calculated,speedMultiplier=multiplier,spin=(guided or offensive) and "topspin" or shotKind=="Slice" and "slice" or nil,
   sliceBoost=Powerups.has(d.powerups,"sliceDice"),atp=Powerups.has(d.powerups,"atpAssassin"),deadly=deadly})

  feedback:FireAllClients({userId=p.UserId,backhand=backhand,slam=slam or deceptive,hidePaddle=rhythm,contact=ball.p,direction=ball.v.Unit,charge=charge,soft=not deceptive and (soft or (softRequested and Rules.softShot(r.Position,d.side) or nil)) or nil},"swing")
  local slamName=not grounded and "SPIKE!" or "SLAM!"
  local message=restored and (slam and slamName.."  SPEED RESET TO 1.00x" or "PERFECT!  SPEED RESET TO 1.00x")
   or (slam and slamName.."  +10%" or (clean and "PERFECT!  +5%" or "LOB RETURN  /  -5%"))
  if charged and clean then message="CHARGED RETURN!  +7%"
  elseif charged and quality~="net" then message="MISTIMED CHARGE  /  WIDE RETURN" end
  if soft then message=soft=="dink" and "PERFECT DINK!" or "PERFECT DROP!"
  elseif quality=="net" then message="BAD TIMING  /  LOW CONTACT" end
  if accelerationMessage then message=accelerationMessage end
  if slam and quality=="net" then message="EARLY SLAM / NET"
  elseif slam and quality=="out" then message="LATE SLAM / OUT" end
  feedback:FireAllClients({userId=p.UserId,text=message,tone=clean and "good" or (quality=="net" or quality=="out" or charged) and "bad" or "neutral"},"playerText")
  d.diveUntil=0
  return true
end
arcadeRemote.OnServerEvent:Connect(function(p,index)
 local d=users[p]; local now=os.clock()
 if not d or d.side==0 or d.variant~="Arcade" or courtVariant~="Arcade" or practicePaused()
  or now<introUntil or loadoutPending or draft or draftDue or p:GetAttribute("LeaveConfirmationOpen") then return end
 local root,humanoid=rootOf(p)
 if not root or not humanoid or humanoid.Health<=0 then return end
 if not ball.live then
  if serveReady then arcade:arm(p,index,now) end
  return
 end
 local opponents=teamPlayers(-d.side)
 if courtMode=="Practice" then table.insert(opponents,"PracticeBot") end
 local card=arcade:activate(p,index,now,d.side,opponents,root,world,courtVariant=="Chaos")
 if card then tell(p,card.name:upper(),"perfect") end
end)
activateArmedPowers=function(now)
 for p,d in pairs(users) do
  if d.side==0 then continue end
  local root,humanoid=rootOf(p)
  if not root or not humanoid or humanoid.Health<=0 then arcade:clearArmed(p); continue end
  local opponents=teamPlayers(-d.side)
  if courtMode=="Practice" then table.insert(opponents,"PracticeBot") end
  for _,card in ipairs(arcade:activateArmed(p,now,d.side,opponents,root,world,courtVariant=="Chaos")) do
   tell(p,card.name:upper(),"perfect")
  end
 end
end
input.OnServerEvent:Connect(function(p,action,moveIntent)
 local d=users[p]
 if not d or d.side==0 or type(action)~="string" or practicePaused() then return end
 local now=os.clock()
 if action=="DiveHeld" then d.diveHeld=moveIntent==true; return end
 if now<d.powerupRally.stunUntil and action=="Dive" then return end
 if now<introUntil or loadoutPending or draft or draftDue then return end
 -- Release/cancel must survive the flood gate, even for a very quick tap.
 if action=="ChargeCancel" then d.serveChargeAt=nil; d.chargeAt=nil; if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end; return end
 local releasedCharge
 if action=="ChargeRelease" then
  if not d.chargeAt then return end
  releasedCharge=Rules.chargeAmount(d.chargeAt,now); d.serveChargeAt=nil; d.chargeAt=nil; if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end
  if ball.live and releasedCharge>0 and now<(d.chargeShotAt or 0) then releasedCharge=0; d.chargeCooldownBlocked=true end
 end
 -- Remote flood protection does not impose a gameplay cooldown on perfect returns.
 if releasedCharge==nil and action~="ServeTimingStop" and action~="ServeChargeStart" and now-d.lastInput<0.015 then return end
 d.lastInput=now
 local r,h=rootOf(p)
 if not r or not h or h.Health<=0 then return end
 if action=="ServeChargeStart" then
  if not serveReady or not serveDeadline or workspace:GetServerTimeNow()>=serveDeadline then return end
  if not Rules.canServe(p.UserId,serverId,serveReady) then return end
  d.serveChargeAt=d.serveChargeAt or workspace:GetServerTimeNow()
  p.Character:SetAttribute("ShotChargeAt",d.serveChargeAt)
 elseif action=="ChargeStart" then
  if not ball.live and not Rules.canServe(p.UserId,serverId,serveReady) then return end
  d.chargeAt=d.chargeAt or now
  p.Character:SetAttribute("ShotChargeAt",workspace:GetServerTimeNow())
 elseif action=="ChargeRelease" then
  if ball.live then
   local hit=tryReturn(p,d,r,now,false,false,releasedCharge)
   if hit and d.chargeCooldownBlocked then tell(p,"CHARGED SHOT RECHARGING  /  NORMAL HIT","info") end
   d.chargeCooldownBlocked=nil
  else serve(p,d,r,h) end
 elseif action=="ServeTimingStop" or action=="Serve" or (action=="Swing" and not ball.live) then
  serve(p,d,r,h)
 elseif action=="Dive" then
  if not Rules.canDive(d.stamina/(d.powerupRally.lava and 2 or 1),d.diveAt,now) then return end
  d.serveChargeAt=nil; d.chargeAt=nil; if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end
  local cooldown=Rules.DIVE_COOLDOWN*(1-((d.powerups and d.powerups.dive) or 0))
  d.stamina=math.max(0,d.stamina-Rules.DIVE_STAMINA_COST*(d.powerupRally.lava and 2 or 1)); d.diveAt=now+cooldown
  d.staminaRecoveryAt=now+Rules.STAMINA_RECOVERY_DELAY
  local moveTime,poseTime=Powerups.diveDuration(d.powerups)
  d.diveUntil=now+moveTime; d.divePoseUntil=now+poseTime; d.diveCharacter=p.Character
  d.powerupRally.diveStarted=now
  activatePowerup(p,"quickRecovery",poseTime); activatePowerup(p,"afterimage",2)
  local delta=ball.live and ball.p-r.Position or Vector3.zero
  if typeof(moveIntent)~="Vector3" or moveIntent.X~=moveIntent.X or moveIntent.Z~=moveIntent.Z then
   moveIntent=h.MoveDirection
  end
  moveIntent=Vector3.new(math.clamp(moveIntent.X,-1,1),0,math.clamp(moveIntent.Z,-1,1))
  local direction=Rules.diveDirection(moveIntent,r.CFrame.LookVector,delta)
  feedback:FireAllClients({userId=p.UserId,direction=direction.Unit,moveTime=moveTime,poseTime=poseTime,afterimage=Powerups.has(d.powerups,"afterimage"),diveReadyAt=workspace:GetServerTimeNow()+cooldown},"diveMotion")
  tell(p,"DIVE","dive")
 elseif action=="Power" then
  if not MatchSetup.abilities(courtVariant) then return end
  if now<d.powerAt then return end
  d.powerAt=now+10; d.powerUntil=now+5
  tell(p,"POWER SHOT ARMED  /  5s","power")
 elseif action=="Slow" then
  if not MatchSetup.abilities(courtVariant) then return end
  if now<d.slowAt then return end
  d.slowAt=now+12
  local opponents=teamPlayers(-d.side)
  if #opponents==0 then botSlowUntil=now+2.5 end
  for _,opponent in ipairs(opponents) do
   users[opponent].slowUntil=now+2.5; tell(opponent,"SLOWED  /  2.5s","slow")
  end
  tell(p,"OPPONENT SLOWED","power")
 elseif action=="Lob" or action=="Slice" then
  if ball.live then tryReturn(p,d,r,now,false,false,0,action) end
  d.serveChargeAt=nil; d.chargeAt=nil; if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end
 elseif action=="Swing" or action=="SoftShot" then
  d.serveChargeAt=nil; d.chargeAt=nil; if p.Character then p.Character:SetAttribute("ShotChargeAt",nil) end
  if ball.live then tryReturn(p,d,r,now,false,action=="SoftShot") end
 end
end)
local accumulator,broadcast=0,0
RunService.Heartbeat:Connect(function(dt)
 updateQueue()
 local now=os.clock()
 if matchIntro and matchIntro.loading and now>=introLoadDeadline then
  local waiting={}
  for player,data in pairs(users) do
   if data.side~=0 and not introReady[player] then table.insert(waiting,player) end
  end
  for _,player in ipairs(waiting) do
   leaveCourt(player)
   users[player].mode="Lobby"; player:SetAttribute("SessionMode","Lobby")
   if player.Character then task.spawn(spawnCharacter,player,player.Character) end
   session:FireClient(player,false,"The moon took too long to load. Please try joining again.")
  end
 end
 local paused=practicePaused()
 if paused then suspendPracticeTimers(dt) else updateDraft(now); arcade:update(now) end
 if not paused and courtVariant=="Chaos" then
  local participants={}
  for p,d in pairs(users) do if d.side~=0 then table.insert(participants,{player=p,side=d.side}) end end
  if courtMode=="Practice" then table.insert(participants,{player="PracticeBot",side=-1}) end
  local live=ball.live and now>=introUntil and not draft and not draftDue
  arcade:chaosUpdate(math.min(dt,0.1),now,participants,world,live)
  if live then arcade:chaosStep(math.min(dt,0.1),now,participants,world) end
 end
 local gravityFactor=arcade:gravity(now)
 if ball.live and gravityFactor~=(ball.arcadeGravity or 1) then
  ball.flightGravity=(ball.flightGravity or GRAVITY)*gravityFactor/(ball.arcadeGravity or 1)
  ball.arcadeGravity=gravityFactor
 end
 local pickupParticipants={}
 for player,data in pairs(users) do
  if data.side~=0 then table.insert(pickupParticipants,{player=player,side=data.side}) end
 end
 if not paused then powerups:update(now,(now<introUntil or not MatchSetup.abilities(courtVariant)) and {} or pickupParticipants) end
 for p,d in pairs(users) do
  if paused and d.mode=="Practice" then freezePracticePlayer(p); continue end
  local recovered=Rules.recoverStamina(d.stamina,d.staminaRecoveryAt or 0,now,dt)
  p:SetAttribute("SlowFallEnabled",Powerups.slowFall(d.powerups,d.side,d.variant))
  d.stamina=math.min(100,d.stamina+(recovered-d.stamina)*(1+((d.powerups and d.powerups.regen) or 0)))
  local r,h=rootOf(p)
  if r and h and h.Health>0 then
   applyEnvironmentGravity(p,r)
   local effect=d.powerupRally
   local camper=false
   if ball.live and d.side~=0 and Powerups.has(d.powerups,"kitchenCamper") then
    camper=Powerups.camp(effect,r.Position.Z*d.side,r.Position.X,Rules.KITCHEN,Rules.BASELINE)
   end
   local baseline=Powerups.has(d.powerups,"baselineSentinel") and math.abs(r.Position.Z*d.side-Rules.BASELINE)<=4 and math.abs(r.Position.X)<=Rules.HALF_WIDTH
   p:SetAttribute("BaselineSentinelActive",baseline and d.side~=0)
   -- Client biases only the lateral input. Recover the original input ratio for speed.
   local move=h.MoveDirection
   local original=Vector3.new(baseline and move.X/1.15 or move.X,0,move.Z)
   local lateral=original.Magnitude>0.01 and original.Unit.X or 0
   local movement=(1+(d.powerups.speed or 0)+(d.powerupMatch.speedWins or 0)*0.05)*Powerups.lateralScale(d.powerups,r.Position.Z*d.side,r.Position.X,lateral)*(camper and 1.15 or 1)*(now<effect.burstUntil and 1.75 or 1)*(Comeback.active(comeback,d.side) and Comeback.MOVE or 1)
   movement*=arcade:speed(p,now)
   local sliding,slideDirection=false,nil
   if d.side~=0 then sliding,slideDirection=arcade:touch(p,d.side,r.Position,now) end
   local stunned=now<effect.stunUntil or sliding
   h.WalkSpeed=(stunned or d.mode=="Spectate" or (d.side~=0 and (now<introUntil or loadoutPending or draft~=nil))) and 0 or (now<d.slowUntil and SLOWED_SPEED or WALK_SPEED)*movement
   p:SetAttribute("PowerupStunned",stunned)
   if stunned then r.AssemblyLinearVelocity=Vector3.new(0,r.AssemblyLinearVelocity.Y,0)+(sliding and slideDirection*16 or Vector3.zero) end
   local face=p.Character:FindFirstChild("PaddleFace")
   local fire=ball.live and Powerups.onFire(d.powerups,effect,ball.shots+1)
   if face then
    face.Size=Vector3.new(1.65,2,0.3)*arcade:reach(p,now)
    face.Material=fire and Enum.Material.Neon or Enum.Material.SmoothPlastic
    face.Color=fire and Color3.fromRGB(255,115,25) or Color3.fromRGB(31,193,180)
   end
   local grounded=h.FloorMaterial~=Enum.Material.Air
   local active={kitchenCamper=camper,baselineSentinel=baseline and math.abs(move.X)>0.1,
    airTime=Powerups.slowFall(d.powerups,d.side,d.variant) and not grounded and now>=(d.divePoseUntil or 0),
    kitchenWarden=Powerups.warden(d.powerups,r.Position.Z*d.side,r.Position.X,Vector3.new(r.AssemblyLinearVelocity.X,0,r.AssemblyLinearVelocity.Z).Magnitude,grounded),
    overcharge=fire,dinkSpecialist=effect.driveReady==true,momentumShift=effect.perfectChain>=3}
   for id,on in pairs(active) do
    if ball.live and on and not (d.powerupActive and d.powerupActive[id]) then activatePowerup(p,id) end
   end
   d.powerupActive=active
   local kitchenFault=Rules.updateKitchen(d,r.Position,grounded,r.AssemblyLinearVelocity,dt)
   if ball.live and d.side~=0 and grounded and math.abs(r.Position.X)<=Rules.HALF_WIDTH+1
    and math.abs(r.Position.Z*d.side-Rules.KITCHEN)<=1 then
    for _,opponent in ipairs(teamPlayers(-d.side)) do
     if Powerups.has(users[opponent].powerups,"lava") then
      if not effect.lava then activatePowerup(opponent,"lava",1.5) end
      effect.lava=true
     end
    end
   end
   if kitchenFault and ball.live then
    point(-d.side,"Kitchen volley fault")
   end
   if d.side~=0 then
    local x,z
    if now<d.diveUntil then
     x=r.Position.X
     z=r.Position.Z
    else
     x=r.Position.X
     z=d.side*math.max(r.Position.Z*d.side,2.5)
    end
    if math.abs(x-r.Position.X)>0.1 or math.abs(z-r.Position.Z)>0.1 or r.Position.Y<178 then
     local recovering=r.Position.Y<178
     r.CFrame=CFrame.new(x,math.max(r.Position.Y,184),z)*r.CFrame.Rotation
     if recovering then
      local velocity=r.AssemblyLinearVelocity
      r.AssemblyLinearVelocity=Vector3.new(velocity.X,0,velocity.Z); h.Jump=false
     end
    end
   end
  end
 end
 local hasBot=courtMode=="Practice" and occupant(1)~=nil and occupant(-1)==nil
 for _,p in ipairs(bot:GetChildren()) do if p:IsA("BasePart") then p.Transparency=hasBot and 0 or 1 end end
 tag.Enabled=hasBot
 if not paused and not draft and not draftDue and not ball.live and not serveReady and now>=nextServe and occupant(1) then prepareServe() end
 if courtMode=="Practice" then
  local key=hasBot and serveReady and servingSide==-1 and serverId==0 and tostring(practiceServeSerial)..":"..tostring(serveX) or nil
  if practice:step(key,dt) then autoBotServe() end
 end
 if not paused and serveReady and serveDeadline and workspace:GetServerTimeNow()>=serveDeadline then
  local server=serverId and Players:GetPlayerByUserId(serverId)
  for player,data in pairs(users) do
   data.serveChargeAt=nil; data.chargeAt=nil
   if player.Character then player.Character:SetAttribute("ShotChargeAt",nil) end
  end
  serveReady=false; serveDeadline=nil
  ball.last=servingSide; ball.shots=0; ball.speed=Rules.servePower(0)
  if server then
   lastHitter[servingSide]=server
   ball.live=true
   feedback:FireClient(server,{grade="SERVE TIMEOUT",offset=1,accuracy=0},"serveTiming")
   point(-servingSide,"Serve timeout")
  else
   -- The practice partner has no human input; only bot serves are automatic.
   ball.speed=Rules.servePower(1)
   local from=Vector3.new(serveX,184,servingSide*46)
   launch(from,Rules.serveTarget(nil,servingSide,serveX),false,false,false,0,nil,false,0,{maxVelocity=Rules.MAX_SERVE_VELOCITY})
   banner="BOT SERVE / LET IT BOUNCE"
  end
 end
 if ball.live and not paused then
  accumulator+=math.min(dt,0.1)
  while accumulator>=1/120 and ball.live do
   local step=1/120
   accumulator-=step
   -- Check throughout the dive at the same fixed rate as ball physics.
   for p,d in pairs(users) do
    if d.side~=0 and d.diveUntil and now<d.diveUntil and p.Character==d.diveCharacter then
     local r,h=rootOf(p)
     if r and h and h.Health>0 then tryReturn(p,d,r,now,true) end
    end
   end
   for p,d in pairs(users) do
    if ball.live and d.side~=0 and d.side~=ball.last and Powerups.has(d.powerups,"deflector")
     and not ball.lob and not ball.soft and ball.shots>=2 then
     local r,h=rootOf(p)
     if r and h and h.Health>0 and math.abs(ball.p.Y-r.Position.Y)<=1.5
      and Vector3.new(ball.p.X-r.Position.X,0,ball.p.Z-r.Position.Z).Magnitude<=2.5
      and (r.Position-ball.p):Dot(ball.v)>0 then
      tryReturn(p,d,r,now,true,false,0,"Deflect")
     end
    end
   end
   if not ball.live then break end
   local previous=ball.p
   local curve=ball.curveX or 0
   ball.p+=Vector3.new(0.5*curve*step*step,0,0)
   ball.p,ball.v,ball.g=Rules.advanceFlight(ball.p,ball.v,ball.flightGravity or GRAVITY,step,ball.lob,ball.bounces>0,ball.offensive,ball.last)
   ball.v+=Vector3.new(curve*step,0,0)
   if previous.Z*ball.p.Z<=0 and math.abs(ball.p.X)<21 and ball.p.Y<184.65 then
    point(-ball.last,"Net")
   elseif ball.p.Y<=FLOOR then
    ball.curveX=0
    local fraction=math.clamp((previous.Y-FLOOR)/math.max(0.0001,previous.Y-ball.p.Y),0,1)
    local impact=previous:Lerp(ball.p,fraction)
    feedback:FireAllClients({position=impact,speed=ball.speed,onCourt=math.abs(impact.X)<=20.09 and math.abs(impact.Z)<=40.09},"ballBounce")
    if ball.bounces==0 and (math.abs(impact.X)>20.09 or math.abs(impact.Z)>40.09) then
     ball.outLanding=Vector3.new(impact.X,FLOOR,impact.Z)
    end
    if ball.bounces>=1 then
     point(ball.last,"Double bounce")
    elseif ball.shots==0 and not Rules.serveLandingValid(ball.p,servingSide,serveX) then
     point(-servingSide,"Serve fault: land in the diagonal service court")
    elseif math.abs(ball.p.X)>20.09 or math.abs(ball.p.Z)>40.09 then
     point(-ball.last,"Out")
    elseif ball.p.Z*ball.last>0 then
     point(-ball.last,"Short return")
    else
     local hitter=ball.hitter and Players:GetPlayerByUserId(ball.hitter)
     local hitterData=hitter and users[hitter]
     if hitterData then
      if Powerups.has(hitterData.powerups,"dinkSpecialist") and ball.soft=="dink" then
       Powerups.dink(hitterData.powerupRally,Rules.inKitchen(impact))
       if Rules.inKitchen(impact) then activatePowerup(hitter,"dinkSpecialist") end
      end
      if ball.atp then
       activatePowerup(hitter,"atpAssassin",1.2)
       for _,opponent in ipairs(teamPlayers(-ball.last)) do
        local enemy=users[opponent]
        enemy.stamina=math.max(0,enemy.stamina-30*(enemy.powerupRally.lava and 2 or 1))
        enemy.staminaRecoveryAt=now+Rules.STAMINA_RECOVERY_DELAY
       end
       tell(hitter,"ATP CRITICAL! / -30% STAMINA","perfect")
      end
     end
     ball.bounces+=1
     if ball.bounces>=2 then point(ball.last,"Double bounce")
     else
      ball.p=Vector3.new(ball.p.X,FLOOR,ball.p.Z)
      ball.v=Rules.bounceVelocity(ball.v,ball.lob)
      local spinScale=Powerups.bounceScale(ball.spin,ball.sliceBoost)
      -- An ignited receiver negates incoming spin before the bounce.
      for _,receiver in ipairs(teamPlayers(-ball.last)) do
       local data=users[receiver]
       if Powerups.onFire(data.powerups,data.powerupRally,ball.shots+1) then spinScale=1 end
      end
      ball.v=Vector3.new(ball.v.X,ball.v.Y*spinScale,ball.v.Z)
      ball.g=(ball.flightGravity or GRAVITY)*(ball.lob and Rules.LOB_GRAVITY_SCALE or 1)*(ball.offensive and 1.8 or 1)
      ball.bounceAt=now
      ball.bouncePoint=ball.p
     end
    end
   elseif ball.p.Y<170 then
    point(ball.bounces>0 and ball.last or -ball.last,"Rally over")
   end
  end
 else accumulator=0 end
 botMoving=false
 if hasBot and ball.live and not paused then
  local config=PracticeSession.Profiles[practice.difficulty]
  if botShotId~=ball.shotId then
   botShotId=ball.shotId
   botReactAt=now+botRandom:NextNumber(config.reactionMin,config.reactionMax)
   botThinkAt=botReactAt; botAttempted=false
   botError=Vector3.new(botRandom:NextNumber(-config.errorX,config.errorX),0,botRandom:NextNumber(-config.errorZ,config.errorZ))
  end
  -- Read the flight periodically instead of following its exact landing every frame.
  if now>=botThinkAt then
   botThinkAt=now+config.think
   if ball.last==1 then
    local predicted=landing()
    botTarget=Vector3.new(math.clamp(predicted.X+botError.X,-30,30),0,
     math.clamp(predicted.Z-3+botError.Z,-Rules.BACK_LIMIT,-2.5))
   else botTarget=Vector3.new(0,0,-28) end
  end
  local delta=botTarget-Vector3.new(botX,0,botZ)
  local move=math.min(delta.Magnitude,math.min(dt,0.1)*(now<botSlowUntil and SLOWED_SPEED or config.move)*(Comeback.active(comeback,-1) and Comeback.MOVE or 1)*arcade:speed("PracticeBot",now))
  local botSliding=arcade:touch("PracticeBot",-1,Vector3.new(botX,184,botZ),now)
  if now<botStunUntil or botSliding then move=0 end
  botMoving=move>0.01
  botStride+=move*0.65
  if delta.Magnitude>0.01 then botX+=delta.Unit.X*move; botZ+=delta.Unit.Z*move end
  local rootPosition=Vector3.new(botX,184,botZ)
  local rootFrame=CFrame.lookAt(rootPosition,rootPosition+Vector3.new(0,0,1))
  local center=Vector3.new(botX,184.5,botZ+1)
  local distance=(ball.p-center).Magnitude
  if ball.last==1 and now>=botReactAt and now>=botSwingAt and not botAttempted
   and ball.p.Z< -2 and distance<6.5*(Comeback.active(comeback,-1) and Comeback.HIT or 1)*arcade:reach("PracticeBot",now) and Rules.contactInFront(ball.p,rootFrame)
   and ball.p.Y<188 and (ball.v.Y<0 or ball.bounces>0)
   and not Rules.returnFault(ball.bounces,ball.shots,Rules.kitchenHitFault(rootPosition,true,false)) then
   -- One attempt per incoming shot: a whiff cannot be retried on the next frame.
   botAttempted=true; botSwingAt=now+0.28
   local pressure=math.clamp((ball.speed-1)*0.15+(distance/6.5)*0.08,0,0.18)
   if ball.deadly then
    point(ball.last,"Unreturnable paddle strike")
   elseif botRandom:NextNumber()>=config.miss+pressure then
    if ball.bounces==0 and ball.soft=="dink" and ball.hitter then
     local prior=Players:GetPlayerByUserId(ball.hitter)
     if prior and users[prior] then Powerups.dink(users[prior].powerupRally,false) end
    end
    local clean=perfect(now) and distance<=Rules.PERFECT_RANGE and botRandom:NextNumber()<config.clean
    local _,timeToBounce=landing()
    local quality=Rules.shotQuality(clean,timeToBounce,now-ball.bounceAt)
    if clean then ball.perfects+=1 end
    ball.speed=Rules.returnSpeed(ball.speed,clean,false)
    ball.last=-1; ball.shots+=1
    local targetX=botRandom:NextNumber(-config.width,config.width)
    local targetZ=botRandom:NextNumber(config.depthMin,config.depthMax)
    if botRandom:NextNumber()<config.wide+pressure*0.3 then
     targetX=(targetX<0 and -1 or 1)*botRandom:NextNumber(21,25)
    end
    launch(ball.p,Vector3.new(targetX,FLOOR,targetZ),false,quality=="lob",false,0,nil,quality=="net",0,{clean=clean,speedMultiplier=config.speed*(Comeback.active(comeback,-1) and Comeback.HIT or 1)})
    feedback:FireAllClients({userId=0,text=clean and "PERFECT!" or "LOB RETURN",tone=clean and "good" or "neutral"},"playerText")
   end
  end
 end
 botBody.Position=Vector3.new(botX,184.2,botZ)
 botHead.Position=Vector3.new(botX,186.3,botZ)
 botPaddle.Size=Vector3.new(1.5,2.2,0.3)*arcade:reach("PracticeBot",now)
 botPaddle.CFrame=CFrame.new(botX-1.8,184.4,botZ+1)*CFrame.Angles(0,0,0.2)
 for i,p in ipairs(botLegs) do
  local stride=botMoving and math.sin(botStride)*(i==1 and 1 or -1) or 0
  p.CFrame=CFrame.new(botX+(i==1 and -0.6 or 0.6),182.4,botZ+stride*0.45)*CFrame.Angles(stride*0.4,0,0)
 end
 if serveReady and not paused then
  local server=serverId and Players:GetPlayerByUserId(serverId)
  ball.p=Rules.heldBallPosition(server and server.Character or (hasBot and bot)) or ball.p
 end
 broadcast+=dt
 if broadcast>=0.05 then
  broadcast=0
  local target,t=landing()
  if ball.live and now-ball.bounceAt<=0.28 and ball.bouncePoint then
   target=ball.bouncePoint; t=0
  end
  for p,d in pairs(users) do
   local practiceState=d.mode=="Practice" and practice:snapshot() or nil
   if practiceState then practiceState.draftRemaining=draft and math.max(0,draft.endsAt-now) or nil end
   local hidden,glitch,heavy=Powerups.tracking(d.side~=0 and d.side~=ball.last,ball.live,now,ball.trackingHiddenUntil,ball.trackingGlitchUntil,ball.heavy,ball.p.Z*ball.last>0)
   local viewPosition,viewVelocity=ball.p,ball.v
   if heavy and ball.launchPosition then
    local scale=math.max(1,ball.speed*(ball.shotMultiplier or 1))
    local age=(now-ball.launchedAt)/scale
    viewPosition,viewVelocity=Rules.advanceFlight(ball.launchPosition,ball.launchVelocity,ball.flightGravity or GRAVITY,age,ball.lob,false,ball.offensive,ball.last)
    viewVelocity/=scale
   end
   local activeEffects={}
   for id,on in pairs(d.powerupActive or {}) do if ball.live and on and Powerups.has(d.powerups,id) then activeEffects[id]=true end end
   for id,untilTime in pairs(d.powerupPulses or {}) do if now<untilTime then activeEffects[id]=true end end
   if ball.live then
    if (d.powerupMatch.reachStacks or 0)>0 then activeEffects.vampiricReach=true end
    if (d.powerupMatch.speedWins or 0)>0 then activeEffects.terminalVelocity=true end
    if Powerups.has(d.powerups,"lava") then
     for _,opponent in ipairs(teamPlayers(-d.side)) do if users[opponent].powerupRally.lava then activeEffects.lava=true end end
    end
   end
   for _,id in ipairs({"carbonFiber","perfectVision","phantom"}) do if ball.live and Powerups.has(d.powerups,id) then activeEffects[id]=true end end
   local auraTier=0
   if courtVariant=="Chaos" and d.side~=0 and ball.live then
    for id,level in pairs(arcade:data(p).levels) do activeEffects[id]=true; auraTier=math.max(auraTier,math.ceil(level/2)) end
   end
   for _,card in ipairs(Powerups.catalog) do if activeEffects[card.id] then auraTier=math.max(auraTier,card.tier) end end
   if ball.live and d.side~=0 then
    for _,stat in ipairs({"speed","regen","reach","dive"}) do if (d.powerups[stat] or 0)>0 then auraTier=math.max(auraTier,1) end end
   end
   p:SetAttribute("ActivePowerupTier",ball.live and d.side~=0 and auraTier or 0)
   p:SetAttribute("ComebackBoost",Comeback.active(comeback,d.side))
   state:FireClient(p,{
    practice=practiceState,practicePaused=paused,
    arcade=d.side~=0 and (courtVariant=="Arcade" or courtVariant=="Chaos") and arcade:snapshot(p,now) or nil,curveX=ball.curveX,
    comeback=Comeback.active(comeback,d.side),
    powerupEffects=activeEffects,powerupProgress={tension=d.powerupRally.tension,perfectChain=d.powerupRally.perfectChain,
     reachStacks=d.powerupMatch.reachStacks or 0,speedWins=d.powerupMatch.speedWins or 0,secondServeUsed=d.powerupMatch.secondServeUsed==true},
    matchIntro=d.side~=0 and now<introUntil and matchIntro or nil,
    trackingHidden=hidden,trackingGlitch=glitch,heavy=heavy,visualRate=heavy and 1/math.max(1,ball.speed*(ball.shotMultiplier or 1)) or 1,
    offensive=ball.offensive,decoyLanding=glitch and target+Vector3.new(target.X>0 and -6 or 6,0,3) or nil,
    outLanding=ball.outLanding,p=viewPosition,v=viewVelocity,g=ball.g,flightGravity=ball.flightGravity or GRAVITY,lob=ball.lob,live=ball.live,landing=target,eta=t,
    slammable=ball.live and ball.slamLob,shotId=ball.shotId,slamReady=slamReady(p,d,now),
    green=ball.live and perfect(now,d),last=ball.last,bounces=ball.bounces,
    perfects=ball.perfects,speed=ball.speed*(ball.live and ball.shotMultiplier or 1),score=score,banner=banner,
    serveReady=serveReady,servingSide=servingSide,serveX=serveX,serverId=serverId,receiverId=receiverId,serverNumber=rotation.number,
    serverName=(serverId and Players:GetPlayerByUserId(serverId) and Players:GetPlayerByUserId(serverId).DisplayName) or "Practice Partner",
    serveDeadline=serveDeadline,serveRemaining=serveDeadline and math.max(0,serveDeadline-workspace:GetServerTimeNow()) or 0,
    canServe=not paused and Rules.canServe(p.UserId,serverId,serveReady),
    mustBounce=ball.live and ball.shots<2 and ball.bounces==0,
    powerupStatus=ball.live and (Powerups.onFire(d.powerups,d.powerupRally,ball.shots+1) and "ON FIRE"
     or now<d.powerupRally.stunUntil and "STUNNED" or d.powerupRally.lava and "KITCHEN IS LAVA / 2x DRAIN"
     or d.powerupRally.perfectChain>=3 and Powerups.has(d.powerups,"momentumShift") and "MOMENTUM SHIFT READY"
     or d.powerupRally.driveReady and "TENSION READY / BASELINE DRIVE" or "") or "",
    side=d.side,bot=hasBot,stamina=d.stamina,dive=math.max(0,d.diveAt-now),
    diveReadyAt=workspace:GetServerTimeNow()+math.max(0,d.diveAt-now),
    homeName=teamName(1),awayName=teamName(-1),
    power=math.max(0,d.powerAt-now),slow=math.max(0,d.slowAt-now),
    armed=math.max(0,d.powerUntil-now),slowed=math.max(0,d.slowUntil-now)
   })
  end
 end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">ArcadePowers</string>
          <string name="Source"><![CDATA[-- Shared eight-power engine: Arcade deck offers and random Chaos stacks.
local Deck=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("ArcadeDeck"))
local Arcade={}
Arcade.__index=Arcade
function Arcade.new(random)
 return setmetatable({random=random or Random.new(),players={},hazards={},zeroUntil=0,glowUntil=0},Arcade)
end
function Arcade:reset()
 for _,hazard in ipairs(self.hazards) do if hazard.part then hazard.part:Destroy() end end
 table.clear(self.players); table.clear(self.hazards); self.zeroUntil=0; self.glowUntil=0
 self.remaining=self.random:NextInteger(2,4)
 self.chaosElapsed=0; self.chaosNext=4; self.chaosEvent=nil
 self.chaosGravity=1
end
function Arcade:data(player)
 if not self.players[player] then self.players[player]={slots={},effects={},pending={},levels={},chaosTimers={}} end
 return self.players[player]
end
function Arcade:empty(player,now)
 local data=self:data(player)
 local slots=data.slots
 for index=1,2 do
  local slot=slots[index]
  if slot and slot.readyAt and now>=slot.readyAt then
   if (slot.charges or 0)>0 then slot.readyAt=nil;slot.activeUntil=nil;slot.duration=nil
   else slots[index]=nil end
  end
  if not slots[index] and #data.pending>0 then
   local id=table.remove(data.pending,1);slots[index]={id=id,charges=1}
   for i=#data.pending,1,-1 do if data.pending[i]==id then slots[index].charges+=1;table.remove(data.pending,i) end end
  end
 end
 for index=1,2 do if not slots[index] then return index end end
end
function Arcade:offer(player,ids,now)
 if not Deck.validate(ids) or not self:empty(player,now) then return nil end
 local cards={}
 for _,id in ipairs(ids) do table.insert(cards,Deck.find(id)) end
 -- Shuffle without changing the selected deck.
 for i=#cards,2,-1 do local j=self.random:NextInteger(1,i); cards[i],cards[j]=cards[j],cards[i] end
 return cards
end
function Arcade:chaosOffer()
 local cards=table.clone(Deck.cards)
 for i=#cards,2,-1 do local j=self.random:NextInteger(1,i); cards[i],cards[j]=cards[j],cards[i] end
 return {cards[1],cards[2],cards[3]}
end
function Arcade:chaosUpgradeOffer(player)
 local levels=self:data(player).levels
 local cards={}
 for _,base in ipairs(Deck.cards) do
  if (levels[base.id] or 0)<Deck.CHAOS_MAX_LEVEL then table.insert(cards,Deck.chaosCard(base.id,levels[base.id])) end
 end
 for i=#cards,2,-1 do local j=self.random:NextInteger(1,i); cards[i],cards[j]=cards[j],cards[i] end
 local offer={}
 for i=1,math.min(3,#cards) do offer[i]=cards[i] end
 return #offer>0 and offer or nil
end
function Arcade:chooseChaos(player,offer,id)
 if type(offer)~="table" or type(id)~="string" then return nil end
 local levels=self:data(player).levels
 for _,candidate in ipairs(offer) do
  if candidate.id==id and candidate.chaosUpgrade and Deck.find(id) then
   local current=levels[id] or 0
   if current>=Deck.CHAOS_MAX_LEVEL or current~=candidate.previousLevel then return nil end
   local card=Deck.chaosCard(id,current)
   levels[id]=card.level
   return card
  end
 end
end
function Arcade:choose(player,offer,id,now,stack)
 local index=self:empty(player,now)
 if (not index and not stack) or type(offer)~="table" then return nil end
 for _,card in ipairs(offer) do
  if card.id==id and Deck.find(id) then
   local data=self:data(player)
   if stack then
    for slot,existing in pairs(data.slots) do
     if existing.id==id then existing.charges=(existing.charges or 0)+1;return card,slot end
    end
   end
   if index then data.slots[index]={id=id,charges=1}
   else table.insert(data.pending,id) end
   return card,index
  end
 end
end
function Arcade:rally()
 self.remaining=(self.remaining or self.random:NextInteger(2,4))-1
 if self.remaining>0 then return false end
 self.remaining=self.random:NextInteger(2,4); return true
end
function Arcade:effect(player,id,now)
 return now<(self:data(player).effects[id] or 0)
end
function Arcade:reach(player,now)
 local data=self:data(player)
 return Deck.chaosValues(data.levels).reach*(data.chaosShrink or 1)
  *(self:effect(player,"bigPaddle",now) and 1.75 or 1)*(self:effect(player,"smallPaddle",now) and 0.5 or 1)
end
function Arcade:speed(player,now)
 return Deck.chaosValues(self:data(player).levels).speed*(self:effect(player,"speedCleats",now) and 1.4 or 1)
end
function Arcade:swingScale(player,now)
 return Deck.chaosValues(self:data(player).levels).swing*(self:effect(player,"speedCleats",now) and Deck.SPEED_SWING_SCALE or 1)
end
function Arcade:gravity(now) return math.min(self.chaosGravity or 1,now<self.zeroUntil and 0.4 or 1) end
function Arcade:arm(player,index,now)
 if type(index)~="number" or index%1~=0 or index<1 or index>2 then return nil end
 self:empty(player,now)
 local slot=self:data(player).slots[index]
 if not slot or slot.readyAt or (slot.charges or 0)<=0 then return nil end
 slot.armed=not slot.armed
 return slot.armed
end
function Arcade:clearArmed(player)
 if player then
  local data=self.players[player]
  if data then for _,slot in pairs(data.slots) do slot.armed=nil end end
 else
  for p in pairs(self.players) do self:clearArmed(p) end
 end
end
function Arcade:activateArmed(player,now,side,opponents,root,world,chaos)
 local activated={}
 local data=self.players[player]
 if not data then return activated end
 for index=1,2 do
  local slot=data.slots[index]
  if slot and slot.armed then
   slot.armed=nil
   local card=self:activate(player,index,now,side,opponents,root,world,chaos)
   if card then table.insert(activated,card) end
  end
 end
 return activated
end
function Arcade:activate(player,index,now,side,opponents,root,world,chaos)
 if type(index)~="number" or index%1~=0 or index<1 or index>2 then return nil end
 self:empty(player,now)
 local data=self:data(player)
 local slot=data.slots[index]
 if not slot or slot.readyAt then return nil end
 slot.armed=nil
 local card=Deck.find(slot.id)
 slot.charges=math.max(0,(slot.charges or 1)-1)
 local duration=card.duration==0 and 15 or card.duration
 slot.cooldownDuration=chaos and Deck.CHAOS_COOLDOWN or Deck.COOLDOWN
 slot.activeUntil=now+duration; slot.readyAt=slot.activeUntil+slot.cooldownDuration; slot.duration=duration
 if card.id~="smallPaddle" then data.effects[card.id]=slot.activeUntil end
 if card.id=="smallPaddle" then
  for _,opponent in ipairs(opponents) do self:data(opponent).effects.smallPaddle=now+Deck.SMALL_PADDLE_SECONDS end
 elseif card.id=="zeroG" then self.zeroUntil=math.max(self.zeroUntil,slot.activeUntil)
 elseif card.id=="glowBall" then self.glowUntil=math.max(self.glowUntil,slot.activeUntil)
 elseif card.id=="dropPickles" or card.id=="slipStream" then
  for i=1,(card.id=="dropPickles" and 3 or 1) do
   local position=Vector3.new(math.clamp(root.Position.X+(i-2)*6,-16,16),181.4,-side*self.random:NextNumber(12,32))
   local part=Instance.new("Part"); part.Name=card.name; part.Anchored=true; part.CanCollide=false; part.CanTouch=false
   part.Material=Enum.Material.Neon; part.Color=card.id=="dropPickles" and Color3.fromRGB(149,255,63) or Color3.fromRGB(255,221,60)
   part.Size=card.id=="dropPickles" and Vector3.new(1.5,0.5,3) or Vector3.new(10,0.12,12)
   part.Position=position; part.Transparency=card.id=="dropPickles" and 0.1 or 0.45; part.Parent=world
   table.insert(self.hazards,{part=part,position=position,side=-side,expires=slot.activeUntil,kind=card.id,touched={}})
  end
 end
 return card
end
function Arcade:heatTarget(player,now,opponentPositions,side)
 local data=self:data(player)
 local level=data.levels.heatseeker or 0
 if level>0 then
  if now<(data.chaosHeatReadyAt or 0) then return nil end
  data.chaosHeatReadyAt=now+Deck.chaosValues(data.levels).heatInterval
 elseif not self:effect(player,"heatseeker",now) then return nil end
 data.effects.heatseeker=0
 for _,slot in pairs(data.slots) do
  if slot.id=="heatseeker" and slot.activeUntil and slot.activeUntil>now then slot.activeUntil=now; slot.readyAt=now+(slot.cooldownDuration or Deck.COOLDOWN) end
 end
 local best,bestDistance
 for _,x in ipairs({-17,17}) do
  local target=Vector3.new(x,181.7,-side*35); local nearest=math.huge
  for _,position in ipairs(opponentPositions) do nearest=math.min(nearest,(target-position).Magnitude) end
  if not best or nearest>bestDistance then best=target; bestDistance=nearest end
 end
 return best
end
function Arcade:touch(key,side,position,now)
 local effects=self:data(key).effects
 for _,hazard in ipairs(self.hazards) do
  if now<hazard.expires and hazard.side==side and not hazard.touched[key] then
   local offset=Vector3.new(position.X-hazard.position.X,0,position.Z-hazard.position.Z)
   local inZone=hazard.halfSize and math.abs(offset.X)<=hazard.halfSize and math.abs(offset.Z)<=hazard.halfSize
    or not hazard.halfSize and offset.Magnitude<=Deck.HAZARD_RADIUS
   if inZone then
    hazard.touched[key]=true; effects.slide=now+Deck.PICKLE_RECOVERY
    effects.slideDirection=offset.Magnitude>0.1 and offset.Unit or Vector3.new(1,0,0)
   end
  end
 end
 return now<(effects.slide or 0),effects.slideDirection
end
function Arcade:update(now)
 for i=#self.hazards,1,-1 do
  if now>=self.hazards[i].expires then self.hazards[i].part:Destroy(); table.remove(self.hazards,i) end
 end
end
function Arcade:chaosGift(player,now)
 local offer=self:chaosOffer()
 return self:choose(player,offer,offer[1].id,now,true)
end

-- Permanent levels remain between rallies; automatic hazards advance only in live play.
function Arcade:chaosUpdate(dt,now,participants,world,live)
 self.chaosGravity=1
 for _,entry in ipairs(participants) do
  local data=self:data(entry.player)
  local values=Deck.chaosValues(data.levels)
  self.chaosGravity=math.min(self.chaosGravity,values.gravity)
  data.chaosShrink=1
  for _,enemy in ipairs(participants) do
   if enemy.side~=entry.side then data.chaosShrink=math.min(data.chaosShrink,Deck.chaosValues(self:data(enemy.player).levels).shrink) end
  end
  if not live then continue end
  for _,id in ipairs({"dropPickles","slipStream"}) do
   local level=data.levels[id] or 0
   if level==0 then continue end
   local elapsed=(data.chaosTimers[id] or 0)+math.max(0,dt)
   local interval=id=="dropPickles" and values.pickleInterval or values.slipInterval
   data.chaosTimers[id]=elapsed
   if elapsed<interval then continue end
   data.chaosTimers[id]=0
   local count=id=="dropPickles" and values.pickleCount or 1
   for _=1,count do
    local position=Vector3.new(self.random:NextNumber(-14,14),181.4,-entry.side*self.random:NextNumber(16,34))
    local part=Instance.new("Part"); part.Name="Chaos "..Deck.find(id).name
    part.Anchored=true; part.CanCollide=false; part.CanTouch=false; part.Material=Enum.Material.Neon
    part.Color=id=="dropPickles" and Color3.fromRGB(149,255,63) or Color3.fromRGB(255,221,60)
    part.Size=id=="dropPickles" and Vector3.new(1.5,0.5,3) or Vector3.new(values.slipSize,0.12,values.slipSize)
    part.Position=position; part.Transparency=id=="dropPickles" and 0.1 or 0.45; part.Parent=world
    table.insert(self.hazards,{part=part,position=position,side=-entry.side,expires=now+6,kind=id,
     halfSize=id=="slipStream" and values.slipSize/2 or nil,touched={}})
   end
  end
 end
end

-- Tick only during live Chaos rallies; one shared event affects both teams.
function Arcade:chaosStep(dt,now,participants,world)
 self.chaosElapsed=(self.chaosElapsed or 0)+math.max(0,dt)
 if self.chaosElapsed<(self.chaosNext or 4) or #participants==0 then return nil end
 local events={
  {id="speedCleats",name="SPEED FRENZY",detail="Everyone moves faster"},
  {id="bigPaddle",name="GIANT PADDLES",detail="Everyone gets extra reach"},
  {id="zeroG",name="GRAVITY SURGE",detail="Extra-low gravity for everyone"},
  {id="glowBall",name="LIGHTS OUT",detail="Follow the glowing ball"},
  {id="pickles",name="PICKLE STORM",detail="Watch your step on both sides"},
 }
 local index=self.random:NextInteger(1,self.chaosEvent and #events-1 or #events)
 if self.chaosEvent and index>=self.chaosEvent.index then index+=1 end
 local event=events[index]
 local endsAt=now+8
 for _,entry in ipairs(participants) do
  local effects=self:data(entry.player).effects
  if event.id=="speedCleats" or event.id=="bigPaddle" then effects[event.id]=math.max(effects[event.id] or 0,endsAt) end
 end
 if event.id=="zeroG" then self.zeroUntil=math.max(self.zeroUntil,endsAt)
 elseif event.id=="glowBall" then self.glowUntil=math.max(self.glowUntil,endsAt)
 elseif event.id=="pickles" then
  for _,side in ipairs({-1,1}) do
   for i=1,3 do
    local position=Vector3.new(self.random:NextNumber(-16,16),181.4,side*self.random:NextNumber(16,36))
    local part=Instance.new("Part"); part.Name="ChaosPickle"; part.Anchored=true; part.CanCollide=false; part.CanTouch=false
    part.Material=Enum.Material.Neon; part.Color=Color3.fromRGB(149,255,63)
    part.Size=Vector3.new(1.5,0.5,3); part.Position=position; part.Rotation=Vector3.new(0,self.random:NextNumber(-90,90),0); part.Parent=world
    table.insert(self.hazards,{part=part,position=position,side=side,expires=endsAt,kind="dropPickles",touched={}})
   end
  end
 end
 self.chaosEvent={index=index,name=event.name,detail=event.detail,endsAt=endsAt}
 self.chaosElapsed=0; self.chaosNext=self.random:NextInteger(10,14)
 return self.chaosEvent
end
function Arcade:pause(dt)
 self.zeroUntil+=dt; self.glowUntil+=dt
 if self.chaosEvent then self.chaosEvent.endsAt+=dt end
 for _,data in pairs(self.players) do
  if data.chaosHeatReadyAt then data.chaosHeatReadyAt+=dt end
  for id,value in pairs(data.effects) do if type(value)=="number" and value>0 then data.effects[id]+=dt end end
  for _,slot in pairs(data.slots) do if slot.readyAt then slot.readyAt+=dt; slot.activeUntil+=dt end end
 end
 for _,hazard in ipairs(self.hazards) do hazard.expires+=dt end
end
function Arcade:snapshot(player,now)
 self:empty(player,now)
 local slots={}
 for index=1,2 do
  local slot=self:data(player).slots[index]
  slots[index]=slot and {id=slot.id,charges=slot.charges or 0,armed=slot.armed==true,active=math.max(0,(slot.activeUntil or 0)-now),cooldown=math.max(0,(slot.readyAt or 0)-now),cooldownDuration=slot.cooldownDuration or Deck.COOLDOWN,duration=slot.duration or 0} or {id=""}
 end
 local event=self.chaosEvent
 local data=self:data(player)
 local values=Deck.chaosValues(data.levels)
 return {slots=slots,queued=#data.pending,levels=table.clone(data.levels),
  glow=now<self.glowUntil or (data.levels.glowBall or 0)>0,lightRange=values.lightRange,lightBrightness=values.lightBrightness,zeroG=self:gravity(now)<1,
  chaos=event and {name=event.name,detail=event.detail,remaining=math.max(0,event.endsAt-now)} or nil}
end
return Arcade
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">CitySurroundings</string>
          <string name="Source"><![CDATA[-- Static scenery around the lobby: shared construction, no running decor scripts or lights.
local CitySurroundings={}
function CitySurroundings.build(lobby)
 if workspace:FindFirstChild("LobbyCity") then return lobby end
 local floor=lobby.Architecture["Cream marble floor"]
 local base=workspace:WaitForChild("Baseplate")
 local groundY=base.Position.Y+base.Size.Y/2
 local city=workspace:WaitForChild("PaddleUp")
 local concrete=city:FindFirstChild("Balcony slab")
 local tower=city:FindFirstChild("City tower")
 local glass=city:FindFirstChild("Apartment glazing")
 local district=Instance.new("Model")
 district.Name="LobbyCity"; district:SetAttribute("Version",1)
 local center=Vector3.new(floor.Position.X,0,floor.Position.Z)
 local function part(parent,name,size,pos,color,material,collide)
  local p=Instance.new("Part")
  p.Name=name; p.Size=size; p.Position=pos; p.Color=color; p.Material=material
  p.Anchored=true; p.CanCollide=collide~=false; p.CanTouch=false; p.CanQuery=true
  p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
  p.Parent=parent
  return p
 end
 local function localPart(parent,name,size,x,y,z,color,material,collide)
  return part(parent,name,size,center+Vector3.new(x,y,z),color,material,collide)
 end
 local stone=concrete.Color
 local asphalt=Color3.fromRGB(47,52,60)
 local metal=Color3.fromRGB(65,75,84)
 local pavement=Color3.fromRGB(139,144,145)
 -- Tile beyond the original baseplate so the lobby never overlooks its nearby edge.
 local ground=Instance.new("Model"); ground.Name="Ground and streets"; ground.Parent=district
 for x=-1,1 do
  for z=-1,1 do
   if x~=0 or z~=0 then
    part(ground,"City ground extension",Vector3.new(base.Size.X,base.Size.Y,base.Size.Z),
     base.Position+Vector3.new(x*base.Size.X,0,z*base.Size.Z),base.Color,base.Material)
   end
  end
 end
 localPart(ground,"West street",Vector3.new(28,0.2,760),-120,groundY+0.1,10,asphalt,Enum.Material.Asphalt)
 localPart(ground,"Connecting street",Vector3.new(410,0.2,20),-90,groundY+0.1,104,asphalt,Enum.Material.Asphalt)
 localPart(ground,"West sidewalk",Vector3.new(12,0.5,760),-100,groundY+0.25,10,pavement,Enum.Material.Concrete)
 localPart(ground,"Opposite sidewalk",Vector3.new(14,0.5,760),-141,groundY+0.25,10,pavement,Enum.Material.Concrete)
 localPart(ground,"Lobby forecourt",Vector3.new(184,0.5,15),0,groundY+0.25,86.5,pavement,Enum.Material.Concrete)
 localPart(ground,"North curb",Vector3.new(410,0.5,3),-90,groundY+0.25,115.5,pavement,Enum.Material.Concrete)
 localPart(ground,"East sidewalk",Vector3.new(10,0.5,158),99,groundY+0.25,0,pavement,Enum.Material.Concrete)
 -- Sparse road markings stop before the junction.
 for z=-330,330,32 do
  if math.abs(z-104)>22 then
   localPart(ground,"Lane marking",Vector3.new(0.2,0.02,10),-120,groundY+0.21,z,
    Color3.fromRGB(204,201,181),Enum.Material.SmoothPlastic,false)
  end
 end
 -- Concrete additions sit outside the retained windows and join the grounded foundation.
 local details=Instance.new("Model"); details.Name="Concrete tower details"; details.Parent=district
 local ceiling=lobby.Architecture["Ivory ceiling"]
 local podiumTop=ceiling.Position.Y+ceiling.Size.Y/2
 for _,x in ipairs({-91,91}) do
  for _,z in ipairs({-79,79}) do
   localPart(details,"Ground floor concrete pier",Vector3.new(2, podiumTop-groundY,2),
    x,(groundY+podiumTop)/2,z,stone,Enum.Material.Concrete)
  end
  localPart(details,"Concrete base course",Vector3.new(0.6,5,158),
   x+math.sign(x)*0.3,groundY+2.5,0,stone,Enum.Material.Concrete)
 end
 for _,z in ipairs({-79,79}) do
  localPart(details,"Concrete base course",Vector3.new(182,5,0.6),
   0,groundY+2.5,z+math.sign(z)*0.3,stone,Enum.Material.Concrete)
 end
 local foundation=lobby.Architecture["Penthouse foundation"]
 local top=foundation.Position.Y+foundation.Size.Y/2
 for _,x in ipairs({-91,91}) do
  for _,z in ipairs({-79,79}) do
   localPart(details,"Concrete corner fin",Vector3.new(1,top-podiumTop,1),
    x,(top+podiumTop)/2,z,stone,Enum.Material.Concrete)
  end
 end
 local occupied={}
 for _,p in ipairs(city:GetChildren()) do
  if p:IsA("BasePart") and (p.Name=="City tower" or p.Name=="Apartment tower") then
   table.insert(occupied,{x=p.Position.X,z=p.Position.Z,w=p.Size.X,d=p.Size.Z})
  end
 end
 table.insert(occupied,{x=center.X,z=center.Z,w=184,d=172})
 local function building(spec,index)
  local x,z,w,d,h=spec[1],spec[2],spec[3],spec[4],spec[5]
  local worldX,worldZ=center.X+x,center.Z+z
  for _,other in ipairs(occupied) do
   assert(math.abs(worldX-other.x)>(w+other.w)/2+4 or math.abs(worldZ-other.z)>(d+other.d)/2+4,
    "City scenery footprint overlaps an existing building")
  end
  table.insert(occupied,{x=worldX,z=worldZ,w=w,d=d})
  local model=Instance.new("Model"); model.Name=spec[6]; model.Parent=district
  local body=part(model,"Concrete structure",Vector3.new(w,h,d),
   Vector3.new(worldX,groundY+h/2,worldZ),tower.Color:Lerp(stone,(index%4)*0.12),Enum.Material.Concrete)
  local tint=glass.Color:Lerp(Color3.fromRGB(125,143,151),(index%3)*0.14)
  for _,side in ipairs({-1,1}) do
   local pane=part(model,"Glazed facade",Vector3.new(w-2,h-14,0.2),
    body.Position+Vector3.new(0,3,side*(d/2+0.11)),tint,Enum.Material.Glass,false)
   pane.Reflectance=0.15
   pane=part(model,"Glazed facade",Vector3.new(0.2,h-14,d-2),
    body.Position+Vector3.new(side*(w/2+0.11),3,0),tint,Enum.Material.Glass,false)
   pane.Reflectance=0.15
  end
  -- One shared slab per floor, rather than individual window parts.
  local stride=index>11 and 24 or 12
  for y=12,h-2,stride do
   part(model,"Concrete floor band",Vector3.new(w+0.6,0.5,d+0.6),
    Vector3.new(worldX,groundY+y,worldZ),stone,Enum.Material.Concrete,false)
  end
  part(model,"Roof parapet",Vector3.new(w+0.6,1.2,d+0.6),
   Vector3.new(worldX,groundY+h+0.6,worldZ),stone,Enum.Material.Concrete,false)
  part(model,"Rooftop service enclosure",Vector3.new(w*0.35,6,d*0.3),
   Vector3.new(worldX+w*0.1,groundY+h+4.2,worldZ-d*0.1),metal,Enum.Material.Metal,false)
  if index<=7 then
   -- Storefronts on the street-facing side; static glazing and frames only.
   local face=index<=4 and 1 or -1
   if index<=4 then
    local xFace=worldX+w/2+0.15
    part(model,"Storefront glazing",Vector3.new(0.2,9,d-8),
     Vector3.new(xFace,groundY+5.5,worldZ),glass.Color,Enum.Material.Glass,false)
    part(model,"Storefront canopy",Vector3.new(4,0.5,d-4),
     Vector3.new(xFace+1.5,groundY+11,worldZ),metal,Enum.Material.Metal,false)
    part(model,"Storefront entrance",Vector3.new(0.25,8,5),
     Vector3.new(xFace+0.1,groundY+4,worldZ),metal,Enum.Material.Metal,false)
   else
    local zFace=worldZ+face*(d/2+0.15)
    part(model,"Storefront glazing",Vector3.new(w-8,9,0.2),
     Vector3.new(worldX,groundY+5.5,zFace),glass.Color,Enum.Material.Glass,false)
    part(model,"Storefront canopy",Vector3.new(w-4,0.5,4),
     Vector3.new(worldX,groundY+11,zFace-1.5),metal,Enum.Material.Metal,false)
    part(model,"Storefront entrance",Vector3.new(5,8,0.25),
     Vector3.new(worldX,groundY+4,zFace-0.1),metal,Enum.Material.Metal,false)
   end
   part(model,"Concrete pavement",Vector3.new(w+12,0.5,d+12),
    Vector3.new(worldX,groundY+0.25,worldZ),pavement,Enum.Material.Concrete)
  end
 end
 -- Coordinates are relative to the integrated lobby; preserve every existing city tower.
 local blocks={
  {-205,-165,78,82,126,"West apartments"},
  {-205,-25,72,104,174,"West office tower"},
  {-205,135,88,84,94,"West commercial block"},
  {-205,285,68,108,198,"West residential tower"},
  {-75,215,78,74,84,"Front commercial block"},
  {5,224,60,80,132,"Front apartments"},
  {95,325,58,60,158,"City infill tower"},
  {-375,-215,110,100,212,"Outer west tower"},
  {-375,10,96,130,148,"Outer west apartments"},
  {-375,265,118,100,192,"Outer west offices"},
  {-135,495,110,96,156,"North district block"},
  {-615,-380,120,96,208,"Distant southwest tower"},
  {-615,-60,104,112,238,"Distant west tower"},
  {-615,280,126,100,182,"Distant northwest tower"},
  {-515,570,140,100,218,"Distant north offices"},
  {-15,640,160,100,190,"Distant north apartments"},
 }
 for index,spec in ipairs(blocks) do building(spec,index) end
 district.Parent=workspace
 return lobby
end
return CitySurroundings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Comeback</string>
          <string name="Source"><![CDATA[-- One 9–3 comeback activation per match. Side 1 is score[1], side -1 score[2].
local Comeback={MOVE=1.15,HIT=1.15}
function Comeback.new() return {side=0,used=false} end
function Comeback.update(state,score,finished)
 if finished then state.side=0; return end
 if state.side~=0 then
  local own=state.side==1 and 1 or 2
  if score[own]>=score[3-own] then state.side=0 end
 elseif not state.used then
  if score[1]==9 and score[2]==3 then state.side=-1; state.used=true
  elseif score[2]==9 and score[1]==3 then state.side=1; state.used=true end
 end
end
function Comeback.active(state,side) return side~=0 and state.side==side end
return Comeback
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">CourtEnvironments</string>
          <string name="Source"><![CDATA[-- Swap only scenery. Keep the live court, net, ball, players, and physics intact.
local Environments={}
Environments.__index=Environments
local shared={
 ["Roof deck"]=true,["Court surround"]=true,["Playing surface"]=true,Kitchen=true,
 Sideline=true,["Court line"]=true,["Service center line"]=true,["Net post"]=true,
 ["Net collision"]=true,["Net white tape"]=true,["Net cord"]=true,RallyLights=true,
}
function Environments.valid(name) return name=="Rooftop" or name=="Moon" end
function Environments.new(root)
 local self=setmetatable({root=root,active="Rooftop",colors={}},Environments)
 local cache=Instance.new("Folder"); cache.Name="CourtEnvironmentCache"; cache.Parent=game:GetService("ServerStorage")
 self.cache=cache
 local rooftop=Instance.new("Model"); rooftop.Name="RooftopEnvironment"
 for _,item in ipairs(root:GetChildren()) do
  if not shared[item.Name] then item.Parent=rooftop
  elseif item:IsA("BasePart") then self.colors[item]={color=item.Color,material=item.Material} end
 end
 rooftop.Parent=root; self.rooftop=rooftop
 -- This adjacent rooftop building lives outside the main court model.
 self.rooftopHall=workspace:FindFirstChild("SkylineLobby")
 root:SetAttribute("Environment","Rooftop"); root:SetAttribute("EnvironmentTitle","SKYLINE CLUB")
 workspace:SetAttribute("CourtEnvironment","Rooftop")
 -- Build once while players browse the lobby, before the first moon admission.
 task.defer(function()
  if not self.moon then
   self.moon=require(script.Parent:WaitForChild("MoonEnvironment")).build()
   self.moon.Parent=self.cache
  end
  require(script.Parent:WaitForChild("MapPreviews")).publish(self.root,self.rooftop,self.moon)
 end)
 return self
end
function Environments:set(name)
 assert(Environments.valid(name),"Unknown court environment")
 if name==self.active then return end
 if name=="Moon" then
  self.moon=self.moon or require(script.Parent:WaitForChild("MoonEnvironment")).build()
  self.rooftop.Parent=self.cache; self.moon.Parent=self.root
  if self.rooftopHall then self.rooftopHall.Parent=self.cache end
 else
  if self.moon then self.moon.Parent=self.cache end
  self.rooftop.Parent=self.root
  if self.rooftopHall then self.rooftopHall.Parent=workspace end
 end
 for part,original in pairs(self.colors) do
  if name=="Rooftop" then part.Color=original.color; part.Material=original.material
  elseif part.Name=="Roof deck" then part.Color=Color3.fromRGB(72,82,98); part.Material=Enum.Material.Metal
  elseif part.Name=="Court surround" then part.Color=Color3.fromRGB(48,59,77)
  elseif part.Name=="Playing surface" then part.Color=Color3.fromRGB(48,89,107)
  elseif part.Name=="Kitchen" then part.Color=Color3.fromRGB(57,127,140) end
 end
 self.active=name
 self.root:SetAttribute("Environment",name)
 self.root:SetAttribute("EnvironmentTitle",name=="Moon" and "SELENE LUNAR OUTPOST" or "SKYLINE CLUB")
 workspace:SetAttribute("CourtEnvironment",name)
end
return Environments
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">CourtPickups</string>
          <string name="Source"><![CDATA[-- Server-owned pickup lifecycle. onCollected(player, kind) is the future effect hook.
local Powerups = {}
Powerups.__index = Powerups

Powerups.SPAWN_INTERVAL = 8
Powerups.LIFETIME = 6
Powerups.FADE_SECONDS = 1.5
Powerups.DROP_SECONDS = 2.4
Powerups.PICKUP_RADIUS = 4

-- Stellate each octahedron face into a pyramid: eight points in all directions.
local function starPieces(model, template)
 local pieces = {}
 local triangles = {}
 for _,x in ipairs({-1,1}) do
  for _,y in ipairs({-1,1}) do
   for _,z in ipairs({-1,1}) do
    local vertices = {Vector3.new(x*0.8,0,0),Vector3.new(0,y*0.8,0),Vector3.new(0,0,z*0.8)}
    local tip = Vector3.new(x,y,z).Unit*1.7
    for index=1,3 do
     table.insert(triangles,{tip,vertices[index],vertices[index%3+1]})
    end
   end
  end
 end
 for index,triangle in ipairs(triangles) do
  local a,b,c = triangle[1],triangle[2],triangle[3]
  local ab,ac,bc = b-a,c-a,c-b
  if ab.Magnitude>ac.Magnitude and ab.Magnitude>bc.Magnitude then
   a,c = c,a
  elseif ac.Magnitude>bc.Magnitude then
   a,b = b,a
  end
  ab,ac,bc = b-a,c-a,c-b
  local right = ac:Cross(ab).Unit
  local back = bc.Unit
  local up = back:Cross(right).Unit
  local height = math.abs(ab:Dot(up))
  for _,half in ipairs({
   {frame=CFrame.fromMatrix((a+b)/2,right,up,back),length=math.abs(ab:Dot(back))},
   {frame=CFrame.fromMatrix((a+c)/2,-right,up,-back),length=math.abs(ac:Dot(back))},
  }) do
   local wedge = Instance.new("WedgePart")
   wedge.Name = "Star facet"
   wedge.Anchored = true
   wedge.CanCollide = false
   wedge.CanTouch = false
   wedge.CanQuery = false
   wedge.CastShadow = false
   wedge.Material = Enum.Material.SmoothPlastic
   wedge.Color = template.Color:Lerp(Color3.fromRGB(32,125,132),(index%3)*0.18)
   local size = Vector3.new(0.025,height,half.length)
   wedge.Size = size
   wedge.Parent = model
   table.insert(pieces,{part=wedge,frame=half.frame,size=size})
  end
 end
 return pieces
end

local function animateStar(pickup, center, scale, rotation, transparency)
 local frame = CFrame.new(center)*CFrame.Angles(0.3,rotation,0.2)
 for index,piece in ipairs(pickup.star) do
  piece.part.Size = piece.size*scale
  piece.part.CFrame = frame*CFrame.new(piece.frame.Position*scale)*piece.frame.Rotation
  piece.part.Transparency = transparency or 0
  -- Both halves of each triangular face share a hue; adjacent faces span the rainbow.
  piece.part.Color = Color3.fromHSV((rotation/3+math.floor((index-1)/2)/24)%1,0.8,1)
 end
end

function Powerups.new(parent, onCollected)
 local folder = Instance.new("Folder")
 folder.Name = "PowerupPickups"
 folder.Parent = parent
 return setmetatable({folder=folder, onCollected=onCollected, random=Random.new(), slots={}, bursts={}}, Powerups)
end

function Powerups:reset()
 self.folder:ClearAllChildren()
 table.clear(self.slots)
 table.clear(self.bursts)
end

function Powerups:spawn(side, now)
 local position = Vector3.new(self.random:NextNumber(-16,16),184,side*self.random:NextNumber(18,36))
 local model = Instance.new("Model")
 model.Name = "Placeholder Powerup"
 model:SetAttribute("PowerupKind", "Placeholder")
 model:SetAttribute("CourtSide", side)
 local orb = Instance.new("Part")
 orb.Name = "Pickup anchor"
 orb.Transparency = 1
 orb.Size = Vector3.new(2,2,2)
 orb.Material = Enum.Material.Neon
 orb.Color = Color3.fromRGB(110,245,218)
 orb.Anchored = true
 orb.CanCollide = false
 orb.CanTouch = false
 orb.CanQuery = false
 orb.CastShadow = false
 orb.Position = position + Vector3.new(0,8,0)
 orb.Parent = model
 model.PrimaryPart = orb
 local sparks = {}
 for index=1,4 do
  local spark = orb:Clone()
  spark.Name = "Orbit spark"
  spark.Transparency = 0
  spark.Shape = Enum.PartType.Block
  spark.Size = Vector3.new(0.3,0.3,0.3)
  spark.Color = Color3.fromRGB(245,225,145)
  spark.Parent = model
  sparks[index] = spark
 end
 local light = Instance.new("PointLight")
 light.Color = orb.Color
 light.Range = 8
 light.Brightness = 0.6
 light.Parent = orb
 local label = Instance.new("BillboardGui")
 label.Size = UDim2.fromOffset(160,42)
 label.StudsOffset = Vector3.new(0,2,0)
 label.MaxDistance = 65
 label.Parent = orb
 local text = Instance.new("TextLabel")
 text.Size = UDim2.fromScale(1,1)
 text.BackgroundTransparency = 1
 text.Font = Enum.Font.GothamBold
 text.TextSize = 12
 text.TextColor3 = Color3.fromRGB(235,255,246)
 text.TextStrokeTransparency = 0.4
 text.Text = "TEST POWERUP\nWalk into star to grab"
 text.Parent = label
 local pickup = {model=model, orb=orb, sparks=sparks, light=light, label=label, position=position, born=now}
 pickup.star = starPieces(model,orb)
 self:animate(pickup,0)
 model.Parent = self.folder
 return pickup
end

function Powerups:animate(pickup, age)
 local progress = math.clamp(age/self.DROP_SECONDS,0,1)
 local eased = progress*progress*(3-2*progress)
 local spiral = math.sin(progress*math.pi)*0.9
 local idle = math.max(0,age-self.DROP_SECONDS)
 local fade = math.clamp((idle-(self.LIFETIME-self.FADE_SECONDS))/self.FADE_SECONDS,0,1)
 local center = pickup.position+Vector3.new(math.sin(progress*math.pi*2)*spiral,
  8*(1-eased)+math.sin(idle*3)*0.25,math.cos(progress*math.pi*2)*spiral)
 pickup.orb.Position = center
 local beat = (1+math.sin(age*math.pi*2*1.5))/2
 local pulse = 1.8+beat*0.7
 pickup.orb.Size = Vector3.new(pulse,pulse,pulse)
 animateStar(pickup,center,pulse/2,age*0.9,fade)
 pickup.light.Color = Color3.fromHSV((age*0.3)%1,0.65,1)
 pickup.light.Brightness = (0.6+beat*1.2)*(1-fade)
 pickup.light.Range = 7+beat*3
 local text = pickup.label:FindFirstChildOfClass("TextLabel")
 if text then
  text.TextTransparency = fade
  text.TextStrokeTransparency = 0.4+0.6*fade
 end
 for index,spark in ipairs(pickup.sparks) do
  spark.Transparency = fade
  spark.Color = Color3.fromHSV((age*0.3+(index-1)/4)%1,0.75,1)
  local sparkSize = 0.22+beat*0.16
  spark.Size = Vector3.new(sparkSize,sparkSize,sparkSize)
  local angle = age*2+(index-1)*math.pi/2
  local radius = 1.65+beat*0.35
  spark.CFrame = CFrame.new(center+Vector3.new(math.cos(angle)*radius,math.sin(angle*2)*0.35,math.sin(angle)*radius))
   *CFrame.Angles(age*2,angle,math.pi/4)
 end
end

-- Claimed objects are already unavailable while their short visual burst finishes.
function Powerups:animateBursts(now)
 for index=#self.bursts,1,-1 do
  local burst = self.bursts[index]
  local t = math.clamp((now-burst.at)/0.45,0,1)
  local pickup = burst.pickup
  if t>=1 then
   pickup.model:Destroy()
   table.remove(self.bursts,index)
  else
   local size = 2*(1-t)+0.05
   pickup.orb.Size = Vector3.new(size,size,size)
   pickup.orb.Position = burst.center+Vector3.new(0,t*1.5,0)
   animateStar(pickup,pickup.orb.Position,size/2,(now-pickup.born)*0.9,t)
   pickup.light.Brightness = (1-t)*2
   for sparkIndex,spark in ipairs(pickup.sparks) do
    local angle = (sparkIndex-1)*math.pi/2
    spark.Position = burst.center+Vector3.new(math.cos(angle)*(1.7+t*3),t,math.sin(angle)*(1.7+t*3))
    spark.Transparency = t
   end
  end
 end
end

-- Participants are supplied by the authoritative court roster; spectators cannot collect.
function Powerups:update(now, participants)
 self:animateBursts(now)
 for _,side in ipairs({1,-1}) do
  local occupied = false
  for _,entry in ipairs(participants) do
   if entry.side == side then occupied = true; break end
  end
  local slot = self.slots[side]
  if not occupied then
   if slot and slot.pickup then slot.pickup.model:Destroy() end
   self.slots[side] = nil
   continue
  end
  if not slot then
   slot = {nextSpawn=now+2}
   self.slots[side] = slot
  end
  if not slot.pickup and now >= slot.nextSpawn then
   slot.pickup = self:spawn(side, now)
  end
  local pickup = slot.pickup
  if not pickup then continue end
  local age = now-pickup.born
  if age >= self.DROP_SECONDS+self.LIFETIME then
   pickup.model:Destroy()
   slot.pickup = nil
   slot.nextSpawn = now+self.SPAWN_INTERVAL
   continue
  end
  self:animate(pickup,age)
  if age < self.DROP_SECONDS then continue end
  for _,entry in ipairs(participants) do
   local character = entry.player.Character
   local root = character and character:FindFirstChild("HumanoidRootPart")
   local humanoid = character and character:FindFirstChildOfClass("Humanoid")
   if entry.side == side and root and humanoid and humanoid.Health > 0
    and (root.Position-pickup.orb.Position).Magnitude <= self.PICKUP_RADIUS then
    -- Remove before invoking the hook: only one player can claim this instance.
    slot.pickup = nil
    slot.nextSpawn = now+self.SPAWN_INTERVAL
    pickup.label.Enabled = false
    table.insert(self.bursts,{pickup=pickup,at=now,center=pickup.orb.Position})
    self:animateBursts(now)
    self.onCollected(entry.player, "Placeholder")
    break
   end
  end
 end
end

function Powerups:destroy()
 self:reset()
 self.folder:Destroy()
end

return Powerups
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">CourtsideClub</string>
          <string name="Source"><![CDATA[-- Static courtside presentation. No roster, ranking, media, or gameplay controllers.
local Club={}
local VERSION=2
local P={ivory=Color3.fromRGB(235,232,241),beige=Color3.fromRGB(202,199,216),
 emerald=Color3.fromRGB(39,42,78),teal=Color3.fromRGB(77,144,157),
 walnut=Color3.fromRGB(62,49,65),gold=Color3.fromRGB(196,180,155),
 ink=Color3.fromRGB(29,31,57),blue=Color3.fromRGB(80,232,255),
 coral=Color3.fromRGB(193,145,170),warm=Color3.fromRGB(255,241,229)}
local function part(parent,name,size,frame,color,material,collide)
 local p=Instance.new("Part")
 p.Name=name; p.Size=size; p.CFrame=frame; p.Anchored=true
 p.Color=color; p.Material=material or Enum.Material.SmoothPlastic
 p.CanCollide=collide==true; p.CanTouch=false; p.CanQuery=collide==true
 p.CastShadow=collide==true; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
 p.Parent=parent; return p
end
local function label(p,value,color)
 local gui=Instance.new("SurfaceGui")
 gui.Name="CourtFacingDisplay"; gui.Face=Enum.NormalId.Front
 gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud; gui.PixelsPerStud=28
 gui.LightInfluence=0.15; gui.Parent=p
 local t=Instance.new("TextLabel",gui)
 t.Size=UDim2.fromScale(1,1); t.BackgroundTransparency=1
 t.Font=Enum.Font.GothamBold; t.TextScaled=true; t.TextWrapped=true
 t.TextColor3=color or P.ivory; t.Text=value
 local pad=Instance.new("UIPadding",t)
 pad.PaddingLeft=UDim.new(0,8); pad.PaddingRight=UDim.new(0,8)
 pad.PaddingTop=UDim.new(0,6); pad.PaddingBottom=UDim.new(0,6)
end
function Club.buildHall()
 local building=workspace:FindFirstChild("SkylineLobby")
 if not building then
  building=Instance.new("Model"); building.Name="SkylineLobby"; building.Parent=workspace
  part(building,"Lobby tower",Vector3.new(58,176,72),CFrame.new(112,90,0),P.walnut,Enum.Material.Concrete,true)
  part(building,"Lobby terrace",Vector3.new(62,3,76),CFrame.new(112,179.5,0),P.ivory,Enum.Material.Marble,true)
  for _,x in ipairs({81,143}) do part(building,"Terrace railing",Vector3.new(0.5,4,76),CFrame.new(x,183,0),P.gold,Enum.Material.Metal,true) end
  for _,z in ipairs({-38,38}) do part(building,"End railing",Vector3.new(62,4,0.5),CFrame.new(112,183,z),P.gold,Enum.Material.Metal,true) end
 end
 local old=building:FindFirstChild("HallOfFame")
 if old and old:GetAttribute("Version")==VERSION then return old end
 -- Retain the existing building envelope and its collision boundaries.
 for _,item in ipairs(building:GetChildren()) do
  if item.Name=="Club lobby sign" or item.Name=="Lobby arrival" or item.Name=="Lounge bench" or item.Name=="Bench cushion"
   or item.Name:match(" station$") or item.Name:match(" queue pad$") then item:Destroy()
  elseif item:IsA("BasePart") then
   if item.Name=="Lobby tower" then item.Color=P.walnut; item.Material=Enum.Material.Concrete
   elseif item.Name=="Lobby terrace" then item.Color=P.ivory; item.Material=Enum.Material.Marble
   elseif item.Name=="Mint rail" then item.Color=P.teal; item.Material=Enum.Material.Neon
   elseif item.Name=="Terrace railing" or item.Name=="End railing" then
    item.Color=P.beige; item.Material=Enum.Material.Glass; item.Transparency=0.65
   elseif item.Name=="Planter" then item.Color=P.ivory; item.Material=Enum.Material.Marble end
   if item.Name=="Planter" or item.Name=="Topiary" then
    -- Keep the reused planting in the terrace corners, clear of the ranking displays.
    local x=item.Position.X<112 and 89 or 137
    item.Position=Vector3.new(x,item.Position.Y,math.sign(item.Position.Z)*32)
   end
  end
 end
 local hall=Instance.new("Model"); hall.Name="HallOfFame"; hall:SetAttribute("Version",VERSION)
 hall:SetAttribute("PresentationOnly",true)
 -- Local -Z is the display front and points directly toward the court at -X.
 local origin=CFrame.new(112,181,0)*CFrame.Angles(0,math.pi/2,0)
 local function fixture(name,size,pos,color,material)
  return part(hall,name,size,origin*CFrame.new(pos),color,material,false)
 end
 fixture("Champions terrace inlay",Vector3.new(66,0.06,47),Vector3.new(0,0.05,2),P.beige,Enum.Material.Marble)
 fixture("Emerald presentation wall",Vector3.new(68,32,1),Vector3.new(0,16,25),P.emerald)
 for _,x in ipairs({-34,34}) do
  fixture("Marble gallery pier",Vector3.new(2.2,36,3),Vector3.new(x,18,24),P.ivory,Enum.Material.Marble)
  fixture("Brass pier reveal",Vector3.new(0.15,33,0.12),Vector3.new(x,18,22.45),P.gold,Enum.Material.Metal)
 end
 for _,x in ipairs({-34,34}) do
  fixture("Front canopy column",Vector3.new(1.4,36,1.4),Vector3.new(x,18,-25),P.ivory,Enum.Material.Marble)
  fixture("Canopy column brass foot",Vector3.new(1.6,0.45,1.6),Vector3.new(x,0.25,-25),P.gold,Enum.Material.Metal)
 end
 fixture("Walnut gallery crown",Vector3.new(73,1.2,55),Vector3.new(0,36,0),P.walnut,Enum.Material.Wood)
 fixture("Champions crown brass lip",Vector3.new(73,0.25,0.2),Vector3.new(0,35.5,-27.5),P.gold,Enum.Material.Metal)
 fixture("Teal canopy edge",Vector3.new(71,0.12,0.12),Vector3.new(0,35.9,-27.65),P.teal,Enum.Material.Neon)
 -- The screen is an inert, named media surface for a future system.
 fixture("Billboard brass surround",Vector3.new(60,19.6,1),Vector3.new(0,23,23.9),P.gold,Enum.Material.Metal)
 fixture("Billboard dark bezel",Vector3.new(59.4,19,1),Vector3.new(0,23,23.3),P.ink,Enum.Material.Metal)
 local screen=fixture("HighlightsScreen",Vector3.new(57.5,17.2,0.12),Vector3.new(0,23,22.73),Color3.fromRGB(36,48,52))
 screen:SetAttribute("MediaReady",true); screen:SetAttribute("DisplayFace","Front")
 for _,x in ipairs({-29,29}) do
  fixture("Electric blue screen corner",Vector3.new(0.18,2,0.12),Vector3.new(x,15,22.65),P.blue,Enum.Material.Neon)
 end
 local gui=Instance.new("SurfaceGui",screen)
 gui.Name="FutureMediaSurface"; gui.Face=Enum.NormalId.Front; gui.CanvasSize=Vector2.new(1920,1080); gui.LightInfluence=0
 local placeholder=Instance.new("Frame",gui)
 placeholder.Name="NeutralPlaceholder"; placeholder.Size=UDim2.fromScale(1,1)
 placeholder.BackgroundColor3=screen.Color; placeholder.BorderSizePixel=0
 local title=fixture("Hall of Fame fascia",Vector3.new(64,2.8,0.15),Vector3.new(0,34,22.8),P.emerald)
 label(title,"TOP PLAYERS  /  HALL OF FAME",P.ivory)
 local sub=fixture("Tournament subtitle",Vector3.new(47,1.2,0.1),Vector3.new(0,12.4,24.25),P.emerald)
 label(sub,"PADDLEUP  /  CHAMPIONS GALLERY",P.gold)
 -- Reusable podium blueprint; every copy shares the same layout and court-facing labels.
 local template=Instance.new("Model"); template.Name="Ranking podium"
 part(template,"Marble podium",Vector3.new(13,2,9),CFrame.new(0,1,0),P.ivory,Enum.Material.Marble)
 part(template,"Brass podium foot",Vector3.new(13.2,0.2,9.2),CFrame.new(0,0.1,0),P.gold,Enum.Material.Metal)
 part(template,"Emerald podium inset",Vector3.new(11.5,1.25,0.1),CFrame.new(0,1,-4.56),P.emerald)
 template.WorldPivot=CFrame.identity
 for _,entry in ipairs({{rank=2,x=-19,rise=0.5},{rank=1,x=0,rise=1.5},{rank=3,x=19,rise=0}}) do
  local x,rise=entry.x,entry.rise
  fixture("Podium riser",Vector3.new(13.4,rise+0.12,9.4),Vector3.new(x,(rise+0.12)/2,1),P.walnut,Enum.Material.Wood)
  local podium=template:Clone(); podium.Name="Rank "..entry.rank.." podium"
  podium:SetAttribute("Rank",entry.rank); podium:PivotTo(origin*CFrame.new(x,rise,1)); podium.Parent=hall
  label(podium["Emerald podium inset"],"#"..entry.rank,P.gold)
  local portrait=fixture("Player portrait placeholder",Vector3.new(7.5,6,0.4),Vector3.new(x,7+rise,3.5),P.walnut,Enum.Material.Wood)
  label(portrait,"TOP "..entry.rank.."\nPLAYER --",P.ivory)
  local stats=fixture("Player stat display",Vector3.new(12,2.3,0.2),Vector3.new(x,3.5+rise,-3.5),P.ink)
  label(stats,"WINS --  /  RANK --\nRECORDS PENDING",P.beige)
  -- Gold pickleball trophy: anchored prop, never a player or bot.
  local trophy=fixture("Golden pickleball trophy",Vector3.new(2,2,2),Vector3.new(x,4+rise,0),P.gold,Enum.Material.Metal)
  trophy.Shape=Enum.PartType.Ball
  fixture("Trophy pedestal",Vector3.new(2.8,0.35,2.8),Vector3.new(x,2.3+rise,0),P.ink,Enum.Material.Marble)
  fixture("Trophy stem",Vector3.new(0.25,1,0.25),Vector3.new(x,2.95+rise,0),P.gold,Enum.Material.Metal)
 end
 template:Destroy()
 for _,x in ipairs({-29,29}) do
  fixture("Display walnut slat wall",Vector3.new(8,10,0.3),Vector3.new(x,6,24.3),P.walnut,Enum.Material.Wood)
  for dx=-3,3,1.5 do fixture("Vertical brass gallery slat",Vector3.new(0.1,9,0.15),Vector3.new(x+dx,6,24.05),P.gold,Enum.Material.Metal) end
  local lamp=fixture("Gallery opal sconce",Vector3.new(1,4,0.5),Vector3.new(x,8,23.7),P.warm,Enum.Material.Neon)
  local light=Instance.new("PointLight",lamp); light.Color=P.warm; light.Range=16; light.Brightness=0.45; light.Shadows=false
 end
 -- Architectural details tie the reused tower to the new terrace feature.
 for _,z in ipairs({-33,33}) do
  fixture("Tower brass seam",Vector3.new(0.18,155,0.12),Vector3.new(z,-85,-29.1),P.gold,Enum.Material.Metal)
 end
 fixture("Front gallery cornice",Vector3.new(74,0.6,0.6),Vector3.new(0,0.25,-30.8),P.gold,Enum.Material.Metal)
 if old then old:Destroy() end
 hall.Parent=building; building:SetAttribute("CourtsideUse","HallOfFame")
 return hall
end
function Club.addStringLights(court)
 local old=court:FindFirstChild("FairyLights")
 if old and old:GetAttribute("Version")==VERSION then return old end
 local rig=Instance.new("Model"); rig.Name="FairyLights"; rig:SetAttribute("Version",VERSION)
 local wire=part(nil,"String cable",Vector3.new(0.045,0.045,1),CFrame.identity,P.walnut,Enum.Material.SmoothPlastic)
 local bulb=part(nil,"Warm fairy bulb",Vector3.new(0.32,0.43,0.32),CFrame.identity,P.warm,Enum.Material.Neon)
 bulb.Shape=Enum.PartType.Ball
 local cap=part(nil,"Brass bulb socket",Vector3.new(0.13,0.15,0.13),CFrame.identity,P.gold,Enum.Material.Metal)
 local spans={}
 -- Attach to the existing light-mast tops, well above gameplay and sightlines.
 for _,x in ipairs({-30,30}) do
  for _,z in ipairs({-54,0}) do table.insert(spans,{Vector3.new(x,201,z),Vector3.new(x,201,z+54)}) end
 end
 for _,z in ipairs({-54,54}) do table.insert(spans,{Vector3.new(-30,201,z),Vector3.new(30,201,z)}) end
 for _,ends in ipairs(spans) do
  local a,b=ends[1],ends[2]
  local count=math.ceil((b-a).Magnitude/4.5)
  local function point(t) return a:Lerp(b,t)-Vector3.yAxis*(1.3*4*t*(1-t)) end
  local previous=point(0)
  for i=1,count do
   local at=point(i/count)
   local cable=wire:Clone(); cable.Size=Vector3.new(0.045,0.045,(at-previous).Magnitude)
   cable.CFrame=CFrame.lookAt((at+previous)/2,at); cable.Parent=rig
   local socket=cap:Clone(); socket.Position=at-Vector3.yAxis*0.08; socket.Parent=rig
   local lamp=bulb:Clone(); lamp.Position=at-Vector3.yAxis*0.34; lamp.Parent=rig
   -- Most bulbs glow as Neon; sparse, low-range lights keep rendering cost low.
   if i%5==0 then
    local light=Instance.new("PointLight",lamp); light.Color=P.warm; light.Brightness=0.18; light.Range=8; light.Shadows=false
   end
   previous=at
  end
 end
 wire:Destroy(); bulb:Destroy(); cap:Destroy()
 if old then old:Destroy() end
 rig.Parent=court; return rig
end
function Club.build(court)
 Club.buildHall(); Club.addStringLights(court)
end
return Club
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">DayNightCycle</string>
          <string name="Source"><![CDATA[-- Permanent arcade sunset. Keep the module name for existing server startup calls.
local Lighting = game:GetService("Lighting")
local DayNightCycle = {}
DayNightCycle.START_HOUR = 18

local function effect(className, name)
 local existing = Lighting:FindFirstChild(name)
 if existing and existing:IsA(className) then return existing end
 local item = Instance.new(className)
 item.Name = name
 item.Parent = Lighting
 return item
end

function DayNightCycle.start()
 -- Apply once: no heartbeat advances the clock after startup.
 Lighting.ClockTime = DayNightCycle.START_HOUR
 Lighting.GeographicLatitude = 35
 Lighting.GlobalShadows = true
 Lighting.Brightness = 2.2
 Lighting.ExposureCompensation = 0.05
 Lighting.Ambient = Color3.fromRGB(145, 143, 155)
 Lighting.OutdoorAmbient = Color3.fromRGB(168, 164, 175)
 Lighting.ColorShift_Top = Color3.fromRGB(255, 211, 166)
 Lighting.ColorShift_Bottom = Color3.fromRGB(20, 20, 25)
 Lighting.EnvironmentDiffuseScale = 0.45
 Lighting.EnvironmentSpecularScale = 0.75

 local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or effect("Atmosphere", "ArcadeSunsetAtmosphere")
 atmosphere.Color = Color3.fromRGB(255, 205, 171)
 atmosphere.Decay = Color3.fromRGB(130, 137, 172)
 atmosphere.Density = 0.24
 atmosphere.Offset = 0.1
 atmosphere.Haze = 1.4
 atmosphere.Glare = 0.2

 local sky = Lighting:FindFirstChildOfClass("Sky") or effect("Sky", "Sky")
 -- Built-in faces have no fixed sun baked into the image.
 for property, face in pairs({SkyboxBk="bk", SkyboxDn="dn", SkyboxFt="ft", SkyboxLf="lf", SkyboxRt="rt", SkyboxUp="up"}) do
  sky[property] = "rbxasset://textures/sky/sky512_" .. face .. ".tex"
 end
 sky.CelestialBodiesShown = true
 sky.SunAngularSize = 14
 sky.StarCount = 0

 local grade = effect("ColorCorrectionEffect", "ArcadeSunsetGrade")
 grade.Enabled = true
 grade.TintColor = Color3.fromRGB(255, 248, 239)
 grade.Brightness = 0.01
 grade.Contrast = 0.02
 grade.Saturation = -0.02

 -- Reuse the map's bloom so the base lighting does not stack two glow effects.
 local bloom = Lighting:FindFirstChild("ArcadeSunsetBloom") or Lighting:FindFirstChildOfClass("BloomEffect") or effect("BloomEffect", "ArcadeSunsetBloom")
 bloom.Enabled = true
 bloom.Intensity = 0.12
 bloom.Size = 32
 bloom.Threshold = 1.5

 local rays = effect("SunRaysEffect", "ArcadeSunsetRays")
 rays.Enabled = true
 rays.Intensity = 0.045
 rays.Spread = 0.8


 -- Clients restore this fixed rooftop profile after leaving the Moon.
 local profile = Lighting:FindFirstChild("RooftopProfile") or Instance.new("Folder")
 profile.Name = "RooftopProfile"
 profile.Parent = Lighting
 for _, property in ipairs({"ClockTime", "Brightness", "Ambient", "OutdoorAmbient",
  "ExposureCompensation", "ColorShift_Top", "ColorShift_Bottom",
  "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "FogEnd", "GeographicLatitude"}) do
  profile:SetAttribute(property, Lighting[property])
 end
 for _, property in ipairs({"Color", "Decay", "Density", "Haze", "Glare"}) do
  profile:SetAttribute("Atmosphere" .. property, atmosphere[property])
 end
end
return DayNightCycle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[-- Separate versioned environment; menu admission, court, and elevator metadata are unchanged.
local Lobby={}
local Furniture=require(script.Parent:WaitForChild("LobbyFurniture"))
local P=Furniture.Palette
local VERSION=6
local O=Vector3.new(0,181,600)
-- Keep the established arrival point and its view of reception.
Lobby.Spawn=CFrame.lookAt(Vector3.new(0,185,650),Vector3.new(0,185,608))
-- Saved lobbies predate the rooftop palette. Recolor in place on every build.
function Lobby.applyPalette(root)
 local legacy={
  ["248,240,220"]=P.ivory,["235,232,241"]=P.ivory,
  ["216,200,175"]=P.linen,["202,199,216"]=P.linen,
  ["194,174,146"]=P.beige,["177,170,191"]=P.beige,
  ["55,34,31"]=P.walnut,["62,49,65"]=P.walnut,
  ["16,110,88"]=P.forest,["32,143,139"]=P.teal,["77,144,157"]=P.teal,
  ["231,181,67"]=P.brass,["196,180,155"]=P.brass,
  ["28,37,61"]=P.ink,["57,103,92"]=P.upholstery,
  ["40,105,255"]=P.blue,["241,70,160"]=P.pink,
  ["231,223,202"]=P.ivory,
  ["202,194,221"]=P.linen,["169,151,193"]=P.beige,["136,128,163"]=P.upholstery,
  ["151,130,194"]=P.rose,["62,49,83"]=P.walnut,["175,168,199"]=P.brass,["39,42,78"]=P.forest,
 }
 local function mapped(color)
  return legacy[string.format("%d,%d,%d",math.round(color.R*255),math.round(color.G*255),math.round(color.B*255))]
 end
 for _,item in ipairs(root:GetDescendants()) do
  if item:IsA("BasePart") then
   local name=string.lower(item.Name)
   local foliage=string.find(name,"leaf",1,true) or string.find(name,"stem",1,true)
   if not foliage and item.Material~=Enum.Material.Glass then
    item.Color=mapped(item.Color) or item.Color
    if item.Material==Enum.Material.Wood then item.Color=P.walnut end
    if item.Material==Enum.Material.Fabric and (string.find(name,"cushion",1,true)
     or string.find(name,"armrest",1,true) or string.find(name,"seat",1,true)
     or string.find(name,"blanket",1,true) or string.find(name,"drape",1,true)) then
     item.Color=(string.find(name,"seat",1,true) or item.Name=="Sofa cushion") and P.rose or P.ivory
    end
   end
   if item.Name=="Cream marble floor" then
    item.Color=P.ivory; item.Material=Enum.Material.SmoothPlastic
   elseif item.Name=="Warm neutral woven rug" then item.Color=P.upholstery
   elseif item.Name=="Ivory ceiling" then item.Color=P.ivory
   elseif item.Name=="Cafe canopy" or item.Name=="Boutique canopy" then item.Color=P.forest end
  elseif item:IsA("TextLabel") then
   item.TextColor3=mapped(item.TextColor3) or item.TextColor3
  elseif item:IsA("Light") then item.Color=P.warm end
 end
 root:SetAttribute("PurplePaletteVersion",2)
 return root
end
-- Refresh lighting on saved lobbies without rebuilding their furniture.
function Lobby.lightInterior(root)
 for _,item in ipairs(root:GetDescendants()) do
  if item:IsA("Light") then item.Enabled=true end
  if item:IsA("BasePart") and item.Name=="Recessed warm diffuser" then
   local light=item:FindFirstChildOfClass("SurfaceLight")
   if light then
    light.Enabled=true; light.Brightness=0.9; light.Range=45
    light.Color=P.warm; light.Shadows=false
   end
  elseif item:IsA("BasePart") and (item.Name=="Cafe canopy" or item.Name=="Boutique canopy") then
   local light=item:FindFirstChild("Interior task light")
   if not light then
    light=Instance.new("SurfaceLight"); light.Name="Interior task light"; light.Parent=item
   end
   light.Enabled=true; light.Face=Enum.NormalId.Bottom; light.Angle=120
   light.Range=26; light.Brightness=0.55; light.Color=P.warm; light.Shadows=false
  end
 end
 return root
end
-- Relocate saved lobbies in place; keep the upper building mass above the ceiling.
function Lobby.moveToFirstFloor(root)
 local shell=root:WaitForChild("Architecture")
 local floor=shell:WaitForChild("Cream marble floor")
 local foundation=shell:WaitForChild("Penthouse foundation")
 if not root:GetAttribute("FirstFloorLobby") then
  local bottom=foundation.Position.Y-foundation.Size.Y/2
  local targetY=bottom+floor.Size.Y
  local delta=Vector3.new(0,targetY-(floor.Position.Y+floor.Size.Y/2),0)
  local foundationTop=foundation.Position.Y+foundation.Size.Y/2
  -- Every lobby component receives exactly the same translation.
  root:PivotTo(root:GetPivot()+delta)
  local ceiling=shell:WaitForChild("Ivory ceiling")
  local ceilingTop=ceiling.Position.Y+ceiling.Size.Y/2
  foundation.Size=Vector3.new(foundation.Size.X,foundationTop-ceilingTop,foundation.Size.Z)
  foundation.Position=Vector3.new(floor.Position.X,(foundationTop+ceilingTop)/2,floor.Position.Z)
  local function piece(template,name,size,position)
   local p=template:Clone()
   p:ClearAllChildren(); p.Name=name; p.Size=size; p.Position=position; p.Parent=shell
   return p
  end
  local center=floor.Position
  local height=ceilingTop-bottom
  for _,side in ipairs({-1,1}) do
   piece(foundation,"Ground floor side wall",Vector3.new(1,height,foundation.Size.Z),
    Vector3.new(center.X+side*(foundation.Size.X/2-0.5),bottom+height/2,center.Z))
  end
  piece(foundation,"Ground floor rear wall",Vector3.new(foundation.Size.X-2,height,1),
   Vector3.new(center.X,bottom+height/2,center.Z-foundation.Size.Z/2+0.5))
  local glass=shell:WaitForChild("Arrival glazing")
  local originalSize,originalPosition=glass.Size,glass.Position
  local width,doorHeight=12,12
  local wing=(originalSize.X-width)/2
  glass.Size=Vector3.new(wing,originalSize.Y,originalSize.Z)
  glass.Position=originalPosition-Vector3.new((width+wing)/2,0,0)
  piece(glass,"Arrival glazing right",glass.Size,originalPosition+Vector3.new((width+wing)/2,0,0))
  piece(glass,"Arrival glazing transom",Vector3.new(width,originalSize.Y-doorHeight,originalSize.Z),
   originalPosition+Vector3.new(0,doorHeight/2,0))
  -- The structural front wall shares the glazing's opening.
  local frontZ=center.Z+foundation.Size.Z/2-0.5
  local frontWing=(foundation.Size.X-2-width)/2
  for _,side in ipairs({-1,1}) do
   piece(foundation,"Ground floor front wall",Vector3.new(frontWing,height,1),
    Vector3.new(center.X+side*(width+frontWing)/2,bottom+height/2,frontZ))
  end
  piece(foundation,"Ground floor entrance lintel",Vector3.new(width,ceilingTop-targetY-doorHeight,1),
   Vector3.new(center.X,(ceilingTop+targetY+doorHeight)/2,frontZ))
  for _,p in ipairs(shell:GetChildren()) do
   if p:IsA("BasePart") and p.Name=="Arrival mullion" and math.abs(p.Position.X-center.X)<width/2 then
    p.Size=Vector3.new(p.Size.X,originalSize.Y-doorHeight,p.Size.Z)
    p.Position+=Vector3.new(0,doorHeight/2,0)
   end
  end
  -- A supported landing reaches outside the building; each step is one stud.
  local edge=center.Z+floor.Size.Z/2
  piece(floor,"Entrance landing",Vector3.new(width, floor.Size.Y,12),
   Vector3.new(center.X,floor.Position.Y,edge+6))
  piece(floor,"Entrance step",Vector3.new(width,1,2),
   Vector3.new(center.X,bottom+0.5,edge+13))
  root:SetAttribute("FirstFloorLobby",true)
 end
 local offset=Vector3.new(0,floor.Position.Y+floor.Size.Y/2-O.Y,0)
 Lobby.Spawn=CFrame.lookAt(O+Vector3.new(0,4,50)+offset,O+Vector3.new(0,4,8)+offset)
 local spawn=workspace:FindFirstChildWhichIsA("SpawnLocation")
 if spawn then spawn.CFrame=Lobby.Spawn-Vector3.new(0,3.5,0) end
 return root
end
-- Complete only this building; reuse the existing lobby glass and upper mass.
function Lobby.encloseBuilding(root)
 local shell=root:WaitForChild("Architecture")
 if root:GetAttribute("ExteriorVersion")==1 then return root end
 local floor=shell:WaitForChild("Cream marble floor")
 local ceiling=shell:WaitForChild("Ivory ceiling")
 local mass=shell:WaitForChild("Penthouse foundation")
 local floorY=floor.Position.Y+floor.Size.Y/2
 local bottom=floor.Position.Y-floor.Size.Y/2
 local top=mass.Position.Y+mass.Size.Y/2
 local center=floor.Position
 local neighbors=workspace:FindFirstChild("PaddleUp")
 local function sample(name,fallback)
  return neighbors and neighbors:FindFirstChild(name) or fallback
 end
 local concrete=sample("Apartment tower",mass)
 local slab=sample("Balcony slab",floor)
 local glazing=sample("Apartment glazing",shell:WaitForChild("Arrival glazing"))
 local facade=Instance.new("Model")
 facade.Name="Building Exterior"; facade.Parent=root
 local function part(name,size,position,color,material,collide)
  local p=Instance.new("Part")
  p.Name=name; p.Size=size; p.Position=position; p.Color=color; p.Material=material
  p.Anchored=true; p.CanCollide=collide~=false; p.CanTouch=false; p.CanQuery=true
  p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
  p.Parent=facade
  return p
 end
 mass.Color=concrete.Color; mass.Material=concrete.Material
 -- Replace opaque backing with a sill and header around the retained glazing.
 for _,p in ipairs(shell:GetChildren()) do
  if p:IsA("BasePart") and (p.Name=="Ground floor side wall" or p.Name=="Ground floor front wall") then
   local size,pos=p.Size,p.Position
   p.Size=Vector3.new(size.X,floorY-bottom,size.Z)
   p.Position=Vector3.new(pos.X,(bottom+floorY)/2,pos.Z)
   p.Color=slab.Color
   local header=part("Lobby window header",Vector3.new(size.X,1.5,size.Z),
    Vector3.new(pos.X,ceiling.Position.Y-0.25,pos.Z),slab.Color,Enum.Material.Concrete)
   -- Cover the small return between the original glazing and exterior wall line.
   if size.X<size.Z then header.Size=Vector3.new(3,1.5,size.Z)
   else header.Size=Vector3.new(size.X,1.5,3) end
  elseif p:IsA("BasePart") and p.Name=="Ground floor entrance lintel" then
   p.Size=Vector3.new(p.Size.X,1.5,3)
   p.Position=Vector3.new(p.Position.X,ceiling.Position.Y-0.25,p.Position.Z)
   p.Color=slab.Color
  end
 end
 local glass=shell:WaitForChild("Arrival glazing")
 local frontZ=glass.Position.Z
 local windowHeight=26
 local halfX=89
 local rearZ=center.Z-77
 -- The retained panes form a continuous collision boundary at their original locations.
 for _,p in ipairs(shell:GetChildren()) do
  if p:IsA("BasePart") and (p.Name=="Panoramic window" or p.Name:find("Arrival glazing",1,true)) then
   p.CanCollide=true; p.CollisionGroup="Default"; p.Anchored=true
  end
 end
 for _,x in ipairs({center.X-halfX,center.X+halfX}) do
  for _,z in ipairs({rearZ,frontZ}) do
   part("Lobby corner pier",Vector3.new(2,windowHeight,2),
    Vector3.new(x,floorY+windowHeight/2,z),slab.Color,Enum.Material.Concrete)
  end
 end
 local door=part("Fixed entrance doors",Vector3.new(12,12,0.6),
  Vector3.new(center.X,floorY+6,frontZ),P.forest,Enum.Material.Metal)
 door.CollisionGroup="Default"
 for _,dx in ipairs({-6,0,6}) do
  part("Entrance brass stile",Vector3.new(0.14,12,0.12),
   door.Position+Vector3.new(dx,0,0.36),P.brass,Enum.Material.Metal,false)
 end
 for _,dx in ipairs({-0.7,0.7}) do
  part("Fixed door handle",Vector3.new(0.16,2,0.3),
   door.Position+Vector3.new(dx,0,-0.45),P.brass,Enum.Material.Metal,false)
 end
 -- Match the adjacent tower's floor rhythm, glazing tint and pale concrete bands.
 local spacing=12
 if neighbors then
  local levels={}
  for _,p in ipairs(neighbors:GetChildren()) do
   if p:IsA("BasePart") and p.Name=="Balcony slab" then table.insert(levels,p.Position.Y) end
  end
  table.sort(levels)
  if #levels>1 then spacing=levels[2]-levels[1] end
 end
 local halfWidth,halfDepth=mass.Size.X/2,mass.Size.Z/2
 for y=math.ceil((ceiling.Position.Y+1)/spacing)*spacing,top-spacing,spacing do
  part("Exterior floor band",Vector3.new(mass.Size.X+0.8,0.8,mass.Size.Z+0.8),
   Vector3.new(center.X,y,center.Z),slab.Color,slab.Material)
  for _,side in ipairs({-1,1}) do
   local front=part("Upper floor glazing",Vector3.new(mass.Size.X-2,7,0.2),
    Vector3.new(center.X,y+5,center.Z+side*(halfDepth+0.11)),glazing.Color,Enum.Material.Glass,false)
   front.Reflectance=0.25
   local flank=part("Upper floor glazing",Vector3.new(0.2,7,mass.Size.Z-2),
    Vector3.new(center.X+side*(halfWidth+0.11),y+5,center.Z),glazing.Color,Enum.Material.Glass,false)
   flank.Reflectance=0.25
  end
 end
 local base=ceiling.Position.Y+ceiling.Size.Y/2
 for x=-halfWidth+10,halfWidth-5,20 do
  for _,side in ipairs({-1,1}) do
   part("Facade mullion",Vector3.new(0.35,top-base,0.35),
    Vector3.new(center.X+x,(base+top)/2,center.Z+side*(halfDepth+0.24)),slab.Color,Enum.Material.Metal,false)
  end
 end
 for z=-halfDepth+10,halfDepth-5,20 do
  for _,side in ipairs({-1,1}) do
   part("Facade mullion",Vector3.new(0.35,top-base,0.35),
    Vector3.new(center.X+side*(halfWidth+0.24),(base+top)/2,center.Z+z),slab.Color,Enum.Material.Metal,false)
  end
 end
 part("Building roof cap",Vector3.new(mass.Size.X+0.8,0.8,mass.Size.Z+0.8),
  Vector3.new(center.X,top+0.4,center.Z),slab.Color,slab.Material)
 root:SetAttribute("ExteriorVersion",1)
 return root
end
-- Surveyed clear site west of the court, inside the existing city baseplate.
function Lobby.integrateCity(root)
 local floor=root:WaitForChild("Architecture"):WaitForChild("Cream marble floor")
 local exterior=root:WaitForChild("Building Exterior")
 if root:GetAttribute("CityIntegrationVersion")~=1 then
  local target=Vector3.new(-345,floor.Position.Y,-70)
  local params=RaycastParams.new()
  params.FilterType=Enum.RaycastFilterType.Exclude
  params.FilterDescendantsInstances={root,workspace:FindFirstChildWhichIsA("SpawnLocation")}
  params.RespectCanCollide=true
  local ground=workspace:Raycast(target+Vector3.new(0,50,0),Vector3.new(0,-1000,0),params)
  assert(ground,"City lobby site needs supporting ground")
  root:PivotTo(root:GetPivot()+(target-floor.Position))
  local shell=root.Architecture
  local mass=shell:WaitForChild("Penthouse foundation")
  local bottom=floor.Position.Y-floor.Size.Y/2
  local function support(name,size,position)
   local p=Instance.new("Part")
   p.Name=name; p.Size=size; p.Position=position
   p.Color=mass.Color; p.Material=Enum.Material.Concrete
   p.Anchored=true; p.CanCollide=true; p.CanTouch=false
   p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
   p.Parent=exterior
  end
  local height=bottom-ground.Position.Y
  if height>0 then
   support("Grounded building foundation",Vector3.new(mass.Size.X,height,mass.Size.Z),
    Vector3.new(floor.Position.X,ground.Position.Y+height/2,floor.Position.Z))
   for _,name in ipairs({"Entrance landing","Entrance step"}) do
    local p=shell:WaitForChild(name)
    local underside=p.Position.Y-p.Size.Y/2
    support(name.." foundation",Vector3.new(p.Size.X,underside-ground.Position.Y,p.Size.Z),
     Vector3.new(p.Position.X,(underside+ground.Position.Y)/2,p.Position.Z))
   end
  end
  local door=exterior:WaitForChild("Fixed entrance doors")
  local glass=shell:WaitForChild("Arrival glazing")
  door.Material=Enum.Material.Glass; door.Color=glass.Color
  door.Transparency=0.65; door.Reflectance=0.08
  door.Anchored=true; door.CanCollide=true; door.CollisionGroup="Default"
  root:SetAttribute("CityIntegrationVersion",1)
 end
 -- Both saved and newly generated lobbies derive arrival from the moved floor.
 Lobby.Spawn=CFrame.lookAt(
  floor.Position+Vector3.new(0,floor.Size.Y/2+4,38),
  floor.Position+Vector3.new(0,floor.Size.Y/2+4,-4))
 local spawn=workspace:FindFirstChildWhichIsA("SpawnLocation")
 if spawn then spawn.CFrame=Lobby.Spawn-Vector3.new(0,3.5,0) end
 return root
end
-- Publish readiness only after the existing lobby and city setup has finished.
local function configureLoading(root)
 Lobby.applyPalette(root)
 root.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
 root:SetAttribute("ExpectedDescendants",#root:GetDescendants())
 local city=workspace:FindFirstChild("LobbyCity")
 if city then
  city.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
  city:SetAttribute("ExpectedDescendants",#city:GetDescendants())
 end
 root:SetAttribute("CityExpected",city~=nil)
 -- Keep main's arrival position and facing, including its floor adjustments.
 local spawn=workspace:FindFirstChildWhichIsA("SpawnLocation") or Instance.new("SpawnLocation")
 spawn.Name="SpawnLocation"; spawn.CFrame=Lobby.Spawn-Vector3.new(0,3.5,0)
 spawn.Size=Vector3.new(5,0.3,5); spawn.Transparency=1; spawn.CanCollide=false
 spawn.Anchored=true; spawn.Enabled=true; spawn.Neutral=true; spawn.Duration=0; spawn.Parent=workspace
 return root
end
function Lobby.build()
 local old=workspace:FindFirstChild("PaddleUpLobby")
 if old then return configureLoading(require(script.Parent:WaitForChild("CitySurroundings")).build(Lobby.integrateCity(Lobby.encloseBuilding(Lobby.moveToFirstFloor(old))))) end
 local root=Instance.new("Model"); root.Name="PaddleUpLobby"
 root:SetAttribute("Version",VERSION)
 root:SetAttribute("FloorAreaIncrease",180*156/(156*136)-1)
 local furniture=Furniture.new()
 local function group(name)
  local model=Instance.new("Model"); model.Name=name; model.Parent=root; return model
 end
 local shell=group("Architecture")
 local reception=group("Check In")
 local elevators=group("Elevator Banks")
 local shop=group("Shop")
 local cafe=group("Cafe")
 local achievements=group("Achievements")
 local lounges=group("Seating Zones")
 local function part(parent,name,size,pos,color,material,collide)
  local p=Instance.new("Part")
  p.Name=name; p.Size=size; p.Position=O+pos; p.Anchored=true
  p.Color=color or P.ivory; p.Material=material or Enum.Material.SmoothPlastic
  p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
  p.CanCollide=collide~=false; p.CanTouch=false; p.CanQuery=p.CanCollide
  p.CastShadow=p.CanCollide; p.Parent=parent
  return p
 end
 local function decor(parent,name,size,pos,color,material)
  return part(parent,name,size,pos,color,material,false)
 end
 local function place(kind,parent,x,y,z,yaw)
  return furniture.place(kind,parent,CFrame.new(O+Vector3.new(x,y,z))*CFrame.Angles(0,math.rad(yaw or 0),0))
 end
 local function sign(parent,name,value,pos,width,height,color,background)
  local p=decor(parent,name,Vector3.new(width,height,0.15),pos,background or P.forest)
  if background==false then p.Transparency=1 end
  local gui=Instance.new("SurfaceGui",p)
  gui.Face=Enum.NormalId.Back; gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud
  gui.PixelsPerStud=32; gui.LightInfluence=0.5
  local t=Instance.new("TextLabel",gui)
  t.Size=UDim2.fromScale(1,1); t.BackgroundTransparency=1
  t.Font=Enum.Font.GothamMedium; t.TextScaled=true; t.TextColor3=color or P.ivory; t.Text=value
  local pad=Instance.new("UIPadding",t)
  pad.PaddingLeft=UDim.new(0,12); pad.PaddingRight=UDim.new(0,12)
  pad.PaddingTop=UDim.new(0,5); pad.PaddingBottom=UDim.new(0,5)
  return p
 end
 local function wash(p,range,brightness,face)
  local light=Instance.new("SurfaceLight",p)
  light.Face=face or Enum.NormalId.Bottom; light.Color=P.warm
  light.Enabled=true; light.Range=range; light.Brightness=brightness; light.Angle=120; light.Shadows=false
 end
 local function rug(parent,x,z,width,depth)
  decor(parent,"Woven rug border",Vector3.new(width,0.05,depth),Vector3.new(x,0.04,z),P.linen,Enum.Material.Fabric)
  decor(parent,"Warm neutral woven rug",Vector3.new(width-0.7,0.05,depth-0.7),Vector3.new(x,0.09,z),P.beige,Enum.Material.Fabric)
  for _,dx in ipairs({-width/2+1.4,width/2-1.4}) do
   decor(parent,"Woven rug detail",Vector3.new(0.12,0.02,depth-2.8),Vector3.new(x+dx,0.13,z),P.upholstery,Enum.Material.Fabric)
  end
 end
 local function art(parent,x,y,z,width,height,style)
  decor(parent,"Walnut picture frame",Vector3.new(width,height,0.3),Vector3.new(x,y,z),P.walnut,Enum.Material.Wood)
  decor(parent,"Ivory art mat",Vector3.new(width-0.4,height-0.4,0.12),Vector3.new(x,y,z+0.21),P.ivory)
  decor(parent,"Sage abstract field",Vector3.new(width*0.58,height*0.52,0.05),Vector3.new(x-width*0.1,y+0.4,z+0.3),P.blue)
  local p=decor(parent,"Abstract forest shape",Vector3.new(width*0.25,height*0.7,0.07),Vector3.new(x+width*0.2,y-0.15,z+0.35),P.pink)
  if style then p.Shape=Enum.PartType.Ball end
  decor(parent,"Brass art line",Vector3.new(width*0.72,0.08,0.09),Vector3.new(x,y-height*0.25,z+0.42),P.brass,Enum.Material.Metal)
 end
 -- +32.4% usable floor area, preserving all original area relationships.
