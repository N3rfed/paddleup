return function(A,Rules)
 assert(A.perfect({perfectVision=true},0.275,10) and not A.perfect({},0.275,10),"Vision expands pre-bounce timing")
 assert(A.perfect({perfectVision=true},10,0.335) and not A.perfect({},10,0.335),"Vision expands post-bounce timing")
 assert(not A.perfect({perfectVision=true},0.277,0.337),"Outside expanded timing remains imperfect")
 local movement,pose=A.diveDuration({quickRecovery=true})
 assert(movement==0.24 and pose==0.33,"Recovery halves both movement and pose locks")
 assert(A.diveDuration({})==0.48,"Ordinary dive unchanged")
 assert(A.lateralScale({baselineSentinel=true},40,0,1)==1.15,"Baseline strafe receives exact boost")
 assert(A.lateralScale({baselineSentinel=true},40,0,0)==1,"Forward movement never receives lateral boost")
 assert(A.lateralScale({baselineSentinel=true},35.9,0,1)==1,"Outside two-foot band remains unchanged")
 assert(A.lateralScale({baselineSentinel=true},40,21,1)==1,"Outside baseline sidelines receives no boost")
 assert(A.warden({kitchenWarden=true},14,0,0,true),"Planted player extends intercept sphere")
 assert(not A.warden({kitchenWarden=true},14,0,2,true),"Moving players cannot extend warden sphere")
 assert(not A.warden({kitchenWarden=true},14,0,0,false),"Airborne warden is not planted")
 local build={momentumShift=true,terminalVelocity=true}
 local state=A.newRally()
 local speed=1
 for _=1,3 do speed=A.acceleration(build,state,speed,true,false,false,Rules.returnSpeed) end
 assert(math.abs(speed-1.08^3)<1e-9,"Terminal perfect acceleration")
 local fourth,message=A.acceleration(build,state,speed,true,false,false,Rules.returnSpeed)
 assert(math.abs(fourth-speed*1.15)<1e-9 and message and state.perfectChain==0,"Momentum overrides terminal on fourth hit")
 A.acceleration(build,state,1,true,false,false,Rules.returnSpeed)
 A.acceleration(build,state,1,false,false,false,Rules.returnSpeed)
 assert(state.perfectChain==0,"Imperfect hits break the perfect chain")
 assert(A.acceleration({terminalVelocity=true},state,100,true,false,false,Rules.returnSpeed)==108,"Terminal acceleration is uncapped")
 local match={}
 A.terminalWin({terminalVelocity=true},match,1.5)
 assert(not match.speedWins,"Terminal win threshold is strictly greater than 1.5")
 for _=1,3 do A.terminalWin({terminalVelocity=true},match,1.51) end
 assert(match.speedWins==3,"Permanent win stacks accumulate")
 assert(not A.apex({apexPredator=true},0,0,45),"Flight apex is not bounce apex")
 assert(A.apex({apexPredator=true},1,2.6,45) and not A.apex({apexPredator=true},1,2.8,45),"Bounce apex tolerance is 60ms")
 local hidden,glitch,heavy=A.tracking(true,true,10,10.5,10.65,true,true)
 assert(hidden and glitch and heavy,"Opponents receive active deception")
 hidden,glitch,heavy=A.tracking(false,true,10,11,11,true,true)
 assert(not hidden and not glitch and not heavy,"Teammates and spectators retain truthful tracking")
 hidden,glitch,heavy=A.tracking(true,true,11,10.5,10.65,true,false)
 assert(not hidden and not glitch and not heavy,"Tracking recovers at expiry and net crossing")
 local from,v=Vector3.new(0,190,1),Vector3.new(0,0,-20)
 local at,velocity,g=Rules.advanceFlight(from,v,45,0.1,false,false,true,1)
 local mid,mv=Rules.advanceBall(from,v,45,0.05,false,false)
 local expected=Rules.advanceBall(mid,mv,81,0.05,false,false)
 assert((at-expected).Magnitude<1e-8 and g==81,"Offensive dive switches gravity exactly at the net")
 local ordinary=Rules.advanceFlight(from,v,45,0.1,false,false,false,1)
 assert(ordinary.Y>at.Y,"Maximum topspin causes additional descent")
 return "Advanced timing, recovery, lateral movement, warden, acceleration, terminal stacks, apex, viewer filtering and topspin passed"
end
