return function(Queue,Setup)
 local events,time={},0
 local random={index=1,NextInteger=function(self,low,high) assert(low==1); return math.min(self.index,high) end}
 local q=Queue.new(function(player,data) events[player]=data end,function() return time end,random)
 local a,b,c,d={DisplayName="A"},{DisplayName="B"},{DisplayName="C"},{DisplayName="D"}
 assert(not q:join(a,"Unknown","1V1") and not q:join(a,"Classic","Unknown"),"Reject invalid queues")
 assert(q:join(a,"Chaos","1V1") and not q:join(a,"Classic","1V1"),"One queue per player")
 q:update(true); assert(not q.active,"Incomplete groups wait")
 q:join(b,"Classic","1V1"); q:join(c,"Chaos","1V1")
 q:update(false); assert(not q.active,"Busy courts keep full groups queued")
 q:update(true)
 assert(events[a].stage=="Setup" and events[c].stage=="Setup" and events[b].stage=="Queued","Queues separate modes")
 assert(events[a].endsAt==15,"A shared server deadline starts voting")
 assert(not q:configure(b,"Moon","None"),"Other queues cannot vote")
 assert(not q:configure(a,"Moon","None") and not q:configure(a,"Invalid","LowGravity"),"Validate modes and maps")
 assert(q:configure(a,"Rooftop","LowGravity") and q:configure(c,"Moon","LowGravity"),"Every player can vote")
 assert(events[a].counts.Moon==1 and events[a].counts.Rooftop==1,"Vote counts are shared")
 assert(events[a].roster[2].map=="Moon" and events[c].roster[1].map=="Rooftop","Player picks are visible to opponents")
 assert(q:configure(c,"Rooftop"),"Picks can change")
 assert(events[a].counts.Rooftop==2 and events[a].counts.Moon==0,"Changing a pick replaces the previous vote")
 q:configure(c,"Moon")
 time=15
 assert(not q:configure(a,"Moon"),"Deadline rejects late votes even before the next heartbeat")
 q:update(true)
 assert(events[a].stage=="Reveal" and #events[a].candidates==2 and events[a].map=="Rooftop","Tie enters a lottery between tied maps")
 assert(not q:configure(c,"Rooftop"),"Reveal locks picks")
 assert(not q:update(true),"Roulette finishes before admission")
 time=19
 local group=q:update(true)
 assert(group and group.map=="Rooftop" and group.modifier=="LowGravity","Server admits the shared result")
 assert(not q.members[a] and not q.members[c] and not q.active,"Admission clears queue membership")
 q:remove(b); assert(#q.groups==0,"Cancellation clears empty groups")
 local function open(mode,format,players)
  for _,p in ipairs(players) do assert(q:join(p,mode,format)) end
  q:update(true)
 end
 open("Classic","1V2",{a,b,c})
 q:configure(a,"Moon"); q:configure(b,"Moon"); q:configure(c,"Rooftop")
 time+=15; q:update(true)
 assert(events[a].map=="Moon" and #events[a].candidates==1,"A majority wins without including losing maps")
 q:remove(b)
 assert(not q.active and events[a].stage=="Queued","Departure cancels the reveal")
 q:join(d,"Classic","1V2"); q:update(true)
 assert(events[a].endsAt==time+15 and events[a].counts.Moon==1,"Replacement restarts voting and removes departed votes")
 q:remove(a); q:remove(c); q:remove(d)
 random.index=2
 open("Classic","Practice",{a})
 time+=15; q:update(true)
 assert(events[a].map=="Moon" and #events[a].candidates==2,"Abstentions randomize all maps; both tie results are reachable")
 time+=4; assert(q:update(true))
 open("Arcade","1V1",{a,b})
 assert(q:configure(a,"Moon","LowGravity") and q:configure(b,"Moon","None"),"Arcade modifier is optional for every voter")
 time+=15; q:update(true)
 assert(events[a].modifier=="None","A tied optional modifier stays off")
 time+=2; assert(q:update(true))
 open("Arcade","1V1",{a,b})
 q:configure(a,"Moon","LowGravity"); q:configure(b,"Moon","LowGravity")
 time+=15; q:update(true)
 assert(events[a].modifier=="LowGravity","Arcade modifier majority enables it")
 q:remove(a); q:remove(b)
 assert(Setup.valid("Chaos","Rooftop","LowGravity") and not Setup.valid("Chaos","Rooftop","None"))
 return "Live picks, changes, mode isolation, vote locking, majority, randomized ties, abstentions, departures, and modifiers passed"
end